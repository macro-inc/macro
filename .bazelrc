common --lockfile_mode=off
build --@rules_rust//rust/settings:pipelined_compilation=False
build --action_env=PATH
build --action_env=CODE_MODE_ASSETS_DIR
build --action_env=AWS_LC_SYS_CMAKE_BUILDER_aarch64_linux_android
build --action_env=AWS_LC_SYS_CMAKE_BUILDER_armv7_linux_androideabi
build --action_env=AWS_LC_SYS_CMAKE_BUILDER_i686_linux_android
build --action_env=AWS_LC_SYS_CMAKE_BUILDER_x86_64_linux_android
build --action_env=BINDGEN_EXTRA_CLANG_ARGS
build --action_env=CC
build --action_env=CFLAGS_aarch64_unknown_linux_gnu
build --action_env=CFLAGS_x86_64_unknown_linux_gnu
build --action_env=CMAKE_INCLUDE_PATH
build --action_env=CMAKE_LIBRARY_PATH
build --action_env=CXX
build --action_env=CXXFLAGS_aarch64_unknown_linux_gnu
build --action_env=CXXFLAGS_x86_64_unknown_linux_gnu
build --action_env=LIBCLANG_PATH
build --action_env=NIX_BINTOOLS
build --action_env=NIX_BINTOOLS_FOR_TARGET
build --action_env=NIX_BINTOOLS_WRAPPER_TARGET_HOST_x86_64_unknown_linux_gnu
build --action_env=NIX_BINTOOLS_WRAPPER_TARGET_TARGET_x86_64_unknown_linux_gnu
build --action_env=NIX_CC
build --action_env=NIX_CC_WRAPPER_TARGET_HOST_x86_64_unknown_linux_gnu
build --action_env=NIX_CFLAGS_COMPILE
build --action_env=NIX_ENFORCE_NO_NATIVE
build --action_env=NIX_HARDENING_ENABLE
build --action_env=NIX_LDFLAGS
build --action_env=NIX_LDFLAGS_FOR_TARGET
build --action_env=OPENSSL_NO_VENDOR
build --action_env=PKG_CONFIG_FOR_TARGET
build --action_env=PKG_CONFIG_PATH
build --action_env=PKG_CONFIG_PATH_FOR_TARGET
test --test_output=errors
test --test_env=DATABASE_URL
test --test_env=REDIS_URL
test --test_env=PATH
test --strategy=TestRunner=local
test --test_env=HOME
test --test_env=LD_LIBRARY_PATH
test --test_env=CODE_MODE_ASSETS_DIR
test --test_env=RUST_BACKTRACE=1

# Written by generate.sh: machine paths such as the linker.
try-import %workspace%/generated.bazelrc

# bazel build --config=clippy <library and binary targets>
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=clippy_checks
build:clippy --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dwarnings
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dclippy::disallowed_methods

# Reproducible outputs, so the remote cache can reuse them. Sandbox paths are random and end up in
# C debug info, CMake files and env!() values; `built` reads the epoch for its timestamp.
build --spawn_strategy=local
build --action_env=SOURCE_DATE_EPOCH=0
