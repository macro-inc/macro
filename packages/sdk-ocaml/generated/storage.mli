(** A thread's location within its document. PDF geometry remains annotation-owned. *)
type nonrec thread_anchor =
  | Markdown of {
      mark_id : string;  (** Mark UUID serialized in the document. *)
      marked_text : string option;
          (** The marked text as it read when the discussion was created, already
trimmed and bounded. Absent on threads created or imported before
snapshots were captured: the text a mark covers cannot be recovered
from the mark id alone. *)
    }  (** Stable Lexical mark identity, independent of transient node keys. *)
  | Pdf_highlight of {
      anchor_id : string;  (** Highlight annotation UUID. *)
      marked_text : string option;
          (** The text the highlight covers, trimmed and bounded like a markdown
snapshot. The highlight owns it and it can be edited there, so it is
read from the highlight whenever the thread is, never stored on the
thread. Absent when the highlight carries no text. *)
    }  (** An independently existing PDF highlight. *)
  | Pdf_placeable of { anchor_id : string  (** Placeable annotation UUID. *) }
      (** A comment-only placeable PDF annotation. It marks a point on a page,
not a span of text, so it has no marked text. *)
  | Spreadsheet of {
      range : string;  (** A1 cell or range, such as B4 or B4:C9. *)
      sheet_id : string;  (** Stable sheet identity within the workbook. *)
      sheet_name : string;  (** Sheet name when the discussion was created. *)
    }  (** A cell or rectangular range in a native spreadsheet. *)
  | Fig of {
      node_id : string option;
          (** Layer the pin follows; absent for a pin on the bare canvas. *)
      page_id : string;  (** Page (canvas) the pin is on. *)
      x : float;
          (** Horizontal offset from the layer's origin, or the page's when
the pin is on no layer, in design units. *)
      y : float;  (** Vertical offset, measured like [x]. *)
    }
      (** A point pinned on a design ([.fig]): on a layer, or on the page
canvas when no layer was under it. *)
  | Unknown of Yojson.Safe.t
      (** A case this SDK version does not know, as received. *)

