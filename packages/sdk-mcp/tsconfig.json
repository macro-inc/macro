{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node", "bun-types"]
	},
	"include": ["src", "scripts", "*.ts"]
}
