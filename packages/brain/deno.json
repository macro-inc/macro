{
  "name": "@macro-inc/brain",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "unstable": ["sloppy-imports"],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": false,
    "lib": ["deno.window"]
  },
  "imports": {
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.318",
    "@macro-inc/sdk": "../sdk/src/macro.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "ts-pattern": "npm:ts-pattern@^5.8.0",
    "uuid": "npm:uuid@^11.1.1"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run=git,cp --allow-env --allow-net=127.0.0.1 src/",
    "check": "deno check src/",
    "compile": "bash ./compile.sh"
  }
}
