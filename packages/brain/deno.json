{
  "name": "@macro-inc/brain",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "unstable": ["sloppy-imports"],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": false,
    "lib": ["deno.window"]
  },
  "imports": {
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.318",
    "@macro-inc/sdk": "../sdk/src/macro.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "ts-pattern": "npm:ts-pattern@^5.8.0",
    "uuid": "npm:uuid@^11.1.1"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run=git --allow-env --allow-net=127.0.0.1 src/",
    "check": "deno check src/",
    "compile": "deno compile --allow-net --allow-read=/home,/tmp --allow-write=/home,/tmp --allow-run=git,claude --allow-env --allow-sys=homedir,osRelease,hostname,uid,gid --exclude node_modules/.deno/@anthropic-ai+claude-agent-sdk-linux-x64@0.3.318/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64 --exclude node_modules/.deno/@anthropic-ai+claude-agent-sdk-linux-x64-musl@0.3.318/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl --output dist/brain src/main.ts"
  }
}
