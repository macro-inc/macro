{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["node", "vite/client"],
    "paths": {
      "@core/constant/isMac": ["../../apps/web/src/lib/core/constant/isMac.ts"]
    }
  },
  "include": ["src", "browser-test", "vite.config.ts", "vitest.config.ts"]
}
