{
  "name": "@macro-inc/sdk",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macro-inc/macro.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "description": "Libary for interacting with Macro.com",
  "main": "./dist/src/macro.js",
  "module": "./dist/src/macro.js",
  "types": "./dist/src/macro.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/macro.d.ts",
      "import": "./dist/src/macro.js"
    },
    "./lexical": {
      "types": "./dist/src/lexical.d.ts",
      "import": "./dist/src/lexical.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*/index.d.ts",
      "import": "./dist/generated/*/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-specs": "bun scripts/sync-specs.ts",
    "webhook": "bun scripts/webhook.ts",
    "validate-webhook": "bun scripts/validate-webhook.ts",
    "coverage": "bun src/coverage/check.ts",
    "generate": "bun scripts/generate.ts",
    "build:js": "bun scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "vendor": "bun scripts/vendor.ts",
    "vendor:check": "bun scripts/vendor.ts --check"
  },
  "dependencies": {
    "linkify-it": "^5.0.0",
    "nanoid": "^5.1.5",
    "ts-pattern": "^5.8.0",
    "uuid": "^11.1.1"
  },
  "peerDependencies": {
    "@lexical/code": "0.45.0",
    "@lexical/headless": "0.45.0",
    "@lexical/link": "0.45.0",
    "@lexical/list": "0.45.0",
    "@lexical/mark": "0.45.0",
    "@lexical/markdown": "0.45.0",
    "@lexical/rich-text": "0.45.0",
    "@lexical/table": "0.45.0",
    "@lexical/utils": "0.45.0",
    "lexical": "0.45.0"
  },
  "peerDependenciesMeta": {
    "@lexical/code": { "optional": true },
    "@lexical/headless": { "optional": true },
    "@lexical/link": { "optional": true },
    "@lexical/list": { "optional": true },
    "@lexical/mark": { "optional": true },
    "@lexical/markdown": { "optional": true },
    "@lexical/rich-text": { "optional": true },
    "@lexical/table": { "optional": true },
    "@lexical/utils": { "optional": true },
    "lexical": { "optional": true }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@hey-api/openapi-ts": "0.99.0",
    "@lexical/code": "0.45.0",
    "@lexical/headless": "0.45.0",
    "@lexical/link": "0.45.0",
    "@lexical/list": "0.45.0",
    "@lexical/mark": "0.45.0",
    "@lexical/markdown": "0.45.0",
    "@lexical/rich-text": "0.45.0",
    "@lexical/table": "0.45.0",
    "@lexical/utils": "0.45.0",
    "@types/bun": "^1.3.5",
    "@types/linkify-it": "^5.0.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.1",
    "hono": "^4.12.27",
    "lexical": "0.45.0",
    "semver": "^7.8.5",
    "typescript": "^5.9.2"
  }
}
