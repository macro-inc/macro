{
  "name": "@macro-inc/sdk",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macro-inc/macro.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "description": "Libary for interacting with Macro.com",
  "main": "./dist/src/macro.js",
  "module": "./dist/src/macro.js",
  "types": "./dist/src/macro.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/macro.d.ts",
      "import": "./dist/src/macro.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*/index.d.ts",
      "import": "./dist/generated/*/index.js"
    },
    "./calls/node": {
      "types": "./dist/src/calls/node.d.ts",
      "import": "./dist/src/calls/node.js"
    },
    "./calls/browser": {
      "types": "./dist/src/calls/browser.d.ts",
      "import": "./dist/src/calls/browser.js"
    }
  },
  "files": [
    "dist",
    "CALLS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-specs": "bun scripts/sync-specs.ts",
    "webhook": "bun scripts/webhook.ts",
    "validate-webhook": "bun scripts/validate-webhook.ts",
    "coverage": "bun src/coverage/check.ts",
    "generate": "bun scripts/generate.ts",
    "build:js": "bun scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "check:pack": "bun scripts/check-pack.ts"
  },
  "dependencies": {
    "ts-pattern": "^5.8.0",
    "uuid": "^11.1.1",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/bun": "^1.3.5",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.1",
    "hono": "^4.12.27",
    "semver": "^7.8.5",
    "typescript": "^5.9.2",
    "@livekit/rtc-node": "^1.2.1",
    "livekit-client": "^2.18.0"
  },
  "peerDependencies": {
    "@livekit/rtc-node": "^1.2.1",
    "livekit-client": "^2.18.0"
  },
  "peerDependenciesMeta": {
    "@livekit/rtc-node": {
      "optional": true
    },
    "livekit-client": {
      "optional": true
    }
  }
}
