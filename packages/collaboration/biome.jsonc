{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "root": true,
  "extends": ["../../biome.base.jsonc"],
  "vcs": {
    "root": "../.."
  },
  "files": {
    "includes": [
      "**/*.{ts,tsx,js,jsx,json}",
      "!**/*.d.ts",
      "!**/node_modules",
      "!src/sync-service/generated",
      "!!**/abi.generated.ts",
      // Generated verbatim; validate through generate-foreign-host-schema.ts --check.
      "!!src/session/foreign-host.generated.ts",
      "!!src/session/foreign-native-fields.generated.ts"
    ]
  }
}
