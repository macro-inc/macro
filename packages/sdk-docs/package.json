{
  "name": "@macro-inc/sdk-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./render": "./src/render.ts"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "bun scripts/generate.ts --build",
    "check:generated": "bun scripts/generate.ts --check",
    "test": "bun run check:generated && vitest run",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "docs:dev": "wrangler dev",
    "docs:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.1",
    "wrangler": "4.110.0"
  }
}
