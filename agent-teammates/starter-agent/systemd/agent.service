# A template: bin/setup writes it to ~/.config/systemd/user/, named for the
# agent's directory, with this checkout's path and name filled in.
[Unit]
Description=@NAME@, an agent on muppet: bin/agent run (@ROOT@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/bin/agent run
Restart=always
RestartSec=5
# A call is a child process; ending the agent must not hang up on someone.
KillMode=process
# nix, git and claude are on the user's profile path.
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
