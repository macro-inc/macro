// The host's own telemetry, sent to the observability cluster through its
// edge (TELEMETRY_ORIGIN, https://<otlpHost>): metrics by Prometheus remote
// write and logs by Loki push, both with HTTP basic auth, user `metrics` and
// the `otlp_token` credential. The native protocols keep Loki's stream labels
// and give metrics a write-ahead log that outlasts an hour without the cluster.
prometheus.exporter.unix "host" {
  disable_collectors = ["textfile"]
  enable_collectors = ["systemd"]
  systemd {
    unit_include = "(nginx|postgresql|postgresql-setup|goalert|goalert-backup|macro-alerts-relay|alloy|observability-.*|amazon-cloudwatch-agent)\\.service"
    task_metrics = true
    enable_restarts = true
    start_time = true
  }
}

prometheus.scrape "host" {
  targets = prometheus.exporter.unix.host.targets
  job_name = "observability/host"
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.cluster.receiver]
}

prometheus.exporter.self "host_alloy" {}
prometheus.scrape "host_alloy" {
  targets = prometheus.exporter.self.host_alloy.targets
  job_name = "observability/host-alloy"
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.cluster.receiver]
}

prometheus.remote_write "cluster" {
  endpoint {
    url = sys.env("TELEMETRY_ORIGIN") + "/api/v1/write"
    basic_auth {
      username = "metrics"
      password_file = sys.env("CREDENTIALS_DIRECTORY") + "/otlp_token"
    }
  }
  wal {
    min_keepalive_time = "5m"
    max_keepalive_time = "1h"
  }
}

loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex = "(nginx|postgresql|postgresql-setup|goalert|goalert-backup|macro-alerts-relay|alloy|observability-.*|amazon-cloudwatch-agent|systemd-.*)\\.service"
    action = "keep"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label = "level"
  }
}

loki.source.journal "host" {
  max_age = "1h"
  labels = {job = "observability/journal", instance = constants.hostname}
  relabel_rules = loki.relabel.journal.rules
  forward_to = [loki.write.cluster.receiver]
}

loki.source.journal "kernel" {
  matches = "_TRANSPORT=kernel"
  max_age = "1h"
  labels = {job = "observability/kernel", instance = constants.hostname}
  forward_to = [loki.write.cluster.receiver]
}

loki.write "cluster" {
  endpoint {
    url = sys.env("TELEMETRY_ORIGIN") + "/loki/api/v1/push"
    basic_auth {
      username = "metrics"
      password_file = sys.env("CREDENTIALS_DIRECTORY") + "/otlp_token"
    }
  }
}
