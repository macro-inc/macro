local.file "otlp_token" {
  filename = sys.env("CREDENTIALS_DIRECTORY") + "/otlp_token"
  is_secret = true
}

otelcol.auth.bearer "ingest" {
  token = local.file.otlp_token.content
}

otelcol.receiver.otlp "ingest" {
  http {
    endpoint = "127.0.0.1:4318"
    auth = otelcol.auth.bearer.ingest.handler
    max_request_body_size = "8MiB"
  }
  output {
    logs = [otelcol.processor.memory_limiter.ingest.input]
    traces = [otelcol.processor.memory_limiter.ingest.input]
    metrics = [otelcol.processor.memory_limiter.ingest.input]
  }
}

otelcol.processor.memory_limiter "ingest" {
  check_interval = "1s"
  limit = "768MiB"
  spike_limit = "128MiB"
  output {
    logs = [otelcol.processor.filter.local_logs.input]
    traces = [otelcol.processor.transform.ai_content.input]
    metrics = [otelcol.processor.transform.emails.input]
  }
}

// Local stacks forward their logs here (docker/grafana-forwarder), and one
// service failing in a loop sent more than every other sender together, nearly
// all of it error-level. Only local-telemetry's run events are kept; the rest
// stay in the stack's own Loki.
otelcol.processor.filter "local_logs" {
  error_mode = "ignore"
  logs {
    log_record = [
      `(resource.attributes["deployment.environment"] == "local" or resource.attributes["deployment.environment.name"] == "local") and resource.attributes["service.name"] != "local-telemetry"`,
    ]
  }
  output { logs = [otelcol.processor.transform.emails.input] }
}

// What people and models wrote never reaches storage. Token counts, models,
// operations, outcomes and the macro.genai.* sizes stay. A failed statement
// fails the batch, so content can't slip through.
otelcol.processor.transform "ai_content" {
  error_mode = "propagate"
  trace_statements {
    context = "span"
    statements = [
      `delete_matching_keys(attributes, "^gen_ai\\.(input|output|prompt|completion|choice|system_instructions|(system|user|assistant|tool)\\.message|tool\\.definitions|tool\\.call\\.(arguments|result))(\\.|$)")`,
      // A harness's own title for a tool call, often its command line. Where it
      // gave no tool name, the title is the name and part of the span's.
      `delete_key(attributes, "macro.genai.tool.title")`,
      `set(name, "execute_tool") where IsMatch(attributes["gen_ai.tool.name"], "[^A-Za-z0-9_:-]")`,
      `delete_key(attributes, "gen_ai.tool.name") where IsMatch(attributes["gen_ai.tool.name"], "[^A-Za-z0-9_:-]")`,
      // A provider's error can quote the request, and a tool's is its output.
      // error.type stays.
      `set(status.message, "") where attributes["gen_ai.operation.name"] != nil`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [
      `delete_matching_keys(attributes, "^gen_ai\\.(input|output|prompt|completion|choice|system_instructions|(system|user|assistant|tool)\\.message|tool\\.definitions|tool\\.call\\.(arguments|result))(\\.|$)")`,
      `delete_matching_keys(attributes, "^(error|exception\\.(message|stacktrace))$") where span.attributes["gen_ai.operation.name"] != nil`,
      // The model client's events carry responses it couldn't parse, in the
      // event's name or its fields.
      `set(name, "rig") where IsMatch(attributes["target"], "^rig")`,
      `keep_keys(attributes, ["level", "target"]) where IsMatch(attributes["target"], "^rig")`,
    ]
  }
  output { traces = [otelcol.processor.transform.emails.input] }
}

// User IDs are email addresses, and logs and errors quote them. Each address,
// wherever it appears, becomes its SHA-256 ("macro|<hash>"), so one user's
// telemetry can still be found by hashing their address as written.
//
// The pattern scan tripled ingest's CPU on spans with long attributes, so a map
// is scanned only when its JSON holds an "@" or a "%40", and checked for an
// address left in a nested list or map only when the JSON shows one; such a
// map is flattened (`a.b.0`) and scanned again. The macro.ingest.* keys carry
// these marks between blocks and are removed after. JSON can't hold a NaN or
// an infinity, so the checks ignore errors, and a map they couldn't check is
// scanned and flattened anyway. Addresses in map keys and byte values stay.
otelcol.processor.transform "emails" {
  error_mode = "propagate"
  log_statements {
    context = "resource"
    statements = [`replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`]
  }
  log_statements {
    context = "scope"
    statements = [
      `replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`,
      `replace_pattern(name, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`,
    ]
  }
  log_statements {
    context = "log"
    error_mode = "ignore"
    statements = [
      `delete_key(attributes, "macro.ingest.no_email")`,
      `delete_key(attributes, "macro.ingest.nested_email")`,
      `set(cache["json"], String(attributes))`,
      `set(attributes["macro.ingest.no_email"], true) where cache["json"] != nil and not (IsMatch(cache["json"], "@") or IsMatch(cache["json"], "%40"))`,
      `set(attributes["macro.ingest.nested_email"], true) where cache["json"] == nil or IsMatch(cache["json"], "\":\\[") or IsMatch(cache["json"], "\":\\{")`,
    ]
  }
  log_statements {
    context = "log"
    statements = [`replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where attributes["macro.ingest.no_email"] != true`]
  }
  log_statements {
    context = "log"
    error_mode = "ignore"
    statements = [
      `delete_key(attributes, "macro.ingest.nested_email") where attributes["macro.ingest.nested_email"] == true and (attributes["macro.ingest.no_email"] == true or not IsMatch(attributes, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)"))`,
      `flatten(attributes) where attributes["macro.ingest.nested_email"] == true`,
    ]
  }
  log_statements {
    context = "log"
    statements = [
      `replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where attributes["macro.ingest.nested_email"] == true`,
      `delete_key(attributes, "macro.ingest.no_email")`,
      `delete_key(attributes, "macro.ingest.nested_email")`,
    ]
  }
  log_statements {
    context = "log"
    error_mode = "ignore"
    statements = [`set(body, String(body)) where (IsMap(body) or IsList(body)) and IsMatch(body, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)")`]
  }
  log_statements {
    context = "log"
    statements = [`replace_pattern(body, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where IsString(body) and (IsMatch(body, "@") or IsMatch(body, "%40"))`]
  }
  trace_statements {
    context = "resource"
    statements = [`replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`]
  }
  trace_statements {
    context = "scope"
    statements = [
      `replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`,
      `replace_pattern(name, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`,
    ]
  }
  trace_statements {
    context = "span"
    error_mode = "ignore"
    statements = [
      `delete_key(attributes, "macro.ingest.no_email")`,
      `delete_key(attributes, "macro.ingest.nested_email")`,
      `set(cache["json"], String(attributes))`,
      `set(attributes["macro.ingest.no_email"], true) where cache["json"] != nil and not (IsMatch(cache["json"], "@") or IsMatch(cache["json"], "%40"))`,
      `set(attributes["macro.ingest.nested_email"], true) where cache["json"] == nil or IsMatch(cache["json"], "\":\\[") or IsMatch(cache["json"], "\":\\{")`,
    ]
  }
  trace_statements {
    context = "span"
    statements = [`replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where attributes["macro.ingest.no_email"] != true`]
  }
  trace_statements {
    context = "span"
    error_mode = "ignore"
    statements = [
      `delete_key(attributes, "macro.ingest.nested_email") where attributes["macro.ingest.nested_email"] == true and (attributes["macro.ingest.no_email"] == true or not IsMatch(attributes, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)"))`,
      `flatten(attributes) where attributes["macro.ingest.nested_email"] == true`,
    ]
  }
  trace_statements {
    context = "span"
    statements = [
      `replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where attributes["macro.ingest.nested_email"] == true`,
      `delete_key(attributes, "macro.ingest.no_email")`,
      `delete_key(attributes, "macro.ingest.nested_email")`,
      `replace_pattern(name, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where (IsMatch(name, "@") or IsMatch(name, "%40"))`,
      `replace_pattern(status.message, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where (IsMatch(status.message, "@") or IsMatch(status.message, "%40"))`,
    ]
  }
  trace_statements {
    context = "spanevent"
    error_mode = "ignore"
    statements = [
      `delete_key(attributes, "macro.ingest.no_email")`,
      `delete_key(attributes, "macro.ingest.nested_email")`,
      `set(cache["json"], String(attributes))`,
      `set(attributes["macro.ingest.no_email"], true) where cache["json"] != nil and not (IsMatch(cache["json"], "@") or IsMatch(cache["json"], "%40"))`,
      `set(attributes["macro.ingest.nested_email"], true) where cache["json"] == nil or IsMatch(cache["json"], "\":\\[") or IsMatch(cache["json"], "\":\\{")`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [`replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where attributes["macro.ingest.no_email"] != true`]
  }
  trace_statements {
    context = "spanevent"
    error_mode = "ignore"
    statements = [
      `delete_key(attributes, "macro.ingest.nested_email") where attributes["macro.ingest.nested_email"] == true and (attributes["macro.ingest.no_email"] == true or not IsMatch(attributes, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)"))`,
      `flatten(attributes) where attributes["macro.ingest.nested_email"] == true`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [
      `replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where attributes["macro.ingest.nested_email"] == true`,
      `delete_key(attributes, "macro.ingest.no_email")`,
      `delete_key(attributes, "macro.ingest.nested_email")`,
      `replace_pattern(name, "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256) where (IsMatch(name, "@") or IsMatch(name, "%40"))`,
    ]
  }
  metric_statements {
    context = "resource"
    statements = [`replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`]
  }
  metric_statements {
    context = "datapoint"
    statements = [`replace_all_patterns(attributes, "value", "([A-Za-z0-9._%+'!#$&*^~{}\\x{80}-\\x{10FFFF}-]+(?:@|%40)(?:[A-Za-z0-9\\x{80}-\\x{10FFFF}-]+\\.)+[A-Za-z\\x{80}-\\x{10FFFF}][A-Za-z0-9\\x{80}-\\x{10FFFF}-]*)", "$1", SHA256)`]
  }
  output {
    logs = [otelcol.processor.batch.ingest.input]
    metrics = [otelcol.processor.batch.ingest.input]
    traces = [otelcol.processor.batch.ingest.input]
  }
}

otelcol.processor.batch "ingest" {
  timeout = "1s"
  send_batch_size = 512
  send_batch_max_size = 1024
  output {
    logs = [otelcol.exporter.otlphttp.loki.input]
    traces = [otelcol.exporter.loadbalancing.sampler.input]
    metrics = [otelcol.exporter.prometheus.metrics.input]
  }
}

otelcol.exporter.otlphttp "loki" {
  client { endpoint = "http://127.0.0.1:3100/otlp" }
  sending_queue { queue_size = 256 }
}

// Every span of a trace to the same sampler (modules/sampler in
// infra/k8s/observability/cluster), which keeps or drops whole traces. The
// queue is in front of the routing, so a span waiting here goes to a sampler
// that is up when it leaves; a full one holds senders back instead of dropping.
otelcol.exporter.loadbalancing "sampler" {
  timeout = "10s"
  resolver {
    dns {
      hostname = "127.0.0.1"
      interval = "5s"
    }
  }
  protocol {
    otlp {
      timeout = "2s"
      queue { enabled = false }
      retry { enabled = false }
      client {
        tls { insecure = true }
      }
    }
  }
  sending_queue {
    queue_size = 256
    block_on_overflow = true
  }
  retry_on_failure { max_elapsed_time = "2m" }
}

otelcol.exporter.prometheus "metrics" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint { url = "http://127.0.0.1:9090/api/v1/write" }
}
