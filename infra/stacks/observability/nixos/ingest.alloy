local.file "otlp_token" {
  filename = sys.env("CREDENTIALS_DIRECTORY") + "/otlp_token"
  is_secret = true
}

otelcol.auth.bearer "ingest" {
  token = local.file.otlp_token.content
}

otelcol.receiver.otlp "ingest" {
  http {
    endpoint = "127.0.0.1:4318"
    auth = otelcol.auth.bearer.ingest.handler
    max_request_body_size = "8MiB"
  }
  output {
    logs = [otelcol.processor.memory_limiter.ingest.input]
    traces = [otelcol.processor.memory_limiter.ingest.input]
    metrics = [otelcol.processor.memory_limiter.ingest.input]
  }
}

otelcol.processor.memory_limiter "ingest" {
  check_interval = "1s"
  limit = "768MiB"
  spike_limit = "128MiB"
  output {
    logs = [otelcol.processor.filter.local_logs.input]
    traces = [otelcol.processor.transform.ai_content.input]
    metrics = [otelcol.processor.batch.ingest.input]
  }
}

// Local stacks forward their logs here (docker/grafana-forwarder), and one
// service failing in a loop sent more than every other sender together, nearly
// all of it error-level. Only local-telemetry's run events are kept; the rest
// stay in the stack's own Loki.
otelcol.processor.filter "local_logs" {
  error_mode = "ignore"
  logs {
    log_record = [
      `(resource.attributes["deployment.environment"] == "local" or resource.attributes["deployment.environment.name"] == "local") and resource.attributes["service.name"] != "local-telemetry"`,
    ]
  }
  output { logs = [otelcol.processor.batch.ingest.input] }
}

// What people and models wrote never reaches storage. Token counts, models,
// operations, outcomes and the macro.genai.* sizes stay. A failed statement
// fails the batch, so content can't slip through.
otelcol.processor.transform "ai_content" {
  error_mode = "propagate"
  trace_statements {
    context = "span"
    statements = [
      `delete_matching_keys(attributes, "^gen_ai\\.(input|output|prompt|completion|choice|system_instructions|(system|user|assistant|tool)\\.message|tool\\.definitions|tool\\.call\\.(arguments|result))(\\.|$)")`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [
      `delete_matching_keys(attributes, "^gen_ai\\.(input|output|prompt|completion|choice|system_instructions|(system|user|assistant|tool)\\.message|tool\\.definitions|tool\\.call\\.(arguments|result))(\\.|$)")`,
    ]
  }
  output { traces = [otelcol.processor.batch.ingest.input] }
}

otelcol.processor.batch "ingest" {
  timeout = "1s"
  send_batch_size = 512
  send_batch_max_size = 1024
  output {
    logs = [otelcol.exporter.otlphttp.loki.input]
    traces = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.metrics.input]
  }
}

otelcol.exporter.otlphttp "loki" {
  client { endpoint = "http://127.0.0.1:3100/otlp" }
  sending_queue { queue_size = 256 }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "127.0.0.1:4317"
    tls { insecure = true }
  }
  sending_queue { queue_size = 256 }
}

otelcol.exporter.prometheus "metrics" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint { url = "http://127.0.0.1:9090/api/v1/write" }
}
