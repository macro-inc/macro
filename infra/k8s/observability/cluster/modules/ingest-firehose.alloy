// CloudWatch Logs through Amazon Data Firehose: AWS Lambda log groups, and any
// other log group, subscribe to the Firehose stream in ../aws
// (modules/firehose.nix), which delivers here through the edge's
// /awsfirehose/api/v1/push with the ingest token as its access key. Each event
// becomes a log record of its log group. service.name is the group's name
// without `/aws/lambda/`, `/aws/vendedlogs/` or a leading `/`, other slashes as
// dashes, and without the stack suffix (`-prod`, `-dev`), which gives deployment.environment. The
// records then take the OTLP path (memory limiter, email hashing, Loki).
//
// Firehose has its 200 once the events are handed on, so a batch the memory
// limiter refuses is lost, not retried or kept in Firehose's failed-records
// bucket. The limiter's incoming minus outgoing items count it, and this
// receiver logs "failed to consume log entries".
loki.source.awsfirehose "cloudwatch" {
  http {
    listen_address = "0.0.0.0"
    listen_port = @FIREHOSE_PORT@
  }
  access_key = local.file.otlp_token.content
  // The event's own time, not Firehose's: delivery waits up to a minute.
  use_incoming_timestamp = true
  relabel_rules = loki.relabel.cloudwatch.rules
  forward_to = [otelcol.receiver.loki.cloudwatch.receiver]
}

// Only these labels leave the source; they become the records' attributes.
loki.relabel "cloudwatch" {
  forward_to = []
  rule {
    source_labels = ["__aws_cw_log_group"]
    target_label = "log_group"
  }
  rule {
    source_labels = ["__aws_cw_log_stream"]
    target_label = "log_stream"
  }
  rule {
    source_labels = ["__aws_cw_msg_type"]
    target_label = "msg_type"
  }
  rule {
    source_labels = ["__aws_firehose_source_arn"]
    regex = "arn:aws:firehose:([^:]+):.*"
    target_label = "region"
  }
}

otelcol.receiver.loki "cloudwatch" {
  output { logs = [otelcol.processor.filter.cloudwatch.input] }
}

// Only log events: CloudWatch's control messages (it checks the destination
// when a subscription is made), records that came from no log group, and
// Firehose's own error log groups, whose events would loop back through it.
otelcol.processor.filter "cloudwatch" {
  error_mode = "ignore"
  logs {
    log_record = [
      `attributes["log_group"] == nil`,
      `attributes["msg_type"] != "DATA_MESSAGE"`,
      `IsMatch(attributes["log_group"], "^/aws/kinesisfirehose/")`,
    ]
  }
  output { logs = [otelcol.processor.transform.cloudwatch.input] }
}

otelcol.processor.transform "cloudwatch" {
  error_mode = "ignore"
  log_statements {
    context = "log"
    statements = [
      `set(attributes["service.name"], attributes["log_group"])`,
      `replace_pattern(attributes["service.name"], "^/aws/(lambda|vendedlogs)/", "")`,
      `replace_pattern(attributes["service.name"], "^/+", "")`,
      `replace_pattern(attributes["service.name"], "/", "-")`,
      `replace_pattern(attributes["service.name"], "-(prod|dev)$", "")`,
      `set(attributes["deployment.environment"], "prod") where IsMatch(attributes["log_group"], "-prod$")`,
      `set(attributes["deployment.environment"], "dev") where IsMatch(attributes["log_group"], "-dev$")`,
      `set(attributes["faas.name"], attributes["log_group"]) where IsMatch(attributes["log_group"], "^/aws/lambda/")`,
      `replace_pattern(attributes["faas.name"], "^/aws/lambda/", "") where attributes["faas.name"] != nil`,
      `set(attributes["aws.log.group.names"], attributes["log_group"])`,
      `set(attributes["aws.log.stream.names"], attributes["log_stream"])`,
      `set(attributes["cloud.provider"], "aws")`,
      `set(attributes["cloud.region"], attributes["region"]) where attributes["region"] != nil`,
      `delete_matching_keys(attributes, "^(log_group|log_stream|msg_type|region|loki\\.attribute\\.labels)$")`,
    ]
  }
  output { logs = [otelcol.processor.groupbyattrs.cloudwatch.input] }
}

// The log group's attributes describe the resource; the stream (one per Lambda
// execution environment) stays on the record.
otelcol.processor.groupbyattrs "cloudwatch" {
  keys = [
    "service.name",
    "deployment.environment",
    "faas.name",
    "aws.log.group.names",
    "cloud.provider",
    "cloud.region",
  ]
  output { logs = [otelcol.processor.memory_limiter.ingest.input] }
}
