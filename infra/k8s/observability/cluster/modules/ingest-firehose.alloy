// CloudWatch Logs through Amazon Data Firehose: AWS Lambda log groups, and any
// other log group, subscribe to the Firehose stream in ../aws
// (modules/firehose.nix), which delivers here through the edge's
// /awsfirehose/api/v1/push with the ingest token as its access key. Each event
// becomes a log record of its log group. service.name is the group's name
// without `/aws/lambda/`, `/aws/vendedlogs/` or a leading `/`, other slashes as
// dashes, and without the stack suffix (`-prod`, `-dev`), which gives deployment.environment. The
// records then take the OTLP path (memory limiter, email hashing, Loki).
//
// Firehose has its 200 once the events are handed on, so a batch the memory
// limiter refuses is lost, not retried or kept in Firehose's failed-records
// bucket. The limiter's incoming minus outgoing items count it, and this
// receiver logs "failed to consume log entries".
loki.source.awsfirehose "cloudwatch" {
  http {
    listen_address = "0.0.0.0"
    listen_port = @FIREHOSE_PORT@
  }
  access_key = local.file.otlp_token.content
  // The event's own time, not Firehose's: delivery waits up to a minute.
  use_incoming_timestamp = true
  relabel_rules = loki.relabel.cloudwatch.rules
  forward_to = [otelcol.receiver.loki.cloudwatch.receiver]
}

// Only these labels leave the source; they become the records' attributes.
loki.relabel "cloudwatch" {
  forward_to = []
  rule {
    source_labels = ["__aws_cw_log_group"]
    target_label = "log_group"
  }
  rule {
    source_labels = ["__aws_cw_log_stream"]
    target_label = "log_stream"
  }
  rule {
    source_labels = ["__aws_cw_msg_type"]
    target_label = "msg_type"
  }
  rule {
    source_labels = ["__aws_firehose_source_arn"]
    regex = "arn:aws:firehose:([^:]+):.*"
    target_label = "region"
  }
}

otelcol.receiver.loki "cloudwatch" {
  output { logs = [otelcol.processor.filter.cloudwatch.input] }
}

// Only log events: CloudWatch's control messages (it checks the destination
// when a subscription is made), records that came from no log group, and
// Firehose's own error log groups, whose events would loop back through it.
otelcol.processor.filter "cloudwatch" {
  error_mode = "ignore"
  logs {
    log_record = [
      `attributes["log_group"] == nil`,
      `attributes["msg_type"] != "DATA_MESSAGE"`,
      `IsMatch(attributes["log_group"], "^/aws/kinesisfirehose/")`,
    ]
  }
  output { logs = [otelcol.processor.transform.cloudwatch.input] }
}

otelcol.processor.transform "cloudwatch" {
  error_mode = "ignore"
  log_statements {
    context = "log"
    statements = [
      `set(attributes["service.name"], attributes["log_group"])`,
      `replace_pattern(attributes["service.name"], "^/aws/(lambda|vendedlogs)/", "")`,
      `replace_pattern(attributes["service.name"], "^/+", "")`,
      `replace_pattern(attributes["service.name"], "/", "-")`,
      `replace_pattern(attributes["service.name"], "-(prod|dev)$", "") where IsMatch(attributes["log_group"], "-(prod|dev)$")`,
      `set(attributes["deployment.environment"], "prod") where IsMatch(attributes["log_group"], "-prod$")`,
      `set(attributes["deployment.environment"], "dev") where IsMatch(attributes["log_group"], "-dev$")`,
      `set(attributes["faas.name"], attributes["log_group"]) where IsMatch(attributes["log_group"], "^/aws/lambda/")`,
      `replace_pattern(attributes["faas.name"], "^/aws/lambda/", "") where attributes["faas.name"] != nil`,
      `set(attributes["aws.log.group.names"], attributes["log_group"])`,
      `set(attributes["aws.log.stream.names"], attributes["log_stream"])`,
      `set(attributes["cloud.provider"], "aws")`,
      `set(attributes["cloud.region"], attributes["region"]) where attributes["region"] != nil`,
      // AWS WAF's request log (aws-waf-logs-*), which holds only the requests
      // WAF blocked or challenged (infra/stacks/cloud-storage-service). The
      // patterns read WAF's flat JSON entries (a header, a custom key, a rule
      // match) in either field order, with whitespace and other fields
      // between, skipping quoted strings.
      //
      // The trace: the first traceparent of the request's headers, lower-cased
      // as Datadog's WAF pipeline takes it. It is the caller's trace, a
      // browser's or another service's, so the event shows in it. A header
      // that can't name one gives no IDs: version ff, an all-zero ID, or
      // anything after the flags in version 00. A later traceparent is not
      // read.
      //
      // No client address: clientIp and a rate-based rule's limitValue are
      // redacted, and so is every value of a header, a custom key or a rule
      // match's matchedData unless it is a header kept as is: host,
      // user-agent, accept and accept-*, content-type, content-length, origin,
      // x-forwarded-proto, x-forwarded-host, x-forwarded-port, traceparent,
      // tracestate, x-amzn-trace-id, x-request-id, cache-control, pragma,
      // connection, upgrade, x-requested-with, sec-fetch-*, sec-ch-ua and
      // sec-ch-ua-*. Custom keys of other types (IP, FORWARDED_IP, QUERY_ARG,
      // ...) and matches outside the headers are redacted whatever their
      // name. Last, anything shaped like an IPv4 or IPv6 address on its own
      // (not part of a longer word or number) is redacted, a run of them as
      // one, so a record the patterns can't read (cut off mid-value) loses its
      // addresses too. A version after a name (Chrome/131.0.0.0), a five-part
      // version, a time, ARNs and account IDs stay. WAF itself already
      // redacts credentials, the path and the query string.
      `merge_maps(cache, ExtractPatterns(body, "\"headers\"\\s*:\\s*\\[(?:\\s*\\{(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*\\}\\s*,)*?\\s*\\{(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*?(?:\"name\"\\s*:\\s*\"(?i:traceparent)\"(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*?\"value\"\\s*:\\s*\"(?P<tp1>(?:[^\"\\\\]|\\\\.)*)\"|\"value\"\\s*:\\s*\"(?P<tp2>(?:[^\"\\\\]|\\\\.)*)\"(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*\"name\"\\s*:\\s*\"(?i:traceparent)\")"), "upsert") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `set(cache["tp"], cache["tp1"]) where cache["tp1"] != nil and cache["tp1"] != ""`,
      `set(cache["tp"], cache["tp2"]) where cache["tp2"] != nil and cache["tp2"] != ""`,
      `merge_maps(cache, ExtractPatterns(cache["tp"], "^\\s*(?P<version>(?i:[0-9a-e][0-9a-f]|f[0-9a-e]))-(?P<trace_id>[0-9a-fA-F]{32})-(?P<span_id>[0-9a-fA-F]{16})-[0-9a-fA-F]{2}(?P<rest>-[^\"]*)?\\s*$"), "upsert") where cache["tp"] != nil`,
      `delete_key(cache, "trace_id") where cache["trace_id"] != nil and (IsMatch(cache["trace_id"], "^0+$") or IsMatch(cache["span_id"], "^0+$") or (cache["version"] == "00" and cache["rest"] != nil and cache["rest"] != ""))`,
      `delete_key(cache, "span_id") where cache["trace_id"] == nil`,
      `set(trace_id.string, ConvertCase(cache["trace_id"], "lower")) where cache["trace_id"] != nil`,
      `set(span_id.string, ConvertCase(cache["span_id"], "lower")) where cache["span_id"] != nil`,
      `replace_pattern(body, "\"(clientIp|limitValue)\"\\s*:\\s*\"(?:[^\"\\\\]|\\\\.)*\"", "\"${1}\":\"redacted\"") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "(\"name\"\\s*:\\s*\"(?i:host|user-agent|accept(?:-[a-z]+)?|content-type|content-length|origin|x-forwarded-proto|x-forwarded-host|x-forwarded-port|traceparent|tracestate|x-amzn-trace-id|x-request-id|cache-control|pragma|connection|upgrade|x-requested-with|sec-fetch-[a-z]+|sec-ch-ua(?:-[a-z0-9]+)*)\"(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*?)\"value\"(\\s*:)", "${1}\"waf_kept_value\"${2}") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "\"value\"(\\s*:\\s*\"(?:[^\"\\\\]|\\\\.)*\"(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*\"name\"\\s*:\\s*\"(?i:host|user-agent|accept(?:-[a-z]+)?|content-type|content-length|origin|x-forwarded-proto|x-forwarded-host|x-forwarded-port|traceparent|tracestate|x-amzn-trace-id|x-request-id|cache-control|pragma|connection|upgrade|x-requested-with|sec-fetch-[a-z]+|sec-ch-ua(?:-[a-z0-9]+)*)\")", "\"waf_kept_value\"${1}") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "(\"matchedFieldName\"\\s*:\\s*\"(?i:host|user-agent|accept(?:-[a-z]+)?|content-type|content-length|origin|x-forwarded-proto|x-forwarded-host|x-forwarded-port|traceparent|tracestate|x-amzn-trace-id|x-request-id|cache-control|pragma|connection|upgrade|x-requested-with|sec-fetch-[a-z]+|sec-ch-ua(?:-[a-z0-9]+)*)\"(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*?)\"matchedData\"(\\s*:)", "${1}\"waf_kept_matchedData\"${2}") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "\"matchedData\"(\\s*:\\s*\\[(?:\\s*\"(?:[^\"\\\\]|\\\\.)*\"\\s*,?)*\\s*\\](?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*\"matchedFieldName\"\\s*:\\s*\"(?i:host|user-agent|accept(?:-[a-z]+)?|content-type|content-length|origin|x-forwarded-proto|x-forwarded-host|x-forwarded-port|traceparent|tracestate|x-amzn-trace-id|x-request-id|cache-control|pragma|connection|upgrade|x-requested-with|sec-fetch-[a-z]+|sec-ch-ua(?:-[a-z0-9]+)*)\")", "\"waf_kept_matchedData\"${1}") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "(\"(?:key|location)\"\\s*:\\s*\"(?:|[^H\"\\\\][^\"\\\\]*|H(?:|[^E\"\\\\][^\"\\\\]*|E(?:|[^A\"\\\\][^\"\\\\]*|A(?:|[^D\"\\\\][^\"\\\\]*|D(?:|[^E\"\\\\][^\"\\\\]*|E(?:|[^R\"\\\\][^\"\\\\]*|R[^\"\\\\]+))))))\"(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*?)\"waf_kept_(value|matchedData)\"", "${1}\"${2}\"") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "\"waf_kept_(value|matchedData)\"(\\s*:\\s*(?:\"(?:[^\"\\\\]|\\\\.)*\"|\\[(?:\\s*\"(?:[^\"\\\\]|\\\\.)*\"\\s*,?)*\\s*\\])(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^{}\"])*\"(?:key|location)\"\\s*:\\s*\"(?:|[^H\"\\\\][^\"\\\\]*|H(?:|[^E\"\\\\][^\"\\\\]*|E(?:|[^A\"\\\\][^\"\\\\]*|A(?:|[^D\"\\\\][^\"\\\\]*|D(?:|[^E\"\\\\][^\"\\\\]*|E(?:|[^R\"\\\\][^\"\\\\]*|R[^\"\\\\]+))))))\")", "\"${1}\"${2}") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "(\"value\"\\s*:\\s*)\"(?:[^\"\\\\]|\\\\.)*\"", "${1}\"redacted\"") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "(\"matchedData\"\\s*:\\s*)\\[(?:\\s*\"(?:[^\"\\\\]|\\\\.)*\"\\s*,?)+\\s*\\]", "${1}[\"redacted\"]") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "\"waf_kept_(value|matchedData)\"", "\"${1}\"") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "(^|[^0-9A-Za-z./\\\\]|[^A-Za-z\\\\]/|\\\\[a-z/\\\\\\\\]|\\\\u[0-9A-Fa-f]{4})(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?:(?:[^0-9A-Za-z\\\\\"]|\\\\[a-z/\\\\\\\\]|\\\\u[0-9A-Fa-f]{4})*(?:[0-9]{1,3}\\.){3}[0-9]{1,3})*([^0-9A-Za-z.]|\\.[^0-9]|$)", "${1}redacted${2}") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `replace_pattern(body, "(^|[^0-9A-Za-z\\\\]|\\\\[a-z/\\\\\\\\]|\\\\u[0-9A-Fa-f]{4})(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){7}|(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4})*)?::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4})*)?)(?:(?:[^0-9A-Za-z\\\\\"]|\\\\[a-z/\\\\\\\\]|\\\\u[0-9A-Fa-f]{4})*(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){7}|(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4})*)?::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4})*)?))*([^0-9A-Za-z:]|$)", "${1}redacted${2}") where IsMatch(attributes["log_group"], "^aws-waf-logs-")`,
      `delete_matching_keys(attributes, "^(log_group|log_stream|msg_type|region|loki\\.attribute\\.labels)$")`,
    ]
  }
  output { logs = [otelcol.processor.groupbyattrs.cloudwatch.input] }
}

// The log group's attributes describe the resource; the stream (one per Lambda
// execution environment) stays on the record.
otelcol.processor.groupbyattrs "cloudwatch" {
  keys = [
    "service.name",
    "deployment.environment",
    "faas.name",
    "aws.log.group.names",
    "cloud.provider",
    "cloud.region",
  ]
  output { logs = [otelcol.processor.memory_limiter.ingest.input] }
}
