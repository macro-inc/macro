// {
  # ── Edge: the instance's single origin (routes, CORS, static frontend) ──
  edge = {
    image = image {
      name = "edge";
      contents = [ pkgs.caddy ];
      entrypoint = [
        "caddy"
        "run"
        "--adapter"
        "caddyfile"
        "--config"
        "${macro.caddyfile}"
      ];
      env = {
        XDG_DATA_HOME = "/tmp";
        XDG_CONFIG_HOME = "/tmp";
        MACRO_FRONTEND = "${macro.frontend}";
      };
    };
    user = 1000;
    ports = [ 8080 ];
    readiness.tcp = 8080;
  };
}
