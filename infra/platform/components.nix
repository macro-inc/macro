# Every workload in a Macro instance. Names and ports match the hosts the
# code-defined environment (xtask_local's local_env.rs) already uses, so the
# services need no per-platform configuration.
{
  pkgs,
  lib,
  platformLib,
  platformPkgs,
  macro,
}:
let
  inherit (platformLib) image;
  sh = script: [
    "/bin/sh"
    "-c"
    script
  ];

  # The instance's AWS-API key, generated by `platform up` and kept in the
  # macro-env Secret; every backend verifies requests against it.
  awsKey.secret = "AWS_ACCESS_KEY_ID";
  awsSecret.secret = "AWS_SECRET_ACCESS_KEY";

  postgres = pkgs.postgresql_18.withPackages (p: [ p.pgvector ]);

  postgresWorkload =
    {
      user,
      # The key of macro-env holding this database's password.
      passwordKey,
      maxConnections ? 500,
    }:
    {
      image = image {
        name = "postgres";
        contents = [ postgres ];
        # The official image's default locale; FusionAuth creates its database
        # with an en_US collation.
        env.LOCALE_ARCHIVE = "${pkgs.glibcLocales}/lib/locale/locale-archive";
        entrypoint = sh ''
          set -e
          export PGDATA=/var/lib/postgresql/data/pgdata
          if [ ! -s "$PGDATA/PG_VERSION" ]; then
            printf '%s' "$POSTGRES_PASSWORD" > /tmp/pw
            ${postgres}/bin/initdb -D "$PGDATA" -U '${user}' --pwfile=/tmp/pw --auth=scram-sha-256 \
              --encoding=UTF8 --locale=en_US.UTF-8
            echo "host all all 0.0.0.0/0 scram-sha-256" >> "$PGDATA/pg_hba.conf"
          fi
          chmod 700 "$PGDATA"
          # Full paths: the extension env locates its share/lib dirs from its
          # own bin, not from the image root's /bin links.
          exec ${postgres}/bin/postgres -D "$PGDATA" -c listen_addresses='*' \
            -c max_connections=${toString maxConnections} \
            -c shared_preload_libraries=pg_stat_statements \
            -c unix_socket_directories=/tmp
        '';
      };
      env.POSTGRES_PASSWORD.secret = passwordKey;
      user = 1000;
      ports = [ 5432 ];
      volumes.data = "/var/lib/postgresql/data";
      readiness.exec = [
        "${postgres}/bin/pg_isready"
        "-h"
        "127.0.0.1"
        "-U"
        user
      ];
      infra = true;
    };

  opensearchHome = pkgs.runCommand "opensearch-with-icu" { nativeBuildInputs = [ pkgs.unzip ]; } ''
    cp -r ${pkgs.opensearch} $out
    chmod -R u+w $out
    mkdir -p $out/plugins/analysis-icu
    unzip -q ${
      pkgs.fetchurl {
        url = "https://artifacts.opensearch.org/releases/plugins/analysis-icu/${pkgs.opensearch.version}/analysis-icu-${pkgs.opensearch.version}.zip";
        hash = "sha256-ZUCg1WsXWcCJ4CRkhFZkeuigLRAcSC9w7Qul88mXMO4=";
      }
    } -d $out/plugins/analysis-icu
  '';

  # Routes each AWS API request to its backend by the service the SDK named:
  # X-Amz-Target for the JSON protocols, the SigV4 credential scope otherwise
  # (header or presigned query). The Host header is preserved because it is
  # part of the signature the backend verifies.
  awsGatewayConf = pkgs.writeText "aws-gateway.conf" ''
    daemon off;
    worker_processes 2;
    error_log stderr warn;
    pid /tmp/nginx.pid;
    events { worker_connections 1024; }
    http {
      access_log off;
      client_body_temp_path /tmp/body;
      proxy_temp_path /tmp/proxy;
      client_max_body_size 0;
      proxy_request_buffering off;
      proxy_buffering off;
      map "$http_x_amz_target|$http_authorization|$arg_x_amz_credential" $aws_backend {
        ~^AmazonSQS              queues;
        ~^DynamoDB_              extenddb;
        ~^TrentService           kms;
        ~/sqs/aws4_request       queues;
        ~/dynamodb/aws4_request  extenddb;
        ~/kms/aws4_request       kms;
        ~/sns/aws4_request       push;
        default                  s3;
      }
      upstream s3 { server rustfs:9000; }
      upstream queues { server queue-gateway:9324; }
      upstream extenddb { server extenddb:18443; }
      upstream kms { server kms:8080; }
      upstream push { server push-sink:8080; }
      server {
        listen 4566;
        location = /_localstack/health { return 200 '{"services":{}}'; }
        location / {
          proxy_set_header Host $http_host;
          proxy_http_version 1.1;
          proxy_ssl_verify off;
          set $scheme_up http;
          if ($aws_backend = extenddb) { set $scheme_up https; }
          proxy_pass $scheme_up://$aws_backend;
        }
      }
    }
  '';

  rustService =
    {
      bin,
      env ? { },
      ports ? [ 8080 ],
      aliases ? [ ],
      health ? "/health",
      terminationGracePeriod ? 30,
    }:
    {
      image = image {
        name = bin;
        contents = [ macro.binaries.${bin} ];
        entrypoint = [ "/bin/${bin}" ];
      };
      sharedEnv = true;
      env = {
        PORT = "8080";
        # Debug builds of the deeper async handlers (DSS /history) overflow
        # tokio's default 2 MiB worker stacks.
        RUST_MIN_STACK = "16777216";
      } // env;
      inherit ports aliases terminationGracePeriod;
    }
    // lib.optionalAttrs (health != null && ports != [ ]) {
      readiness = {
        http = health;
        port = 8080;
      };
    };

  # RustFS delivers bucket events to webhooks, not SQS ARNs. This forwards each
  # S3-format event, unchanged, into the queue the upload finalizer reads.
  s3EventsBridge = pkgs.writeText "s3-events.py" ''
    import http.server, json, urllib.request

    QUEUE = "http://queue-gateway:9324/000000000000/document-upload-finalizer-queue"

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_HEAD(self):
            self.send_response(200)
            self.end_headers()

        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
            request = urllib.request.Request(
                "http://queue-gateway:9324/",
                data=json.dumps({"QueueUrl": QUEUE, "MessageBody": body.decode()}).encode(),
                headers={
                    "Content-Type": "application/x-amz-json-1.0",
                    "X-Amz-Target": "AmazonSQS.SendMessage",
                },
            )
            urllib.request.urlopen(request).read()
            self.send_response(200)
            self.end_headers()

        def log_message(self, *args):
            pass

    http.server.ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
  '';

  celldFleet =
    { bucket, port }:
    {
      image = image {
        name = "celld";
        contents = [ platformPkgs.celld ];
        entrypoint = sh ''
          exec celld --bucket s3://${bucket} --endpoint http://rustfs:9000 \
            --region us-east-1 --listen 0.0.0.0:${toString port} --internal-listen 0.0.0.0:8081 \
            --advertise "$POD_IP:8081"
        '';
        env = {
          AWS_REGION = "us-east-1";
          HOME = "/tmp";
          CELLD_WATCH = "/var/lib/celld/state";
          # A node halts if it cannot renew its lease in time. The default of 10s trips
          # on a busy node, and a fleet of one has nothing to fail over to anyway.
          CELLD_TTL_MS = "60000";
        };
      };
      env = {
        POD_IP.fieldRef = "status.podIP";
        AWS_ACCESS_KEY_ID = awsKey;
        AWS_SECRET_ACCESS_KEY = awsSecret;
      };
      user = 1000;
      ports = [
        port
        8081
      ];
      volumes.state = "/var/lib/celld";
      readiness.tcp = port;
    };

  # An unmodified Lambda binary behind lambda-runner (see its header).
  lambdaHandler =
    {
      bin,
      trigger,
      env ? { },
      workingDir ? null,
    }:
    {
      image = image {
        name = bin;
        inherit workingDir;
        contents = [
          macro.binaries.${bin}
          pkgs.python3
        ];
        entrypoint = [
          "python3"
          "${./lambda-runner/runner.py}"
          "/bin/${bin}"
        ];
      };
      sharedEnv = true;
      scaleOnQueue =
        let
          source = lib.splitString ":" trigger;
        in
        if builtins.elem (builtins.head source) [ "sqs" "s3" ] then lib.last source else null;
      env = {
        LAMBDA_TRIGGER = trigger;
        RUST_MIN_STACK = "16777216";
      }
      // env;
    };

  # Handlers with their production triggers (seconds from the stacks' rates).
  # Env values are what their Pulumi stacks set on dev.
  lambdaHandlers = lib.filterAttrs (_: h: macro.binaries ? ${h.bin}) {
    deleted-item-poller = {
      bin = "deleted_item_poller";
      trigger = "schedule:14400";
    };
    user-link-cleanup = {
      bin = "user_link_cleanup_handler";
      trigger = "schedule:86400";
    };
    email-refresh = {
      bin = "email_refresh_handler";
      trigger = "schedule:3600";
      env = {
        DELETE_UNUSED_AFTER_DAYS = "5000";
        DELETE_INACTIVE_AFTER_DAYS = "5000";
        INBOX_HEALTH_POLL_INTERVAL_HOURS = "6";
      };
    };
    email-scheduled = {
      bin = "email_scheduled_handler";
      trigger = "schedule:60";
    };
    notification-retention = {
      bin = "notification_retention_handler";
      trigger = "schedule:3600";
      # Its stack passes this as the rule's input, defaulting to a dry run.
      env.LAMBDA_SCHEDULE_INPUT = builtins.toJSON { dry_run = true; };
    };
    organization-retention-trigger = {
      bin = "organization_retention_trigger";
      trigger = "schedule:86400";
    };
    organization-retention = {
      bin = "organization_retention_handler";
      trigger = "sqs:organization-retention-handler-queue";
    };
    email-sfs-delete = {
      bin = "email_sfs_delete_handler";
      trigger = "schedule:86400";
    };
    delete-chat = {
      bin = "delete_chat_handler";
      trigger = "sqs:delete-chat-handler-queue";
    };
    document-text-extractor = {
      bin = "document_text_extractor";
      trigger = "sqs:document-text-extractor-lambda-queue";
      # The binary loads ./pdfium-lib/linux/libpdfium.so (PDFIUM_LIB_PATH).
      workingDir = "${pkgs.runCommand "pdfium-workdir" { } ''
        mkdir -p $out/pdfium-lib/linux
        ln -s ${pkgs.pdfium-binaries}/lib/libpdfium.so $out/pdfium-lib/linux/libpdfium.so
      ''}";
    };
    upload-extractor = {
      bin = "upload_extractor_lambda_handler";
      trigger = "sqs:bulk-upload-queue";
      env = {
        DYNAMODB_TABLE = "bulk-upload";
        UPLOAD_BUCKET_NAME = "bulk-upload-staging";
        DSS_URL = "http://document-storage-service:8080";
        CONNECTION_GATEWAY_URL = inNetwork.gateway;
      };
    };
  };

  # Provisioning runs in the cluster, the same on every environment. Bundles
  # hold no secrets; the Jobs read those from the shared env.
  provisioner = args: {
    job = true;
    image = image {
      name = "provisioner";
      contents = [
        macro.binaries.xtask_local
        pkgs.sqlx-cli
        pkgs.bun
        pkgs.esbuild
        platformPkgs.celld
      ];
      entrypoint = [ "/bin/xtask_local" ];
      env = {
        HOME = "/tmp";
        PLATFORM_MIGRATIONS_DIR = "${../../crates/macro_db_client/migrations}";
        PLATFORM_OPENSEARCH_HELPERS = "${macro.node.opensearch-helpers}";
        PLATFORM_BUNDLE_SYNC = "${macro.node.sync-bundle}";
        PLATFORM_BUNDLE_ANALYTICS = "${macro.node.analytics-bundle}";
        PLATFORM_BUNDLE_AI_EDITING = "${macro.node.ai-editing-bundle}";
      };
    };
    inherit args;
    sharedEnv = true;
    user = 1000;
  };

  inNetwork = {
    gateway = "http://connection-gateway:8080";
    lexical = "http://lexical-service:8096";
    sync = "http://sync-service:8787";
  };
in
{
  # ── Data plane ────────────────────────────────────────────────────────
  postgres = postgresWorkload {
    user = "user";
    passwordKey = "PLATFORM_POSTGRES_PASSWORD";
  };

  # FusionAuth's own database (`jdbc:postgresql://db:5432/fusionauth`).
  db = postgresWorkload {
    user = "postgres";
    passwordKey = "PLATFORM_FUSIONAUTH_DB_ROOT_PASSWORD";
    maxConnections = 100;
  };

  redis = {
    image = image {
      name = "valkey";
      contents = [ pkgs.valkey ];
      entrypoint = [
        "valkey-server"
        "--bind"
        "0.0.0.0"
        "--protected-mode"
        "no"
        "--dir"
        "/data"
        "--appendonly"
        "yes"
      ];
    };
    user = 1000;
    ports = [ 6379 ];
    volumes.data = "/data";
    readiness.tcp = 6379;
    infra = true;
  };

  kafka = {
    image = image {
      name = "kafka";
      contents = [ pkgs.apacheKafka ];
      entrypoint = sh ''
        set -e
        cat > /tmp/server.properties <<EOF
        process.roles=broker,controller
        node.id=1
        controller.quorum.voters=1@kafka:29093
        listeners=PLAINTEXT://:29092,CONTROLLER://:29093,HOST://:9092
        advertised.listeners=PLAINTEXT://kafka:29092,HOST://localhost:${toString macro.kafkaHostPort}
        listener.security.protocol.map=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,HOST:PLAINTEXT
        inter.broker.listener.name=PLAINTEXT
        controller.listener.names=CONTROLLER
        log.dirs=/var/lib/kafka/data
        offsets.topic.replication.factor=1
        transaction.state.log.replication.factor=1
        transaction.state.log.min.isr=1
        share.coordinator.state.topic.replication.factor=1
        share.coordinator.state.topic.min.isr=1
        auto.create.topics.enable=true
        EOF
        kafka-storage.sh format --ignore-formatted -t TWFjcm9Mb2NhbEthZmthMQ -c /tmp/server.properties
        exec kafka-server-start.sh /tmp/server.properties
      '';
      env.KAFKA_HEAP_OPTS = "-Xms256m -Xmx768m";
    };
    user = 1000;
    ports = [
      9092
      29092
      29093
    ];
    volumes.data = "/var/lib/kafka/data";
    readiness.tcp = 29092;
    infra = true;
  };

  search = {
    image = image {
      name = "opensearch";
      contents = [ pkgs.jdk21_headless ];
      entrypoint = sh ''
        set -e
        mkdir -p /tmp/os/config
        cp -r ${opensearchHome}/config/. /tmp/os/config/
        chmod -R u+w /tmp/os/config
        # The launcher runs from the read-only home; keep JVM output in /tmp.
        sed -i -e 's|logs/gc.log|/tmp/os/logs/gc.log|' -e 's|HeapDumpPath=data|HeapDumpPath=/tmp|' \
          -e 's|ErrorFile=logs/|ErrorFile=/tmp/os/logs/|' /tmp/os/config/jvm.options
        cat > /tmp/os/config/opensearch.yml <<EOF
        cluster.name: search
        node.name: search
        discovery.type: single-node
        network.host: 0.0.0.0
        path.data: /usr/share/opensearch/data
        path.logs: /tmp/os/logs
        plugins.security.disabled: true
        EOF
        export OPENSEARCH_PATH_CONF=/tmp/os/config OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"
        # jvm.options logs GC to a path relative to the working directory.
        mkdir -p /tmp/os/logs && cd /tmp/os
        exec ${opensearchHome}/bin/opensearch
      '';
    };
    user = 1000;
    ports = [ 9200 ];
    volumes.data = "/usr/share/opensearch/data";
    readiness.http = "/";
    infra = true;
  };

  rustfs = {
    image = image {
      name = "rustfs";
      contents = [ platformPkgs.rustfs ];
      entrypoint = [
        "rustfs"
        "/data"
      ];
      env = {
        RUSTFS_ADDRESS = ":9000";
        RUSTFS_CONSOLE_ENABLE = "false";
        # Doc-storage uploads -> s3-events bridge -> upload-finalizer queue.
        RUSTFS_NOTIFY_ENABLE = "true";
        RUSTFS_NOTIFY_WEBHOOK_ENABLE_FINALIZER = "on";
        RUSTFS_NOTIFY_WEBHOOK_ENDPOINT_FINALIZER = "http://s3-events:8080/";
        RUSTFS_NOTIFY_WEBHOOK_QUEUE_DIR_FINALIZER = "/data/.notify";
        # RustFS refuses webhooks that resolve to private addresses, as a ClusterIP
        # does, and reports it as `dns_failure`.
        RUSTFS_OUTBOUND_ALLOW_ORIGINS = "http://s3-events:8080";
      };
    };
    env = {
      RUSTFS_ACCESS_KEY = awsKey;
      RUSTFS_SECRET_KEY = awsSecret;
    };
    user = 1000;
    ports = [ 9000 ];
    volumes.data = "/data";
    readiness.tcp = 9000;
    infra = true;
  };

  # The SQS API, on Kafka, so an instance runs one messaging system. See
  # services/queue_gateway.
  queue-gateway = {
    image = image {
      name = "queue_gateway";
      contents = [ macro.binaries.queue_gateway ];
      entrypoint = [ "/bin/queue_gateway" ];
    };
    sharedEnv = true;
    env.PORT = "9324";
    user = 1000;
    ports = [ 9324 ];
    # Consumers own in-flight messages; two replicas would split a queue's state.
    singleton = true;
    readiness = {
      http = "/health";
      port = 9324;
    };
    infra = true;
  };

  extenddb = {
    image = image {
      name = "extenddb";
      contents = [ platformPkgs.extenddb ];
      env.HOME = "/var/lib/extenddb";
      entrypoint = sh ''
        set -e
        cd /var/lib/extenddb
        if [ ! -f extenddb.toml ]; then
          extenddb init --pg-host postgres --pg-port 5432 --pg-user user \
            --extenddb-user extenddb --bind-addr 0.0.0.0 --tls-san extenddb \
            --config extenddb.toml > init.log 2>&1 || { cat init.log; exit 1; }
          grep -oE 'Password: [A-Za-z0-9]+' init.log | head -1 | cut -d' ' -f2 > admin-password
        fi
        # Started in the same sync wave as Postgres, and exits if it is not up.
        until nc -z postgres 5432; do sleep 1; done
        extenddb serve --config extenddb.toml --foreground &
        server=$!
        until extenddb healthcheck --config extenddb.toml >/dev/null 2>&1; do
          kill -0 "$server" 2>/dev/null || exit 1
          sleep 1
        done
        # Idempotent, so every start converges on the account, user, key, and
        # policy the services sign with.
        (
          export EXTENDDB_PASSWORD="$(cat admin-password)"
          M="extenddb manage --config extenddb.toml --user admin"
          # Each step tolerates "already exists": a restart can interrupt this.
          $M create-account --account-id 000000000000 --account-name local || true
          $M create-user --account-id 000000000000 --user-name services || true
          $M import-access-key --yes --account-id 000000000000 --user-name services \
            --access-key-id "$AWS_ACCESS_KEY_ID" --secret-access-key "$AWS_SECRET_ACCESS_KEY" || true
          $M put-user-policy --account-id 000000000000 --user-name services --policy-name all \
            --policy-document '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":"dynamodb:*","Resource":"*"}]}'
        ) || echo "extenddb: key provisioning incomplete; retrying on next start"
        wait
      '';
    };
    env = {
      EXTENDDB_PG_PASSWORD.secret = "PLATFORM_POSTGRES_PASSWORD";
      EXTENDDB_APP_PASSWORD.secret = "PLATFORM_EXTENDDB_PASSWORD";
      AWS_ACCESS_KEY_ID = awsKey;
      AWS_SECRET_ACCESS_KEY = awsSecret;
    };
    user = 1000;
    ports = [ 18443 ];
    volumes.state = "/var/lib/extenddb";
    readiness.tcp = 18443;
    infra = true;
  };

  # Key management. `kms` serves the KMS API on OpenBao's transit engine, so services
  # use aws_sdk_kms unchanged; see services/kms_gateway. The static seal unseals OpenBao
  # without a person, from a key in macro-env. On first start it creates transit and a
  # token limited to it, then revokes its root token. Each step tolerates a restart.
  openbao = {
    image = image {
      name = "openbao";
      contents = [ pkgs.openbao ];
      env.HOME = "/tmp";
      entrypoint = sh ''
        set -e
        cat > /tmp/bao.hcl <<EOF
        ui = false
        disable_mlock = true
        api_addr = "http://openbao:8200"
        default_max_lease_ttl = "87600h"
        listener "tcp" {
          address = "0.0.0.0:8200"
          tls_disable = true
        }
        storage "file" {
          path = "/var/lib/openbao/data"
        }
        seal "static" {
          current_key_id = "v1"
          current_key = "env://BAO_SEAL_KEY"
        }
        EOF
        bao server -config=/tmp/bao.hcl &
        server=$!
        export BAO_ADDR=http://127.0.0.1:8200
        until bao status -format=json >/dev/null 2>&1 || [ $? -eq 2 ]; do
          kill -0 "$server" 2>/dev/null || exit 1
          sleep 1
        done
        state=/var/lib/openbao/bootstrap
        if ! bao status -format=json | grep -q '"initialized": true'; then
          bao operator init -recovery-shares=1 -recovery-threshold=1 -format=json \
            > "$state.init"
        fi
        if [ -f "$state.init" ]; then
          until ! bao status >/dev/null 2>&1 || bao status | grep -q 'Sealed.*false'; do sleep 1; done
          BAO_TOKEN="$(sed -n 's/.*"root_token": "\(.*\)".*/\1/p' "$state.init")"
          export BAO_TOKEN
          bao secrets enable transit 2>/dev/null || true
          printf 'path "transit/*" { capabilities = ["create", "read", "update"] }\n' \
            | bao policy write transit -
          bao token create -id="$OPENBAO_TOKEN" -policy=transit -orphan -ttl=87600h \
            >/dev/null 2>&1 || true
          bao token revoke -self
          unset BAO_TOKEN
          rm -f "$state.init"
        fi
        wait "$server"
      '';
    };
    env = {
      BAO_SEAL_KEY.secret = "PLATFORM_KMS_SEAL_KEY";
      OPENBAO_TOKEN.secret = "PLATFORM_KMS_TOKEN";
    };
    user = 1000;
    ports = [ 8200 ];
    volumes.data = "/var/lib/openbao";
    singleton = true;
    readiness.tcp = 8200;
    infra = true;
  };

  kms = {
    image = image {
      name = "kms_gateway";
      contents = [ macro.binaries.kms_gateway ];
      entrypoint = [ "/bin/kms_gateway" ];
    };
    env = {
      PORT = "8080";
      OPENBAO_ADDR = "http://openbao:8200";
      OPENBAO_TOKEN.secret = "PLATFORM_KMS_TOKEN";
      ENVIRONMENT.secret = "ENVIRONMENT";
    };
    user = 1000;
    ports = [ 8080 ];
    readiness = {
      http = "/health";
      port = 8080;
    };
    infra = true;
  };

  aws-gateway = {
    image = image {
      name = "aws-gateway";
      contents = [ pkgs.nginx ];
      entrypoint = [
        "nginx"
        "-e"
        "/dev/stderr"
        "-c"
        "${awsGatewayConf}"
      ];
    };
    user = 1000;
    ports = [ 4566 ];
    # The code-defined environment names LocalStack's host.
    aliases = [ "localstack" ];
    readiness.http = "/_localstack/health";
    infra = true;
  };

  s3-events = {
    image = image {
      name = "s3-events";
      contents = [ pkgs.python3 ];
      entrypoint = [
        "python3"
        "${s3EventsBridge}"
      ];
    };
    user = 1000;
    ports = [ 8080 ];
    readiness.tcp = 8080;
    infra = true;
  };

  # Mailpit's counterpart for mobile push: see push-sink/sink.py.
  push-sink = {
    image = image {
      name = "push-sink";
      contents = [ pkgs.python3 ];
      entrypoint = [
        "python3"
        "${./push-sink/sink.py}"
      ];
    };
    user = 1000;
    ports = [ 8080 ];
    readiness.tcp = 8080;
    singleton = true;
    infra = true;
  };

  mailpit = {
    image = image {
      name = "mailpit";
      contents = [ pkgs.mailpit ];
      entrypoint = [ "mailpit" ];
      env = {
        MP_SMTP_AUTH_ACCEPT_ANY = "1";
        MP_SMTP_AUTH_ALLOW_INSECURE = "1";
        MP_WEBROOT = "/mailpit";
        MP_DATABASE = "/data/mailpit.db";
      };
    };
    user = 1000;
    ports = [
      1025
      8025
    ];
    volumes.data = "/data";
    readiness.tcp = 8025;
    infra = true;
  };

  fusionauth = {
    image = image {
      name = "fusionauth";
      contents = [ platformPkgs.fusionauth ];
      entrypoint = sh ''
        set -e
        # Silent configuration runs once at boot and does not retry a refused
        # connection (compose ordered this with depends_on: healthy).
        until nc -z db 5432; do sleep 1; done
        src=${platformPkgs.fusionauth}/share/fusionauth
        # /tmp survives container restarts within a pod; start clean.
        rm -rf /tmp/fusionauth && mkdir -p /tmp/fusionauth/logs
        for entry in "$src"/*; do
          case "$(basename "$entry")" in config|logs) ;; *) ln -s "$entry" /tmp/fusionauth/ ;; esac
        done
        # Config lives on the volume, seeded from the package default once.
        mkdir -p /var/lib/fusionauth/config
        [ -f /var/lib/fusionauth/config/fusionauth.properties ] || \
          cp "$src/config/fusionauth.properties" /var/lib/fusionauth/config/
        chmod u+w /var/lib/fusionauth/config/fusionauth.properties
        ln -s /var/lib/fusionauth/config /tmp/fusionauth/config
        # start.sh downloads a JDK unless one sits at java/current.
        mkdir -p /tmp/fusionauth/java/jdk-21.0.4+7
        ln -s ${platformPkgs.fusionauthJdk} /tmp/fusionauth/java/current
        export FUSIONAUTH_BASE=/tmp/fusionauth
        exec ${platformPkgs.fusionauth}/bin/fusionauth
      '';
    };
    user = 1000;
    env = {
      DATABASE_URL = "jdbc:postgresql://db:5432/fusionauth";
      DATABASE_ROOT_USERNAME = "postgres";
      DATABASE_ROOT_PASSWORD.secret = "PLATFORM_FUSIONAUTH_DB_ROOT_PASSWORD";
      DATABASE_USERNAME = "fusionauth";
      DATABASE_PASSWORD.secret = "PLATFORM_FUSIONAUTH_DB_PASSWORD";
      FUSIONAUTH_APP_KICKSTART_FILE = "/kickstart/kickstart.json";
      FUSIONAUTH_APP_MEMORY = "512M";
      FUSIONAUTH_APP_RUNTIME_MODE = "development";
      FUSIONAUTH_APP_URL = "http://fusionauth:9011";
      FUSIONAUTH_APP_SILENT_MODE = "true";
      SEARCH_TYPE = "database";
    };
    ports = [ 9011 ];
    volumes.config = "/var/lib/fusionauth/config";
    files.kickstart = {
      secret = "fusionauth-kickstart";
      mountPath = "/kickstart";
    };
    readiness.http = "/api/status";
    infra = true;
  };

  # ── Macro services ────────────────────────────────────────────────────
  authentication-service = rustService { bin = "authentication_service"; };
  connection-gateway = rustService { bin = "connection_gateway_service"; };
  contacts-service = rustService { bin = "contacts_service"; };
  document-storage-service = rustService {
    bin = "document_storage_service";
    env = {
      OVERRIDE_SYNC_SERVICE_URL = inNetwork.sync;
      OVERRIDE_LEXICAL_SERVICE_URL = inNetwork.lexical;
    };
  };
  document-upload-finalizer = rustService {
    bin = "document_upload_finalizer_local_worker";
    ports = [ ];
    env.DOCUMENT_UPLOAD_FINALIZER_QUEUE_URL = "http://localstack:4566/000000000000/document-upload-finalizer-queue";
  };
  email-service = rustService { bin = "email_service"; };
  email-pubsub-workers = rustService {
    bin = "pubsub_workers";
    ports = [ ];
  };
  calendar-service = rustService { bin = "calendar_service"; };
  notification-service = rustService {
    bin = "notification_service";
    env = {
      LAST_ONLINE_REDIS_URI = "redis://redis:6379";
      OVERRIDE_CONNECTION_GATEWAY_URL = inNetwork.gateway;
    };
  };
  search-processing-service = rustService {
    bin = "search_processing_service";
    env.OVERRIDE_LEXICAL_SERVICE_URL = inNetwork.lexical;
  };
  agent-harness-service = rustService {
    bin = "agent_harness_service";
    ports = [
      8080
      8102
      8111
      2222
    ];
    env = {
      OVERRIDE_CONNECTION_GATEWAY_URL = inNetwork.gateway;
      OVERRIDE_LEXICAL_SERVICE_URL = inNetwork.lexical;
      OVERRIDE_SYNC_SERVICE_URL = inNetwork.sync;
    };
  };
  whatsapp-session-service = rustService {
    bin = "whatsapp_session_service";
    ports = [ 8080 ];
    terminationGracePeriod = 120;
  };
  static-file-service = rustService {
    bin = "static_file_service";
    health = "/api/health";
  };
  unfurl-service = rustService { bin = "unfurl_service"; };
  # Background workers: no HTTP surface, and idle until their feature is configured.
  agent-trigger-service = rustService {
    bin = "agent_trigger_service";
    ports = [ ];
  };
  email-focus-worker = rustService {
    bin = "email_focus_worker";
    ports = [ ];
  };
  slack-import-worker = rustService {
    bin = "slack_import_worker";
    ports = [ ];
  };
  image-proxy-service = rustService { bin = "image_proxy_service"; };

  # ── Node services (host-built bundles; present once `platform up` built them)
}
