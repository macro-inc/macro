#!/usr/bin/env bash
set -euo pipefail

# Pi invokes shellPath as: .pi/bin/nix-develop-shell -c '<command>'.
# Re-exec bash inside the repo flake so normal bash tool calls see Rust and
# other development tooling without requiring `direnv exec`.
#
# Deliberately use bash, not $SHELL: Pi's tool is a bash tool and generated
# commands commonly use bash syntax. If $SHELL is fish/nu/etc., those commands
# fail even though the Nix environment loaded correctly.

script_path="${BASH_SOURCE[0]:-$0}"
script_dir="$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/../.." && pwd)"

if [ -n "${PI_NIX_DEVELOP_SHELL_ACTIVE:-}" ] || [ -n "${IN_NIX_SHELL:-}" ]; then
  exec bash "$@"
fi

export PI_NIX_DEVELOP_SHELL_ACTIVE=1

if command -v nix >/dev/null 2>&1 && [ -f "$repo_root/flake.nix" ]; then
  exec nix develop "$repo_root" -c bash "$@"
fi

exec bash "$@"
