{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.processing,\n            s.delivery_started_at,\n            s.delivery_claim_id,\n            s.delivery_status,\n            s.sent,\n            d.checkpoint\n        FROM\n            email_scheduled_messages s\n        JOIN\n            email_mailbox_drafts d ON d.message_id = s.message_id\n        WHERE\n            s.message_id = $1\n        ",
