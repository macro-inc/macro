{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                w.id,\n                w.workspace_id,\n                w.name,\n                w.endpoint_url,\n                w.signing_secret,\n                w.headers,\n                w.status,\n                w.is_valid,\n                w.created_by_user_id,\n                w.created_at,\n                w.updated_at,\n                w.deleted_at,\n                w.filters\n            FROM webhook w\n            WHERE w.workspace_id = ANY($1)\n              AND w.deleted_at IS NULL\n            ORDER BY w.created_at DESC, w.id DESC\n            ",
