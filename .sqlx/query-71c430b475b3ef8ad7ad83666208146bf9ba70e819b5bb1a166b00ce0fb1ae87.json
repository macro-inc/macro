  "query": "\n        SELECT\n            a.id,\n            a.message_id,\n            a.provider_attachment_id,\n            a.filename,\n            a.mime_type,\n            a.size_bytes,\n            a.content_id,\n            a.created_at,\n            a.thread_id\n        FROM\n            email_attachments a\n        WHERE\n            a.thread_id = ANY($1)\n        ORDER BY\n            a.created_at ASC\n        ",
