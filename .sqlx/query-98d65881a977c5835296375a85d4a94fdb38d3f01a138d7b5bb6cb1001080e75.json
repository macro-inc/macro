{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.internal_date_ts, m.replying_to_id, m.headers_jsonb, m.body_text,\n                      lower(c.email_address) AS \"from_email?\"\n               FROM email_messages m LEFT JOIN email_contacts c ON c.id = m.from_contact_id\n               WHERE m.id = $1 AND m.link_id = $2 AND NOT m.is_sent AND NOT m.is_draft",
