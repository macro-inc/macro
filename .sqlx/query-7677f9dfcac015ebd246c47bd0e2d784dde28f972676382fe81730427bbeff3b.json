  "query": "SELECT thread_id,draft_generation,is_draft,is_sent,\n            (EXISTS (SELECT 1 FROM email_mailbox_drafts d WHERE d.message_id = m.id AND d.delete_requested) OR EXISTS(SELECT 1 FROM email_draft_transfers t WHERE t.source_id=m.id AND t.state<>'preparing')) AS \"deleted!\"\n            FROM email_messages m WHERE id = $1 AND link_id = $2",
