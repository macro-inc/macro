{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, name, enabled, trigger_type, next_run_at,\n                   (claim_token IS NOT NULL AND claimed >= $2) AS \"running!\"\n            FROM scheduled_action\n            WHERE owner COLLATE \"C\" = $1 AND parent_id IS NULL\n            ORDER BY created_at, id\n            LIMIT $3\n            ",
