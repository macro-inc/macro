{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            b.id,\n            b.team_id,\n            b.name,\n            b.handle,\n            b.description,\n            b.avatar_url,\n            b.created_by,\n            b.created_at,\n            b.updated_at,\n            c.harness,\n            c.model,\n            c.system_prompt,\n            c.repo_url\n        FROM bots b\n        JOIN bot_agent_config c ON c.bot_id = b.id\n        WHERE b.id = $1\n          AND b.deleted_at IS NULL\n        ",
