  "query": "\n        SELECT github_key, repository_id, number, owner, repo\n        FROM github_pull_request\n        WHERE lower(github_key) = lower($1)\n           OR (repository_id = $2 AND number = $3)\n        ORDER BY github_key\n        FOR UPDATE\n        ",
