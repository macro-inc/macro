  "query": "\n            SELECT id, computer_id, from_host, to_host, stage AS \"stage: MoveStage\", ticket,\n                   rounds, last_round_bytes, was_running, flipped_at, error, created_by, created_at\n            FROM computer_move\n            WHERE computer_id = $1\n            ORDER BY created_at DESC\n            LIMIT 50\n            ",
