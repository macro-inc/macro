  "query": "\n        SELECT\n            l.updated_at AS \"link_updated_at!\",\n            g.granted_scopes AS \"side_scopes!\",\n            g.grant_version AS \"side_version!\"\n        FROM email_links l\n        JOIN email_link_google_scopes g ON g.link_id = l.id\n        WHERE l.id = $1\n        ",
