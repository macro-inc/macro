  "query": "\n            SELECT\n                id,\n                parent_id,\n                name,\n                description,\n                color AS \"color: SubteamColor\",\n                join_policy AS \"join_policy: SubteamJoinPolicy\",\n                created_at\n            FROM subteam\n            WHERE team_id = $1 AND ($2::uuid IS NULL OR id = $2)\n            ORDER BY lower(name), id\n            ",
