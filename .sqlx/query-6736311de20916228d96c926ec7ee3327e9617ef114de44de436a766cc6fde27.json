  "query": "\n        SELECT entity_id AS \"entity_id!\", access_level AS \"access_level!: AccessLevel\"\n        FROM entity_access\n        JOIN database_entity d ON d.database_id = entity_access.entity_id\n        WHERE entity_type = 'database'\n        AND source_id = ANY($1)\n        ",
