  "query": "\n            SELECT\n                id,\n                user_id,\n                credential_ciphertext,\n                expires_at,\n                consumed_by\n            FROM\n                imap_verifications\n            WHERE\n                id = $1\n                AND (expires_at > now()\n                    OR consumed_by IS NOT NULL)\n            ",
