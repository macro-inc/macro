  "query": "SELECT metadata,user_id,grants,deleting,revision,totp_key_id FROM password_item_entities WHERE team_id=$1 AND deleted_at IS NULL AND NOT deleting AND (grants @> $3 OR grants @> $4 OR user_id=$5) AND ($6::uuid IS NULL OR id < $6) AND (lower(metadata->>'name') || ' ' || lower(COALESCE(metadata->>'url',''))) LIKE lower($2) ESCAPE '\\' ORDER BY id DESC LIMIT $7",
