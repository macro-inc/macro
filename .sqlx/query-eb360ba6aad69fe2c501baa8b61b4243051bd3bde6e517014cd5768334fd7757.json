{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            m.content as \"content\",\n            c.name as \"name\",\n            m.role as \"role\",\n            c.\"deletedAt\"::timestamptz as \"deleted_at\",\n            c.\"userId\" as \"owner_user_id\",\n            m.\"createdAt\" as \"created_at\",\n            m.\"updatedAt\" as \"updated_at\"\n        FROM\n            \"ChatMessage\" m\n        JOIN\n            \"Chat\" c on c.\"id\" = m.\"chatId\"\n        WHERE\n            m.id = $1 AND m.\"chatId\" = $2\n        ",
