  "query": "\n        SELECT\n            event.status,\n            event.event_type,\n            event.reminders_use_default,\n            event.reminder_overrides,\n            COALESCE(reminder_owner_calendar_id(event.id), $2) AS reminder_calendar_id\n        FROM calendar_events event\n        WHERE event.id = $1\n        ",
