{
  "db_name": "PostgreSQL",
  "query": "SELECT b.channel_id,m.message_id,m.effect_revision,m.published_revision,m.origin FROM whatsapp_external_message m JOIN whatsapp_group_binding b ON b.id=m.binding_id WHERE m.message_id IS NOT NULL AND m.published_revision<m.effect_revision AND m.native_retry_at<=now() ORDER BY m.native_retry_at,m.message_id LIMIT 50",
