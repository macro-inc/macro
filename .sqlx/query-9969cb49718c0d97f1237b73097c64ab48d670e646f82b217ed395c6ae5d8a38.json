  "query": "SELECT m.person_id, m.message_id, m.origin, m.deleted_at, m.revision_content, m.content_revision, m.revised_at\n            FROM whatsapp_group_message m JOIN whatsapp_identity_alias a ON a.binding_id = m.binding_id AND a.person_id = m.person_id\n            WHERE m.binding_id = $1 AND a.jid = $2 AND m.source_id = $3",
