  "query": "SELECT id, share_token, user_id, title, scheduled_start, scheduled_end, channel_id, channel_call_id, active_call_id\n               FROM call_meetings\n               WHERE (active_call_id = $1 OR id = (SELECT meeting_id FROM call_records WHERE id = $1))\n                 AND ($2 OR cancelled_at IS NULL)\n               ORDER BY created_at DESC\n               LIMIT 1",
