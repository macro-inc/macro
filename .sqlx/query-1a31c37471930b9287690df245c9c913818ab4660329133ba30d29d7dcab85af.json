  "query": "\n            INSERT INTO database_tables (id, database_id, name, position)\n            SELECT $1, $2, $3, $4\n            WHERE NOT EXISTS (\n                SELECT 1 FROM database_tables\n                WHERE database_id = $2 AND lower(name) = lower($3)\n            )\n            RETURNING id, database_id, name, position, version\n            ",
