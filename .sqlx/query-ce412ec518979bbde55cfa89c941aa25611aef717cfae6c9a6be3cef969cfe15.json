{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            d.status,\n            d.delivered_at,\n            d.attempt_count,\n            a.status AS attempt_status,\n            a.completed_at,\n            w.last_success_at,\n            w.last_failure_at\n        FROM webhook_delivery d\n        JOIN webhook_delivery_attempt a ON a.webhook_delivery_id = d.id\n        JOIN webhook w ON w.id = d.webhook_id\n        WHERE d.id = $1\n        ",
