  "query": "\n                    SELECT id, actor_id, action, action_payload,\n                           subject_id, entity_type, entity_id, occurred_at\n                    FROM activity_events\n                    WHERE subject_id = $1\n                    ORDER BY occurred_at DESC, id DESC\n                    LIMIT $2\n                    ",
