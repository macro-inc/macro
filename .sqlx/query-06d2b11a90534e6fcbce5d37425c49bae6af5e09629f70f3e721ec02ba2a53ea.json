{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                a.user_id,\n                a.team_id,\n                a.created_by,\n                a.job_description,\n                a.personality,\n                a.harness_id,\n                a.brain_bot_id,\n                a.brain_session_id,\n                a.created_at,\n                u.email,\n                COALESCE(mui.first_name, u.name, u.email) AS \"name!\"\n            FROM team_agents a\n            JOIN \"User\" u ON u.id = a.user_id\n            LEFT JOIN macro_user_info mui ON mui.macro_user_id = u.macro_user_id\n            WHERE a.user_id = $1\n            ",
