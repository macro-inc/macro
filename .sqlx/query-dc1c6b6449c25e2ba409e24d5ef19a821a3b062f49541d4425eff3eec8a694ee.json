{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT id, task_id, user_id, entry_date, minutes, note, started_at, ended_at,\n                           source AS \"source: TimeEntrySource\", created_at, updated_at\n                    FROM time_entry\n                    WHERE task_id = $1\n                      AND (entry_date, id) < ($2, $3)\n                    ORDER BY entry_date DESC, id DESC\n                    LIMIT $4\n                    ",
