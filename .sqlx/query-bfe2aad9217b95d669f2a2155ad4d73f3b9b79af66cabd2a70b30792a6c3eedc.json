  "query": "\n        SELECT\n            source_id,\n            source_type::text AS \"source_type!\",\n            access_level AS \"access_level: _\",\n            granted_from_project_id,\n            created_at,\n            updated_at\n        FROM entity_access\n        WHERE entity_id = $1 AND entity_type = $2\n        ORDER BY source_type::text, source_id, granted_from_project_id NULLS FIRST\n        ",
