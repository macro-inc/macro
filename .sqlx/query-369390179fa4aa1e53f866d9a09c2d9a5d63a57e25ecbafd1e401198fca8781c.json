  "query": "SELECT c.channel_id,m.message_id,m.effect_revision,m.published_revision,m.provenance,m.direction FROM meta_messaging_message m JOIN meta_messaging_conversation c ON c.connection_id = m.connection_id AND c.customer_id = m.customer_id WHERE m.published_revision<m.effect_revision AND m.native_retry_at<=now() ORDER BY m.native_retry_at,m.created_at,m.message_id LIMIT 100",
