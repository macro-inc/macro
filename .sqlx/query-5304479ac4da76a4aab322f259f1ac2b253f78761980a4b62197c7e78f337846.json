  "query": "\n            SELECT d.id, d.user_id, d.title, d.current_version, v.view, d.created_at, d.updated_at\n            FROM dashboard_entities d\n            JOIN dashboard_versions v ON v.dashboard_id = d.id AND v.version = d.current_version\n            WHERE d.id = $1\n            ",
