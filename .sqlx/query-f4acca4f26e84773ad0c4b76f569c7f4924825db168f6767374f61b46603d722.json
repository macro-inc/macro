  "query": "\n            UPDATE fusion_item\n            SET sync_lease_until = now() + make_interval(secs => $3)\n            WHERE user_id = $1\n              AND item_id = $2\n              AND (sync_lease_until IS NULL OR sync_lease_until < now())\n            RETURNING project_id, document_id, state, sync_lease_until AS \"sync_lease_until!\"\n            ",
