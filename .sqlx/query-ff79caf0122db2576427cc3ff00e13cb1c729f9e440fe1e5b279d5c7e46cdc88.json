{
  "db_name": "PostgreSQL",
  "query": "        SELECT i.id, i.name, i.owner_user_id, i.created_at, i.updated_at, uh.\"updatedAt\"::timestamptz AS viewed_at\n        FROM initiative i\n        LEFT JOIN \"UserHistory\" uh ON uh.\"itemId\" = i.id::text\n            AND uh.\"itemType\" = 'initiative' AND uh.\"userId\" = $1\n        WHERE i.id = ANY($2)\n",
