  "query": "\n            SELECT granularity AS \"granularity: Granularity\", period_start, period_end, content\n            FROM memory_activity WHERE user_id = $1 AND period_start <= $3 AND period_end >= $2\n            ORDER BY period_start, granularity LIMIT 1500\n        ",
