{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT e.entry_date, e.user_id, e.task_id, e.minutes, e.note,\n                           e.source AS \"source: TimeEntrySource\"\n                    FROM time_entry e\n                    WHERE e.task_id = ANY($1::text[])\n                      AND e.entry_date BETWEEN $2 AND $3\n                    ORDER BY e.entry_date, e.id\n                    LIMIT $4\n                    ",
