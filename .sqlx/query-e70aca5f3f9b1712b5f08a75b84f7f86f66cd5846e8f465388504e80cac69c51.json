  "query": "\n            SELECT \n                u.id as user_profile_id, \n                mui.first_name, \n                mui.last_name,\n                u.\"isAgent\" as is_agent\n            FROM macro_user_info mui\n            JOIN \"User\" u ON mui.macro_user_id = u.macro_user_id\n            WHERE u.id = ANY($1)\n        ",
