{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT sp.\"linkShareAccessLevel\" AS \"access_level!: AccessLevel\"\n        FROM initiative i\n        JOIN \"SharePermission\" sp ON sp.id = i.share_permission_id\n        WHERE i.id = $1\n          AND sp.\"linkShare\" = 'PUBLIC'\n          AND sp.\"linkShareAccessLevel\" IS NOT NULL\n        ",
