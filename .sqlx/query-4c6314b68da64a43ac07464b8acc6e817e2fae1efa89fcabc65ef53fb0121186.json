  "query": "\n        SELECT\n            id,\n            team_id,\n            user_id,\n            database_id,\n            display_name,\n            data_type as \"data_type: DataType\",\n            is_multi_select,\n            specific_entity_type as \"specific_entity_type: Option<EntityType>\",\n            created_at,\n            updated_at,\n            is_system\n        FROM property_definitions\n        WHERE id = $1\n          -- Database columns are not part of the shared property namespace.\n          AND database_id IS NULL\n        ",
