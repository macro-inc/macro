{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                ct.id,\n                ct.company_id,\n                ct.email,\n                ct.name,\n                ct.hidden,\n                ct.first_interaction,\n                ct.last_interaction,\n                ct.created_at,\n                ct.updated_at\n            FROM crm_contacts ct\n            JOIN crm_companies co ON co.id = ct.company_id\n            WHERE ct.email = LOWER($1)\n              AND co.team_id = $2\n              AND ($3 OR (ct.hidden = FALSE AND co.hidden = FALSE))\n            ORDER BY ct.id DESC\n            LIMIT 1\n            ",
