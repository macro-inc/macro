  "query": "\n            SELECT\n                webhook_id,\n                status,\n                attempt_count,\n                COALESCE(next_attempt_at <= now(), true) AS \"is_due!\"\n            FROM webhook_delivery\n            WHERE id = $1\n            FOR UPDATE\n            ",
