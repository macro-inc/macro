{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            d.message_id,\n            d.state,\n            d.revision,\n            m.provider_version,\n            d.error_code,\n            d.checkpoint->>'stage' AS stage,\n            d.checkpoint->>'send_rejection_reason' AS send_rejection_reason\n        FROM\n            email_mailbox_drafts d\n        JOIN\n            email_messages m ON m.id = d.message_id\n        WHERE\n            d.message_id = ANY($1)\n        ",
