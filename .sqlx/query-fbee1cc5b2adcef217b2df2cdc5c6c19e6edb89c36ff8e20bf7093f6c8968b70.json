{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT tu.plan AS \"plan: SeatPlan\", t.enterprise\n            FROM team_user tu\n            JOIN team t ON t.id = tu.team_id\n            WHERE tu.user_id = $1\n              AND (t.enterprise OR (t.paying AND t.subscription_id IS NOT NULL))\n            LIMIT 1\n            ",
