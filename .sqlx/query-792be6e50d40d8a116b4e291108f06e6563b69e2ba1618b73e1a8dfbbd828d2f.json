  "query": "\n            SELECT\n                subteam_id,\n                user_id,\n                role AS \"role: SubteamRole\"\n            FROM subteam_member\n            WHERE team_id = $1 AND ($2::uuid IS NULL OR subteam_id = $2)\n            ORDER BY role DESC, created_at, user_id\n            ",
