  "query": "\n            SELECT id, LOWER(email) AS \"email!\", manually_created, hidden\n            FROM crm_contacts\n            WHERE team_id = $1\n              AND company_id IS NULL\n              AND LOWER(email) > COALESCE($2, '')\n            ORDER BY LOWER(email)\n            LIMIT $3\n            ",
