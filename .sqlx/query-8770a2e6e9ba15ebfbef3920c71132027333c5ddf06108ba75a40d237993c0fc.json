  "query": "\n                    SELECT id, task_id, user_id, entry_date, minutes, note, started_at, ended_at,\n                           source AS \"source: TimeEntrySource\", created_at, updated_at\n                    FROM time_entry\n                    WHERE task_id = $1\n                    ORDER BY entry_date DESC, id DESC\n                    LIMIT $2\n                    ",
