  "query": "SELECT b.group_jid, b.id, b.name, b.user_id AS owner_id\n            FROM whatsapp_group b\n            WHERE b.group_jid = ANY($2) AND b.state <> 'detached' AND whatsapp_group_can_view(b.id, $1)\n            ORDER BY b.adopted_at DESC, b.id DESC",
