  "query": "\n            SELECT\n                id,\n                owner_user_id,\n                name,\n                handle,\n                description,\n                avatar_url,\n                system_prompt,\n                created_at,\n                updated_at\n            FROM personas\n            WHERE owner_user_id = $1\n              AND deleted_at IS NULL\n            ORDER BY created_at DESC\n            ",
