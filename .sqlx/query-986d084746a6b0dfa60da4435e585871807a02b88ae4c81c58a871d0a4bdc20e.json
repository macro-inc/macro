{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            'view'::\"AccessLevel\" AS \"access_level!: AccessLevel\",\n            c.team_id AS \"team_id!\",\n            'member'::team_role AS \"team_role!: TeamRole\"\n        FROM crm_contacts ct\n        JOIN crm_companies c\n          ON c.id = ct.company_id\n        WHERE ct.id = $1\n          AND c.team_id = $2\n          AND ct.hidden = false\n          AND c.hidden = false\n        ",
