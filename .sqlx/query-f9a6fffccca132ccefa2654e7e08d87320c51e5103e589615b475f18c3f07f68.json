  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.id, t.name, t.slug, t.owner_id, t.auto_join_domain,\n                COALESCE(tcs.crm_enabled, FALSE) AS \"crm_enabled!\"\n            FROM team t\n            LEFT JOIN team_crm_settings tcs ON tcs.team_id = t.id\n            WHERE t.id = $1\n            ",
