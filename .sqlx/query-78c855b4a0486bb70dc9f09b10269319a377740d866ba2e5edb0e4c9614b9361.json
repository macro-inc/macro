  "db_name": "PostgreSQL",
  "query": "\n            SELECT agent_user_id, team_id, request_id, mailbox_id, address, state,\n                   last_error, fake_provider, updated_at\n            FROM team_agent_inboxes\n            WHERE state IN ('pausing', 'releasing') AND updated_at < $1\n            ORDER BY updated_at\n            LIMIT $2\n            ",
