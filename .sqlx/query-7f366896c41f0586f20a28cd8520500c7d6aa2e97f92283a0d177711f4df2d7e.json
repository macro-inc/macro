  "query": "\n            SELECT\n                id,\n                macro_id,\n                provider::text AS provider,\n                sync_generation,\n                grant_generation,\n                disconnect_requested_at,\n                deleting_at\n            FROM\n                email_links\n            WHERE\n                lower(email_address) = lower($1)\n            ORDER BY\n                created_at,\n                id\n            LIMIT 1\n            FOR UPDATE\n            ",
