  "query": "\n            SELECT b.id, b.name, b.handle, ac.workspace_path\n            FROM agent_configs ac\n            JOIN bots b ON b.id = ac.bot_id\n            WHERE ac.harness_id = $1\n              AND b.deleted_at IS NULL\n              AND b.has_agent\n            ORDER BY b.created_at\n            ",
