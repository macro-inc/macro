{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                number,\n                message,\n                created_by,\n                created_by_agent,\n                created_at,\n                (SELECT count(*) FROM jsonb_object_keys(files)) AS \"file_count!\",\n                (SELECT coalesce(sum((value->>'size')::bigint), 0) FROM jsonb_each(files))::bigint AS \"total_size!\"\n            FROM artifact_versions\n            WHERE document_id = $1\n            ORDER BY number DESC\n            ",
