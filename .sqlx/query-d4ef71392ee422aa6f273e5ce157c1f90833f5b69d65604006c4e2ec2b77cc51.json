  "query": "\n            UPDATE team_agent_inboxes\n            SET mailbox_id = COALESCE($2, mailbox_id),\n                address = COALESCE($3, address),\n                state = $4,\n                last_error = $5,\n                updated_at = now()\n            WHERE agent_user_id = $1\n            RETURNING agent_user_id, team_id, request_id, mailbox_id, address, state,\n                      last_error, updated_at\n            ",
