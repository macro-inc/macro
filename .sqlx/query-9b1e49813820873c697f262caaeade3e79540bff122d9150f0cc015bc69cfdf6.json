  "db_name": "PostgreSQL",
  "query": "\n        SELECT ea.entity_id, ea.access_level AS \"access_level: AccessLevel\"\n        FROM entity_access ea\n        JOIN forms f ON f.id = ea.entity_id\n        WHERE ea.entity_type = 'form'\n        AND ea.source_id = ANY($1)\n        AND f.trashed_at IS NULL\n        ",
