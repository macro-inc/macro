  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            link_id,\n            subscription_id,\n            subscription_expires_at,\n            delta_cursor,\n            created_at,\n            updated_at\n        FROM email_outlook_sync_state\n        WHERE subscription_id IS NOT NULL\n          AND subscription_expires_at <= $1\n        ORDER BY subscription_expires_at, link_id\n        LIMIT $2\n        ",
