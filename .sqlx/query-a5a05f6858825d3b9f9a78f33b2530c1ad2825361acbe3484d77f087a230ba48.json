{
  "db_name": "PostgreSQL",
  "query": "SELECT r.message_id, r.emoji, r.person_id, p.user_id, r.user_id IS NOT DISTINCT FROM $2 AS \"mine!\"\n            FROM external_chat_reaction r JOIN external_chat_person p ON p.id = r.person_id\n            WHERE r.message_id = ANY($1) AND r.emoji <> ''\n            ORDER BY r.message_id, r.emoji, r.updated_at, r.person_id",
