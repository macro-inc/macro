  "query": "\n        UPDATE calendar_event_join_requests\n        SET status = $2, resolved_at = now()\n        WHERE id = $1\n          AND (status = 'pending' OR ($2 = 'accepted' AND status = 'declined'))\n        RETURNING id, event_id, requester_id, requester_email, status, created_at\n        ",
