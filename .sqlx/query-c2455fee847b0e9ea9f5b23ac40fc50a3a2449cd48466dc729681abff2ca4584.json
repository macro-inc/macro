  "query": "\n            SELECT s.id, s.user_id, s.filter\n            FROM mcp_event_subscription_event e\n            JOIN mcp_event_subscription s ON s.id = e.subscription_row_id\n            WHERE e.user_id = ANY($1) AND e.event_name = $2 AND s.expires_at > now()\n            ",
