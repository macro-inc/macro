  "query": "\n        SELECT\n            'view'::\"AccessLevel\" AS \"access_level!: AccessLevel\",\n            team_id AS \"team_id!\",\n            'member'::team_role AS \"team_role!: TeamRole\"\n        FROM (\n            SELECT team_id, hidden FROM crm_companies WHERE id = $1 OFFSET 0\n        ) company\n        WHERE team_id = $2\n          AND hidden = false\n        ",
