{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                d.id AS delivery_id,\n                d.status AS delivery_status,\n                d.attempt_count,\n                d.next_attempt_at,\n                w.id AS webhook_id,\n                w.workspace_id,\n                w.name,\n                w.endpoint_url,\n                w.signing_secret,\n                w.headers,\n                w.status AS webhook_status,\n                w.is_valid,\n                w.created_by_user_id,\n                w.created_at,\n                w.updated_at,\n                w.deleted_at,\n                w.filters\n            FROM webhook_delivery d\n            JOIN webhook w ON w.id = d.webhook_id\n            WHERE d.webhook_id = $1\n              AND d.event_id = $2\n            ",
