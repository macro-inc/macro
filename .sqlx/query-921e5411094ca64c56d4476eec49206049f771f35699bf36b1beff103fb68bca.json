  "query": "\n            SELECT\n                id,\n                user_id,\n                description,\n                entity_type,\n                entity_id,\n                remind_at,\n                cron,\n                timezone,\n                next_run_at,\n                enabled,\n                completed_at,\n                created_at,\n                updated_at\n            FROM reminder\n            WHERE id = $1\n              AND next_run_at = $2\n              AND enabled\n              AND completed_at IS NULL\n            ",
