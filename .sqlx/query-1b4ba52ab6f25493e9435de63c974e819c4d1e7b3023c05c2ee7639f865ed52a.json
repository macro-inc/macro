{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT user_id, app_slug, server_name, account_id, enabled, provider\n            FROM pipedream_mcp_connections c\n            WHERE user_id = $1\n                AND NOT EXISTS (SELECT 1 FROM mcp_overlays o WHERE o.app_slug = c.app_slug)\n            ORDER BY server_name\n            ",
