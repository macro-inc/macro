{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, agent_correlation_id, agent_verb, actor_id, action, action_payload,\n                   subject_id, entity_type, entity_id, occurred_at\n            FROM activity_events\n            WHERE subject_id = $1\n              AND action <> 'appearance_changed'\n              AND occurred_at >= $2\n              AND occurred_at < $3\n            ORDER BY occurred_at DESC, id DESC\n            LIMIT $4\n            ",
