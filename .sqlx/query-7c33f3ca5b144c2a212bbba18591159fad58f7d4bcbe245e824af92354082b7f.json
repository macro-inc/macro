  "query": "\n        SELECT\n            entity_id,\n            entity_type,\n            source_id,\n            access_level AS \"access_level: _\",\n            granted_from_project_id\n        FROM entity_access\n        WHERE source_id = $1 AND source_type = 'channel'\n        ORDER BY entity_type, entity_id, granted_from_project_id NULLS FIRST\n        ",
