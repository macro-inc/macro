{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                w.id,\n                w.workspace_id,\n                w.owner_bot_id,\n                w.namespace,\n                w.name,\n                w.endpoint_url,\n                w.signing_secret,\n                w.headers,\n                w.status,\n                w.is_valid,\n                w.created_by_user_id,\n                w.created_at,\n                w.updated_at,\n                w.deleted_at,\n                w.filters\n            FROM webhook w\n            WHERE w.owner_bot_id = $1\n              AND w.deleted_at IS NULL\n              AND w.status = 'active'\n              AND w.is_valid\n              AND w.filters @> jsonb_build_array(jsonb_build_object('events', jsonb_build_array($2::text)))\n            ORDER BY w.id\n            ",
