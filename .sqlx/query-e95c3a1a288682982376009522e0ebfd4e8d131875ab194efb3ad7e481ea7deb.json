{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, type AS event_type, created_at, received_at, object_id, payload, traceparent\n            FROM stripe_events\n            WHERE ordering_key = $1\n              AND type = ANY($2)\n              AND (created_at, id) > (COALESCE($3, '-infinity'::timestamptz), COALESCE($4, ''))\n            ORDER BY created_at, id\n            LIMIT $5\n            ",
