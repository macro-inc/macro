{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                s.id AS session_id,\n                s.bot_id,\n                b.name AS bot_name,\n                b.handle AS bot_handle,\n                s.name,\n                s.status,\n                s.model,\n                s.owner_id,\n                s.created_at,\n                s.modified_at\n            FROM agent_session s\n            JOIN agent_configs ac ON ac.bot_id = s.bot_id\n            JOIN bots b ON b.id = s.bot_id\n            WHERE ac.harness_id = $1\n            ORDER BY s.modified_at DESC\n            LIMIT 50\n            ",
