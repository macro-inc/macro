{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE bots\n            SET owner_user_id = $2,\n                team_id = $3,\n                name = $4,\n                handle = $5,\n                description = $6,\n                avatar_url = $7,\n                updated_at = now()\n            WHERE id = $1\n              AND deleted_at IS NULL\n              AND EXISTS (SELECT 1 FROM agent_configs WHERE bot_id = $1)\n            RETURNING\n                id,\n                kind,\n                owner_user_id,\n                team_id,\n                name,\n                handle,\n                description,\n                avatar_url,\n                created_by,\n                created_at,\n                updated_at,\n                deleted_at,\n                TRUE AS \"has_agent!\"\n            ",
