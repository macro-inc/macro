  "query": "\n            SELECT\n                k.user_id,\n                u.id AS fusion_user_id,\n                u.email,\n                u.\"organizationId\" AS \"organization_id?\"\n            FROM \"UserApiKey\" k\n            JOIN \"User\" u ON u.id = k.user_id\n            WHERE k.key = $1\n            ",
