// Host and per-computer metrics of a Firecracker host, written to Macro's
// Prometheus, and the host agent's spans and journal, sent to its OTLP
// ingest. Nothing here runs in a guest: a computer's numbers are its VM's
// cgroup under the host agent's unit, read on the host.
//
// @HOST@, @ENVIRONMENT@, @REMOTE_WRITE_URL@, @OTLP_URL@ and @OTLP_ADDRESS@
// are filled in by firecracker-host.nix.

prometheus.exporter.unix "host" {
	// ksmd: memory KSM shares. pressure (PSI) and meminfo (swap, zram) are on
	// by default.
	enable_collectors  = ["ksmd"]
	disable_collectors = ["textfile"]
}

// An exporter labels its targets job="integrations/<name>", which overrides
// a scrape's `job_name`: set the job the fleet dashboard selects on the
// targets themselves.
discovery.relabel "host" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "job"
		replacement  = "firecracker-host/host"
	}
}

prometheus.scrape "host" {
	targets         = discovery.relabel.host.output
	job_name        = "firecracker-host/host"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.macro.receiver]
}

// One cgroup per VM at <unit>/vms/c-<computer id without dashes>, under the
// parent that holds every VM together. A series without `computer_id` is the
// parent's. `diskIO` has no series until the agent turns the `io` controller
// on for these cgroups.
prometheus.exporter.cadvisor "computers" {
	raw_cgroup_prefix_allowlist = ["/system.slice/firecracker-host.service/vms"]
	docker_only                 = false
	store_container_labels      = false
	enabled_metrics             = ["cpu", "memory", "diskIO", "process"]
}

discovery.relabel "computers" {
	targets = prometheus.exporter.cadvisor.computers.targets

	rule {
		target_label = "job"
		replacement  = "firecracker-host/computers"
	}
}

prometheus.scrape "computers" {
	targets         = discovery.relabel.computers.output
	job_name        = "firecracker-host/computers"
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.computers.receiver]
}

prometheus.relabel "computers" {
	forward_to = [prometheus.remote_write.macro.receiver]

	// Only every VM together (the parent) and each computer's VM: cAdvisor
	// also reports the cgroups above them, and the golden build's VM is not
	// a computer.
	rule {
		source_labels = ["id"]
		regex         = "/system\\.slice/firecracker-host\\.service/vms(/c-[0-9a-f]{32})?"
		action        = "keep"
	}

	// The computer's id, as the control plane writes it.
	rule {
		source_labels = ["id"]
		regex         = ".*/vms/c-([0-9a-f]{8})([0-9a-f]{4})([0-9a-f]{4})([0-9a-f]{4})([0-9a-f]{12})"
		replacement   = "$1-$2-$3-$4-$5"
		target_label  = "computer_id"
	}

	// The path says nothing the computer id does not.
	rule {
		regex  = "id|name|image"
		action = "labeldrop"
	}
}

prometheus.remote_write "macro" {
	external_labels = {
		host                   = "@HOST@",
		deployment_environment = "@ENVIRONMENT@",
	}

	endpoint {
		url = "@REMOTE_WRITE_URL@"

		basic_auth {
			username      = "metrics"
			password_file = sys.env("CREDENTIALS_DIRECTORY") + "/remote-write-password"
		}

		queue_config {
			max_shards           = 2
			capacity             = 2500
			max_samples_per_send = 1000
		}
	}

	// A host cut off from the metrics stack keeps an hour of samples.
	wal {
		min_keepalive_time = "5m"
		max_keepalive_time = "1h"
	}
}

// The host agent's spans: the entrypoint sends a copy here
// (GRAFANA_OTLP_ENDPOINT) besides the Datadog agent's.
otelcol.receiver.otlp "agent" {
	grpc {
		endpoint = "@OTLP_ADDRESS@"
	}

	output {
		traces = [otelcol.processor.batch.macro.input]
	}
}

// The units the Datadog agent ships from the journal: the agent, its storage
// check and its health check. Matches on one field are alternatives.
loki.source.journal "agent" {
	matches       = "_SYSTEMD_UNIT=firecracker-host.service _SYSTEMD_UNIT=firecracker-host-storage.service _SYSTEMD_UNIT=firecracker-host-health.service"
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [otelcol.receiver.loki.journal.receiver]
}

// Only these labels leave the source; they become the records' attributes.
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

otelcol.receiver.loki "journal" {
	output {
		logs = [otelcol.processor.transform.journal.input]
	}
}

// The same service, host and environment as the agent's spans and the host's
// metrics.
otelcol.processor.transform "journal" {
	error_mode = "ignore"

	log_statements {
		context    = "resource"
		statements = [
			`set(attributes["service.name"], "firecracker-host")`,
			`set(attributes["host.name"], "@HOST@")`,
			`set(attributes["deployment.environment"], "@ENVIRONMENT@")`,
		]
	}

	output {
		logs = [otelcol.processor.batch.macro.input]
	}
}

otelcol.processor.batch "macro" {
	output {
		traces = [otelcol.exporter.otlphttp.macro.input]
		logs   = [otelcol.exporter.otlphttp.macro.input]
	}
}

// The ingest takes the same token as remote write's password, as a bearer
// token; a file's trailing newline would make it an invalid header.
local.file "token" {
	filename  = sys.env("CREDENTIALS_DIRECTORY") + "/remote-write-password"
	is_secret = true
}

otelcol.auth.bearer "macro" {
	token = string.trim_space(convert.nonsensitive(local.file.token.content))
}

otelcol.exporter.otlphttp "macro" {
	client {
		endpoint = "@OTLP_URL@"
		auth     = otelcol.auth.bearer.macro.handler
	}

	// A host cut off from the ingest drops its oldest batches, not memory.
	sending_queue {
		queue_size = 256
	}
}
