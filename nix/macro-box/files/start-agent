# `start-agent run`: clones the agent's repo into its workspace on first
# start, configures git, links the image's packages, rolls back to the last
# good commit after repeated failed boots, then runs the runtime.
# `_agent.nix` prepends `workspace`, `last_good`, `failures`, `boot_head`,
# `helper`, `helper_credentials`, `runtime` and `max_failed_boots`.
umask 077
mode=${1:?usage: start-agent run}
# The unit sets MUPPET_CREDENTIALS_FILE to its agent.env credential.
credentials=${MUPPET_CREDENTIALS_FILE:?}

[[ $mode == run ]] || { echo "unknown mode: $mode" >&2; exit 2; }

repo_url=$(setting "$credentials" MACRO_REPO_URL)
user_id=$(setting "$credentials" MACRO_AGENT_USER_ID)
name=$(setting "$credentials" MACRO_AGENT_NAME)
# Configuration errors exit 78, as the runtime's do: retried, never rolled back.
for key in MACRO_REPO_URL MACRO_REPO_TOKEN MACRO_AGENT_USER_ID MACRO_AGENT_NAME; do
  if [[ -z "$(setting "$credentials" "$key")" ]]; then
    echo "agent.env is missing $key" >&2
    exit 78
  fi
done
if [[ "$user_id" != macro\|?*@?* ]]; then
  echo 'MACRO_AGENT_USER_ID must contain the agent email (macro|email)' >&2
  exit 78
fi
# Reject credentials in the URL; the helper supplies them only to git.
if [[ ! "$repo_url" =~ ^https?://[^/@]+/ ]]; then
  echo 'MACRO_REPO_URL must be an HTTP(S) URL without credentials' >&2
  exit 78
fi

export GIT_TERMINAL_PROMPT=0
helper_command="!$helper $helper_credentials"
if [[ ! -e "$workspace" ]]; then
  # Clone into a temporary sibling: a failed clone never poisons first start.
  mkdir -p "$(dirname "$workspace")"
  staging=$(mktemp -d "$workspace.clone.XXXXXX")
  trap 'rm -rf "$staging"' EXIT
  git -c credential.useHttpPath=true -c credential.helper= -c credential.helper="$helper_command" \
    clone -- "$repo_url" "$staging"
  mv -T "$staging" "$workspace"
  trap - EXIT
fi

# Follow a re-enrollment's repo URL. Store only the helper and the credential
# file's path, never the token. The empty entry resets inherited helpers.
git -C "$workspace" remote set-url origin "$repo_url"
git -C "$workspace" config --local --replace-all credential.helper ''
git -C "$workspace" config --local --add credential.helper "$helper_command"
git -C "$workspace" config --local credential.useHttpPath true
git -C "$workspace" config --local user.name "$name"
git -C "$workspace" config --local user.email "${user_id#macro|}"

# The workspace's git, never running a hook: hooks are files the agent writes.
wgit() { git -C "$workspace" -c core.hooksPath=/dev/null -c commit.gpgsign=false "$@"; }

# Boot rollback: `agent-stopped` counts boots that failed before the runtime
# wrote last-good for them. After max_failed_boots, go back to last-good's
# code with a commit of its tree on top of the broken head, so the runtime's
# next pull --rebase keeps it (and its next sync pushes it) instead of
# fast-forwarding back to the broken head still on origin.
count=$(cat "$failures" 2>/dev/null || echo 0)
good=$(cat "$last_good" 2>/dev/null || true)
head=$(wgit rev-parse HEAD)
if ((count >= max_failed_boots)) && [[ -n $good && $good != "$head" ]]; then
  echo "rolling back from $head to last-good $good after $count failed boots" >&2
  rollback=$(wgit commit-tree "$good^{tree}" -p "$head" \
    -m "revert(agent): roll back to last-good ${good:0:12} after $count failed boots")
  wgit reset --hard --quiet "$rollback"
  head=$rollback
  echo 0 > "$failures"
fi
# Written before anything here can fail the boot, so agent-stopped counts
# that failure against this head.
echo "$head" > "$boot_head"

# The image's packages, installed from the starter agent's bun.lock. A lock
# that differs because the image was updated is adopted (committed, so the
# runtime pushes it); one that differs because the agent changed its
# dependencies fails the boot, which rolls back: new packages need a new
# image. The agent changed them if its package.json's dependency fields (as
# checked out, so uncommitted changes count) differ from the template's (the
# repository's first commit); scripts and other fields don't matter. A
# rollback restores the template's, so a rolled-back agent boots again.
# `dependency_fields` prints them canonically (keys sorted) from stdin.
dependency_fields() {
  bun -e '
    const sorted = (value) =>
      Array.isArray(value) ? value.map(sorted)
      : value !== null && typeof value === "object"
        ? Object.fromEntries(Object.keys(value).sort().map((key) => [key, sorted(value[key])]))
        : value;
    const json = JSON.parse(await Bun.stdin.text());
    const fields = ["dependencies", "devDependencies", "optionalDependencies",
      "peerDependencies", "workspaces", "overrides"];
    console.log(JSON.stringify(fields.map((field) => [field, sorted(json[field] ?? null)])));
  '
}
dependencies_edited() {
  local template ours theirs
  template=$(wgit rev-list --max-parents=0 HEAD | tail -n 1)
  theirs=$(wgit show "$template:package.json" | dependency_fields) || return 0
  ours=$(dependency_fields <"$workspace/package.json") || return 0
  [[ $ours != "$theirs" ]]
}
if ! cmp -s "$workspace/bun.lock" "$runtime/bun.lock"; then
  if dependencies_edited; then
    echo "bun.lock differs from the image's and the agent changed its dependencies; new packages need a new image" >&2
    exit 1
  fi
  echo "adopting the image's bun.lock" >&2
  cp "$runtime/bun.lock" "$workspace/bun.lock"
  wgit add bun.lock
  wgit commit -qm "chore(agent): adopt the image's bun.lock"
  head=$(wgit rev-parse HEAD)
  echo "$head" > "$boot_head"
fi
modules=$workspace/node_modules
if [[ "$(readlink "$modules" || true)" != "$runtime/node_modules" ]]; then
  rm -rf "$modules"
  ln -s "$runtime/node_modules" "$modules"
fi

cd "$workspace"
echo "starting the runtime at $head" >&2
exec bun "$workspace/cli.ts" run
