[Unit]
Description=Macro computer display (Xvnc :0 on 127.0.0.1:5900)

[Service]
# Local-only, no VNC password: macrod relays the screen to Macro.
# TCP readiness probes must not blacklist the relay before its handshake.
ExecStart=/usr/bin/Xtigervnc :0 -geometry 1920x1080 -depth 24 -rfbport 5900 -interface 127.0.0.1 -localhost -SecurityTypes None -UseBlacklist 0 -AlwaysShared -nolisten tcp
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
