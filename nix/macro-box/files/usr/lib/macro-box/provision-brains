#!/bin/bash
set -euo pipefail
shopt -s nullglob
for env_file in /etc/macro/personas/*.env; do
  os_user=${env_file##*/}
  os_user=${os_user%.env}
  if [[ ! "$os_user" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || [[ "$os_user" == root || "$os_user" == macro ]]; then
    echo "Invalid brain persona user: $os_user" >&2
    exit 1
  fi
  # Never source the environment file: systemd parses it, it is not a script.
  if ! id "$os_user" >/dev/null 2>&1; then
    useradd --create-home --user-group --shell /bin/bash "$os_user"
  fi
  if [[ "$(getent passwd "$os_user" | cut -d: -f6)" != "/home/$os_user" ]]; then
    echo "Persona user has an unexpected home: $os_user" >&2
    exit 1
  fi
  systemctl enable --now "brain@$os_user.service"
done
