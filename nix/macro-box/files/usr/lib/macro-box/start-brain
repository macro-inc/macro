#!/bin/bash
set -euo pipefail
umask 077
: "${HOME:?}" "${BRAIN_WORKSPACE:?}" "${MACRO_REPO_URL:?}" "${MACRO_REPO_TOKEN:?}"
: "${MACRO_AGENT_USER_ID:?}"
if [[ "$MACRO_AGENT_USER_ID" != macro\|?*@?* ]] || [[ "$MACRO_AGENT_USER_ID" == *$'\n'* ]]; then
  echo 'MACRO_AGENT_USER_ID must contain the persona email (macro|email)' >&2
  exit 1
fi
if [[ "$BRAIN_WORKSPACE" != "$HOME/workspace" ]]; then
  echo 'BRAIN_WORKSPACE must be the persona home/workspace' >&2
  exit 1
fi
# Reject credentials in the URL; the helper supplies them only to git.
if [[ ! "$MACRO_REPO_URL" =~ ^https?://[^/@]+/ ]] || [[ "$MACRO_REPO_URL" == *$'\n'* ]]; then
  echo 'MACRO_REPO_URL must be an HTTP(S) URL without credentials' >&2
  exit 1
fi
export GIT_TERMINAL_PROMPT=0
helper=/usr/lib/macro-box/git-credential-brain
trace_args=()
if [[ -n "${BRAIN_PROVISION_TRACEPARENT:-}" ]]; then
  if [[ ! "$BRAIN_PROVISION_TRACEPARENT" =~ ^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$ ]] ||
     [[ "$BRAIN_PROVISION_TRACEPARENT" =~ ^00-0{32}- ]] ||
     [[ "$BRAIN_PROVISION_TRACEPARENT" =~ -0{16}- ]]; then
    echo 'BRAIN_PROVISION_TRACEPARENT must be a valid W3C traceparent' >&2
    exit 1
  fi
  trace_args=(-c "http.extraHeader=traceparent: $BRAIN_PROVISION_TRACEPARENT")
fi
if [[ ! -e "$BRAIN_WORKSPACE" ]]; then
  # Clone into a temporary sibling: a failed clone never poisons first start.
  staging=$(mktemp -d "$HOME/.workspace-clone.XXXXXX")
  trap 'rm -rf "$staging"' EXIT
  git "${trace_args[@]}" -c credential.useHttpPath=true -c credential.helper= -c credential.helper="$helper" clone -- "$MACRO_REPO_URL" "$staging"
  mv -T "$staging" "$BRAIN_WORKSPACE"
  trap - EXIT
fi
# Store only the helper path, never the token. Empty entry resets inherited helpers.
git -C "$BRAIN_WORKSPACE" config --local --replace-all credential.helper ''
git -C "$BRAIN_WORKSPACE" config --local --add credential.helper "$helper"
git -C "$BRAIN_WORKSPACE" config --local credential.useHttpPath true
git -C "$BRAIN_WORKSPACE" config --local user.name "$(id -un)"
git -C "$BRAIN_WORKSPACE" config --local user.email "${MACRO_AGENT_USER_ID#macro|}"
cd "$BRAIN_WORKSPACE"
exec /opt/macro/brain run
