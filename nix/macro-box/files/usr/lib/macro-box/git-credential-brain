#!/bin/bash
set -euo pipefail
# The git credential protocol, not shell code. Never service another origin/repo.
[[ "${1:-}" == get ]] || exit 0
protocol= host= path=
while IFS='=' read -r key value && [[ -n "$key" ]]; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
    path) path=$value ;;
  esac
done
[[ "${protocol}://${host}/${path}" == "${MACRO_REPO_URL:?}" ]] || exit 0
printf 'username=brain\npassword=%s\n\n' "${MACRO_REPO_TOKEN:?}"
