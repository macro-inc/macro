# One viewer's encoder (stdin and stdout are its connection): read
# `<fps> <width> <height> <keyint>\n`, then write fragmented MP4 of $DISPLAY,
# one moof+mdat per frame, until the connection closes. See
# _agent-screen-encoder.nix.

# bash reads a socket one byte at a time, so nothing past the line is lost.
if ! IFS=' ' read -r -t 10 fps width height keyint extra; then
  echo "agent-screen-encoder: no config line" >&2
  exit 64
fi

# At most four significant digits, so the arithmetic can't wrap.
in_range() { [[ $1 =~ ^0*([0-9]{1,4})$ ]] && ((10#${BASH_REMATCH[1]} >= $2 && 10#${BASH_REMATCH[1]} <= $3)); }
if [[ -n ${extra:-} ]] ||
  ! in_range "$fps" 1 60 ||
  ! in_range "$width" 160 1920 || ((10#$width % 2)) ||
  ! in_range "$height" 120 1080 || ((10#$height % 2)) ||
  ! in_range "$keyint" 1 600; then
  echo "agent-screen-encoder: invalid config line" >&2
  exit 64
fi

# -nostdin: stdin is the connection, not ffmpeg's console.
exec ffmpeg-x11grab -hide_banner -loglevel error -nostdin \
  -f x11grab -draw_mouse 1 -framerate "$((10#$fps))" -i "$DISPLAY" \
  -vf "scale=$((10#$width)):$((10#$height)):flags=fast_bilinear,format=yuv420p" \
  -c:v libx264 -preset ultrafast -tune zerolatency -profile:v baseline -bf 0 \
  -g "$((10#$keyint))" -sc_threshold 0 -crf 28 \
  -f mp4 -movflags empty_moov+default_base_moof+frag_every_frame \
  -flush_packets 1 pipe:1
