# The git credential protocol, not shell code: `git-credential-agent <file>
# get`, where <file> is the agent's credential file (agent.env). Never answers
# for another origin or repo: the token goes only to the exact MACRO_REPO_URL.
[[ "${2:-}" == get ]] || exit 0
file=${1:?}
setting() { sed -n "s/^$1=//p" "$file" | tail -n 1; }
protocol='' host='' path=''
while IFS='=' read -r key value && [[ -n "$key" ]]; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
    path) path=$value ;;
  esac
done
url=$(setting MACRO_REPO_URL)
token=$(setting MACRO_REPO_TOKEN)
[[ -n "$url" && -n "$token" && "${protocol}://${host}/${path}" == "$url" ]] || exit 0
printf 'username=agent\npassword=%s\n\n' "$token"
