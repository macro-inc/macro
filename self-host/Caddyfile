# Two sites:
#   {$MACRO_DOMAIN}  the app and every API, on one origin. The frontend bundle
#                    is built with VITE_LOCAL_BACKEND_ORIGIN=same-origin, so it
#                    calls these paths relatively and needs no rebuild to move
#                    between hostnames.
#   {$S3_DOMAIN}     object storage. Presigned URLs are signed for this exact
#                    host, so this site must not rewrite the Host header
#                    (Caddy passes it through by default — do not add
#                    `header_up Host`).

{
	email {$ACME_EMAIL}
	# Point at a private ACME server (e.g. step-ca) for an internal install.
	# Leave unset for Let's Encrypt. For a LAN-only install with no public DNS,
	# replace the `{$MACRO_DOMAIN} {` line below with `{$MACRO_DOMAIN} {
	# tls internal` instead.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	admin off
}

{$MACRO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Proxy liveness, distinct from any service's /health.
	handle /_healthz {
		respond "ok" 200
	}

	# --- generated service routes -------------------------------------------
	handle_path /auth/* {
		reverse_proxy authentication-service:8080
	}
	@connection_gateway path /connection-gateway /connection-gateway/*
	handle @connection_gateway {
		uri strip_prefix /connection-gateway
		reverse_proxy connection-gateway:8080
	}
	handle_path /contacts/* {
		reverse_proxy contacts-service:8080
	}
	handle_path /cognition/* {
		reverse_proxy document-cognition-service:8080
	}
	handle_path /dss/* {
		reverse_proxy document-storage-service:8080
	}
	handle_path /email/* {
		reverse_proxy email-service:8080
	}
	handle_path /notification/* {
		reverse_proxy notification-service:8080
	}
	handle_path /unfurl/* {
		reverse_proxy unfurl-service:8080
	}
	handle_path /image-proxy/* {
		reverse_proxy image-proxy-service:8080
	}
	handle_path /agent-harness/* {
		reverse_proxy agent-harness-service:8080
	}
	# --- end generated service routes ---------------------------------------

	# Non-inventory services: their own ports, so they can't be generated.
	@websocket path /websocket /websocket/*
	handle @websocket {
		uri strip_prefix /websocket
		reverse_proxy websocket-service:6969
	}
	@sync path /sync /sync/*
	handle @sync {
		uri strip_prefix /sync
		reverse_proxy sync-service:8787
	}
	handle_path /lexical/* {
		reverse_proxy lexical-service:8096
	}
	handle_path /ai-editing/* {
		reverse_proxy ai-editing-worker:8933
	}
	# Telemetry proxy. Only reachable when the `analytics` profile is up; the
	# app degrades silently when it isn't. The worker routes on the /i/ prefix
	# itself, so no strip.
	handle /i/* {
		reverse_proxy analytics-proxy:8098 {
			header_up CF-Connecting-IP {http.request.remote.host}
		}
	}

	# The CDN fan-out CloudFront serves in the hosted product: API and internal
	# paths to the service, everything else straight out of the bucket.
	route /static-file/* {
		uri strip_prefix /static-file
		@svc path /api/* /internal/*
		reverse_proxy @svc static-file-service:8080
		rewrite * /static-file-storage{uri}
		reverse_proxy localstack:4566
	}

	# The app bundle. Built with base `/app`, so the URL space maps onto the
	# dist root once the prefix is stripped; unknown paths fall back to
	# index.html for client-side routing.
	redir / "/app/?{query}" 302
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	respond "macro" 200
}

# FusionAuth's own pages. Only Google/GitHub SSO sends a browser here —
# passwordless email login never leaves the app origin. FusionAuth builds
# absolute URLs from the host it is reached on, so it gets its own name rather
# than a path prefix on the app origin.
{$FUSIONAUTH_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy fusionauth:9011
}

{$S3_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# Host header passes through unchanged, which is what makes the SigV4
	# presigned signature verify at the origin.
	reverse_proxy localstack:4566
}
