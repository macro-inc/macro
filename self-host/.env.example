# Macro self-host configuration.
#
# Copy to .env and fill in, or run `./macroctl generate-secrets` which writes
# a .env with every secret below filled with fresh random values.
#
# NOTE: docker compose passes this file to containers verbatim — values are
# NOT expanded, so ${VAR} references do not work here. Every value must be
# literal. macroctl substitutes your domain and secrets when it generates it.

# ============================================================================
# 1. Deployment identity — the only section you must edit by hand.
# ============================================================================

# The hostname the app is served from. One origin for the UI and every API.
MACRO_DOMAIN=macro.example.com
# Object storage. Presigned URLs are signed for this host, so it must be a
# real DNS name pointing at this machine (a CNAME to MACRO_DOMAIN is fine).
S3_DOMAIN=s3.macro.example.com
# FusionAuth's own pages. Only used by Google/GitHub SSO, which redirect the
# browser to it. Passwordless email login never touches this host.
FUSIONAUTH_DOMAIN=auth.macro.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=admin@example.com
# Image tag to run. Pin to a release for production; `latest` tracks main.
MACRO_VERSION=latest

# Published ports. Change only if something else on the host owns 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# `local` is correct for a self-hosted stack: it selects the code paths that
# read the OVERRIDE_* service URLs below and skip CloudFront request signing.
# It does not mean 'development' — it means 'not Macro's own cloud'.
ENVIRONMENT=local
PORT=8080

# Browser-facing app root. Post-login redirects, invite links and agent tool
# responses are built on this.
APP_BASE_URL=https://macro.example.com/app
PIPEDREAM_ALLOWED_ORIGINS=https://macro.example.com
# Read by the few link builders that still compose a host:port URL. Set to the
# public HTTPS port so any such link lands on this deployment.
FRONTEND_PORT=443

# ============================================================================
# 2. Secrets. `macroctl generate-secrets` fills every REPLACE_ME below.
#    Never ship the defaults — the local dev stack's fixed values are public.
# ============================================================================

POSTGRES_USER=macro
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=macrodb
FUSIONAUTH_DB_USER=postgres
FUSIONAUTH_DB_PASSWORD=REPLACE_ME

# Service-to-service auth. Every service and worker must agree on these.
INTERNAL_API_SECRET_KEY=REPLACE_ME
INTERNAL_API_KEY=REPLACE_ME
INTERNAL_AUTH_KEY=REPLACE_ME
AUTHENTICATION_SERVICE_SECRET_KEY=REPLACE_ME
SYNC_SERVICE_AUTH_KEY=REPLACE_ME
SERVICE_INTERNAL_AUTH_KEY=REPLACE_ME
DOCUMENT_STORAGE_SERVICE_AUTH_KEY=REPLACE_ME
DOCUMENT_PERMISSION_JWT=REPLACE_ME
INTERNAL_CALL_SECRET=REPLACE_ME
URL_SIGNING_HMAC=REPLACE_ME

# Session JWTs. Rotating this signs every user out.
JWT_SECRET_KEY=REPLACE_ME

# FusionAuth identity. These must match the kickstart macroctl renders, so
# change them only by regenerating both (`macroctl generate-secrets`).
FUSIONAUTH_API_KEY=REPLACE_ME
FUSIONAUTH_API_KEY_SECRET_KEY=REPLACE_ME
FUSIONAUTH_CLIENT_ID=REPLACE_ME_UUID
FUSIONAUTH_CLIENT_SECRET_KEY=REPLACE_ME
FUSIONAUTH_TENANT_ID=REPLACE_ME_UUID
FUSIONAUTH_JWT_SIGNING_KEY_ID=REPLACE_ME_UUID
FUSIONAUTH_PASSWORDLESS_TEMPLATE_ID=REPLACE_ME_UUID
AUDIENCE=REPLACE_ME_UUID
ISSUER=macro.example.com
# Internal FusionAuth object ids. Stable identifiers, not secrets — they only
# need to stay the same across restarts of this deployment.
POPULATE_JWT_LAMBDA_ID=a7f3e8d2-4b91-4c5a-9e6f-1a2b3c4d5e6f
RECONCILE_LAMBDA_ID=66666666-6666-4666-8666-666666666666
GOOGLE_IDP_ID=44444444-4444-4444-8444-444444444444
GOOGLE_GMAIL_IDP_ID=55555555-5555-4555-8555-555555555555

# The FusionAuth admin console account (https://auth.<your domain>). Used to
# administer identity, not to sign in to Macro.
ADMIN_EMAIL=admin@macro.example.com
ADMIN_PASSWORD=REPLACE_ME

# Encrypts stored MCP credentials. Base64 of exactly 32 random bytes.
MCP_CREDENTIALS_KEY_SECRET_NAME=REPLACE_ME_BASE64_32

# ============================================================================
# 3. Infrastructure endpoints — in-network, no need to change.
# ============================================================================

DATABASE_URL=postgres://macro:REPLACE_ME@postgres:5432/macrodb
DATABASE_URL_READONLY=postgres://macro:REPLACE_ME@postgres:5432/macrodb
MACRO_DB_URL=postgres://macro:REPLACE_ME@postgres:5432/macrodb
REDIS_URI=redis://redis:6379
REDIS_HOST=redis://redis:6379
DOCUMENT_STORAGE_SERVICE_REDIS_URI=redis://redis:6379
LAST_ONLINE_REDIS_URI=redis://redis:6379
OPENSEARCH_URL=http://search:9200
OPENSEARCH_USERNAME=macro
OPENSEARCH_PASSWORD=REPLACE_ME
KAFKA_BROKERS=kafka:29092

# Auth service's own public origin (OAuth callbacks, verification links).
BASE_URL=https://macro.example.com/auth
FUSIONAUTH_BASE_URL=http://fusionauth:9011
FUSIONAUTH_PUBLIC_URL=https://auth.macro.example.com
FUSIONAUTH_OAUTH_REDIRECT_URI=https://macro.example.com/auth/oauth/redirect
MCP_PUBLIC_URL=https://macro.example.com/cognition

# In-network service addresses. Without these, services fall back to
# localhost defaults that resolve to the calling container itself.
OVERRIDE_CONNECTION_GATEWAY_URL=http://connection-gateway:8080
OVERRIDE_DOCUMENT_STORAGE_SERVICE_URL=http://document-storage-service:8080
OVERRIDE_LEXICAL_SERVICE_URL=http://lexical-service:8096
OVERRIDE_EMAIL_SERVICE_URL=http://email-service:8080
OVERRIDE_AUTH_SERVICE_URL=http://authentication-service:8080

# ============================================================================
# 4. Object storage, queues and tables.
#    LocalStack backs S3, SQS, DynamoDB and KMS. See README.md — this is the
#    part of the stack to replace first if you have managed equivalents.
# ============================================================================

LOCAL_AWS_URL=http://localstack:4566
# Public S3 endpoint used to sign and serve object URLs. Must match S3_DOMAIN
# or presigned links will fail signature verification in the browser.
S3_ENDPOINT_URL=https://s3.macro.example.com
AWS_ACCESS_KEY_ID=macro-selfhost
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
CURSOR_API_KEY_KMS_KEY_ID=alias/macro-selfhost-cursor-api-key

# --- buckets (generated from the resource catalog) ---
ATTACHMENT_BUCKET=macro-email-attachments
DOCUMENT_STORAGE_BUCKET=doc-storage
DOCX_DOCUMENT_UPLOAD_BUCKET=docx-upload
STATIC_STORAGE_BUCKET=static-file-storage
UPLOAD_STAGING_BUCKET=bulk-upload-staging
CALL_RECORDING_BUCKET_NAME=macro-call-recording-local

# --- tables (generated from the resource catalog) ---
BULK_UPLOAD_REQUESTS_TABLE=bulk-upload
CONNECTION_GATEWAY_TABLE=connection-gateway-table
STATIC_FILE_SERVICE_DYNAMODB_TABLE_NAME=static-file-metadata
# Created on demand by search_processing_service, so it is named but not provisioned.
BACKFILL_JOBS_TABLE=search-processing-backfill-jobs

# --- queues (generated from the resource catalog) ---
NOTIFICATION_QUEUE=http://localstack:4566/000000000000/notification-queue
NOTIFICATION_INGRESS_QUEUE=http://localstack:4566/000000000000/notification-ingress-queue
PUSH_NOTIFICATION_EVENT_HANDLER_QUEUE=push-delivery-queue
OVERRIDE_WEBHOOK_EVENT_QUEUE=http://localstack:4566/000000000000/webhook-event-queue.fifo
BACKFILL_QUEUE=email-service-backfill-queue
EMAIL_BACKFILL_QUEUE=http://localstack:4566/000000000000/email-service-backfill-queue
OVERRIDE_EMAIL_CRM_CLEANUP_QUEUE=http://localstack:4566/000000000000/email-service-crm-cleanup-queue
CHAT_DELETE_QUEUE=delete-chat-handler-queue
CONTACTS_QUEUE=contacts-queue
CONVERT_QUEUE=convert-service-queue
DOCUMENT_DELETE_QUEUE=delete-document-handler-queue
DOCUMENT_UPLOAD_FINALIZER_QUEUE_URL=http://localstack:4566/000000000000/document-upload-finalizer-queue
DOCUMENT_TEXT_EXTRACTOR_QUEUE=document-text-extractor-lambda-queue
EMAIL_SCHEDULED_QUEUE=email-service-scheduled-queue
GMAIL_INBOX_SYNC_QUEUE=email-service-gmail-inbox-sync-queue
GMAIL_INBOX_SYNC_RETRY_QUEUE=email-service-gmail-inbox-retry-queue
GMAIL_OPS_QUEUE=email-service-gmail-ops-queue
GMAIL_OPS_RETRY_QUEUE=email-service-gmail-ops-retry-queue
LINK_MANAGER_QUEUE=email-service-refresh-queue
SEARCH_EVENT_QUEUE=search-event-queue
AI_PROJECTION_QUEUE=http://localstack:4566/000000000000/ai-projection-queue
SFS_DELETE_QUEUE=email-sfs-delete-queue
SFS_UPLOADER_QUEUE=email-service-sfs-mapper-queue
STATIC_FILE_SERVICE_S3_EVENT_QUEUE_URL=http://localstack:4566/000000000000/static-file-s3-event-notification-queue
OVERRIDE_REMINDER_DISPATCH_QUEUE=http://localstack:4566/000000000000/reminder-dispatch-queue
OVERRIDE_CALENDAR_REMINDER_DISPATCH_QUEUE=http://localstack:4566/000000000000/calendar-reminder-dispatch-queue

# ============================================================================
# 5. Mail. Required: FusionAuth emails login codes here, and notification
#    digests are sent through it. Any SMTP relay works.
# ============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# NONE, SSL or TLS. Derived from SMTP_PORT when left blank (465 -> SSL).
SMTP_SECURITY=TLS
SMTP_USERNAME=
SMTP_PASSWORD=
# From-address domain for outbound mail.
SENDER_BASE_ADDRESS=macro.example.com
MAIL_FROM=noreply@macro.example.com

# ============================================================================
# 6. Optional integrations. Every value below is a placeholder that only
#    satisfies a config loader at boot — the feature it backs stays off until
#    you supply real credentials. Nothing here blocks a working install.
# ============================================================================

# Google (SSO + Gmail sync). Real Gmail at any scale also needs Google's
# restricted-scope security assessment for your own OAuth app.
GOOGLE_CLIENT_ID=unset-google-client
GOOGLE_CLIENT_SECRET_KEY=unset-google-client-secret

# GitHub (SSO + PR linking).
GITHUB_CLIENT_ID=unset-github-client
GITHUB_CLIENT_SECRET=unset-github-client-secret
GITHUB_IDP_ID=99999999-9999-4999-8999-999999999999
GITHUB_SYNC_APP_URL=https://macro.example.com
GITHUB_SYNC_APP_CLIENT_ID=unset-github-sync-client
GITHUB_SYNC_APP_CLIENT_SECRET=unset-github-sync-secret
GITHUB_INSTALLATION_STATE_SECRET=unset-github-installation-state
GITHUB_WEBHOOK_SECRET_KEY=unset-github-webhook-secret
GITHUB_SYNC_APP_PEM_SECRET_KEY=unset-github-sync-pem

# AI providers. Agents, chat and document cognition need at least one real key.
ANTHROPIC_API_KEY=unset-anthropic-key
OPENAI_API_KEY=unset-openai-key
COHERE_API_KEY=unset-cohere-key

# Calls (LiveKit). Self-host LiveKit or use LiveKit Cloud.
LIVEKIT_SERVER_URL=http://livekit:7880
LIVEKIT_API_KEY=unset-livekit-key
LIVEKIT_API_SECRET=unset-livekit-secret

# Billing. Not needed for a self-hosted install; the signup hook detects the
# placeholder and stores a local customer id instead of calling Stripe.
STRIPE_SECRET_KEY=unset-stripe-secret
STRIPE_PRICE_ID=unset-stripe-price
STRIPE_WEBHOOK_SECRET_KEY=unset-stripe-webhook-secret

# CDN signing. Unused here: objects are served through Caddy, not CloudFront.
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_DISTRIBUTION_URL=https://macro.example.com/static-file
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PUBLIC_KEY_ID=unset-cloudfront-signer
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY=unset
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY_SECRET_NAME=unset-cloudfront-signer-private-key
EMAIL_SERVICE_CLOUDFRONT_DISTRIBUTION_URL=https://macro.example.com/static-file
EMAIL_SERVICE_CLOUDFRONT_SIGNER_PUBLIC_KEY_ID=unset-cloudfront-signer
EMAIL_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY=unset

# Macro API tokens (the SDK/MCP token format). Only parsed when such a token
# is presented; browser sessions use FusionAuth JWTs.
MACRO_API_TOKEN_ISSUER=macro.example.com
MACRO_API_TOKEN_PUBLIC_KEY=unset-macro-api-token-public-key
MACRO_API_TOKEN_PRIVATE_SECRET_KEY=unset-macro-api-token-private-key
MACRO_API_TOKEN_EXPIRY_SECONDS=3600

# Mobile push. Requires an AWS SNS account; push is inert without it.
APPLE_BUNDLE_ID=com.macro.selfhost
SNS_APNS_PLATFORM_ARN=arn:aws:sns:us-east-1:000000000000:app/APNS/macro-selfhost
SNS_FCM_PLATFORM_ARN=arn:aws:sns:us-east-1:000000000000:app/GCM/macro-selfhost

# Remaining loader-required placeholders. Leave as-is unless you use them.
GMAIL_GCP_QUEUE=gmail-gcp-queue-selfhost
APOLLO_API_KEY=unset
SLACK_MCP_CLIENT_ID=unset-slack-mcp-client
SLACK_MCP_CLIENT_SECRET=unset-slack-mcp-secret
CAL_WEBHOOK_SECRET_KEY=unset-cal-webhook-secret
CAL_EVENT_TYPE_CONTENT_NAMES_KEY={"1":{"content_name":"selfhost","value":0}}
META_PIXEL_ID=unset-meta-pixel
META_ACCESS_TOKEN=unset-meta-access-token

# ============================================================================
# 7. Agents. The harness runs sandboxed coding agents as sibling containers
#    on this host's Docker daemon, which is root-equivalent access to the
#    host. It only starts under `macroctl up --profile agents`.
# ============================================================================

HARNESS_BOT_ID=00000000-0000-0000-0000-00000000a9e7
DEV_DANGEROUS_LOCAL_CONTAINERS=true
LOCAL_CONTAINER_IMAGE=macro-agent-harness:latest
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=macro-agent-harness
EGRESS_BASE_URL=http://agent-harness-service:8102
# Compose network sandboxes join. `<project>_services`; the project is fixed to
# macro-selfhost by docker-compose.yml.
LOCAL_CONTAINER_NETWORK=macro-selfhost_services
MACRO_MCP_URL=http://mcp-service:8080/mcp

# ============================================================================
# 8. Feature flags.
# ============================================================================

CALENDAR_SYNC_ENABLED=true
CALENDAR_SCOPE_ENABLED=true
CALENDAR_SEARCH_ENABLED=true
