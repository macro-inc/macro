lambda_name := file_name(justfile_directory())
DATABASE_URL := "postgres://user:password@localhost:5432/macrodb"

mod sqlx '../sqlx.just'

prepare_db:
    just sqlx::prepare_db {{ DATABASE_URL }}

test:
    cargo test --all-features

build:
    SQLX_OFFLINE=true cargo lambda build --release --bin {{lambda_name}} --output-format zip