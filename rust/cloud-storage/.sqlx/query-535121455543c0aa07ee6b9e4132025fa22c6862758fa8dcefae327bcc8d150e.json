{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                ct.id,\n                ct.company_id,\n                ct.email,\n                ct.name,\n                ct.first_interaction,\n                ct.last_interaction,\n                ct.created_at,\n                ct.updated_at\n            FROM crm_contacts ct\n            JOIN crm_companies co ON co.id = ct.company_id\n            WHERE ct.id = $1\n              AND co.team_id = $2\n              AND ct.hidden = FALSE\n              AND co.hidden = FALSE\n            ",
