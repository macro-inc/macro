{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            cp.role as \"role?: ParticipantRole\",\n            c.channel_type as \"channel_type!: ChannelType\",\n            c.org_id\n        FROM comms_channels c\n        LEFT JOIN comms_channel_participants cp\n            ON cp.channel_id = c.id AND cp.user_id = $2 AND cp.left_at IS NULL\n        WHERE c.id = $1\n        ",
