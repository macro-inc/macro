load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "graphql_soup_filter_input",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "server",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_soup_filter_input"},
    deps = [
        "//crates/document_sub_type:document_sub_type",
        "//crates/filter_ast:filter_ast",
        "//crates/graphql_common:graphql_common",
        "//crates/item_filters:item_filters",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model_file_type:model_file_type",
        "//crates/model_owner:model_owner",
        "//crates/notification_state:notification_state",
        "@crates//:async-graphql-7.2.1",
        "@crates//:chrono-0.4.45",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "graphql_soup_filter_input_unit",
    crate = ":graphql_soup_filter_input",
    crate_features = [
        "default",
        "server",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_soup_filter_input"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_soup_filter_input"},
)

