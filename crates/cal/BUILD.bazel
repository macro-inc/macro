load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "cal",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "all",
        "axum",
        "outbound",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/cal"},
    deps = [
        "//crates/analytics_client:analytics_client",
        "//crates/model-error-response:model_error_response",
        "@crates//:axum-0.8.9",
        "@crates//:chrono-0.4.45",
        "@crates//:hex-0.4.3",
        "@crates//:hmac-0.12.1",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "cal_unit",
    crate = ":cal",
    crate_features = [
        "all",
        "axum",
        "outbound",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/cal"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/cal"},
)

