load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "genai_telemetry",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/genai_telemetry"},
    deps = [
        "//crates/macro_env_var:macro_env_var",
        "@crates//:opentelemetry-0.31.0",
        "@crates//:serde_json-1.0.150",
        "@crates//:tracing-0.1.44",
        "@crates//:tracing-opentelemetry-0.32.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "genai_telemetry_unit",
    crate = ":genai_telemetry",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/genai_telemetry"},
    deps = [
        "@crates//:opentelemetry_sdk-0.31.0",
        "@crates//:tracing-subscriber-0.3.23",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/genai_telemetry"},
)

