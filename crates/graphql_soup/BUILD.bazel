load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "graphql_soup",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_soup"},
    deps = [
        "//crates/document_sub_type:document_sub_type",
        "//crates/email:email",
        "//crates/entity_access:entity_access",
        "//crates/filter_ast:filter_ast",
        "//crates/graphql_common:graphql_common",
        "//crates/graphql_email:graphql_email",
        "//crates/graphql_permission:graphql_permission",
        "//crates/graphql_soup_filter_input:graphql_soup_filter_input",
        "//crates/item_filters:item_filters",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-entity:model_entity",
        "//crates/model_file_type:model_file_type",
        "//crates/models_grouping:models_grouping",
        "//crates/models_pagination:models_pagination",
        "//crates/models_soup:models_soup",
        "//crates/predicate_index:predicate_index",
        "//crates/soup:soup",
        "//crates/soup_filter_projection:soup_filter_projection",
        "//crates/soup_realtime:soup_realtime",
        "@crates//:anyhow-1.0.103",
        "@crates//:async-graphql-7.2.1",
        "@crates//:async-stream-0.3.6",
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:chrono-0.4.45",
        "@crates//:futures-0.3.32",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "graphql_soup_unit",
    crate = ":graphql_soup",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_soup"},
    deps = [
        "//crates/model_owner:model_owner",
        "//crates/models_properties:models_properties",
        "@crates//:either-1.16.0",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_soup"},
)

