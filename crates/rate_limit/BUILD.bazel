load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "rate_limit",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "axum",
        "testing",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/rate_limit"},
    deps = [
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:hex-0.4.3",
        "@crates//:redis-1.2.1",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:twox-hash-2.1.2",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "rate_limit_unit",
    crate = ":rate_limit",
    crate_features = [
        "axum",
        "testing",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/rate_limit"},
    deps = [
        "@crates//:tokio-1.54.1",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/rate_limit"},
)

