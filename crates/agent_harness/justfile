# Build `container/` as a local Docker tag so `just run_local` (which sets
# DEV_DANGEROUS_LOCAL_CONTAINERS) can spawn sandboxes from our image, not a
# stock one. `run_local` / `stack up` already `docker build` the tag with no
# `--platform` (BuildKit cache no-ops when `container/` is unchanged); this
# recipe is the same unpinned build, so Apple Silicon / ARM Linux bake native
# `aarch64-linux`.
#
# The recipe skips the build when the image already exists, which is wrong
# whenever `container/` has changed - a stale image is reused silently and the
# failure shows up much later, inside the sandbox. Use `build-local --force`
# after touching the Dockerfile or the sidecar.
set dotenv-load := true

# The local Docker tag.
image_name := env_var_or_default("AGENT_HARNESS_IMAGE", "macro-agent-harness")

# List recipes; first so a bare `just` cannot start an image build
default:
    @just --list

# Build the image for the local Docker provider if missing
build-local force="":
    #!/usr/bin/env bash
    set -euo pipefail
    # Slow on a cold build: the image bakes two nix dev shells.
    tag={{image_name}}:latest
    if [ -z "{{force}}" ] && docker image inspect "$tag" >/dev/null 2>&1; then
      echo "image $tag already exists, skipping build (pass --force to rebuild)"
      exit 0
    fi
    echo "building $tag (native platform; flake has x86_64-linux and aarch64-linux)"
    docker build --tag "$tag" container
