load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "agent_preview",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_preview", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/ai_toolset:ai_toolset",
        "//crates/entity_access:entity_access",
        "//crates/folds/agent_fold:agent_fold",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_tower_layers:macro_tower_layers",
        "//crates/macro_user_id:macro_user_id",
        "@crates//:axum-0.8.9",
        "@crates//:base64-0.22.1",
        "@crates//:bytes-1.11.1",
        "@crates//:chrono-0.4.45",
        "@crates//:http-body-util-0.1.3",
        "@crates//:hyper-1.9.0",
        "@crates//:hyper-util-0.1.20",
        "@crates//:rand-0.9.4",
        "@crates//:rmcp-1.7.0",
        "@crates//:rootcause-0.12.1",
        "@crates//:russh-0.63.3",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:sqlx-0.8.6",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "agent_preview_unit",
    crate = ":agent_preview",
    crate_features = [],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_preview", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "@crates//:futures-util-0.3.32",
        "@crates//:tempfile-3.27.0",
        "@crates//:tokio-tungstenite-0.28.0",
        "@crates//:tower-0.5.3",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_preview"},
)

