load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "docx_engine",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
        "default",
        "embedded-fonts",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/pptx_engine:all_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/docx_engine"},
    deps = [
        "//crates/pptx_engine:pptx_engine",
        "@crates//:base64-0.22.1",
        "@crates//:clap-4.6.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "docx_engine_unit",
    crate = ":docx_engine",
    crate_features = [
        "cli",
        "default",
        "embedded-fonts",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/docx_engine"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/pptx_engine:all_files"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/docx_engine"},
)

rust_binary(
    name = "docx_corpus_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "docx_corpus",
    crate_root = "src/bin/docx_corpus/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
        "default",
        "embedded-fonts",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/pptx_engine:all_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/docx_engine"},
    deps = [
        "//crates/pptx_engine:pptx_engine",
        ":docx_engine",
        "@crates//:base64-0.22.1",
        "@crates//:clap-4.6.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "upgraded_legacy_itest",
    srcs = depset(["tests/upgraded_legacy.rs"] + glob(["tests/**/*.rs"])).to_list(),
    crate_name = "upgraded_legacy",
    crate_root = "tests/upgraded_legacy.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
        "default",
        "embedded-fonts",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/pptx_engine:all_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/docx_engine"},
    deps = [
        "//crates/pptx_engine:pptx_engine",
        ":docx_engine",
        "@crates//:base64-0.22.1",
        "@crates//:clap-4.6.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/pptx_engine:all_files"] + [],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/docx_engine"},
)

