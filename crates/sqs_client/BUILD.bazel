load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "sqs_client",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_projection",
        "chat",
        "chrono",
        "convert",
        "default",
        "document",
        "document_text_extractor",
        "email",
        "futures",
        "gmail",
        "model",
        "models_email",
        "organization_retention",
        "search",
        "sfs_delete",
        "sfs_uploader",
        "upload_extractor",
        "uuid",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/sqs_client"},
    deps = [
        "//crates/email:email",
        "//crates/model:model",
        "//crates/models_ai_projection:models_ai_projection",
        "//crates/models_email:models_email",
        "//crates/s3_key:s3_key",
        "@crates//:anyhow-1.0.103",
        "@crates//:aws-sdk-sqs-1.99.0",
        "@crates//:chrono-0.4.45",
        "@crates//:futures-0.3.32",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:strum-0.27.2",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "sqs_client_unit",
    crate = ":sqs_client",
    crate_features = [
        "ai_projection",
        "chat",
        "chrono",
        "convert",
        "default",
        "document",
        "document_text_extractor",
        "email",
        "futures",
        "gmail",
        "model",
        "models_email",
        "organization_retention",
        "search",
        "sfs_delete",
        "sfs_uploader",
        "upload_extractor",
        "uuid",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/sqs_client"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/sqs_client"},
)

