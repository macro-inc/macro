    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/comms_db_client", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/channels:channels",
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "//crates/model:model",
        "@crates//:anyhow-1.0.103",
        "@crates//:cached-0.54.0",
        "@crates//:chrono-0.4.45",
        "@crates//:doppleganger-0.5.0",
        "@crates//:futures-0.3.32",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:strum-0.27.2",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

