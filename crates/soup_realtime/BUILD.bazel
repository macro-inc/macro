load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "soup_realtime",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "consumer",
        "default",
        "outbound",
        "ports",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_realtime"},
    deps = [
        "//crates/agent_session:agent_session",
        "//crates/broadcast:broadcast",
        "//crates/call:call",
        "//crates/channels:channels",
        "//crates/chat:chat",
        "//crates/documents:documents",
        "//crates/email:email",
        "//crates/entity_access:entity_access",
        "//crates/github_pull_requests:github_pull_requests",
        "//crates/initiative:initiative",
        "//crates/kafka_util:kafka_util",
        "//crates/macro_event_broker:macro_event_broker",
        "//crates/macro_event_topics:macro_event_topics",
        "//crates/macro_user_id:macro_user_id",
        "//crates/messages:messages",
        "//crates/model-entity:model_entity",
        "//crates/model_owner:model_owner",
        "//crates/models_properties:models_properties",
        "//crates/projects:projects",
        "//crates/properties:properties",
        "//crates/system_properties:system_properties",
        "@crates//:futures-0.3.32",
        "@crates//:rdkafka-0.37.0",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-retry-0.3.2",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "soup_realtime_unit",
    crate = ":soup_realtime",
    crate_features = [
        "consumer",
        "default",
        "outbound",
        "ports",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_realtime"},
    deps = [
        "@crates//:chrono-0.4.45",
        "@crates//:serde_json-1.0.150",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_realtime"},
)

