load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "dynamic_ui",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/dynamic_ui"},
    deps = [
        "@crates//:lazy-regex-3.6.1",
        "@crates//:nutype-0.8.0",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:serde_path_to_error-0.1.20",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:specta-serde-0.0.12",
        "@crates//:specta-typescript-0.0.12",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "dynamic_ui_unit",
    crate = ":dynamic_ui",
    crate_features = [
        "cli",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/dynamic_ui"},
    deps = [
        "@crates//:insta-1.48.0",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/dynamic_ui"},
)

rust_binary(
    name = "export_view_types_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "export_view_types",
    crate_root = "src/bin/export_view_types.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/dynamic_ui"},
    deps = [
        ":dynamic_ui",
        "@crates//:lazy-regex-3.6.1",
        "@crates//:nutype-0.8.0",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:serde_path_to_error-0.1.20",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:specta-serde-0.0.12",
        "@crates//:specta-typescript-0.0.12",
    ],
    proc_macro_deps = [],
    aliases = {},
)

