---
source: crates/dynamic_ui/src/test.rs
expression: schema
---
{
  "$defs": {
    "AgendaEvent": {
      "description": "A calendar event an agenda lists.",
      "properties": {
        "eventId": {
          "description": "The eventId a calendar tool such as ListCalendarEvents returned.",
          "type": "string"
        },
        "occurrenceKey": {
          "description": "One instance of a recurring event: that instance's recurrenceId from\nListCalendarEvents.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "eventId"
      ],
      "type": "object"
    },
    "AgentSessionRef": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "AgentUpdateItem": {
      "description": "One item of macro.agentSessions.updates(); its other fields are ignored.",
      "properties": {
        "harness": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AgentUpdateKind"
        },
        "session": {
          "$ref": "#/$defs/AgentSessionRef"
        },
        "sessionName": {
          "type": "string"
        },
        "since": {
          "type": "string"
        }
      },
      "required": [
        "session",
        "sessionName",
        "harness",
        "kind",
        "since"
      ],
      "type": "object"
    },
    "AgentUpdateKind": {
      "enum": [
        "permission",
        "elicitation",
        "tool_approval",
        "stalled"
      ],
      "type": "string"
    },
    "Align": {
      "description": "How a container aligns its children across its axis.",
      "enum": [
        "start",
        "center",
        "end",
        "stretch"
      ],
      "type": "string"
    },
    "CallStatus": {
      "description": "Whether a call was attended.",
      "enum": [
        "ATTENDED",
        "MISSED",
        "UNATTENDED"
      ],
      "type": "string"
    },
    "CardItem": {
      "description": "A workspace item a card shows.",
      "properties": {
        "id": {
          "description": "The item's id exactly as a tool returned it: a document id (documents\nand spreadsheets), an email thread id, a calendar eventId, or a\nproject, channel, routine, form or initiative id.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/CardItemType"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "CardItemType": {
      "description": "The kinds of workspace item a card shows.",
      "enum": [
        "document",
        "email_thread",
        "calendar_event",
        "project",
        "channel",
        "routine",
        "form",
        "initiative"
      ],
      "type": "string"
    },
    "DateRangeFilter": {
      "description": "Bounds on a timestamp, as ISO 8601 strings.",
      "properties": {
        "gt": {
          "type": [
            "string",
            "null"
          ]
        },
        "gte": {
          "type": [
            "string",
            "null"
          ]
        },
        "lt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lte": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Direction": {
      "description": "The axis a container lays its children along.",
      "enum": [
        "row",
        "col"
      ],
      "type": "string"
    },
    "DocumentFieldFilters": {
      "description": "The filters that apply to documents.",
      "properties": {
        "documentCreatedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ]
        },
        "documentDone": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "documentId": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "documentImportance": {
          "description": "For tasks, whether the current user is an assignee.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "documentOwnerId": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "documentSeen": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "documentUpdatedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ]
        },
