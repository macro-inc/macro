          "type": [
            "array",
            "null"
          ]
        },
        "color": {
          "description": "One of the tag colours: red, tomato, orange, amber, yellow, green,\nteal, blue, indigo, purple, pink, gray. Gray when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "What the tag is for, in a few words.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "The tag's name. Name a narrower tag on its own: \"bug\" under \"Type\",\nnot \"Type/bug\".",
          "type": "string"
        },
        "tagId": {
          "description": "For a tag that exists, the id ListTags or CreateTag returned: the tag\nthen shows its current name and colour, and opens what is tagged with\nit.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "TimelineEvent": {
      "description": "One event of a timeline.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Links the event to a workspace entity."
        },
        "future": {
          "description": "true = upcoming/future event, rendered gray; omitted/false = past,\nrendered accent.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "time": {
          "description": "Human-readable timestamp, e.g. \"9:32am\" or \"Yesterday\".",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "time",
        "title"
      ],
      "type": "object"
    },
    "View": {
      "description": "A top-level composed view: a flex column of widgets.",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "widgets": {
          "items": {
            "$ref": "#/$defs/Widget"
          },
          "type": "array"
        }
      },
      "required": [
        "widgets"
      ],
      "type": "object"
    },
    "WakeStatusFilter": {
      "description": "The wakes a wakes widget shows, by where they stand.",
      "oneOf": [
        {
          "enum": [
            "ok",
            "failed",
            "timeout",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "const": "running",
          "description": "Still running.",
          "type": "string"
        }
      ]
    },
    "Widget": {
      "description": "One block of a view. Layout is order-driven; nesting is achieved with the\n`container` widget.",
      "oneOf": [
        {
          "description": "Markdown text: the narrative between the other widgets. Its type is\n\"md\", never \"markdown\".",
          "properties": {
            "markdown": {
              "type": "string"
            },
            "type": {
              "const": "md",
              "type": "string"
            }
          },
          "required": [
            "type",
            "markdown"
          ],
          "type": "object"
        },
        {
          "description": "A chronological sequence of events. Great for \"what happened\" answers.",
          "properties": {
            "events": {
              "items": {
                "$ref": "#/$defs/TimelineEvent"
              },
              "type": "array"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "timeline",
              "type": "string"
            }
          },
          "required": [
            "type",
            "events"
          ],
          "type": "object"
        },
        {
          "description": "A list of workspace items, fetched by a filter query or given as a\nfixed set of entity references.",
          "properties": {
            "groupBy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GroupBy"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Group rows by a facet."
            },
            "limit": {
              "description": "Cap the number of rows shown.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/ListSource"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ],
          "type": "object"
        },
        {
          "description": "A single channel message with surrounding context.",
          "properties": {
            "channelId": {
              "description": "The channel the message belongs to.",
              "type": "string"
            },
            "messageId": {
              "description": "The message to render.",
              "type": "string"
            },
            "type": {
              "const": "channelMessage",
              "type": "string"
            }
          },
          "required": [
            "type",
            "channelId",
            "messageId"
          ],
          "type": "object"
        },
        {
          "description": "A calendar agenda: the events grouped by day with their times, places\nand attendees, loaded live from the user's calendars. Use it whenever\nan answer is about calendar events instead of listing them in text.",
          "properties": {
            "events": {
              "items": {
                "$ref": "#/$defs/AgendaEvent"
              },
              "type": "array"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "events",
              "type": "string"
            }
          },
          "required": [
            "type",
            "events"
          ],
          "type": "object"
        },
        {
          "description": "Rich cards for the one to four specific items the answer is about: a\ndocument or spreadsheet, an email thread, a calendar event, a project,\na channel, a routine, a form or an initiative. Each card opens its\nitem, and a routine's card can pause it or run it now. Use a list\nwidget for longer sets.",
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/CardItem"
              },
              "type": "array"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "cards",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        },
        {
          "description": "Tags as coloured pills, nested to any depth: the user's tags, a\ntaxonomy the answer proposes, or any other ontology of tags, each with\nwhat it is for. Use it whenever an answer is about tags, instead of a\ntable or a list in markdown.",
          "properties": {
            "tags": {
              "items": {
                "$ref": "#/$defs/TagNode"
              },
              "type": "array"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "tags",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tags"
          ],
          "type": "object"
        },
        {
          "description": "Live cards on which the user answers coding agents' waiting\npermission requests and questions, and sees stalled sessions. Pass the\nitems macro.agentSessions.updates() returned, unchanged, whenever it\nreturns any: these cards are the only place the user can answer them.",
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/AgentUpdateItem"
              },
              "type": "array"
            },
            "type": {
              "const": "agentUpdates",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        },
        {
          "description": "An agent account's wakes, newest first: what woke it, whether it is\nstill running, how long it took, what it cost when known, and what\ncame of it. Only the agent and the owners and admins of its teams can\nread them; others see that they have no access.",
          "properties": {
            "agentId": {
              "description": "The agent account's user id, e.g. what macro.me() returns for it.",
              "type": "string"
            },
            "limit": {
              "description": "Cap the number of rows shown. Defaults to 25.",
              "format": "uint32",
              "maximum": 100,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "status": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WakeStatusFilter"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only wakes in this status."
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "wakes",
              "type": "string"
            }
          },
          "required": [
            "type",
            "agentId"
          ],
          "type": "object"
        },
        {
          "description": "One wake's model session as a waterfall: its prompt, turns and tool\ncalls with their timing, tokens and results. Use the wake id a wakes\nwidget or the SDK's wake list shows.",
          "properties": {
            "agentId": {
              "description": "The agent account's user id.",
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "trace",
              "type": "string"
            },
            "wakeId": {
              "description": "The wake's id.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "agentId",
            "wakeId"
          ],
          "type": "object"
        },
        {
          "description": "A nestable flex container of widgets.",
          "properties": {
            "align": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Align"
                },
                {
                  "type": "null"
                }
              ]
            },
            "children": {
              "items": {
                "$ref": "#/$defs/Widget"
              },
              "type": "array"
            },
            "direction": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Direction"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gap": {
              "description": "Tailwind-ish gap step, 0-8. Defaults to 3.",
              "format": "uint8",
              "maximum": 8,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "justify": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Justify"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "container",
              "type": "string"
            },
            "wrap": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "children"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Inside ExecuteCode, `await execution.views.present(view)` presents the user a rich, interactive view (item cards, lists, timelines, calendar agendas, tags, channel messages) in the conversation, where `view` is the `view` property below. Nothing is saved and nothing comes back. Decide for yourself when to present something: the user will not ask. When a turn made, changed or sent something the user will want to open, end it by presenting that item. Present the smallest set that does the job: usually one to four cards for the items that matter, never every item a step touched. Leave out what you only read along the way, supporting or intermediate items, and items you already presented unless this turn changed them. Do not present a view when the answer is a sentence or two, or when nothing in the turn is worth opening. For questions about workspace data - summaries of tasks, documents or activity, lists of items, anything that would otherwise need a markdown table or a long list - the view is the answer. Typical triggers: \"what did I get done this week?\", \"what is a teammate working on?\", \"my open tasks\", \"summarize this project\", and \"what happened in this channel?\". Keep accompanying prose to a one-line lead-in that says what you did, and do not restate what the view shows. Never add a mention or link in your reply for an item the view shows: the view already opens it. Entity-backed widgets take real workspace entity ids obtained from other tools such as ListEntities or search; never invent ids. Prefer list sources with kind \"items\" and those entity references. To present calendar events, use an events widget with the eventIds a calendar tool returned: it renders an agenda loaded live from the calendar, so never restate the times in prose. Present one to four specific items - a document or spreadsheet, an email thread, an event, a routine - in a cards widget, and a longer set in a list widget. To present tags - the user's own, or a taxonomy or ontology of any depth - use a tags widget, never a table or a list in markdown. Nest narrower tags under the tags they belong to, and give a tag that exists the tagId a tag tool returned. In a direct message with the user, the view is posted with your reply. The view is checked against this schema before it is presented: a view that does not match throws with what to fix. Present it again rather than running the program again.",
  "properties": {
    "view": {
      "$ref": "#/$defs/View"
    }
  },
  "required": [
    "view"
  ],
  "title": "PresentView",
  "type": "object"
}
