          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "fileType": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "isEmailAttachment": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "projectId": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "subType": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DocumentFilterClause": {
      "description": "Documents to include and exclude.",
      "properties": {
        "exclude": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentFieldFilters"
            },
            {
              "type": "null"
            }
          ]
        },
        "include": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentFieldFilters"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "DocumentFilterCombination": {
      "description": "Document filter expressions combined.",
      "oneOf": [
        {
          "properties": {
            "clauses": {
              "items": {
                "$ref": "#/$defs/DocumentFilterExpression"
              },
              "type": "array"
            },
            "op": {
              "const": "and",
              "type": "string"
            }
          },
          "required": [
            "op",
            "clauses"
          ],
          "type": "object"
        },
        {
          "properties": {
            "clauses": {
              "items": {
                "$ref": "#/$defs/DocumentFilterExpression"
              },
              "type": "array"
            },
            "op": {
              "const": "or",
              "type": "string"
            }
          },
          "required": [
            "op",
            "clauses"
          ],
          "type": "object"
        },
        {
          "properties": {
            "clause": {
              "$ref": "#/$defs/DocumentFilterClause"
            },
            "op": {
              "const": "not",
              "type": "string"
            }
          },
          "required": [
            "op",
            "clause"
          ],
          "type": "object"
        }
      ]
    },
    "DocumentFilterExpression": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentFilterCombination"
        },
        {
          "$ref": "#/$defs/DocumentFilterClause"
        }
      ],
      "description": "A document filter: a clause, or clauses combined with `op`."
    },
    "DocumentWhere": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DocumentFilterExpression"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/DocumentFilterExpression"
        }
      ],
      "description": "Several document filter expressions that all apply, or one. Several comes\nfirst: serde reads a struct from an array too, so a clause would take one."
    },
    "EmailShared": {
      "description": "Which shared emails to match.",
      "enum": [
        "exclude",
        "include",
        "only"
      ],
      "type": "string"
    },
    "EmailView": {
      "description": "Which mailbox a query reads.",
      "enum": [
        "inbox",
        "drafts",
        "sent",
        "all"
      ],
      "type": "string"
    },
    "EntityRef": {
      "description": "A reference to a workspace item.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "type": "object"
    },
    "EntityType": {
      "description": "The kinds of workspace item a view can show.",
      "enum": [
        "user",
        "chat",
        "channel",
        "channel_message",
        "document",
        "project",
        "email_thread",
        "calendar_event",
        "team",
        "call",
        "foreign_entity",
        "static_file",
