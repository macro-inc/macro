        "crm_contact",
        "crm_pipeline",
        "reminder",
        "skill",
        "agent_session",
        "scheduled_action",
        "initiative",
        "database",
        "database_row",
        "form",
        "external_chat",
        "email",
        "routine",
        "channel_thread"
      ],
      "type": "string"
    },
