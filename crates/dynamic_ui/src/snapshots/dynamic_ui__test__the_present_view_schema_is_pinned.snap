        "all"
      ],
      "type": "string"
    },
    "TagNode": {
      "description": "One tag of an ontology and the narrower tags under it. A tag may exist\nalready, or be one the answer proposes.",
      "properties": {
        "children": {
          "description": "The narrower tags under this one.",
          "items": {
