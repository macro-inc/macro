load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "email_api_client",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "microsoft-gate",
        "outbound-gmail",
        "outbound-outlook",
        "ports",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/email_api_client", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/calendar_events:calendar_events",
        "//crates/email_utils:email_utils",
        "//crates/gmail_client:gmail_client",
        "//crates/models_email:models_email",
        "@crates//:base64-0.22.1",
        "@crates//:chrono-0.4.45",
        "@crates//:chrono-tz-0.10.4",
        "@crates//:encoding_rs-0.8.35",
        "@crates//:html-escape-0.2.13",
        "@crates//:http-1.4.0",
        "@crates//:httpdate-1.0.3",
        "@crates//:lol_html-2.9.0",
        "@crates//:mail-builder-0.4.4",
        "@crates//:mailparse-0.16.1",
        "@crates//:redis-1.2.1",
        "@crates//:reqwest-0.13.4",
        "@crates//:scraper-0.18.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "email_api_client_unit",
    crate = ":email_api_client",
    crate_features = [
        "default",
        "microsoft-gate",
        "outbound-gmail",
        "outbound-outlook",
        "ports",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/email_api_client", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "//crates/macro_event_broker:macro_event_broker",
        "@crates//:sqlx-0.8.6",
        "@crates//:tracing-subscriber-0.3.23",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/email_api_client"},
)

