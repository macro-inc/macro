load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "image_generation",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "axum",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/image_generation"},
    deps = [
        "//crates/ai_billing:ai_billing",
        "//crates/ai_toolset:ai_toolset",
        "//crates/ai_usage:ai_usage",
        "//crates/attachment:attachment",
        "//crates/bot_id:bot_id",
        "//crates/entity_registry/entity_registry:entity_registry",
        "//crates/lexical_client:lexical_client",
        "//crates/macro_authorization:macro_authorization",
        "//crates/model-entity:model_entity",
        "//crates/model:model",
        "//crates/model_owner:model_owner",
        "//crates/non_empty:non_empty",
        "//crates/static_file_service_client:static_file_service_client",
        "@crates//:anyhow-1.0.103",
        "@crates//:axum-0.8.9",
        "@crates//:base64-0.22.1",
        "@crates//:image-0.25.10",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "image_generation_unit",
    crate = ":image_generation",
    crate_features = [
        "axum",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/image_generation"},
    deps = [
        "//crates/macro_user_id:macro_user_id",
        "//crates/model_user:model_user",
        "@crates//:http-body-util-0.1.3",
        "@crates//:tokio-1.54.1",
        "@crates//:tower-0.5.3",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/image_generation"},
)

