load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "macro_aws_config",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "s3",
        "sqs",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_aws_config"},
    deps = [
        "//crates/macro_env_var:macro_env_var",
        "@crates//:aws-config-1.8.17",
        "@crates//:aws-sdk-s3-1.133.0",
        "@crates//:aws-sdk-sqs-1.99.0",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "macro_aws_config_unit",
    crate = ":macro_aws_config",
    crate_features = [
        "s3",
        "sqs",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_aws_config"},
    deps = [
        "@crates//:tokio-1.54.1",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_aws_config"},
)

