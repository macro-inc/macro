load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "channel_bots",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/channel_bots"},
    deps = [
        "//crates/agent:agent",
        "//crates/ai_billing:ai_billing",
        "//crates/ai_tools:ai_tools",
        "//crates/ai_toolset:ai_toolset",
        "//crates/ai_usage:ai_usage",
        "//crates/bot_id:bot_id",
        "//crates/calendar_events:calendar_events",
        "//crates/channel_sender:channel_sender",
        "//crates/entity_access:entity_access",
        "//crates/lexical_client:lexical_client",
        "//crates/macro_user_id:macro_user_id",
        "//crates/messages:messages",
        "//crates/prompt:prompt",
        "@crates//:anyhow-1.0.103",
        "@crates//:chrono-0.4.45",
        "@crates//:chrono-tz-0.10.4",
        "@crates//:futures-0.3.32",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "channel_bots_unit",
    crate = ":channel_bots",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/channel_bots"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/channel_bots"},
)

