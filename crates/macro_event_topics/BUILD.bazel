load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "macro_event_topics",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_event_topics"},
    deps = [
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
    ],
    proc_macro_deps = [
        "@crates//:sealed-0.6.0",
    ],
    aliases = {},
)

rust_test(
    name = "macro_event_topics_unit",
    crate = ":macro_event_topics",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_event_topics"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_event_topics"},
)

rust_binary(
    name = "dump_topics_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "dump_topics",
    crate_root = "src/bin/dump_topics.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_event_topics"},
    deps = [
        ":macro_event_topics",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
    ],
    proc_macro_deps = [
        "@crates//:sealed-0.6.0",
    ],
    aliases = {},
)

