load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "prompt",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/prompt"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "prompt_unit",
    crate = ":prompt",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/prompt"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/prompt"},
)

rust_test(
    name = "compose_itest",
    srcs = depset(["tests/compose.rs"] + glob(["tests/**/*.rs"])).to_list(),
    crate_name = "compose",
    crate_root = "tests/compose.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/prompt"},
    deps = [
        ":prompt",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + [],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/prompt"},
)

rust_test(
    name = "runtime_compose_itest",
    srcs = depset(["tests/runtime_compose.rs"] + glob(["tests/**/*.rs"])).to_list(),
    crate_name = "runtime_compose",
    crate_root = "tests/runtime_compose.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/prompt"},
    deps = [
        ":prompt",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + [],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/prompt"},
)

