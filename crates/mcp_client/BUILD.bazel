load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "mcp_client",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "macro_env_var",
        "providers",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/mcp_client", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/agent:agent",
        "//crates/ai_toolset:ai_toolset",
        "//crates/authentication_service_client:authentication_service_client",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_env_var:macro_env_var",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-error-response:model_error_response",
        "@crates//:aes-gcm-0.10.3",
        "@crates//:anyhow-1.0.103",
        "@crates//:async-openai-0.36.1",
        "@crates//:axum-0.8.9",
        "@crates//:base64-0.22.1",
        "@crates//:futures-0.3.32",
        "@crates//:oauth2-5.0.0",
        "@crates//:redis-1.2.1",
        "@crates//:reqwest-0.13.4",
        "@crates//:rmcp-1.7.0",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "mcp_client_unit",
    crate = ":mcp_client",
    crate_features = [
        "default",
        "macro_env_var",
        "providers",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/mcp_client", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "@crates//:regex-1.13.1",
        "@crates//:tokio-1.54.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/mcp_client"},
)

