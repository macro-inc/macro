load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "call",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_tools",
        "channels",
        "default",
        "inbound",
        "outbound",
        "ports",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/call", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/activity:activity",
        "//crates/agent:agent",
        "//crates/ai_toolset:ai_toolset",
        "//crates/ai_usage:ai_usage",
        "//crates/channels:channels",
        "//crates/connection:connection",
        "//crates/entity_access:entity_access",
        "//crates/entity_access_db_utils:entity_access_db_utils",
        "//crates/entity_mutation:entity_mutation",
        "//crates/filter_ast:filter_ast",
        "//crates/invite_email:invite_email",
        "//crates/ip_extractor:ip_extractor",
        "//crates/item_filters:item_filters",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_aws_config:macro_aws_config",
        "//crates/macro_event_broker:macro_event_broker",
        "//crates/macro_event_topics:macro_event_topics",
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "//crates/messages:messages",
        "//crates/model-entity:model_entity",
        "//crates/model-error-response:model_error_response",
        "//crates/models_pagination:models_pagination",
        "//crates/models_permissions:models_permissions",
        "//crates/notification:notification",
        "//crates/rate_limit:rate_limit",
        "//crates/share_permission_db_utils:share_permission_db_utils",
        "@crates//:anyhow-1.0.103",
        "@crates//:aws-sdk-s3-1.133.0",
        "@crates//:axum-0.8.9",
        "@crates//:chrono-0.4.45",
        "@crates//:cloudfront_sign-0.3.0",
        "@crates//:futures-0.3.32",
        "@crates//:livekit-api-0.4.24",
        "@crates//:livekit-protocol-0.7.7",
        "@crates//:pgvector-0.4.1",
        "@crates//:rootcause-0.12.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:strum-0.27.2",
        "@crates//:subtle-2.6.1",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:urlencoding-2.1.3",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "call_unit",
    crate = ":call",
    crate_features = [
        "ai_tools",
        "channels",
        "default",
        "inbound",
        "outbound",
        "ports",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/call", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "@crates//:base64-0.22.1",
        "@crates//:mockall-0.13.1",
        "@crates//:sha2-0.10.9",
        "@crates//:tower-0.5.3",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/call"},
)

