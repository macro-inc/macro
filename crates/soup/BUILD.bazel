load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "soup",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_tools",
        "all",
        "axum",
        "inbound",
        "outbound",
        "ports",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/activity:activity",
        "//crates/agent_changes:agent_changes",
        "//crates/ai_toolset:ai_toolset",
        "//crates/call:call",
        "//crates/channels:channels",
        "//crates/cowlike:cowlike",
        "//crates/crm:crm",
        "//crates/document_sub_type:document_sub_type",
        "//crates/email:email",
        "//crates/entity_access:entity_access",
        "//crates/favorites:favorites",
        "//crates/filter_ast:filter_ast",
        "//crates/foreign_entity:foreign_entity",
        "//crates/frecency:frecency",
        "//crates/github_pull_requests:github_pull_requests",
        "//crates/item_filters:item_filters",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-entity:model_entity",
        "//crates/model-error-response:model_error_response",
        "//crates/model_owner:model_owner",
        "//crates/models_grouping:models_grouping",
        "//crates/models_pagination:models_pagination",
        "//crates/models_properties:models_properties",
        "//crates/models_soup:models_soup",
        "//crates/non_empty:non_empty",
        "//crates/properties:properties",
        "//crates/readonly_pool:readonly_pool",
        "//crates/system_properties:system_properties",
        "@crates//:anyhow-1.0.103",
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:chrono-0.4.45",
        "@crates//:doppleganger-0.5.0",
        "@crates//:either-1.16.0",
        "@crates//:indexmap-2.14.0",
        "@crates//:recursion-0.5.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "soup_unit",
    crate = ":soup",
    crate_features = [
        "ai_tools",
        "all",
        "axum",
        "inbound",
        "outbound",
        "ports",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "//crates/model_user:model_user",
        "@crates//:cool_asserts-2.0.4",
        "@crates//:futures-0.3.32",
        "@crates//:http-body-util-0.1.3",
        "@crates//:mockall-0.13.1",
        "@crates//:ordered-float-5.3.0",
        "@crates//:tower-0.5.3",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup"},
)

