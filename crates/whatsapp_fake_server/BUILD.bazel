load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "whatsapp_fake_server",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/whatsapp_fake_server"},
    deps = [
        "//crates/whatsmeow:whatsmeow",
        "//crates/whatsmeow_signal:whatsmeow_signal",
        "@crates//:aes-gcm-0.10.3",
        "@crates//:axum-0.8.9",
        "@crates//:base64-0.22.1",
        "@crates//:chrono-0.4.45",
        "@crates//:flate2-1.1.9",
        "@crates//:futures-0.3.32",
        "@crates//:hmac-0.12.1",
        "@crates//:nom-8.0.0",
        "@crates//:prost-0.14.3",
        "@crates//:rand-0.9.4",
        "@crates//:reqwest-0.13.4",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-tungstenite-0.28.0",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "whatsapp_fake_server_unit",
    crate = ":whatsapp_fake_server",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/whatsapp_fake_server"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/whatsapp_fake_server"},
)

