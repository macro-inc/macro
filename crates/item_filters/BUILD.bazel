load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "item_filters",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "mock",
        "native",
        "schema",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/item_filters"},
    deps = [
        "//crates/document_sub_type:document_sub_type",
        "//crates/filter_ast:filter_ast",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model_file_type:model_file_type",
        "//crates/model_owner:model_owner",
        "//crates/non_empty:non_empty",
        "//crates/notification_state:notification_state",
        "@crates//:chrono-0.4.45",
        "@crates//:either-1.16.0",
        "@crates//:nom-8.0.0",
        "@crates//:rootcause-0.12.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "item_filters_unit",
    crate = ":item_filters",
    crate_features = [
        "default",
        "mock",
        "native",
        "schema",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/item_filters"},
    deps = [
        "@crates//:cool_asserts-2.0.4",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/item_filters"},
)

