load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "properties_service",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/properties_service"},
    deps = [
        "//crates/entity_access:entity_access",
        "//crates/macro_authorization:macro_authorization",
        "//crates/models_properties:models_properties",
        "//crates/notification:notification",
        "//crates/properties:properties",
        "@crates//:axum-0.8.9",
        "@crates//:serde_json-1.0.150",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "properties_service_unit",
    crate = ":properties_service",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/properties_service"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/properties_service"},
)

rust_binary(
    name = "properties_service_openapi_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "properties_service_openapi",
    crate_root = "src/openapi.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/properties_service"},
    deps = [
        "//crates/entity_access:entity_access",
        "//crates/macro_authorization:macro_authorization",
        "//crates/models_properties:models_properties",
        "//crates/notification:notification",
        "//crates/properties:properties",
        ":properties_service",
        "@crates//:axum-0.8.9",
        "@crates//:serde_json-1.0.150",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

