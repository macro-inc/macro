// Production compatibility calls use typed native references and UTF-16 values.
// This envelope does not alter the flat model Diff or session transport ABI.
const uint32 COMPATIBILITY_PROTOCOL_MAJOR = 1;
struct CompatBegin { string[] tags; }
struct CompatConfig { uint32 editorId; ForeignClassRegistration[] classes; }
// Bind the actual JS object to this exact owned capture without graph writes.
// Zero identifiers are not hydrated instances; native code validates ownership.
struct CompatInstanceBind {
  ForeignRecordRef record;
  uint32 instanceOwnerId; uint32 classId; uint32 instanceId;
}
enum CompatOperation : uint16 {
  Unknown = 0;
  GetRoot = 1; GetNodeByKey = 2;
  CreateText = 3; CreateParagraph = 4; CreateHeading = 5;
  CreateLineBreak = 6; CreateTab = 7;
  GetLatest = 8; GetWritable = 9;
  Append = 10; GetChildren = 11; GetChildrenSize = 12;
  GetTextContent = 13; GetTextContentSize = 14; SetTextContent = 15;
  GetFirstChild = 16; GetLastChild = 17; GetParent = 18;
  GetPreviousSibling = 19; GetNextSibling = 20;
  GetIndent = 21; SetIndent = 22; IsAttached = 23; IsInline = 24;
  GetSelection = 25; GetPreviousSelection = 26;
  GetCompositionKey = 27; AddUpdateTag = 28;
  GetNodeField = 29; SetNativeField = 30;
  ExportNodeJson = 31; ExportStateJson = 32;
  CreateRangeSelection = 33; CreateNodeSelection = 34; SetSelection = 35;
  SelectionClone = 36; SelectionGetNodes = 37; SelectionGetTextContent = 38;
  SelectionInsertText = 39; SelectionInsertNodes = 40;
  SelectionFormatText = 41; SelectionDeleteCharacter = 42;
  SelectionDeleteWord = 43; SelectionDeleteLine = 44;
  SelectionInsertParagraph = 45; SelectionInsertLineBreak = 46;
  SelectionExtract = 47; SelectionIsCollapsed = 48; SelectionIsBackward = 49;
  NodeSelectionAdd = 50; NodeSelectionDelete = 51; NodeSelectionClear = 52;
  NodeSelectionHas = 53; SelectionHasFormat = 54;
  SetCompositionKey = 55; CreateTableSelection = 56;
}
struct CompatRequest {
  CompatOperation operation;
  bool historical;
  uint64 stateVersion;
  bool hasReceiver;
  ForeignRecordRef receiver;
  ForeignCallbackValue[] args;
}
struct CompatReply { ForeignCallbackValue value; ForeignRenderRecord[] records; CompatSelectionData[] selections; }
struct CompatDirtyElement { ForeignKey key; bool intentional; }
struct CompatSnapshot {
  uint64 version;
  ForeignRenderBatch batch;
  CompatSelectionData selection;
}
struct CompatCommit {
  uint32 flags;
  uint64 version;
  bool changed;
  ForeignKey[] dirtyLeaves;
  CompatDirtyElement[] dirtyElements;
  string[] tags;
  ForeignRenderBatch batch;
  CompatSelectionData selection;
}

// External native publications retain the actual commit metadata until delivery.
struct CompatPublications { CompatCommit[] commits; }

// Ordinary JS selections retain their objects; these are typed native snapshots
// and explicit writes, never a JSON encoding of arbitrary own properties.
enum CompatPointKind : byte { Unknown = 0; Text = 1; Element = 2; }
struct CompatPoint { ForeignKey key; uint32 offset; CompatPointKind kind; }
union CompatSelectionData {
  1 -> struct CompatNoSelection { }
  2 -> struct CompatRangeSelection {
    ForeignSelectionRef reference; CompatPoint anchor; CompatPoint focus;
    uint32 format; uint16[] style; bool dirty;
    bool hasCachedBackward; bool cachedBackward;
    bool hasCachedNodes; ForeignNodeRef[] cachedNodes;
  }
  3 -> struct CompatNodeSelection {
    ForeignSelectionRef reference; ForeignKey[] keys; bool dirty;
    bool hasCachedNodes; ForeignNodeRef[] cachedNodes;
  }
  4 -> struct CompatTableSelection {
    ForeignSelectionRef reference; ForeignKey tableKey;
    CompatPoint anchor; CompatPoint focus; bool dirty;
    bool hasCachedNodes; ForeignNodeRef[] cachedNodes;
  }
}
struct CompatSelectionPatch {
  bool historical; uint64 stateVersion;
  bool activate; CompatSelectionData selection;
}

// Compact transaction construction uses only keys issued by the native allocator.
// Reservations are scoped to the editor/update, single use, and burned on discard.
struct CompatKeyReservation {
  uint32 editorId; uint64 reservationId; ForeignKey[] keys;
}
struct CompatBeginRequest { string[] tags; uint32 reserveKeys; }
struct CompatBeginReply {
  uint64 version; uint32 updateId; uint64 mutationEpoch;
  ForeignOptionalKey composition; CompatKeyReservation reservation;
}
union CompatNodeOperand {
  1 -> struct CompatNoNode { }
  2 -> struct CompatCapturedNode { ForeignRecordRef record; }
  3 -> struct CompatReservedNode { uint64 reservationId; ForeignKey key; }
}
// Apply retains before releases atomically; only issued capture IDs are valid.
// Frozen records remain live while leased, independently of the active graph.
struct CompatCaptureLeases {
  uint32 editorId; uint64[] retain; uint64[] release;
}
// Incremental replies never materialize the root's whole-document text cache.
// An explicit initial snapshot may carry it; later changes invalidate the cache.
struct CompatRecordDelta {
  ForeignRenderRecord[] records; ForeignKey[] removedKeys;
  bool invalidateRootText;
}

// A creation seed names the JS instance whose constructor already ran once.
// A COW clone uses the separate native clone-stage acknowledgement instead.
// Reject seeds for noncreation/COW, reused IDs, or mismatched owner/class/kind;
// validate reservations and capture leases before invoking any host callbacks.
union CompatInstanceSeed {
  1 -> struct CompatNoInstanceSeed { }
  2 -> struct CompatCreatedInstance {
    uint32 instanceOwnerId; uint32 classId; uint32 instanceId;
    ForeignBasePatch base; ForeignNativeProjection nativeProjection;
    ForeignOpaqueValue ownFields;
  }
}
union CompatBatchArgument {
  1 -> struct CompatValueArgument { ForeignCallbackValue value; }
  2 -> struct CompatNodeArgument { CompatNodeOperand value; }
  3 -> struct CompatNodeArrayArgument { CompatNodeOperand[] values; }
}
struct CompatBatchOperation {
  CompatOperation operation; CompatNodeOperand receiver;
  CompatBatchArgument[] args; CompatInstanceSeed initialInstance;
}
struct CompatBatchRequest {
  uint32 updateId; uint64 expectedEpoch; CompatCaptureLeases leases;
  CompatBatchOperation[] operations; bool finalize;
  float64 now; float64 wall;
}
struct CompatBatchResult { ForeignCallbackValue value; CompatRecordDelta delta; }
union CompatFailureLocation {
  1 -> struct CompatOperationFailure { uint32 index; }
  2 -> struct CompatFinalizeFailure { }
}
union CompatBatchOutcome {
  1 -> struct CompatBatchSuccess { }
  2 -> struct CompatBatchNativeFailure {
    CompatFailureLocation location; uint16[] errorText;
  }
  3 -> struct CompatBatchHostFailure {
    CompatFailureLocation location; ForeignOpaqueValue error;
  }
}
// Operation failure index equals the successful prefix results.length; finalize
// failure follows all operation results. Failure always has published=false and
// invalidates admission. The final delta includes partial failing-operation effects
// needed by captures/selection (or explicit discard), not just successful results.
// Noop and composition are part of this single final crossing.
struct CompatBatchReply {
  uint32 flags; bool published; bool changed; bool noop;
  uint64 version; uint64 mutationEpoch; ForeignOptionalKey composition;
  CompatSelectionData selection; string[] tags;
  ForeignKey[] dirtyLeaves; CompatDirtyElement[] dirtyElements;
  CompatRecordDelta delta; CompatBatchResult[] results;
  CompatBatchOutcome outcome;
}
