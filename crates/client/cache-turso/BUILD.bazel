load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "cache_turso",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "browser-test-hooks",
        "default",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/client/cache-core:all_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/client/cache-turso"},
    deps = [
        "//crates/client/cache-core:cache_core",
        "//crates/maybe_send:maybe_send",
        "//crates/predicate_index:predicate_index",
        "@crates//:thiserror-2.0.18",
        "@crates//:turso_core-0.8.0-pre.3",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

