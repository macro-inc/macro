load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "shared_entity_registry",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/entity_registry/shared_entity_registry"},
    deps = [
        "//crates/model-entity:model_entity",
        "//crates/model_owner:model_owner",
        "@crates//:chrono-0.4.45",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:thiserror-2.0.18",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "shared_entity_registry_unit",
    crate = ":shared_entity_registry",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/entity_registry/shared_entity_registry"},
    deps = [
        "@crates//:serde_json-1.0.150",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/entity_registry/shared_entity_registry"},
)

