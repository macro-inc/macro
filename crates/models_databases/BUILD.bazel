load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "models_databases",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "schema",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/models_databases"},
    deps = [
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "@crates//:chrono-0.4.45",
        "@crates//:fractional_index-2.0.2",
        "@crates//:nom-8.0.0",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "models_databases_unit",
    crate = ":models_databases",
    crate_features = [
        "schema",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/models_databases"},
    deps = [
        "@crates//:serde_json-1.0.150",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/models_databases"},
)

rust_test(
    name = "wire_schema_itest",
    srcs = depset(["tests/wire_schema.rs"] + glob(["tests/**/*.rs"])).to_list(),
    crate_name = "wire_schema",
    crate_root = "tests/wire_schema.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "schema",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/models_databases"},
    deps = [
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        ":models_databases",
        "@crates//:chrono-0.4.45",
        "@crates//:fractional_index-2.0.2",
        "@crates//:nom-8.0.0",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + [],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/models_databases"},
)

