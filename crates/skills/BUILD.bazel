load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "skills",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_tools",
        "default",
        "outbound",
        "ports",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/skills"},
    deps = [
        "//crates/ai_toolset:ai_toolset",
        "//crates/cognition:cognition",
        "//crates/cowlike:cowlike",
        "//crates/document_sub_type:document_sub_type",
        "//crates/documents:documents",
        "//crates/email:email",
        "//crates/entity_access:entity_access",
        "//crates/filter_ast:filter_ast",
        "//crates/item_filters:item_filters",
        "//crates/lexical_client:lexical_client",
        "//crates/macro_user_id:macro_user_id",
        "//crates/models_pagination:models_pagination",
        "//crates/models_search:models_search",
        "//crates/models_soup:models_soup",
        "//crates/search_service_client:search_service_client",
        "//crates/soup:soup",
        "//crates/system_skills:system_skills",
        "@crates//:anyhow-1.0.103",
        "@crates//:chrono-0.4.45",
        "@crates//:futures-0.3.32",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "skills_unit",
    crate = ":skills",
    crate_features = [
        "ai_tools",
        "default",
        "outbound",
        "ports",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/skills"},
    deps = [
        "@crates//:rootcause-0.12.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/skills"},
)

