load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "whatsmeow",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "testing",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/whatsmeow"},
    deps = [
        "//crates/whatsmeow_proto:whatsmeow_proto",
        "@crates//:aes-0.8.4",
        "@crates//:aes-gcm-0.10.3",
        "@crates//:base64-0.22.1",
        "@crates//:cbc-0.1.2",
        "@crates//:chrono-0.4.45",
        "@crates//:constant_time_eq-0.3.1",
        "@crates//:flate2-1.1.9",
        "@crates//:futures-0.3.32",
        "@crates//:hex-0.4.3",
        "@crates//:hkdf-0.12.4",
        "@crates//:hmac-0.12.1",
        "@crates//:lazy-regex-3.6.1",
        "@crates//:md-5-0.10.6",
        "@crates//:miniz_oxide-0.8.9",
        "@crates//:prost-0.14.3",
        "@crates//:rand-0.9.4",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-tungstenite-0.28.0",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
        "@crates//:x25519-dalek-2.0.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "whatsmeow_unit",
    crate = ":whatsmeow",
    crate_features = [
        "testing",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/whatsmeow"},
    deps = [
        "@crates//:axum-0.8.9",
        "@crates//:tempfile-3.27.0",
        "@crates//:tracing-subscriber-0.3.23",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/whatsmeow"},
)

