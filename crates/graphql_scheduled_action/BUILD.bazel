load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "graphql_scheduled_action",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_scheduled_action"},
    deps = [
        "//crates/macro_user_id:macro_user_id",
        "//crates/scheduled_action:scheduled_action",
        "@crates//:async-graphql-7.2.1",
        "@crates//:chrono-0.4.45",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde_json-1.0.150",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "graphql_scheduled_action_unit",
    crate = ":graphql_scheduled_action",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_scheduled_action"},
    deps = [
        "//crates/macro_uuid:macro_uuid",
        "//crates/model_owner:model_owner",
        "@crates//:tokio-1.54.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_scheduled_action"},
)

