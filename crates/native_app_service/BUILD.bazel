load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "native_app_service",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/native_app_service"},
    deps = [
        "//crates/macro_env_var:macro_env_var",
        "@crates//:axum-0.8.9",
        "@crates//:futures-0.3.32",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:semver-1.0.28",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "native_app_service_unit",
    crate = ":native_app_service",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/native_app_service"},
    deps = [
        "@crates//:cool_asserts-2.0.4",
        "@crates//:strum-0.27.2",
        "@crates//:tower-0.5.3",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/native_app_service"},
)

