{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "view": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "widgets"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "view"
  ],
  "additionalProperties": false,
  "title": "Show",
  "description": "Show the user a rich, interactive view (item cards, lists, timelines, calendar agendas, tags, channel messages) directly in the conversation. Decide for yourself when to show something: the user will not ask. Nothing you create, change or send reaches the user as a card unless you show it, so end a turn that made, changed or sent something the user will want to open by showing it. Their cards say what you did to them, so the rest of the view need not. Show the smallest set that does the job: usually one to four cards for the items that matter, never every item a step touched. Leave out what you only read along the way, supporting or intermediate items, and items you already showed unless this turn changed them. Do not call Show when the answer is a sentence or two, or when nothing in the turn is worth opening. For questions about workspace data - summaries of tasks, documents or activity, lists of items, anything that would otherwise need a markdown table or a long list - the view is the answer. Typical triggers: \"what did I get done this week?\", \"what is a teammate working on?\", \"my open tasks\", \"summarize this project\", and \"what happened in this channel?\". What ReadActivity returns is not shown to the user by itself: answer an activity question by showing the few items or events that matter, not by summarizing them in prose. Keep accompanying prose to a one-line lead-in at most and do not restate what the view shows. Never mention, link or name in your reply an item the view shows - no mention chip, no \"I created X\": its card or row already opens it and says what you did to it. Entity-backed widgets take real workspace entity ids obtained from other tools such as ListEntities or search; never invent ids. Prefer list sources with kind \"items\" and those entity references. To show calendar events, use an events widget with the eventIds a calendar tool returned: it renders an agenda loaded live from the calendar, so never restate the times in prose. Show one to four specific items - a document or spreadsheet, an email thread, an event, a routine - in a cards widget, and a longer set in a list widget; mention items in passing as chips instead. To show tags - the user's own, or a taxonomy or ontology of any depth - use a tags widget, never a table or a list in markdown. Nest narrower tags under the tags they belong to, and give a tag that exists the tagId a tag tool returned. In a channel or a private conversation with the user, the view is posted with your reply. The view is checked against this schema before it is shown: a view that does not match is not shown, and the error says what to fix.",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "md"
            },
            "markdown": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "markdown"
          ],
          "additionalProperties": false,
          "description": "Markdown text: the narrative between the other widgets. Its type is \"md\", never \"markdown\"."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timeline"
            },
            "title": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "time": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "entity": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "user",
                          "chat",
                          "channel",
                          "channel_message",
                          "document",
                          "project",
                          "email_thread",
                          "calendar_event",
                          "team",
                          "call",
                          "foreign_entity",
                          "static_file",
                          "crm_company",
                          "crm_contact",
                          "crm_pipeline",
                          "reminder",
                          "skill",
                          "agent_session",
                          "scheduled_action",
                          "initiative",
                          "database",
                          "database_row",
                          "form",
                          "email",
                          "routine",
                          "channel_thread"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "future": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "time",
                  "title"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "events"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            },
            "title": {
              "type": "string"
            },
            "source": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "query"
                    },
                    "query": {}
                  },
                  "required": [
                    "kind",
                    "query"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "items"
                    },
                    "entities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "user",
                              "chat",
                              "channel",
                              "channel_message",
                              "document",
                              "project",
                              "email_thread",
                              "calendar_event",
                              "team",
                              "call",
                              "foreign_entity",
                              "static_file",
                              "crm_company",
                              "crm_contact",
                              "crm_pipeline",
                              "reminder",
                              "skill",
                              "agent_session",
                              "scheduled_action",
                              "initiative",
                              "database",
                              "database_row",
                              "form",
                              "email",
                              "routine",
                              "channel_thread"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "entities"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "groupBy": {
              "type": "string",
              "enum": [
                "date",
                "entity_type",
                "project"
              ]
            },
            "limit": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "channelMessage"
            },
            "channelId": {
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "channelId",
            "messageId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "events"
            },
            "title": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "eventId": {
                    "type": "string",
                    "description": "The eventId a calendar tool such as ListCalendarEvents returned."
                  },
                  "occurrenceKey": {
                    "description": "One instance of a recurring event: that instance's recurrenceId from ListCalendarEvents.",
                    "type": "string"
                  }
                },
                "required": [
                  "eventId"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "events"
          ],
          "additionalProperties": false,
          "description": "A calendar agenda: the events grouped by day with their times, places and attendees, loaded live from the user's calendars. Use it whenever an answer is about calendar events instead of listing them in text."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cards"
            },
            "title": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "document",
                      "email_thread",
                      "calendar_event",
                      "project",
                      "channel",
                      "routine",
                      "form",
                      "initiative"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "description": "The item's id exactly as a tool returned it: a document id (documents and spreadsheets), an email thread id, a calendar eventId, or a project, channel, routine, form or initiative id."
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false,
          "description": "Rich cards for the one to four specific items the answer is about: a document or spreadsheet, an email thread, a calendar event, a project, a channel, a routine, a form or an initiative. Each card opens its item, and a routine's card can pause it or run it now. A card for an item you created or changed this turn says so itself. Use a list widget for longer sets."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tags"
            },
            "title": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            }
          },
          "required": [
            "type",
            "tags"
          ],
          "additionalProperties": false,
          "description": "Tags as coloured pills, nested to any depth: the user's tags, a taxonomy the answer proposes, or any other ontology of tags, each with what it is for. Use it whenever an answer is about tags, instead of a table or a list in markdown."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "container"
            },
            "direction": {
              "type": "string",
              "enum": [
                "row",
                "col"
              ]
            },
            "gap": {
              "type": "number"
            },
            "wrap": {
              "type": "boolean"
            },
            "align": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ]
            },
            "justify": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "between"
              ]
            },
            "title": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "The tag's name. Name a narrower tag on its own: \"bug\" under \"Type\", not \"Type/bug\"."
        },
        "color": {
          "description": "One of the tag colours: red, tomato, orange, amber, yellow, green, teal, blue, indigo, purple, pink, gray. Gray when omitted.",
          "type": "string"
        },
        "description": {
          "description": "What the tag is for, in a few words.",
          "type": "string"
        },
        "tagId": {
          "description": "For a tag that exists, the id ListTags or CreateTag returned: the tag then shows its current name and colour, and opens what is tagged with it.",
          "type": "string"
        },
        "children": {
          "description": "The narrower tags under this one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    }
  }
}
