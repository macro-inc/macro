load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "local_e2e_test_support",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/local_e2e_test_support"},
    deps = [
        "//crates/macro_auth:macro_auth",
        "@crates//:anyhow-1.0.103",
        "@crates//:dotenvy-0.15.7",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:url-2.5.8",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "local_e2e_test_support_unit",
    crate = ":local_e2e_test_support",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/local_e2e_test_support"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/local_e2e_test_support"},
)

rust_binary(
    name = "generate_local_e2e_token_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "generate_local_e2e_token",
    crate_root = "src/bin/generate_local_e2e_token.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/local_e2e_test_support"},
    deps = [
        "//crates/macro_auth:macro_auth",
        ":local_e2e_test_support",
        "@crates//:anyhow-1.0.103",
        "@crates//:dotenvy-0.15.7",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:url-2.5.8",
    ],
    proc_macro_deps = [],
    aliases = {},
)

