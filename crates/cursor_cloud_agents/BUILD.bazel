load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "cursor_cloud_agents",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "postgres",
        "test-utils",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/cursor_cloud_agents", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/agent_runtime_protocol:agent_runtime_protocol",
        "//crates/agent_session:agent_session",
        "//crates/macro_env_var:macro_env_var",
        "//crates/macro_tower_layers:macro_tower_layers",
        "//crates/static_file_service_client:static_file_service_client",
        "@crates//:agent-client-protocol-2.0.0",
        "@crates//:base64-0.22.1",
        "@crates//:bytes-1.11.1",
        "@crates//:futures-0.3.32",
        "@crates//:nom-8.0.0",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:sse-core-0.2.3",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:tracing-subscriber-0.3.23",
        "@crates//:url-2.5.8",
        "@crates//:urlencoding-2.1.3",
        "@crates//:uuid-1.23.1",
        "@crates//:zeroize-1.9.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "cursor_cloud_agents_unit",
    crate = ":cursor_cloud_agents",
    crate_features = [
        "default",
        "postgres",
        "test-utils",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/cursor_cloud_agents", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/folds/agent_fold:agent_fold",
        "@crates//:insta-1.48.0",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/cursor_cloud_agents"},
)

