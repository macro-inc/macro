ound/redis_pg/test/manager.rs","./crates/stream/src/outbound/redis_pg/mod.rs","./crates/stream/src/outbound/redis_pg/manager.rs","./crates/stream/src/outbound/redis_pg/ext.rs","./crates/stream/src/outbound/mod.rs"],"totalFiles":20}}},"toolCallId":"tool_b1dd9d67-c38d-40b3-8c86-fec24329420","startedAtMs":"1787344989005","completedAtMs":"1787344989116"}},{"toolCall":{"readToolCall":{"args":{"path":"/workspace/apps/web/src/lib/service-clients/service-connection/stream.ts"},"result":{"success":{"content":"import type { EntityData } from '@entity';\nimport type { ChatStream } from '@service-cognition/generated/schemas';\nimport type { Accessor, Setter } from 'solid-js';\nimport { createSignal } from 'solid-js';\nimport { createStore, produce } from 'solid-js/store';\nimport { match } from 'ts-pattern';\nimport { createConnectionWebsocketEffect } from './websocket';\n// entities that support streaming\nexport type StreamType = {\n  chat: ChatStream;\n};\n\nexport function isStreamEntity(\n  entity_type: EntityData['type']\n): entity_type is keyof StreamType {\n  return entity_type === 'chat';\n}\n\nexport type StreamId = {\n  entity_type: keyof StreamType;\n  entity_id: string;\n  // matches chat message id\n  stream_id: string;\n};\n\ntype StreamItem<K extends keyof StreamType> = {\n  id: StreamId;\n  payload: StreamType[K];\n};\n\nexport interface Stream<K extends keyof StreamType> {\n  id: Accessor<StreamId | undefined>;\n  data: Accessor<StreamType[K][]>;\n  isDone: Accessor<boolean>;\n}\n\nexport type StreamController<K extends keyof StreamType> = {\n  stream: Stream<K>;\n  setData: Setter<StreamType[K][]>;\n  setDone: () => void;\n  id: Accessor<StreamId | undefined>;\n};\n\nexport function createStreamController<K extends keyof StreamType>(\n  id: StreamId | Accessor<StreamId | undefined>\n): StreamController<K> {\n  const [data, setData] = createSignal<StreamType[K][]>([]);\n  const [isDone, setIsDone] = createSignal(false);\n  const idSignal = typeof id === 'function' ? id : () => id;\n\n  return {\n    stream: {\n      id: idSignal,\n      data,\n      isDone,\n    },\n    id: idSignal,\n    setData,\n    setDone: () => setIsDone(true),\n  };\n}\n\ntype StreamWithType = {\n  stream: StreamController<keyof StreamType>;\n  type: keyof StreamType;\n};\n\n// internal record of all streams\n// map<entity_id, map<stream_id, StreamWithType>>;\nconst [streams, setStreams] = createStore<\n  Record<string, Record<string, StreamWithType>>\n>({});\n\nexport function clearStream(entity_id: string) {\n  setStreams(\n    produce((s) => {\n      delete s[entity_id];\n    })\n  );\n}\n\nfunction streamIsDone(\n  kind: keyof StreamType,\n  item: StreamType[keyof StreamType]\n): boolean {\n  const isDone = match({ kind, item })\n    .with({ kind: 'chat' }, ({ item }) => item.type === 'stream_end')\n    .exhaustive();\n  return isDone;\n}\n\nfunction addStream(\n  entity_id: string,\n  stream_id: string,\n  entry: StreamWithType\n) {\n  setStreams(\n    produce((s) => {\n      if (!s[entity_id]) s[entity_id] = {};\n      s[entity_id][stream_id] = entry;\n    })\n  );\n}\n\n// new message!\ncreateConnectionWebsocketEffect((message) => {\n  // not a stream\n  if (message.type !== 'stream') return;\n\n  let item: StreamItem<keyof StreamType>;\n  try {\n    item = JSON.parse(message.data);\n  } catch {\n    console.error('unparsable stream payload', message);\n    return;\n  }\n  // if this is not the 1st item proces new item / add to stream\n  if (\n    streams[item.id.entity_id] &&\n    streams[item.id.entity_id][item.id.stream_id]\n  ) {\n    const stream = streams[item.id.entity_id][item.id.stream_id];\n    if (streamIsDone(item.id.entity_type, item.payload)) {\n      stream.stream.setDone();\n    } else {\n      stream.stream.setData((p) => [...p, item.payload]);\n    }\n  }\n  // is 1st item\n  else {\n    // new stream\n    const newStream = createStreamController(item.id);\n    // process item\n    if (streamIsDone(item.id.entity_type, item.payload)) {\n      newStream.setDone();\n    } else {\n      newStream.setData([item.payload]);\n    }\n    addStream(item.id.entity_id, item.id.stream_id, {\n      stream: newStream,\n      type: item.id.entity_type,\n    });\n  }\n});\n\n// create a new stream or retreive existing stream\n// if a new stream is created it represents the expectation that items will arive to that stream\nexport function subscribe<K extends keyof StreamType>(\n  entity_type: K,\n  entity_id: string,\n  stream_id: string\n): Stream<K> | undefined {\n  if (streams[entity_id]?.[stream_id]) {\n    if (streams[entity_id][stream_id].type !== entity_type) {\n      console.error('unexpected stream type');\n      return;\n    }\n    return streams[entity_id][stream_id].stream.stream as Stream<K>;\n  } else {\n    const controller = createStreamController({\n      entity_id,\n      entity_type,\n      stream_id,\n    });\n    addStream(entity_id, stream_id, {\n      stream: controller,\n      type: entity_type,\n    });\n    return controller.stream as Stream<K>;\n  }\n}\n\n/** Reactive accessor for all streams on an entity. */\nexport function getEntityStreams<K extends keyof StreamType>(\n  entity_type: K,\n  entity_id: string\n): Accessor<Stream<K>[]> {\n  return () => {\n    const entityStreams = streams[entity_id];\n    if (!entityStreams) return [];\n    return Object.values(entityStreams)\n      .filter((s) => s.type === entity_type)\n      .map((s) => s.stream.stream as Stream<K>);\n  };\n}\n\nexport type ChatMessageStream = Stream<'chat'>;\nexport type ChatStreamController = StreamController<'chat'>;\n","totalLines":189,"fileSize":4917,"path":"/workspace/apps/web/src/lib/service-clients/service-connection/stream.ts","readRange":{"startLine":1,"endLine":189}}}},"toolCallId":"tool_120afe95-723c-4df9-aa3f-66f59a2a6c5","startedAtMs":"1787344989005","completedAtMs":"1787344989082"}},{"toolCall":{"readToolCall":{"args":{"path":"/workspace/apps/web/src/lib/service-clients/service-connection/stream-events.ts"},"result":{"success":{"content":"import type { EntityData } from '@entity';\nimport type { Accessor } from 'solid-js';\nimport { createStore } from 'solid-js/store';\nimport type { StreamEvent } from './generated/schemas';\nimport { isStreamEntity } from './stream';\nimport { createConnectionWebsocketEffect, ws } from './websocket';\n\nconst [streamState, setStreamState] = createStore<Record<string, StreamEvent>>(\n  {}\n);\nconst subscribed = new Set<string>();\n\ncreateConnectionWebsocketEffect((data) => {\n  if (data.type !== 'stream_event') return;\n  try {\n    const event = JSON.parse(data.data) as StreamEvent;\n    setStreamState(event.entity_id, event);\n  } catch {\n    return;\n  }\n});\n\nexport function getStreamState(\n  entity_id: string\n): Accessor<StreamEvent | undefined> {\n  return () => streamState[entity_id];\n}\n\nexport function subscribeToStreamState(\n  entity_id: string,\n  entity_type: EntityData['type']\n) {\n  if (!isStreamEntity(entity_type) || subscribed.has(entity_id)) return;\n  subscribed.add(entity_id);\n  ws.send({\n    type: 'stream_events',\n    entity_id,\n    entity_type: entity_type,\n  });\n}\n","totalLines":41,"fileSize":1080,"path":"/workspace/apps/web/src/lib/service-clients/service-connection/stream-events.ts","readRange":{"startLine":1,"endLine":41}}}},"toolCallId":"tool_a1b201a3-c75b-48ed-a543-669fdbfc2ba","startedAtMs":"1787344989005","completedAtMs":"1787344989071"}},{"toolCall":{"grepToolCall":{"args":{"pattern":".","glob":"crates/stream/**/*","outputMode":"content","caseInsensitive":false,"headLimit":50,"multiline":false,"toolCallId":"tool_fa3478f9-3061-4033-ad43-5d2f3da0a63","offset":0},"result":{"success":{"pattern":".","outputMode":"content","workspaceResults":{"/workspace":{"content":{"matches":[{"file":"./crates/stream/Cargo.toml","matches":[{"lineNumber":1,"content":"[package]"},{"lineNumber":2,"content":"name = \"stream\""},{"lineNumber":3,"content":"version = \"0.1.0\""},{"lineNumber":4,"