 inner: &'c Client,\n}\n\nimpl Client {\n    pub fn chat(&'_ self) -> Chat<'_> {\n        Chat { inner: self }\n    }\n}\n\nimpl<'c> Chat<'c> {\n    pub async fn create<I>(\n        &self,\n        request: I,\n    ) -> Result<MessageResponse, crate::error::AnthropicError>\n    where\n        I: Into<CreateMessageRequestBody>,\n    {\n        let request = request.into();\n        let request = transform_request_web_fetch(request);\n        self.inner.post(\"/v1/messages\", request).await\n    }\n\n    pub async fn create_stream<I>(&self, request: I) -> MessageCompletionResponseStream\n    where\n        I: Into<CreateMessageRequestBody>,\n    {\n        let mut request = request.into();\n        request.stream = Some(true);\n        let request = transform_request_web_fetch(request);\n        self.create_stream_unchecked(request).await\n    }\n\n    pub async fn create_stream_unchecked<I, O>(\n        &self,\n        request: I,\n    ) -> Pin<Box<dyn Stream<Item = Result<O, AnthropicError>> + Send>>\n    where\n        I: Serialize + Debug,\n        O: DeserializeOwned + Send + Sync + 'static,\n    {\n        self.inner.post_stream(\"/v1/messages\", request).await\n    }\n}\n","totalLines":59,"fileSize":1636,"path":"/workspace/crates/anthropic/src/client/chat.rs","readRange":{"startLine":1,"endLine":59}}}},"toolCallId":"tool_99b4dcb8-9d83-4009-beef-71c3512debe","startedAtMs":"1787345002482","completedAtMs":"1787345002550"}},{"toolCall":{"grepToolCall":{"args":{"pattern":"eventsource|EventSource|text/event|bytes_stream|lines\\(\\)","glob":"crates/anthropic/**/*","outputMode":"content","caseInsensitive":false,"headLimit":80,"multiline":false,"toolCallId":"tool_6c7c0cd9-1028-4a58-acb2-a4a2343296c","offset":0},"result":{"success":{"pattern":"eventsource|EventSource|text/event|bytes_stream|lines\\(\\)","outputMode":"content","workspaceResults":{"/workspace":{"content":{"matches":[{"file":"./crates/anthropic/src/client/mod.rs","matches":[{"lineNumber":148,"content":"    