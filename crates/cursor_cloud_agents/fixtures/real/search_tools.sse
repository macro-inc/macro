8,"content":"rig-agent = \"0.41.0\""},{"lineNumber":39,"content":"# Enable rig's scripted MockCompletionModel for tests (fake AI streams)."},{"lineNumber":40,"content":"rig-core = { version = \"0.41.0\", features = [\"test-utils\"] }"},{"lineNumber":41,"content":"rig-agent = { version = \"0.41.0\", features = [\"test-utils\"] }"}]},{"file":"./crates/agent/src/stream.rs","matches":[{"lineNumber":3,"content":"use futures::stream::Stream;"},{"lineNumber":7,"content":"/// The main streaming type returned by [`crate::Session::send_message`]."},{"lineNumber":11,"content":"/// An individual event in the agent stream."},{"lineNumber":31,"content":"    /// The original (un-mangled) tool name."}]},{"file":"./crates/agent/src/model/openai.rs","matches":[{"lineNumber":4,"content":"use rig_core::{client::CompletionClient, providers::openai};"},{"lineNumber":24,"content":"    /// The rig completion model for this id."},{"lineNumber":32,"content":"    /// Best-effort reasoning config, flattened into the request by rig, or"},{"lineNumber":77,"content":"    /// The rig Responses API completion model for this id."},{"lineNumber":81,"content":"    /// GPT reasoning models. Tools are sent verbatim (non-strict is rig's"}]},{"file":"./crates/agent/src/model/router.rs","matches":[{"lineNumber":10,"content":"//! - [`ProviderAgent`] — a built rig agent, with the same arms. Its"},{"lineNumber":11,"content":"//!   [`run_stream`](ProviderAgent::run_stream) matches internally, so callers"},{"lineNumber":14,"content":"//! Ids are addressed as `provider/model` (e.g. `anthropic/claude-opus-4-8`,"},{"lineNumber":25,"content":"use rig_agent::agent::{Agent, AgentBuilder, MultiTurnStreamItem};"},{"lineNumber":26,"content":"use rig_agent::streaming::StreamingPrompt;"},{"lineNumber":27,"content":"use rig_agent::tool::server::ToolServerHandle;"},{"lineNumber":28,"content":"use rig_core::completion::{CompletionModel, GetTokenUsage};"},{"lineNumber":29,"content":"use rig_core::message::Message;"},{"lineNumber":30,"content":"use rig_core::providers::{anthropic, openai};"},{"lineNumber":31,"content":"use rig_core::streaming::StreamedAssistantContent;"},{"lineNumber":39,"content":"use crate::stream::{ChatCompletionStream, StreamPart};"},{"lineNumber":70,"content":"    /// Build the rig agent for this model, applying provider-specific thinking"},{"lineNumber":117,"content":"/// A built rig agent bound to the provider serving the session's model."},{"lineNumber":119,"content":"/// The two arms are different concrete `Agent<M>` types; [`run_stream`] hides"},{"lineNumber":122,"content":"/// [`run_stream`]: ProviderAgent::run_stream"},{"lineNumber":137,"content":"    /// Run the agentic loop and adapt rig's stream into the provider-agnostic"},{"lineNumber":138,"content":"    /// [`StreamPart`] stream consumed by DCS. The provider fan-out is internal."},{"lineNumber":140,"content":"    pub(crate) async fn run_stream("},{"lineNumber":155,"content":"                drive_stream("},{"lineNumber":171,"content":"                drive_stream("},{"lineNumber":187,"content":"                drive_stream("},{"lineNumber":205,"content":"                    .run_stream_dyn("},{"lineNumber":378,"content":"/// Build a rig agent from a completion model and per-session config."},{"lineNumber":398,"content":"/// Run the agentic loop on `agent` and adapt rig's stream into the"},{"lineNumber":399,"content":"/// provider-agnostic [`StreamPart`] stream consumed by DCS."},{"lineNumber":401,"content":"async fn drive_stream<M>("},{"lineNumber":425,"content":"    // Driver-side sender for parts derived from rig stream items (thinking,"},{"lineNumber":430,"content":"    let mut rig_stream = agent"},{"lineNumber":431,"content":"        .stream_prompt(prompt)"},{"lineNumber":438,"content":"    // Drive the rig stream on its own task. The hook emits a tool call the"},{"lineNumber":440,"content":"    // but rig runs that execution inside a single `rig_stream.next()` poll, so"},{"lineNumber":442,"content":"    // hidden until its response landed. Polling the rig stream here, off the"},{"lineNumber":450,"content":"        while let Some(item) = rig_stream.next().await {"},{"lineNumber":465,"content":"                            // Best-effort cost logging; never fails the stream."},{"lineNumber":471,"content":"                            let _ = driver_tx.send(Ok(StreamPart::Usage(crate::stream::Usage {"},{"lineNumber":487,"content":"        // Dropping `rig_stream` (and with it the hook's sender) plus `driver_tx`"},{"lineNumber":488,"content":"        // here closes the channel, ending the consumer stream below."},{"lineNumber":491,"content":"    // Abort the driver when the consumer drops the returned stream (e.g. on"},{"lineNumber":492,"content":"    // cancellation), which drops `rig_stream` and cancels any in-flight tool —"},{"lineNumber":493,"content":"    // matching the prior behaviour where the rig stream lived inline."},{"lineNumber":502,"content":"    let stream = async_stream::stream! {"},{"lineNumber":509,"content":"    Box::pin(stream)"},{"lineNumber":514,"content":"/// Mirrors the production arms: it just drives [`drive_stream`]."},{"lineNumber":518,"content":"    fn run_stream_dyn<'a>("},{"lineNumber":541,"content":"    fn run_stream_dyn<'a>("},{"lineNumber":556,"content":"        Box::pin(drive_stream("}]},{"file":"./crates/agent/src/model/anthropic.rs","matches":[{"lineNumber":2,"content":"use rig_core::{client::CompletionClient, providers::anthropic};"},{"lineNumber":21,"content":"    /// The rig completion model for this id. The id is passed verbatim to the"},{"lineNumber":28,"content":"    /// into the request body by rig, or `None` if the model doesn't support it."}]},{"file":"./crates/agent/src/model/predefined_model.rs","matches":[{"lineNumber":5,"content":"use rig_core::providers::anthropic::completion::{"},{"lineNumber":8,"content":"use rig_core::providers::openai::{GPT_5_5, GPT_5_MINI};"}]},{"file":"./crates/agent/src/accumulator.rs","matches":[{"lineNumber":2,"content":"use crate::stream::{StreamPart, ToolResponse};"},{"lineNumber":5,"content":"/// Accumulates [`StreamPart`]s emitted by an agent stream into an ordered"},{"lineNumber":8,"content":"/// Parts are stored in arrival order exactly as they stream in. Consecutive"},{"lineNumber":10,"content":"/// accessed via [`StreamAccumulator::into_parts`] or"},{"lineNumber":31,"content":"    /// a consumer can forward it as an individual streamed chunk."},{"lineNumber":33,"content":"        let part = stream_part_to_message_part(part)?;"},{"lineNumber":62,"content":"/// originating service is preserved. Usage events and empty text/thinking"},{"lineNumber":64,"content":"fn stream_part_to_message_part(part: StreamPart) -> Option<AssistantMessagePart> {"}]},{"file":"./crates/agent/src/error.rs","matches":[{"lineNumber":1,"content":"use rig_agent::agent::StreamingError;"},{"lineNumber":2,"content":"use rig_agent::completion::PromptError;"},{"lineNumber":3,"content":"use rig_core::completion::CompletionError;"},{"lineNumber":14,"content":"    /// An error from the RIG streaming layer."},{"lineNumber":34,"content":"    ProviderClientError(#[from] rig_core::client::ProviderClientError),"},{"lineNumber":37,"content":"    RigHttpClient(#[from] rig_core::http_client::Error),"}]}],"totalLines":417,"totalMatchedLines":417,"clientTruncated":true,"headLimitApplied":80}}}}}},"toolCallId":"tool_9a927441-609e-419f-824f-e4ac43ee0c8","startedAtMs":"1787344996970","completedAtMs":"1787344997090"}},{"toolCall":{"grepToolCall":{"args":{"pattern":"rig|async_openai|stream.*response|ChatCompletionStream","glob":"services/document_cognition_service/**/*","outputMode":"content","caseInsensitive":false,"headLimit":80,"multiline":false,"toolCallId":"tool_9d198f99-c70b-4488-bffb-df19322fd57","offset":0},"result":{"success":{"pattern":"rig|async_openai|stream.*response|ChatCompletionStream","outputMode":"content","workspaceResults":{"/workspace":{"content":{"matches":[{"file":"./servi