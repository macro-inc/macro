load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "ai_toolset",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/ai_toolset"},
    deps = [
        "//crates/bot_id:bot_id",
        "//crates/genai_telemetry:genai_telemetry",
        "//crates/macro_user_id:macro_user_id",
        "@crates//:anyhow-1.0.103",
        "@crates//:axum-0.8.9",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
        "@crates//:axum-macros-0.5.1",
    ],
    aliases = {},
)

rust_test(
    name = "ai_toolset_unit",
    crate = ":ai_toolset",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/ai_toolset"},
    deps = [
        "@crates//:opentelemetry-0.31.0",
        "@crates//:opentelemetry_sdk-0.31.0",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-opentelemetry-0.32.1",
        "@crates//:tracing-subscriber-0.3.23",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/ai_toolset"},
)

