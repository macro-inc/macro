load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "macro_tower_layers",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_tower_layers"},
    deps = [
        "@crates//:axum-0.8.9",
        "@crates//:http-1.4.0",
        "@crates//:opentelemetry-0.31.0",
        "@crates//:opentelemetry-http-0.31.0",
        "@crates//:tokio-1.54.1",
        "@crates//:tower-0.5.3",
        "@crates//:tower-http-0.6.11",
        "@crates//:tracing-0.1.44",
        "@crates//:tracing-opentelemetry-0.32.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "macro_tower_layers_unit",
    crate = ":macro_tower_layers",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_tower_layers"},
    deps = [
        "@crates//:opentelemetry_sdk-0.31.0",
        "@crates//:tracing-subscriber-0.3.23",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_tower_layers"},
)

