load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "entity_access_db_utils",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/call:all_files", "//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/entity_access_db_utils", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "//crates/model-entity:model_entity",
        "//crates/model_owner:model_owner",
        "//crates/models_entity_access_management:models_entity_access_management",
        "//crates/models_permissions:models_permissions",
        "@crates//:anyhow-1.0.103",
        "@crates//:serde-1.0.228",
        "@crates//:sqlx-0.8.6",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "entity_access_db_utils_unit",
    crate = ":entity_access_db_utils",
    crate_features = [],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/entity_access_db_utils", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "@crates//:tokio-1.54.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/call:all_files", "//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/entity_access_db_utils"},
)

