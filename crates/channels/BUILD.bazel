rust_test(
    name = "channels_unit",
    crate = ":channels",
    crate_features = [
        "ai_tools",
        "attachment",
        "entity_mutation",
        "inbound",
        "kafka_consumer",
        "list",
        "outbound",
        "ports",
        "schema",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/channels", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "//crates/macro_env_var:macro_env_var",
