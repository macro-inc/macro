    ],
    proc_macro_deps = [],
    aliases = {"//crates/notification:notification": "notification_hex"},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/channels"},
)

