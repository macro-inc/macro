load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "serde_utils",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "urlencode",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/serde_utils"},
    deps = [
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:urlencoding-2.1.3",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "serde_utils_unit",
    crate = ":serde_utils",
    crate_features = [
        "urlencode",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/serde_utils"},
    deps = [
        "@crates//:cool_asserts-2.0.4",
        "@crates//:serde_urlencoded-0.7.1",
        "@crates//:url-2.5.8",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/serde_utils"},
)

