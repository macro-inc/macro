    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/call:all_files", "//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/entity_access", "SQLX_OFFLINE": "true"},
