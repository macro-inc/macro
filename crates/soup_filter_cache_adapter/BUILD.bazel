load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "soup_filter_cache_adapter",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_apps_web_src_lib_service_clients_service_storage_graphql_soup_graphql", "//crates/soup_filter_projection:all_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_filter_cache_adapter"},
    deps = [
        "//crates/client/cache-core:cache_core",
        "//crates/graphql_soup_filter_input:graphql_soup_filter_input",
        "//crates/item_filter_index:item_filter_index",
        "//crates/predicate_index:predicate_index",
        "//crates/soup_filter_projection:soup_filter_projection",
        "@crates//:chrono-0.4.45",
        "@crates//:indexmap-2.14.0",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "soup_filter_cache_adapter_unit",
    crate = ":soup_filter_cache_adapter",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_filter_cache_adapter"},
    deps = [
        "//crates/client/cache-turso:cache_turso",
        "@crates//:pollster-0.4.0",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_apps_web_src_lib_service_clients_service_storage_graphql_soup_graphql", "//crates/soup_filter_projection:all_files"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_filter_cache_adapter"},
)

