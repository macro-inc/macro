load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "stream",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "redis-test",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/stream", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/model-entity:model_entity",
        "@crates//:anyhow-1.0.103",
        "@crates//:async-stream-0.3.6",
        "@crates//:dashmap-6.2.1",
        "@crates//:futures-0.3.32",
        "@crates//:redis-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "stream_unit",
    crate = ":stream",
    crate_features = [
        "redis-test",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/stream", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "@crates//:serial_test-3.4.0",
        "@crates//:tokio-test-0.4.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/stream"},
)

rust_binary(
    name = "stream_stdin_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "stream_stdin",
    crate_root = "src/bin/stream_stdin.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "redis-test",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/stream", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/model-entity:model_entity",
        ":stream",
        "@crates//:anyhow-1.0.103",
        "@crates//:async-stream-0.3.6",
        "@crates//:dashmap-6.2.1",
        "@crates//:futures-0.3.32",
        "@crates//:redis-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

