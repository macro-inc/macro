load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "fusionauth",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/fusionauth"},
    deps = [
        "//crates/upstream_error:upstream_error",
        "@crates//:anyhow-1.0.103",
        "@crates//:base64-0.22.1",
        "@crates//:jsonwebtoken-10.3.0",
        "@crates//:reqwest-0.13.4",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:serde_urlencoded-0.7.1",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:urlencoding-2.1.3",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "fusionauth_unit",
    crate = ":fusionauth",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/fusionauth"},
    deps = [
        "@crates//:tokio-1.54.1",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/fusionauth"},
)

