load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "secretsmanager_client",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "local",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/secretsmanager_client"},
    deps = [
        "//crates/macro_env:macro_env",
        "//crates/remote_env_var:remote_env_var",
        "@crates//:aws-sdk-secretsmanager-1.105.0",
        "@crates//:mockall-0.13.1",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "secretsmanager_client_unit",
    crate = ":secretsmanager_client",
    crate_features = [
        "local",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/secretsmanager_client"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/secretsmanager_client"},
)

