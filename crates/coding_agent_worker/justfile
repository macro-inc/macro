# Manual test loop for external agent sessions, end to end.
#
# From this directory (or `just -f crates/coding_agent_worker/justfile ...`):
#
#   just seed_bot                      # once: demo agent bot + token in the local stack DB
#   just create_session                # POST /agent-sessions; prints id + gatewayUrl
#   <put id/gatewayUrl in macro.toml>  # or edit in place; then:
#   just run                           # the worker (holds the bridge; silence = healthy)
#   just prompt <id> "do the thing"    # first prompt via the control endpoint
#   just frames <id>                   # raw ACP frames, both directions, from the log
#   just status <id>                   # session row status
#
# Defaults target the `just run_local` stack; override with env vars:
#   AGENT_BASE, BOT_TOKEN, BOT_SCOPE, MACRO_DB, SESSION_OWNER

BASE := env("AGENT_BASE", "http://localhost:50009/agent-harness")
TOKEN := env("BOT_TOKEN", "mbot_demo_wolflocal0000000000000000000000")
SCOPE := env("BOT_SCOPE", "user")
DB := env("MACRO_DB", "postgres://user:password@localhost:50000/macrodb")
OWNER := env("SESSION_OWNER", "macro|wolf@macro.com")
BOT_ID := env("BOT_ID", "11111111-1111-1111-1111-111111111111")

# Seed (or re-arm) the demo agent bot and its token. Idempotent.
seed_bot:
    psql "{{ DB }}" -c "INSERT INTO bots (id, kind, owner_user_id, name, handle, created_by, has_agent) VALUES ('{{ BOT_ID }}', 'owned', '{{ OWNER }}', 'Wolf Dev Agent', 'wolfdev', '{{ OWNER }}', true) ON CONFLICT (id) DO UPDATE SET has_agent = true"
    psql "{{ DB }}" -c "INSERT INTO bot_tokens (id, bot_id, token) SELECT gen_random_uuid(), '{{ BOT_ID }}', '{{ TOKEN }}' WHERE NOT EXISTS (SELECT 1 FROM bot_tokens WHERE token = '{{ TOKEN }}')"

# Open an external session for WORKSPACE (defaults to where you ran just).
create_session workspace=invocation_directory():
    curl -sX POST "{{ BASE }}/agent-sessions" \
        -H 'content-type: application/json' \
        -H 'x-macro-bot-token: {{ TOKEN }}' -H 'x-macro-bot-scope: {{ SCOPE }}' \
        -d '{"workspace": "{{ workspace }}", "owner": "{{ OWNER }}"}' | python3 -m json.tool

# Run the worker against ../../macro.toml (repo root).
run:
    cargo run -p coding_agent_worker -- --config {{ justfile_directory() }}/../../macro.toml

# Send a prompt to a live session through the control endpoint.
#
# The acting-user header matters: a user-scoped bot resolves its session
# access through the user it acts for, so control calls act for the session
# owner. This is also what the phase-5 daemon will send (the mention's
# sender).
prompt session text:
    curl -sX POST "{{ BASE }}/agent-sessions/{{ session }}/control" \
        -H 'content-type: application/json' \
        -H 'x-macro-bot-token: {{ TOKEN }}' -H 'x-macro-bot-scope: {{ SCOPE }}' \
        -H 'x-macro-bot-for-macro-user-id: {{ OWNER }}' \
        -d '{"type": "prompt", "prompt": "{{ text }}"}'
    @echo

# The session row: status and negotiated ACP session id.
status session:
    psql "{{ DB }}" -c "SELECT status, status_event_name, acp_session_id, workspace FROM agent_session WHERE id = '{{ session }}'"

# Every logged ACP frame, both directions, oldest first.
frames session:
    psql "{{ DB }}" -c "SELECT created_at::time, direction, left(content::text, 140) AS frame FROM agent_session_log WHERE agent_session_id = '{{ session }}' ORDER BY created_at"

# Tail the harness service container.
service_logs:
    docker logs -f macro-lazy-websockets-agent_harness_service-1

# Delete a session so its (thread, bot) slot frees up.
delete_session session:
    psql "{{ DB }}" -c "DELETE FROM agent_session_log WHERE agent_session_id = '{{ session }}'; DELETE FROM agent_session WHERE id = '{{ session }}'"
