[Unit]
Description=Private Claude token storage

[Service]
ExecStart=/usr/local/bin/macrod computer-token-store --owner {owner}
User=root
RuntimeDirectory=macrod
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/macrod /run/macrod
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
