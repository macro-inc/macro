load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "calendar_events",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_tools",
        "call-meetings",
        "default",
        "dispatch",
        "dispatch-sqs",
        "google",
        "inbound",
        "mutation-client",
        "notify",
        "outlook",
        "postgres",
        "schema",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/calendar_events", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/ai_toolset:ai_toolset",
        "//crates/call:call",
        "//crates/email_utils:email_utils",
        "//crates/email_validator:email_validator",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_event_broker:macro_event_broker",
        "//crates/macro_event_topics:macro_event_topics",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-entity:model_entity",
        "//crates/model_notifications:model_notifications",
        "//crates/models_pagination:models_pagination",
        "//crates/notification:notification",
        "@crates//:anyhow-1.0.103",
        "@crates//:aws-sdk-sqs-1.99.0",
        "@crates//:axum-0.8.9",
        "@crates//:chrono-0.4.45",
        "@crates//:chrono-tz-0.10.4",
        "@crates//:futures-0.3.32",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:sqlx-0.8.6",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:urlencoding-2.1.3",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "calendar_events_unit",
    crate = ":calendar_events",
    crate_features = [
        "ai_tools",
        "call-meetings",
        "default",
        "dispatch",
        "dispatch-sqs",
        "google",
        "inbound",
        "mutation-client",
        "notify",
        "outlook",
        "postgres",
        "schema",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/calendar_events", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:all_files", "//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/calendar_events"},
)

