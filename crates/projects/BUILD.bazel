rust_test(
    name = "projects_unit",
    crate = ":projects",
    crate_features = [
        "ai_tools",
        "axum",
        "default",
        "inbound",
        "outbound",
        "ports",
        "service",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/projects", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/kafka_util:kafka_util",
