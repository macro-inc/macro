load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "projects",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_tools",
        "axum",
        "default",
        "inbound",
        "outbound",
        "ports",
        "service",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/projects", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/activity:activity",
        "//crates/ai_toolset:ai_toolset",
        "//crates/bot_id:bot_id",
        "//crates/document_sub_type:document_sub_type",
        "//crates/documents:documents",
        "//crates/dynamodb_client:dynamodb_client",
        "//crates/entity_access:entity_access",
        "//crates/entity_access_db_utils:entity_access_db_utils",
        "//crates/entity_access_management:entity_access_management",
        "//crates/entity_mutation:entity_mutation",
        "//crates/entity_registry/entity_registry:entity_registry",
        "//crates/entity_registry/entity_registry_db_utils:entity_registry_db_utils",
        "//crates/entity_registry/shared_entity_registry:shared_entity_registry",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_aws_config:macro_aws_config",
        "//crates/macro_env_var:macro_env_var",
        "//crates/macro_event_broker:macro_event_broker",
        "//crates/macro_event_topics:macro_event_topics",
        "//crates/macro_sha_count_client:macro_sha_count_client",
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "//crates/model-entity:model_entity",
        "//crates/model-error-response:model_error_response",
        "//crates/model:model",
        "//crates/model_owner:model_owner",
        "//crates/models_bulk_upload:models_bulk_upload",
        "//crates/models_permissions:models_permissions",
        "//crates/s3_key:s3_key",
        "//crates/share_permission_db_utils:share_permission_db_utils",
        "//crates/sqs_client:sqs_client",
        "//crates/system_properties:system_properties",
        "@crates//:anyhow-1.0.103",
        "@crates//:aws-sdk-s3-1.133.0",
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:base64-0.22.1",
        "@crates//:chrono-0.4.45",
        "@crates//:futures-0.3.32",
        "@crates//:hex-0.4.3",
        "@crates//:rootcause-0.12.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
