    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    deps = [
        "@crates//:prost-build-0.14.3",
        "@crates//:protox-0.10.0",
