load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "graphql_work_feed",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_work_feed"},
    deps = [
        "//crates/attention_feed:attention_feed",
        "//crates/graphql_common:graphql_common",
        "//crates/graphql_notification:graphql_notification",
        "//crates/graphql_soup:graphql_soup",
        "//crates/macro_user_id:macro_user_id",
        "//crates/soup:soup",
        "//crates/work_feed:work_feed",
        "@crates//:async-graphql-7.2.1",
        "@crates//:async-stream-0.3.6",
        "@crates//:futures-0.3.32",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "graphql_work_feed_unit",
    crate = ":graphql_work_feed",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_work_feed"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_work_feed"},
)

