rust_test(
    name = "notification_unit",
    crate = ":notification",
    crate_features = [
        "ai_tool",
        "axum",
        "clear_ios_push",
        "default",
        "docs",
        "kafka",
        "redis-tests",
        "schema",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/notification", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
