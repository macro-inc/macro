load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "notification",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_tool",
        "axum",
        "clear_ios_push",
        "default",
        "docs",
        "kafka",
        "redis-tests",
        "schema",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/notification", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/ai_toolset:ai_toolset",
        "//crates/broadcast:broadcast",
        "//crates/cowlike:cowlike",
        "//crates/kafka_util:kafka_util",
        "//crates/last_online_tracker:last_online_tracker",
        "//crates/macro_authorization:macro_authorization",
