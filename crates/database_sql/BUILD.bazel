load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "database_sql",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
        "openapi",
        "schema",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_apps_web_src_lib_core_database_sql_generated_types_ts"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/database_sql"},
    deps = [
        "//crates/filter_ast:filter_ast",
        "//crates/item_filters:item_filters",
        "//crates/maybe_send:maybe_send",
        "//crates/models_databases:models_databases",
        "@crates//:chrono-0.4.45",
        "@crates//:logos-0.16.1",
        "@crates//:nom-8.0.0",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:specta-serde-0.0.12",
        "@crates//:specta-typescript-0.0.12",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "database_sql_unit",
    crate = ":database_sql",
    crate_features = [
        "cli",
        "openapi",
        "schema",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/database_sql"},
    deps = [
        "@crates//:clap-4.6.1",
        "@crates//:pollster-0.4.0",
        "@crates//:reqwest-0.13.4",
        "@crates//:serde_json-1.0.150",
        "@crates//:tokio-1.54.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_apps_web_src_lib_core_database_sql_generated_types_ts"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/database_sql"},
)

rust_binary(
    name = "database_sql_types_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "database_sql_types",
    crate_root = "src/bin/database_sql_types.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
        "openapi",
        "schema",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_apps_web_src_lib_core_database_sql_generated_types_ts"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/database_sql"},
    deps = [
        "//crates/filter_ast:filter_ast",
        "//crates/item_filters:item_filters",
        "//crates/maybe_send:maybe_send",
        "//crates/models_databases:models_databases",
        ":database_sql",
        "@crates//:chrono-0.4.45",
        "@crates//:logos-0.16.1",
        "@crates//:nom-8.0.0",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:specta-serde-0.0.12",
        "@crates//:specta-typescript-0.0.12",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

