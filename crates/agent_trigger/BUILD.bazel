load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "agent_trigger",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "admission",
        "outbound",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_trigger", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/agent:agent",
        "//crates/agent_session:agent_session",
        "//crates/ai_billing:ai_billing",
        "//crates/ai_usage:ai_usage",
        "//crates/bot_id:bot_id",
        "//crates/bots:bots",
        "//crates/call:call",
        "//crates/channel_sender:channel_sender",
        "//crates/channels:channels",
        "//crates/document_storage_service_client:document_storage_service_client",
        "//crates/document_sub_type:document_sub_type",
        "//crates/entity_access:entity_access",
        "//crates/initiative:initiative",
        "//crates/jev:jev",
        "//crates/lexical_client:lexical_client",
        "//crates/macro_event_broker:macro_event_broker",
        "//crates/macro_event_topics:macro_event_topics",
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "//crates/messages:messages",
        "//crates/models_properties:models_properties",
        "//crates/properties:properties",
        "//crates/static_file:static_file",
        "//crates/system_properties:system_properties",
        "//crates/trigger_context:trigger_context",
        "@crates//:anyhow-1.0.103",
        "@crates//:chrono-0.4.45",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:sqlx-0.8.6",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "agent_trigger_unit",
    crate = ":agent_trigger",
    crate_features = [
        "admission",
        "outbound",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_trigger", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "//crates/model_owner:model_owner",
        "@crates//:mime-0.3.17",
        "@crates//:mockall-0.13.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_trigger"},
)

