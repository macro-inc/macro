load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "dictation",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "inbound",
        "outbound",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/dictation"},
    deps = [
        "//crates/ai_usage:ai_usage",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_env_var:macro_env_var",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-error-response:model_error_response",
        "//crates/rate_limit:rate_limit",
        "@crates//:async-openai-0.36.1",
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:backoff-0.4.0",
        "@crates//:bytes-1.11.1",
        "@crates//:infer-0.19.0",
        "@crates//:opus-pure-0.2.1",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:symphonia-0.6.1",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "dictation_unit",
    crate = ":dictation",
    crate_features = [
        "default",
        "inbound",
        "outbound",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/dictation"},
    deps = [
        "//crates/model_user:model_user",
        "@crates//:http-body-util-0.1.3",
        "@crates//:serde_json-1.0.150",
        "@crates//:tower-0.5.3",
        "@crates//:tracing-subscriber-0.3.23",
        "@crates//:uuid-1.23.1",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/dictation"},
)

