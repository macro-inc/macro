load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "databases_sql",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "ai_tools",
        "default",
        "inbound",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/databases_sql"},
    deps = [
        "//crates/ai_toolset:ai_toolset",
        "//crates/bot_id:bot_id",
        "//crates/contacts:contacts",
        "//crates/database_sql:database_sql",
        "//crates/databases:databases",
        "//crates/email:email",
        "//crates/entity_access:entity_access",
        "//crates/filter_ast:filter_ast",
        "//crates/item_filters:item_filters",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-error-response:model_error_response",
        "//crates/models_databases:models_databases",
        "//crates/models_grouping:models_grouping",
        "//crates/models_pagination:models_pagination",
        "//crates/models_properties:models_properties",
        "//crates/models_soup:models_soup",
        "//crates/soup:soup",
        "@crates//:anyhow-1.0.103",
        "@crates//:axum-0.8.9",
        "@crates//:base64-0.22.1",
        "@crates//:chrono-0.4.45",
        "@crates//:rootcause-0.12.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "databases_sql_unit",
    crate = ":databases_sql",
    crate_features = [
        "ai_tools",
        "default",
        "inbound",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/databases_sql"},
    deps = [
        "//crates/model_owner:model_owner",
        "@crates//:tokio-1.54.1",
        "@crates//:tower-0.5.3",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/databases_sql"},
)

