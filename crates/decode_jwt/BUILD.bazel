load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "decode_jwt",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "local_auth",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/decode_jwt"},
    deps = [
        "//crates/macro_auth:macro_auth",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-error-response:model_error_response",
        "//crates/model_user:model_user",
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:serde-1.0.228",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "decode_jwt_unit",
    crate = ":decode_jwt",
    crate_features = [
        "local_auth",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/decode_jwt"},
    deps = [
        "@crates//:cookie-0.18.1",
        "@crates//:http-body-util-0.1.3",
        "@crates//:jsonwebtoken-10.3.0",
        "@crates//:serde_json-1.0.150",
        "@crates//:serde_urlencoded-0.7.1",
        "@crates//:tokio-1.54.1",
        "@crates//:tower-0.5.3",
        "@crates//:url-2.5.8",
        "@crates//:urlencoding-2.1.3",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/decode_jwt"},
)

