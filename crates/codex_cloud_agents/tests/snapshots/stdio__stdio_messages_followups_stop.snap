      }
    }
  ],
  "followup": [
    {
      "jsonrpc": "2.0",
      "method": "session/update",
      "params": {
        "sessionId": "SESSION",
        "update": {
          "sessionUpdate": "agent_message_chunk",
          "content": {
            "type": "text",
            "text": "Hello 🌍"
          }
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 4,
      "result": {
        "stopReason": "end_turn"
      }
    }
  ],
  "stop": [
    {
      "jsonrpc": "2.0",
      "method": "session/update",
      "params": {
        "sessionId": "SESSION",
        "update": {
          "sessionUpdate": "tool_call",
          "toolCallId": "running-tool",
          "title": "sleep 60",
          "kind": "execute",
          "status": "in_progress",
          "rawInput": {
            "id": "running-tool",
            "type": "commandExecution",
            "command": "sleep 60"
          }
