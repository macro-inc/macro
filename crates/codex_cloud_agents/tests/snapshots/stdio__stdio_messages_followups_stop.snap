        "name": "codex_acp",
        "version": "0.1.0"
      }
    }
  },
  "new": [
    {
      "jsonrpc": "2.0",
      "id": 2,
      "result": {
        "sessionId": "SESSION"
      }
    }
  ],
  "first": [
    {
      "jsonrpc": "2.0",
      "method": "session/update",
      "params": {
        "sessionId": "SESSION",
        "update": {
          "sessionUpdate": "agent_message_chunk",
          "content": {
            "type": "text",
            "text": "Hello 🌍"
          }
        }
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 3,
