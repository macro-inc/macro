load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "agent_session_realtime",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "redis",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_session_realtime"},
    deps = [
        "//crates/agent_session:agent_session",
        "//crates/broadcast:broadcast",
        "//crates/macro_uuid:macro_uuid",
        "@crates//:chrono-0.4.45",
        "@crates//:redis-1.2.1",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde_json-1.0.150",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-retry-0.3.2",
        "@crates//:tracing-0.1.44",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "agent_session_realtime_unit",
    crate = ":agent_session_realtime",
    crate_features = [
        "default",
        "redis",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_session_realtime"},
    deps = [
        "//crates/agent_runtime_protocol:agent_runtime_protocol",
        "//crates/macro_env_var:macro_env_var",
        "@crates//:agent-client-protocol-2.0.0",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_session_realtime"},
)

