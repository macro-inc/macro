load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "sync_service_client",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_infra_local_certs_ca_pem"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/sync_service_client"},
    deps = [
        "//crates/macro_sync_service_jwt:macro_sync_service_jwt",
        "//crates/model:model",
        "//crates/sync_service:sync_service_hex",
        "@crates//:anyhow-1.0.103",
        "@crates//:base64-0.22.1",
        "@crates//:reqwest-0.13.4",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "sync_service_client_unit",
    crate = ":sync_service_client",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/sync_service_client"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_infra_local_certs_ca_pem"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/sync_service_client"},
)

