load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "agent_runtime_protocol",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "test-utils",
        "transport",
        "utoipa",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_services_coding_agent_worker_src_protocol_generated_ts"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_runtime_protocol"},
    deps = [
        "//crates/macro_uuid:macro_uuid",
        "@crates//:agent-client-protocol-2.0.0",
        "@crates//:axum-0.8.9",
        "@crates//:futures-0.3.32",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:specta-serde-0.0.12",
        "@crates//:specta-typescript-0.0.12",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-tungstenite-0.28.0",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "agent_runtime_protocol_unit",
    crate = ":agent_runtime_protocol",
    crate_features = [
        "default",
        "test-utils",
        "transport",
        "utoipa",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_runtime_protocol"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_services_coding_agent_worker_src_protocol_generated_ts"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_runtime_protocol"},
)

rust_binary(
    name = "export_types_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "export_types",
    crate_root = "src/bin/export_types.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "test-utils",
        "transport",
        "utoipa",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_services_coding_agent_worker_src_protocol_generated_ts"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_runtime_protocol"},
    deps = [
        "//crates/macro_uuid:macro_uuid",
        ":agent_runtime_protocol",
        "@crates//:agent-client-protocol-2.0.0",
        "@crates//:axum-0.8.9",
        "@crates//:futures-0.3.32",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:specta-2.0.0-rc.25",
        "@crates//:specta-serde-0.0.12",
        "@crates//:specta-typescript-0.0.12",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-tungstenite-0.28.0",
        "@crates//:tracing-0.1.44",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

