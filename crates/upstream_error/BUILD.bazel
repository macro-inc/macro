load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "upstream_error",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "axum",
        "default",
        "reqwest",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/upstream_error"},
    deps = [
        "@crates//:axum-0.8.9",
        "@crates//:http-1.4.0",
        "@crates//:reqwest-0.13.4",
        "@crates//:serde-1.0.228",
        "@crates//:thiserror-2.0.18",
        "@crates//:utoipa-5.5.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "upstream_error_unit",
    crate = ":upstream_error",
    crate_features = [
        "axum",
        "default",
        "reqwest",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/upstream_error"},
    deps = [
        "@crates//:http-body-util-0.1.3",
        "@crates//:serde_json-1.0.150",
        "@crates//:tokio-1.54.1",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/upstream_error"},
)

