                        String("1\tuse agent_runtime_protocol::domain::schema::v0::{SystemEvent, ToRuntimeMessage, ToServerMessage};\n2\tuse bots::domain::models::BotId;\n3\tuse chrono::{DateTime, Utc};\n4\tuse macro_user_id::user_id::MacroUserIdStr;\n5\tuse macro_uuid::Uuid;\n6\tuse serde::{Deserialize, Serialize};\n7\t\n8\tpub struct UninitializedSession;\n9\t\n10\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n11\tpub struct AgentSessionId(Uuid);\n12\t\n13\timpl AgentSessionId {\n14\t    /// Wrap an existing UUID as an agent session id.\n15\t    pub fn new_from_uuid(id: Uuid) -> Self {\n16\t        Self(id)\n17\t    }\n18\t\n19\t    /// The underlying UUID.\n20\t    pub fn as_uuid(&self) -> Uuid {\n21\t        self.0\n22\t    }\n23\t}\n24\t\n25\t#[derive(Debug, Clone, Default)]\n26\tpub enum SessionStatus {\n27\t    /// No status updates received\n28\t    #[default]\n29\t    NoMessages,\n30\t    /// EventRecieved from container\n31\t    Event(SystemEvent),\n32\t    /// A session disconnected without sending a clsoed event\n33\t    Disconnected,\n34\t}\n35\t\n36\t/// A running or historical agent coding session.\n37\t#[derive(Debug, Clone)]\n38\tpub struct AgentSession<SessionId> {\n39\t    /// id of the agent session\n40\t    pub id: SessionId,\n41\t    /// if this was created by `@` in a thread\n42\t    pub created_from_thread_id: Option<Uuid>,\n43\t    /// the thread id of the comms thread\n44\t    pub thread_id: Uuid,\n45\t    /// the bot id of the bot running the agent\n46\t    pub bot_id: BotId,\n47\t    /// model slug - TODO: probably a better type here\n48\t    pub model: String,\n49\t    /// harness slug - TODO: probably a better type here\n50\t    pub harness: String,\n51\t    /// repo we are working with\n52\t    pub repo_url: String,\n53\t    /// ACP session if we have one\n54\t    pub acp_session_id: Option<String>,\n55\t    pub status: SessionStatus,\n56\t    pub created_at: DateTime<Utc>,\n57\t    pub modified_at: DateTime<Utc>,\n58\t}\n59\t\n60\t/// One logical protocol message with its direction.\n61\t///\n62\t/// Serializes as `{\"direction\": \"to_server\" | \"to_runtime\", \"content\": <envelope>}`,\n63\t/// the same vocabulary the Postgres log storage uses for its `direction` and\n64\t/// `content` columns, so recorded fixtures and stored rows share one wire\n65\t/// format.\n66\t#[derive(Debug, Clone, Serialize, Deserialize)]\n67\t#[serde(tag = \"direction\", content = \"content\", rename_all = \"snake_case\")]\n68\tpub enum Message {\n69\t    ToServer(ToServerMessage),\n70\t    ToRuntime(ToRuntimeMessage),\n71\t}\n72\t\n73\t#[derive(Debug, Clone)]\n74\tpub struct AgentSessionLog {\n75\t    pub agent_session_id: AgentSessionId,\n76\t    /// if this is ACP sent by a user this will be Some\n77\t    pub user_id: Option<MacroUserIdStr<'static>>,\n78\t    pub content: Message,\n79\t}\n80\t"),
