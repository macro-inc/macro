                                    "    drop(service);\n    websocket_handle.abort();\n    match writer.await {\n        Ok(Ok(())) => eprintln!(\"recorder: session saved to {}\", path.display()),\n        Ok(Err(error)) => eprintln!(\"recorder: writing the recording failed: {error}\"),\n        Err(error) => eprintln!(\"recorder: recording writer panicked: {error}\"),\n    }\n    result\n}\n\n/// Where a session started at `now` is recorded for the user whose home\n/// directory is `home`.\nfn recording_path(home: &Path, now: DateTime<Utc>) -> PathBuf {\n    home.join(\".agent_runtime_sessions\")\n        .join(format!(\"{}.jsonl\", now.format(\"%Y-%m-%dT%H-%M-%SZ\")))\n}\n\n/// Append recorded lines to the session file until every sink handle drops.\n///\n/// Flushes after every line so a session killed mid-run keeps its data.\nasync fn run_writer(\n    path: PathBuf,\n    mut lines: mpsc::UnboundedReceiver<String>,\n) -> std::io::Result<()> {\n    if let Some(parent) = path.parent() {\n        tokio::fs::create_dir_all(parent).await?;\n    }\n    let mut file = tokio::fs::File::create(&path).await?;\n    while let Some(line) = lines.recv().await {\n        file.write_all(line.as_bytes()).await?;\n        file.write_all(b\"\\n\").await?;\n        file.flush().await?;\n    }\n    file.flush().await\n}\n",
