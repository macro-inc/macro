                            "content": String("#!/usr/bin/env python3\n\"\"\"Split per-process agent_session_recorder JSONL files into per-session files.\n\nMirrors the routing in crates/agent_session/examples/agent_session_recorder.rs:\n\n- lines naming `params.sessionId` go to that session's file;\n- responses are attributed via the JSON-RPC id of the request they answer\n  (ids are scoped by the direction of the request);\n- a request naming no session is held until its response shows whether it\n  minted a session (`session/new`);\n- connection-level lines (acp_ready, the initialize pair) are copied into\n  every session file so each recording stands alone.\n\nUsage: python3 split_recording.py <recording.jsonl> [...]\n\nOutput files land next to each source as <session-id>.jsonl. Files are\nOVERWRITTEN on the first touch of a run (re-running is idempotent for the\nsame sources), so re-run this only on the old per-process files — not after\nthe new per-session recorder has appended to a session file this would clobber.\nThe source files are left untouched.\n\"\"\"\n\nimport json\nimport sys\nfrom pathlib import Path\n\n\ndef opposite(direction):\n    return \"to_runtime\" if direction == \"to_server\" else \"to_server\"\n\n\ndef sanitize(session_id):\n    return \"\".join(\n        c if c.isascii() and (c.isalnum() or c in \"-_.\") else \"_\" for c in session_id\n    )\n\n\ndef split(source: Path):\n    \"\"\"Return ({session_id: [lines]}, [unattributable lines]).\"\"\"\n    shared = []  # connection-level lines, copied into every session file\n    sessions = {}\n\n    # (issuer direction, id json) -> (\"session\", sid) | (\"unattributed\", line)\n    pending = {}\n\n    def to_session(sid, line):\n        if sid not in sessions:\n            sessions[sid] = list(shared)\n        sessions[sid].append(line)\n\n    def to_shared(line):\n        shared.append(line)\n        for lines in sessions.values():\n            lines.append(line)\n\n    for raw in source.read_text().splitlines():\n        if not raw.strip():\n            continue\n        value = json.loads(raw)\n        direction = value.get(\"direction\")\n        content = value.get(\"content\") or {}\n        method = content.get(\"method\")\n        rpc_id = json.dumps(content[\"id\"]) if content.get(\"id\") is not None else None\n        params = content.get(\"params\")\n        sid = params.get(\"sessionId\") if isinstance(params, dict) else None\n\n        if method is not None and rpc_id is not None:  # request\n            if sid is not None:\n                pending[(direction, rpc_id)] = (\"session\", sid)\n                to_session(sid, raw)\n            else:\n                pending[(direction, rpc_id)] = (\"unattributed\", raw)\n        elif method is not None:  # notification\n            to_session(sid, raw) if sid is not None else to_shared(raw)\n        elif rpc_id is not None:  # response\n            kind, val = pending.pop((opposite(direction), rpc_id), (None, None))\n            if kind == \"session\":\n                to_session(val, raw)\n            elif kind == \"unattributed\":\n                result = content.get(\"result\")\n                minted = result.get(\"sessionId\") if isinstance(result, dict) else None\n                if minted is not None:\n                    to_session(minted, val)\n                    to_session(minted, raw)\n                else:\n                    to_shared(val)\n                    to_shared(raw)\n            else:\n                to_shared(raw)\n        else:  # not JSON-RPC, e.g. the acp_ready event\n            to_shared(raw)\n\n    # Requests that never got a response (connection died mid-request).\n    for key in sorted(pending):\n        kind, val = pending[key]\n        if kind == \"unattributed\":\n            to_shared(val)\n\n    return sessions\n\n\ndef main():\n    sources = [Path(arg).expanduser() for arg in sys.argv[1:]]\n    if not sources:\n        sys.exit(__doc__)\n\n    touched = set()\n    for source in sources:\n        sessions = split(source)\n        if not sessions:\n            print(f\"{source}: no sessions found\")\n            continue\n        for sid, lines in sessions.items():\n            target = source.parent / f\"{sanitize(sid)}.jsonl\"\n            if target.resolve() == source.resolve():\n                sys.exit(f\"refusing to overwrite source {source}\")\n            mode = \"a\" if target in touched else \"w\"\n            with open(target, mode) as f:\n                f.write(\"\\n\".join(lines) + \"\\n\")\n            touched.add(target)\n            print(f\"{source.name}: {len(lines):4} lines -> {target.name}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"),
