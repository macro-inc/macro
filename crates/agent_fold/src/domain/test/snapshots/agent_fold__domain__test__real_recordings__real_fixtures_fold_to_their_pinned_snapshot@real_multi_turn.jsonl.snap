                        String("1\tuse serde_json::{Value, json};\n2\tuse tokio::time::{Duration, timeout};\n3\t\n4\tuse super::*;\n5\t\n6\t#[test]\n7\tfn recording_path_is_timestamped_jsonl_under_home() {\n8\t    let now = DateTime::parse_from_rfc3339(\"2026-08-03T14:22:07Z\")\n9\t        .expect(\"timestamp should parse\")\n10\t        .with_timezone(&Utc);\n11\t\n12\t    assert_eq!(\n13\t        recording_path(Path::new(\"/home/user\"), now),\n14\t        PathBuf::from(\"/home/user/.agent_runtime_sessions/2026-08-03T14-22-07Z.jsonl\"),\n15\t    );\n16\t}\n17\t\n18\t#[tokio::test]\n19\tasync fn tap_records_and_forwards_both_directions() {\n20\t    let (inner, mut runtime_side) = Channel::duplex();\n21\t    let (sink, mut lines) = mpsc::unbounded_channel();\n22\t    let mut tapped = record_channel(inner, sink);\n23\t\n24\t    // Runtime -> service traffic is forwarded and recorded as to_server.\n25\t    runtime_side\n26\t        .tx\n27\t        .send(ToServerMessage::Event {\n28\t            event: SystemEvent::AcpReady,\n29\t        })\n30\t        .expect(\"tap should be listening\");\n31\t    let forwarded = timeout(Duration::from_secs(1), tapped.rx.recv())\n32\t        .await\n33\t        .expect(\"runtime message should be forwarded promptly\")\n34\t        .expect(\"tapped channel should stay open\");\n35\t    assert!(matches!(\n36\t        forwarded,\n37\t        ToServerMessage::Event {\n38\t            event: SystemEvent::AcpReady\n39\t        }\n40\t    ));\n41\t\n42\t    // Service -> runtime traffic is forwarded and recorded as to_runtime.\n43\t    let prompt: ToRuntimeMessage = serde_json::from_value(json!({\n44\t        \"type\": \"acp\",\n45\t        \"jsonrpc\": \"2.0\",\n46\t        \"id\": 1,\n47\t        \"method\": \"session/prompt\",\n48\t        \"params\": { \"sessionId\": \"sess-1\", \"prompt\": [] },\n49\t    }))\n50\t    .expect(\"envelope should deserialize\");\n51\t    tapped.tx.send(prompt).expect(\"tap should be listening\");\n52\t    let forwarded = timeout(Duration::from_secs(1), runtime_side.rx.recv())\n53\t        .await\n54\t        .expect(\"service message should be forwarded promptly\")\n55\t        .expect(\"runtime channel should stay open\");\n56\t    assert!(matches!(forwarded, ToRuntimeMessage::Acp(_)));\n57\t\n58\t    // Each direction was recorded before it was forwarded, so by the time\n59\t    // the forwards above were observed both lines are already in the sink,\n60\t    // in send order. Each line is Message's own serialization plus `ts`, so\n61\t    // it parses straight back into Message.\n62\t    let event_line = lines.recv().await.expect(\"event line\");\n63\t    let event_value: Value =\n64\t        serde_json::from_str(&event_line).expect(\"recorded line should be JSON\");\n65\t    assert_eq!(event_value[\"direction\"], \"to_server\");\n66\t    assert_eq!(\n67\t        event_value[\"content\"],\n68\t        json!({\"type\": \"event\", \"event\": \"acp_ready\"})\n69\t    );\n70\t    DateTime::parse_from_rfc3339(event_value[\"ts\"].as_str().expect(\"ts should be a string\"))\n71\t        .expect(\"ts should be RFC 3339\");\n72\t    let event_message: Message =\n73\t        serde_json::from_str(&event_line).expect(\"line should parse as Message\");\n74\t    assert!(matches!(\n75\t        event_message,\n76\t        Message::ToServer(ToServerMessage::Event {\n77\t            event: SystemEvent::AcpReady\n78\t        })\n79\t    ));\n80\t\n81\t    let prompt_line = lines.recv().await.expect(\"prompt line\");\n82\t    let prompt_value: Value =\n83\t        serde_json::from_str(&prompt_line).expect(\"recorded line should be JSON\");\n84\t    assert_eq!(prompt_value[\"direction\"], \"to_runtime\");\n85\t    assert_eq!(prompt_value[\"content\"][\"type\"], \"acp\");\n86\t    assert_eq!(prompt_value[\"content\"][\"method\"], \"session/prompt\");\n87\t    assert_eq!(prompt_value[\"content\"][\"params\"][\"sessionId\"], \"sess-1\");\n88\t    let prompt_message: Message =\n89\t        serde_json::from_str(&prompt_line).expect(\"line should parse as Message\");\n90\t    assert!(matches!(\n91\t        prompt_message,\n92\t        Message::ToRuntime(ToRuntimeMessage::Acp(_))\n93\t    ));\n94\t}\n95\t"),
                    ),
