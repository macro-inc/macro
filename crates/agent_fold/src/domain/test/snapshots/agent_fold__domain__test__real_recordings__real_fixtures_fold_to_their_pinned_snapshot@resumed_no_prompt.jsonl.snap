                    label: "Write",
                    status: Completed,
                    detail: Edit {
                        diffs: [
                            FileDiff {
                                path: "/Users/eric/Code/macro/crates/agent_fold/src/domain/service.rs",
                                old_text: None,
                                new_text: "//! The domain service implementing the query port.\n//!\n//! [`FoldedMessageService`] is the \"query engine\" of the pretend store: every\n//! query loads the session's log through\n//! [`AgentSessionLogRepo`](agent_session::domain::ports::AgentSessionLogRepo)\n//! and runs the fold. Anomalies the fold reports are logged as warnings\n//! rather than surfaced to callers - a query against a store should not fail\n//! because one frame was strange - so the only error a query can return is a\n//! failure to load the log itself.\n\nuse crate::domain::fold;\nuse crate::domain::message::{FoldedMessage, MessageId};\nuse crate::domain::ports::FoldedMessageRepo;\nuse agent_session::domain::model::AgentSessionId;\nuse agent_session::domain::ports::AgentSessionLogRepo;\n\n#[cfg(test)]\nmod test;\n\n/// Serves [`FoldedMessageRepo`] queries by folding the session log on read.\n#[derive(Debug, Clone)]\npub struct FoldedMessageService<Logs> {\n    logs: Logs,\n}\n\nimpl<Logs> FoldedMessageService<Logs> {\n    /// A service answering queries from the given log repo.\n    pub fn new(logs: Logs) -> Self {\n        Self { logs }\n    }\n}\n\nimpl<Logs> FoldedMessageService<Logs>\nwhere\n    Logs: AgentSessionLogRepo + Sync,\n{\n    /// Load and fold a session's log, reporting anomalies as warnings.\n    async fn fold_session(\n        &self,\n        session: AgentSessionId,\n    ) -> Result<Vec<FoldedMessage>, rootcause::Report> {\n        let log = self\n            .logs\n            .list_by_session(session)\n            .await\n            .map_err(|error| rootcause::report!(error))?;\n\n        let folded = fold::fold(log);\n        for anomaly in &folded.anomalies {\n            tracing::warn!(\n                anomaly = ?anomaly,\n                session = ?session,\n                \"agent session log frame could not be folded\"\n            );\n        }\n        Ok(folded.messages)\n    }\n}\n\nimpl<Logs> FoldedMessageRepo for FoldedMessageService<Logs>\nwhere\n    Logs: AgentSessionLogRepo + Sync,\n{\n    #[tracing::instrument(err, skip(self))]\n    async fn list_by_session(\n        &self,\n        session: AgentSessionId,\n    ) -> Result<Vec<FoldedMessage>, rootcause::Report> {\n        self.fold_session(session).await\n    }\n\n    #[tracing::instrument(err, skip(self))]\n    async fn get(\n        &self,\n        session: AgentSessionId,\n        id: MessageId,\n    ) -> Result<Option<FoldedMessage>, rootcause::Report> {\n        let messages = self.fold_session(session).await?;\n        Ok(messages.into_iter().find(|message| message.id() == id))\n    }\n}\n",
                            },
                        ],
                    },
                    raw_input: Some(
