                                old_text: None,
                                new_text: "#![deny(missing_docs)]\n//! Folds an agent session's protocol log into renderable messages.\n//!\n//! An agent session is recorded as a flat log of Agent Runtime Protocol\n//! frames - see `agent_session_log` and\n//! [`agent_runtime_protocol::domain::schema::v0`]. That log is faithful but\n//! unreadable: a single session is hundreds of streamed chunks, tool-call\n//! patches and token-usage reports. This crate collapses it into the handful\n//! of messages a person would recognize as the story of the session.\n//!\n//! Nothing here is persisted. [`fold`] is a pure function from log to\n//! messages, so its output vocabulary can change without a migration - the\n//! messages are re-derived on every read.\n//!\n//! ```no_run\n//! use agent_fold::{fold, LogEntry};\n//!\n//! # fn run(log: Vec<LogEntry>) {\n//! let folded = fold(log);\n//! for message in &folded.messages {\n//!     println!(\"{:?} said {} part(s)\", message.author, message.parts.len());\n//! }\n//! # }\n//! ```\n\n/// Collapsing a protocol log into messages.\npub mod fold;\n/// Harness-specific `_meta` extraction.\npub mod meta;\n/// The renderable message vocabulary.\npub mod message;\n\npub use fold::{Anomaly, Fold, LogEntry, LogMessage, fold};\npub use message::{\n    AnsiText, Author, FileDiff, FoldedMessage, MessagePart, Permission, PermissionOption,\n    PermissionOutcome, StopReason, ToolDetail, ToolStatus, ToolUse, ToolUseId, TurnId,\n};\n",
                            },
                        ],
                    },
