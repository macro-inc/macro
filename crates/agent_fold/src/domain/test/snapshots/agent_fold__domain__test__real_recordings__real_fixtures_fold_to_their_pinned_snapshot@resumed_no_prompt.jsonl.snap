                    raw_output: Some(
                        String("1\t//! Collapsing a session's protocol log into renderable messages.\n2\t//!\n3\t//! # Why this cannot fail\n4\t//!\n5\t//! [`fold`] is total. Messages are derived on every read, so returning an\n6\t//! error would mean rendering an empty channel - strictly worse than rendering\n7\t//! a partially-understood session. Every case that looks like a failure is\n8\t//! instead a state worth showing:\n9\t//!\n10\t//! - A tool call with no result is in flight, or was interrupted when the\n11\t//!   session died. Its status stays [`ToolStatus::Pending`].\n12\t//! - A tool call whose opening frame carried no useful fields gets them from\n13\t//!   later patches. Until then it renders as a bare tool row.\n14\t//! - A permission request with no answer is outstanding.\n15\t//!\n16\t//! What is left over - a patch for a tool call that was never opened, an\n17\t//! update variant this fold does not model - is reported through\n18\t//! [`Fold::anomalies`] instead. That keeps the render path lenient while\n19\t//! letting tests be strict: a replay test asserts `anomalies.is_empty()`, so\n20\t//! protocol drift fails loudly in CI rather than silently degrading in\n21\t//! production.\n22\t//!\n23\t//! # Why one match rather than a registry\n24\t//!\n25\t//! Dispatch is a single explicit `match` over the protocol, in [`fold`] and\n26\t//! the handlers it calls. A registry of self-describing handlers would move\n27\t//! the decision of what matches what into data, where it is invisible; here\n28\t//! every frame this fold understands is named in one place you can read\n29\t//! top-to-bottom, and every frame it ignores is an explicit arm.\n30\t\n31\tuse crate::message::{\n32\t    AnsiText, Author, FileDiff, FoldedMessage, MessagePart, Permission, PermissionOption,\n33\t    PermissionOutcome, StopReason, ToolDetail, ToolStatus, ToolUse, ToolUseId, TurnId,\n34\t};\n35\tuse crate::meta::{claude_code, command_from_raw_input};\n36\tuse agent_client_protocol::schema::v1::{\n37\t    ContentBlock, Meta, RequestId, Response, SessionNotification, SessionUpdate, ToolCall,\n38\t    ToolCallContent, ToolCallStatus, ToolCallUpdate, ToolKind,\n39\t};\n40\tuse agent_client_protocol::{RawJsonRpcMessage, RawJsonRpcParams};\n41\tuse agent_runtime_protocol::domain::schema::v0::{ToRuntimeMessage, ToServerMessage};\n42\tuse macro_user_id::user_id::MacroUserIdStr;\n43\tuse non_empty::NonEmpty;\n44\tuse std::collections::HashMap;\n45\tuse std::path::PathBuf;\n46\t\n47\t#[cfg(test)]\n48\tmod test;\n49\t\n50\t/// One row of a session's protocol log.\n51\t///\n52\t/// Mirrors `agent_session_log`, but is defined here so the fold depends only\n53\t/// on the protocol schema rather than on the crate that persists it.\n54\t#[derive(Debug, Clone)]\n55\tpub struct LogEntry {\n56\t    /// Set when this frame is ACP traffic that originated from a user.\n57\t    pub user_id: Option<MacroUserIdStr<'static>>,\n58\t    /// The frame, in its original direction.\n59\t    pub message: LogMessage,\n60\t}\n61\t\n62\t/// A logged frame, tagged with the direction it travelled.\n63\t#[derive(Debug, Clone)]\n64\tpub enum LogMessage {\n65\t    /// Agent Runtime to Agent Service.\n66\t    ToServer(ToServerMessage),\n67\t    /// Agent Service to Agent Runtime.\n68\t    ToRuntime(ToRuntimeMessage),\n69\t}\n70\t\n71\t/// The result of folding a log.\n72\t#[derive(Debug, Clone, Default)]\n73\tpub struct Fold {\n74\t    /// Renderable messages, in log order.\n75\t    pub messages: Vec<FoldedMessage>,\n76\t    /// Frames the fold could not place. Not failures - see the module docs.\n77\t    pub anomalies: Vec<Anomaly>,\n78\t}\n79\t\n80\t/// Something in the log the fold could not account for.\n81\t#[derive(Debug, Clone, PartialEq, Eq)]\n82\tpub enum Anomaly {\n83\t    /// A `tool_call_update` arrived for an id no `tool_call` had opened.\n84\t    ///\n85\t    /// Unobserved in practice: log rows are ordered by `created_at` then by a\n86\t    /// v7 uuid, which is itself time-ordered, so frames cannot be reordered.\n87\t    /// It is still reachable through `session/load`, where a resumed session's\n88\t    /// log legitimately begins mid-stream.\n89\t    PatchBeforeOpen {\n90\t        /// The unopened tool call.\n91\t        tool_call: ToolUseId,\n92\t    },\n93\t    /// A `session/update` whose variant this fold does not model.\n94\t    UnmodelledSessionUpdate {\n95\t        /// The variant's wire name, when it could be read.\n96\t        kind: String,\n97\t    },\n98\t    /// A `session/update` frame whose params would not deserialize.\n99\t    UndecodableSessionUpdate,\n100\t    /// A response arrived for a request id the fold was not tracking.\n101\t    UncorrelatedResponse,\n102\t}\n103\t\n104\t/// Collapse a session's protocol log into renderable messages.\n105\t///\n106\t/// Total by construction: unrecognized and incomplete frames land in\n107\t/// [`Fold::anomalies`] rather than aborting the fold. See the module docs for\n108\t/// why.\n109\t#[must_use]\n110\tpub fn fold(log: impl IntoIterator<Item = LogEntry>) -> Fold {\n111\t    let mut state = State::default();\n112\t\n113\t    for entry in log {\n114\t        // The one place the protocol is dispatched. Each arm names a frame\n115\t        // this fold understands; the rest are ignored on purpose.\n116\t        match &entry.message {\n117\t            LogMessage::ToRuntime(ToRuntimeMessage::Acp(acp)) => match &acp.0 {\n118\t                // A user's prompt opens a turn.\n119\t                RawJsonRpcMessage::Request(request) if &*request.method == \"session/prompt\" => {\n120\t                    state.begin_turn(\n121\t                        &request.id,\n122\t                        params_value(request.params.as_ref()),\n123\t                        entry.user_id,\n124\t                    );\n125\t                }\n126\t                // The user's answer to a permission request.\n127\t                RawJsonRpcMessage::Response(Response::Result { id, result }) => {\n128\t                    state.resolve_permission(id, Some(result));\n129\t                }\n130\t                RawJsonRpcMessage::Response(Response::Error { id, .. }) => {\n131\t                    state.resolve_permission(id, None);\n132\t                }\n133\t                // Handshake and configuration traffic: nothing to render.\n134\t                RawJsonRpcMessage::Request(_) | RawJsonRpcMessage::Notification(_) => {}\n135\t            },\n136\t\n137\t            LogMessage::ToServer(ToServerMessage::Acp(acp)) => match &acp.0 {\n138\t                // The bulk of the log: streamed content and tool activity.\n139\t                RawJsonRpcMessage::Notification(notification)\n140\t                    if &*notification.method == \"session/update\" =>\n141\t                {\n142\t                    state.apply_session_update(params_value(notification.params.as_ref()));\n143\t                }\n144\t                // The agent asking to proceed.\n145\t                RawJsonRpcMessage::Request(request)\n146\t                    if &*request.method == \"session/request_permission\" =>\n147\t                {\n148\t                    state.request_permission(&request.id, params_value(request.params.as_ref()));\n149\t                }\n150\t                // The response to `session/prompt` closes the turn.\n151\t                RawJsonRpcMessage::Response(Response::Result { id, result }) => {\n152\t                    state.end_turn(id, Some(result));\n153\t                }\n154\t                RawJsonRpcMessage::Response(Response::Error { id, .. }) => {\n155\t                    state.end_turn(id, None);\n156\t                }\n157\t                RawJsonRpcMessage::Request(_) | RawJsonRpcMessage::Notification(_) => {}\n158\t            },\n159\t\n160\t            // Runtime lifecycle events carry no conversation content. The one\n161\t            // the service acts on, `acp_ready`, is a handshake signal.\n162\t            LogMessage::ToServer(ToServerMessage::Event { .. }) => {}\n163\t\n164\t            // Both message enums are `#[non_exhaustive]`.\n165\t            _ => {}\n166\t        }\n167\t    }\n168\t\n169\t    state.finish()\n170\t}\n171\t\n172\t/// Accumulated fold state.\n173\t#[derive(Default)]\n174\tstruct State {\n175\t    messages: Vec<FoldedMessage>,"),
                    ),
                },
                ToolUse {
                    id: ToolUseId(
                        "toolu_01Dvw8FiPMEqdtL4XDjktdfQ",
