                    raw_output: Some(
                        String("/Users/eric/.agent_runtime_sessions:\n1c6f5dbc-0fa8-4558-8ebb-3165a1daea56.jsonl\nab25cf29-d876-4ec6-9c30-dac24f13bcfe.jsonl\ncdf15e0e-c8b7-486e-93de-f596f547e641.jsonl\n\u{1b}[0m\u{1b}[01;34mclaude_config\u{1b}[0m\n\n/Users/eric/.agent_runtime_sessions/claude_config:\n\u{1b}[01;34mbackups\u{1b}[0m\npolicy-limits.json\n\u{1b}[01;34mprojects\u{1b}[0m\nremote-settings.json\n\u{1b}[01;34msessions\u{1b}[0m\nsettings.json\n\n/Users/eric/.agent_runtime_sessions/claude_config/backups:\n\n/Users/eric/.agent_runtime_sessions/claude_config/projects:\n\u{1b}[01;34m-Users-eric-Code-macro\u{1b}[0m\n\u{1b}[01;34m-Users-eric-Code-macro-crates\u{1b}[0m\n\n/Users/eric/.agent_runtime_sessions/claude_config/projects/-Users-eric-Code-macro:\n\u{1b}[01;34mmemory\u{1b}[0m\n\n/Users/eric/.agent_runtime_sessions/claude_config/projects/-Users-eric-Code-macro/memory:\n\n/Users/eric/.agent_runtime_sessions/claude_config/projects/-Users-eric-Code-macro-crates:\nfe461773-871c-41e8-8b10-8b5abce9dc55.jsonl\n\n/Users/eric/.agent_runtime_sessions/claude_config/sessions:"),
