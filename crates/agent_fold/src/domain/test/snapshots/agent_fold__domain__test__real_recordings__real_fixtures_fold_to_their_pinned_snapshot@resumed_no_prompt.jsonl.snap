                    detail: Edit {
                        diffs: [
                            FileDiff {
                                path: "/Users/eric/Code/macro/crates/agent_fold/src/inbound/comms_message.rs",
                                old_text: None,
                                new_text: "//! The fold from Agent Runtime Protocol traffic to comms channel messages.\n//!\n//! This is where the two halves meet. The domain folds a protocol log into\n//! its own vocabulary; this adapter renders that vocabulary as\n//! [`ChannelMessage`], the shape a channel already knows how to display. The\n//! domain never names a comms type, so the coupling lives here and only here.\n//!\n//! # The lossy part\n//!\n//! `comms_messages.content` is a single `text` column and\n//! [`ChannelMessage::content`] is a `String`, so structure has to be flattened\n//! into markdown: tool calls become fenced blocks, thoughts a blockquote,\n//! permissions a one-line note. That loses the collapsible tool rows, diff\n//! rendering and live status a reader would want.\n//!\n//! It is the right lossy choice *for now*, because it renders today with no\n//! schema change and no frontend work. When a comms message can carry\n//! structured parts, this module is the only thing that changes - swap\n//! [`render_markdown`] for a mapping onto that representation and the domain,\n//! the fold and every test above it stay put.\n\nuse crate::domain::message::{\n    AuthorKind, FoldedMessage, MessagePart, Permission, PermissionOutcome, StopReason, ToolDetail,\n    ToolStatus, ToolUse,\n};\nuse crate::domain::ports::FoldedMessageRepo;\nuse agent_session::domain::model::{AgentSession, AgentSessionId};\nuse agent_session::domain::ports::AgentSessionRepo;\nuse bot_id::BotId;\nuse channels::domain::models::{BotSenderProfile, ChannelMessage, ThreadInfo};\nuse chrono::{DateTime, Utc};\nuse macro_uuid::Uuid;\n\n#[cfg(test)]\nmod test;\n\n/// The namespace for deriving stable message ids.\n///\n/// A folded message has no stored row and therefore no id of its own, but a\n/// channel message needs one - and needs the *same* one on every read, or\n/// clients would treat each poll as a batch of new messages. Deriving it as a\n/// v5 (name-based) uuid from the session and the message's natural key makes\n/// the id a pure function of the log, exactly like the messages themselves.\nconst MESSAGE_ID_NAMESPACE: Uuid = Uuid::from_bytes([\n    0x6a, 0x67, 0x65, 0x6e, 0x74, 0x2d, 0x66, 0x6f, 0x6c, 0x64, 0x2d, 0x6d, 0x73, 0x67, 0x00, 0x01,\n]);\n\n/// What a folded message needs in order to look like a channel message.\n///\n/// Everything here comes off the [`AgentSession`] itself, which already knows\n/// the comms thread it belongs to and the bot running it - see\n/// [`context_for_session`].\n#[derive(Debug, Clone)]\npub struct CommsContext {\n    /// The session being rendered.\n    pub session: AgentSessionId,\n    /// The channel the session's thread lives in.\n    pub channel_id: Uuid,\n    /// The bot posting the agent's side of the conversation.\n    pub bot: BotId,\n    /// Display name and avatar for that bot.\n    pub bot_profile: Option<BotSenderProfile>,\n    /// Storage id of the user whose prompts opened the turns, used when a\n    /// prompt was logged without one.\n    pub fallback_user_id: Option<String>,\n}\n\n/// Read the rendering context off a session record.\n///\n/// The session is the source of truth for both the thread it posts into and\n/// the bot it speaks as, so callers should not have to supply either.\npub async fn context_for_session<Sessions>(\n    sessions: &Sessions,\n    session: AgentSessionId,\n) -> Result<CommsContext, rootcause::Report>\nwhere\n    Sessions: AgentSessionRepo + Sync,\n{\n    let record: AgentSession<AgentSessionId> = sessions\n        .get(session)\n        .await\n        .map_err(|error| rootcause::report!(error))?;\n\n    Ok(CommsContext {\n        session,\n        channel_id: record.thread_id,\n        bot: record.bot_id,\n        bot_profile: None,\n        fallback_user_id: None,\n    })\n}\n\n/// Render a session's folded messages as channel messages.\n///\n/// The composed fold: protocol log in, comms messages out.\n#[tracing::instrument(err, skip(messages))]\npub async fn list_as_channel_messages<Messages>(\n    messages: &Messages,\n    context: &CommsContext,\n) -> Result<Vec<ChannelMessage>, rootcause::Report>\nwhere\n    Messages: FoldedMessageRepo + Sync,\n{\n    let folded = messages.list_by_session(context.session).await?;\n    Ok(folded\n        .into_iter()\n        .map(|message| to_channel_message(context, message))\n        .collect())\n}\n\n/// Render one folded message as a channel message.\n///\n/// Timestamps are the one thing the fold cannot supply: `agent_session_log`\n/// has a `created_at` per frame, but\n/// [`AgentSessionLog`](agent_session::domain::model::AgentSessionLog) does not\n/// carry it, so there is nothing truthful to put here. Both stamps are left\n/// at the epoch rather than invented from the wall clock, which would make\n/// every read report a different time. Threading a frame timestamp through the\n/// log model is the fix.\n#[must_use]\npub fn to_channel_message(context: &CommsContext, message: FoldedMessage) -> ChannelMessage {\n    let id = derive_message_id(context.session, &message);\n    let is_agent = message.author.kind() == AuthorKind::Agent;\n\n    let sender_id = match &message.author {\n        crate::domain::message::Author::User(user) => user\n            .as_ref()\n            .map(ToString::to_string)\n            .or_else(|| context.fallback_user_id.clone())\n            .unwrap_or_default(),\n        crate::domain::message::Author::Agent => {\n            context.bot.into_storage_id().as_ref().to_string()\n        }\n    };\n\n    ChannelMessage {\n        id,\n        channel_id: context.channel_id,\n        sender_id,\n        // The user who prompted the turn is what a reader wants attributed\n        // here, and only the agent's own messages carry that relationship.\n        triggered_by: is_agent.then(|| context.fallback_user_id.clone()).flatten(),\n        bot_profile: is_agent.then(|| context.bot_profile.clone()).flatten(),\n        content: render_markdown(&message),\n        created_at: DateTime::<Utc>::UNIX_EPOCH,\n        updated_at: DateTime::<Utc>::UNIX_EPOCH,\n        edited_at: None,\n        deleted_at: None,\n        thread: ThreadInfo {\n            reply_count: 0,\n            latest_reply_at: None,\n            preview: Vec::new(),\n        },\n        reactions: Vec::new(),\n        attachments: Vec::new(),\n    }\n}\n\n/// The stable id for a folded message within its session.\nfn derive_message_id(session: AgentSessionId, message: &FoldedMessage) -> Uuid {\n    let key = message.id();\n    let author = match key.author {\n        AuthorKind::User => \"user\",\n        AuthorKind::Agent => \"agent\",\n    };\n    let name = format!(\"{}:{}:{author}\", session.as_uuid(), key.turn.0);\n    Uuid::new_v5(&MESSAGE_ID_NAMESPACE, name.as_bytes())\n}\n\n/// Flatten a folded message's parts into markdown.\n#[must_use]\npub fn render_markdown(message: &FoldedMessage) -> String {\n    let mut blocks: Vec<String> = Vec::new();\n\n    for part in message.parts.iter() {\n        match part {\n            MessagePart::Text(text) => blocks.push(text.trim().to_owned()),\n            MessagePart::Thought(text) => blocks.push(render_thought(text)),\n            MessagePart::ToolUse(tool) => blocks.push(render_tool(tool)),\n            MessagePart::Permission(permission) => blocks.push(render_permission(permission)),\n        }\n    }\n\n    if let Some(note) = stop_note(message.stop.as_ref()) {\n        blocks.push(note);\n    }\n\n    blocks.retain(|block| !block.is_empty());\n    blocks.join(\"\\n\\n\")\n}\n\n/// Reasoning as a blockquote, so it reads as an aside.\nfn render_thought(text: &str) -> String {\n    text.trim()\n        .lines()\n        .map(|line| format!(\"> {line}\"))\n        .collect::<Vec<_>>()\n        .join(\"\\n\")\n}\n\n/// A tool call as a status line plus whatever detail it produced.\nfn render_tool(tool: &ToolUse) -> String {\n    let mut out = format!(\"{} **{}**\", status_marker(tool.status), tool.label);\n\n    match &tool.detail {\n        ToolDetail::Terminal {\n            command,\n            output,\n            exit_code,\n        } => {\n            if let Some(command) = command {\n                out.push_str(&format!(\"\\n\\n```sh\\n{}\\n```\", command.trim()));\n            }\n            if let Some(output) = output {\n                let text = strip_ansi(output.as_str());\n                if !text.trim().is_empty() {\n                    out.push_str(&format!(\"\\n\\n```\\n{}\\n```\", text.trim_end()));\n                }\n            }\n            // A zero exit is the unremarkable case; only note failures.\n            if let Some(code) = exit_code.filter(|code| *code != 0) {\n                out.push_str(&format!(\"\\n\\nexited with {code}\"));\n            }\n        }\n        ToolDetail::Edit { diffs } => {\n            for diff in diffs {\n                out.push_str(&format!(\"\\n\\n`{}`\", diff.path.display()));\n                out.push_str(&format!(\"\\n\\n```diff\\n{}\\n```\", render_diff_body(diff)));\n            }\n        }\n        ToolDetail::Read { paths } => {\n            for path in paths {\n                out.push_str(&format!(\"\\n\\n`{}`\", path.display()));\n            }\n        }\n        ToolDetail::Other { kind, input } => {\n            out.push_str(&format!(\" _({kind})_\"));\n            if let Some(input) = input {\n                if let Ok(pretty) = serde_json::to_string_pretty(input) {\n                    if pretty != \"{}\" {\n                        out.push_str(&format!(\"\\n\\n```json\\n{pretty}\\n```\"));\n                    }\n                }\n            }\n        }\n    }\n\n    out\n}\n\n/// A diff as `-`/`+` lines. Not a real unified diff - there are no hunk\n/// headers to compute from old/new text alone - but it renders in a `diff`\n/// fence and reads correctly.\nfn render_diff_body(diff: &crate::domain::message::FileDiff) -> String {\n    let mut body = String::new();\n    if let Some(old) = &diff.old_text {\n        for line in old.lines() {\n            body.push_str(&format!(\"-{line}\\n\"));\n        }\n    }\n    for line in diff.new_text.lines() {\n        body.push_str(&format!(\"+{line}\\n\"));\n    }\n    body.trim_end().to_owned()\n}\n\n/// A permission request and how it went.\nfn render_permission(permission: &Permission) -> String {\n    match &permission.outcome {\n        Some(PermissionOutcome::Selected { option_id }) => {\n            let name = permission\n                .options\n                .iter()\n                .find(|option| &option.id == option_id)\n                .map_or(option_id.as_str(), |option| option.name.as_str());\n            format!(\"_Permission requested — {name}._\")\n        }\n        Some(PermissionOutcome::Cancelled) => \"_Permission request cancelled._\".to_owned(),\n        None => \"_Waiting for permission…_\".to_owned(),\n    }\n}\n\n/// A note for turns that ended in something other than a clean finish.\nfn stop_note(stop: Option<&StopReason>) -> Option<String> {\n    match stop? {\n        // The ordinary ending needs no annotation.\n        StopReason::EndTurn => None,\n        StopReason::MaxTokens => Some(\"_Stopped: token limit reached._\".to_owned()),\n        StopReason::MaxTurnRequests => Some(\"_Stopped: turn limit reached._\".to_owned()),\n        StopReason::Refusal => Some(\"_The agent declined to continue._\".to_owned()),\n        StopReason::Cancelled => Some(\"_Cancelled._\".to_owned()),\n        StopReason::Other(reason) => Some(format!(\"_Stopped: {reason}._\")),\n    }\n}\n\nfn status_marker(status: ToolStatus) -> &'static str {\n    match status {\n        ToolStatus::Pending => \"◦\",\n        ToolStatus::Running => \"◍\",\n        ToolStatus::Completed => \"●\",\n        ToolStatus::Failed => \"✕\",\n    }\n}\n\n/// Drop ANSI escape sequences.\n///\n/// The domain preserves them deliberately - stripping is lossy and\n/// irreversible - but markdown has no way to render them, so the flattening\n/// adapter is where they go. A structured representation would keep them and\n/// let the client decide.\n#[must_use]\npub fn strip_ansi(text: &str) -> String {\n    let mut out = String::with_capacity(text.len());\n    let mut chars = text.chars();\n\n    while let Some(character) = chars.next() {\n        if character != '\\u{1b}' {\n            out.push(character);\n            continue;\n        }\n        // CSI sequences (`ESC [ … final`) are all that terminal output uses\n        // here; a final byte in `@`..=`~` ends one.\n        match chars.next() {\n            Some('[') => {\n                for parameter in chars.by_ref() {\n                    if ('@'..='~').contains(&parameter) {\n                        break;\n                    }\n                }\n            }\n            // A bare or unrecognized escape: drop the escape itself and keep\n            // whatever followed.\n            Some(other) => out.push(other),\n            None => break,\n        }\n    }\n\n    out\n}\n",
                            },
                        ],
                    },
                    raw_input: Some(
                        Object {
                            "file_path": String("/Users/eric/Code/macro/crates/agent_fold/src/inbound/comms_message.rs"),
                            "content": String("//! The fold from Agent Runtime Protocol traffic to comms channel messages.\n//!\n//! This is where the two halves meet. The domain folds a protocol log into\n//! its own vocabulary; this adapter renders that vocabulary as\n//! [`ChannelMessage`], the shape a channel already knows how to display. The\n//! domain never names a comms type, so the coupling lives here and only here.\n//!\n//! # The lossy part\n//!\n//! `comms_messages.content` is a single `text` column and\n//! [`ChannelMessage::content`] is a `String`, so structure has to be flattened\n//! into markdown: tool calls become fenced blocks, thoughts a blockquote,\n//! permissions a one-line note. That loses the collapsible tool rows, diff\n//! rendering and live status a reader would want.\n//!\n//! It is the right lossy choice *for now*, because it renders today with no\n//! schema change and no frontend work. When a comms message can carry\n//! structured parts, this module is the only thing that changes - swap\n//! [`render_markdown`] for a mapping onto that representation and the domain,\n//! the fold and every test above it stay put.\n\nuse crate::domain::message::{\n    AuthorKind, FoldedMessage, MessagePart, Permission, PermissionOutcome, StopReason, ToolDetail,\n    ToolStatus, ToolUse,\n};\nuse crate::domain::ports::FoldedMessageRepo;\nuse agent_session::domain::model::{AgentSession, AgentSessionId};\nuse agent_session::domain::ports::AgentSessionRepo;\nuse bot_id::BotId;\nuse channels::domain::models::{BotSenderProfile, ChannelMessage, ThreadInfo};\nuse chrono::{DateTime, Utc};\nuse macro_uuid::Uuid;\n\n#[cfg(test)]\nmod test;\n\n/// The namespace for deriving stable message ids.\n///\n/// A folded message has no stored row and therefore no id of its own, but a\n/// channel message needs one - and needs the *same* one on every read, or\n/// clients would treat each poll as a batch of new messages. Deriving it as a\n/// v5 (name-based) uuid from the session and the message's natural key makes\n/// the id a pure function of the log, exactly like the messages themselves.\nconst MESSAGE_ID_NAMESPACE: Uuid = Uuid::from_bytes([\n    0x6a, 0x67, 0x65, 0x6e, 0x74, 0x2d, 0x66, 0x6f, 0x6c, 0x64, 0x2d, 0x6d, 0x73, 0x67, 0x00, 0x01,\n]);\n\n/// What a folded message needs in order to look like a channel message.\n///\n/// Everything here comes off the [`AgentSession`] itself, which already knows\n/// the comms thread it belongs to and the bot running it - see\n/// [`context_for_session`].\n#[derive(Debug, Clone)]\npub struct CommsContext {\n    /// The session being rendered.\n    pub session: AgentSessionId,\n    /// The channel the session's thread lives in.\n    pub channel_id: Uuid,\n    /// The bot posting the agent's side of the conversation.\n    pub bot: BotId,\n    /// Display name and avatar for that bot.\n    pub bot_profile: Option<BotSenderProfile>,\n    /// Storage id of the user whose prompts opened the turns, used when a\n    /// prompt was logged without one.\n    pub fallback_user_id: Option<String>,\n}\n\n/// Read the rendering context off a session record.\n///\n/// The session is the source of truth for both the thread it posts into and\n/// the bot it speaks as, so callers should not have to supply either.\npub async fn context_for_session<Sessions>(\n    sessions: &Sessions,\n    session: AgentSessionId,\n) -> Result<CommsContext, rootcause::Report>\nwhere\n    Sessions: AgentSessionRepo + Sync,\n{\n    let record: AgentSession<AgentSessionId> = sessions\n        .get(session)\n        .await\n        .map_err(|error| rootcause::report!(error))?;\n\n    Ok(CommsContext {\n        session,\n        channel_id: record.thread_id,\n        bot: record.bot_id,\n        bot_profile: None,\n        fallback_user_id: None,\n    })\n}\n\n/// Render a session's folded messages as channel messages.\n///\n/// The composed fold: protocol log in, comms messages out.\n#[tracing::instrument(err, skip(messages))]\npub async fn list_as_channel_messages<Messages>(\n    messages: &Messages,\n    context: &CommsContext,\n) -> Result<Vec<ChannelMessage>, rootcause::Report>\nwhere\n    Messages: FoldedMessageRepo + Sync,\n{\n    let folded = messages.list_by_session(context.session).await?;\n    Ok(folded\n        .into_iter()\n        .map(|message| to_channel_message(context, message))\n        .collect())\n}\n\n/// Render one folded message as a channel message.\n///\n/// Timestamps are the one thing the fold cannot supply: `agent_session_log`\n/// has a `created_at` per frame, but\n/// [`AgentSessionLog`](agent_session::domain::model::AgentSessionLog) does not\n/// carry it, so there is nothing truthful to put here. Both stamps are left\n/// at the epoch rather than invented from the wall clock, which would make\n/// every read report a different time. Threading a frame timestamp through the\n/// log model is the fix.\n#[must_use]\npub fn to_channel_message(context: &CommsContext, message: FoldedMessage) -> ChannelMessage {\n    let id = derive_message_id(context.session, &message);\n    let is_agent = message.author.kind() == AuthorKind::Agent;\n\n    let sender_id = match &message.author {\n        crate::domain::message::Author::User(user) => user\n            .as_ref()\n            .map(ToString::to_string)\n            .or_else(|| context.fallback_user_id.clone())\n            .unwrap_or_default(),\n        crate::domain::message::Author::Agent => {\n            context.bot.into_storage_id().as_ref().to_string()\n        }\n    };\n\n    ChannelMessage {\n        id,\n        channel_id: context.channel_id,\n        sender_id,\n        // The user who prompted the turn is what a reader wants attributed\n        // here, and only the agent's own messages carry that relationship.\n        triggered_by: is_agent.then(|| context.fallback_user_id.clone()).flatten(),\n        bot_profile: is_agent.then(|| context.bot_profile.clone()).flatten(),\n        content: render_markdown(&message),\n        created_at: DateTime::<Utc>::UNIX_EPOCH,\n        updated_at: DateTime::<Utc>::UNIX_EPOCH,\n        edited_at: None,\n        deleted_at: None,\n        thread: ThreadInfo {\n            reply_count: 0,\n            latest_reply_at: None,\n            preview: Vec::new(),\n        },\n        reactions: Vec::new(),\n        attachments: Vec::new(),\n    }\n}\n\n/// The stable id for a folded message within its session.\nfn derive_message_id(session: AgentSessionId, message: &FoldedMessage) -> Uuid {\n    let key = message.id();\n    let author = match key.author {\n        AuthorKind::User => \"user\",\n        AuthorKind::Agent => \"agent\",\n    };\n    let name = format!(\"{}:{}:{author}\", session.as_uuid(), key.turn.0);\n    Uuid::new_v5(&MESSAGE_ID_NAMESPACE, name.as_bytes())\n}\n\n/// Flatten a folded message's parts into markdown.\n#[must_use]\npub fn render_markdown(message: &FoldedMessage) -> String {\n    let mut blocks: Vec<String> = Vec::new();\n\n    for part in message.parts.iter() {\n        match part {\n            MessagePart::Text(text) => blocks.push(text.trim().to_owned()),\n            MessagePart::Thought(text) => blocks.push(render_thought(text)),\n            MessagePart::ToolUse(tool) => blocks.push(render_tool(tool)),\n            MessagePart::Permission(permission) => blocks.push(render_permission(permission)),\n        }\n    }\n\n    if let Some(note) = stop_note(message.stop.as_ref()) {\n        blocks.push(note);\n    }\n\n    blocks.retain(|block| !block.is_empty());\n    blocks.join(\"\\n\\n\")\n}\n\n/// Reasoning as a blockquote, so it reads as an aside.\nfn render_thought(text: &str) -> String {\n    text.trim()\n        .lines()\n        .map(|line| format!(\"> {line}\"))\n        .collect::<Vec<_>>()\n        .join(\"\\n\")\n}\n\n/// A tool call as a status line plus whatever detail it produced.\nfn render_tool(tool: &ToolUse) -> String {\n    let mut out = format!(\"{} **{}**\", status_marker(tool.status), tool.label);\n\n    match &tool.detail {\n        ToolDetail::Terminal {\n            command,\n            output,\n            exit_code,\n        } => {\n            if let Some(command) = command {\n                out.push_str(&format!(\"\\n\\n```sh\\n{}\\n```\", command.trim()));\n            }\n            if let Some(output) = output {\n                let text = strip_ansi(output.as_str());\n                if !text.trim().is_empty() {\n                    out.push_str(&format!(\"\\n\\n```\\n{}\\n```\", text.trim_end()));\n                }\n            }\n            // A zero exit is the unremarkable case; only note failures.\n            if let Some(code) = exit_code.filter(|code| *code != 0) {\n                out.push_str(&format!(\"\\n\\nexited with {code}\"));\n            }\n        }\n        ToolDetail::Edit { diffs } => {\n            for diff in diffs {\n                out.push_str(&format!(\"\\n\\n`{}`\", diff.path.display()));\n                out.push_str(&format!(\"\\n\\n```diff\\n{}\\n```\", render_diff_body(diff)));\n            }\n        }\n        ToolDetail::Read { paths } => {\n            for path in paths {\n                out.push_str(&format!(\"\\n\\n`{}`\", path.display()));\n            }\n        }\n        ToolDetail::Other { kind, input } => {\n            out.push_str(&format!(\" _({kind})_\"));\n            if let Some(input) = input {\n                if let Ok(pretty) = serde_json::to_string_pretty(input) {\n                    if pretty != \"{}\" {\n                        out.push_str(&format!(\"\\n\\n```json\\n{pretty}\\n```\"));\n                    }\n                }\n            }\n        }\n    }\n\n    out\n}\n\n/// A diff as `-`/`+` lines. Not a real unified diff - there are no hunk\n/// headers to compute from old/new text alone - but it renders in a `diff`\n/// fence and reads correctly.\nfn render_diff_body(diff: &crate::domain::message::FileDiff) -> String {\n    let mut body = String::new();\n    if let Some(old) = &diff.old_text {\n        for line in old.lines() {\n            body.push_str(&format!(\"-{line}\\n\"));\n        }\n    }\n    for line in diff.new_text.lines() {\n        body.push_str(&format!(\"+{line}\\n\"));\n    }\n    body.trim_end().to_owned()\n}\n\n/// A permission request and how it went.\nfn render_permission(permission: &Permission) -> String {\n    match &permission.outcome {\n        Some(PermissionOutcome::Selected { option_id }) => {\n            let name = permission\n                .options\n                .iter()\n                .find(|option| &option.id == option_id)\n                .map_or(option_id.as_str(), |option| option.name.as_str());\n            format!(\"_Permission requested — {name}._\")\n        }\n        Some(PermissionOutcome::Cancelled) => \"_Permission request cancelled._\".to_owned(),\n        None => \"_Waiting for permission…_\".to_owned(),\n    }\n}\n\n/// A note for turns that ended in something other than a clean finish.\nfn stop_note(stop: Option<&StopReason>) -> Option<String> {\n    match stop? {\n        // The ordinary ending needs no annotation.\n        StopReason::EndTurn => None,\n        StopReason::MaxTokens => Some(\"_Stopped: token limit reached._\".to_owned()),\n        StopReason::MaxTurnRequests => Some(\"_Stopped: turn limit reached._\".to_owned()),\n        StopReason::Refusal => Some(\"_The agent declined to continue._\".to_owned()),\n        StopReason::Cancelled => Some(\"_Cancelled._\".to_owned()),\n        StopReason::Other(reason) => Some(format!(\"_Stopped: {reason}._\")),\n    }\n}\n\nfn status_marker(status: ToolStatus) -> &'static str {\n    match status {\n        ToolStatus::Pending => \"◦\",\n        ToolStatus::Running => \"◍\",\n        ToolStatus::Completed => \"●\",\n        ToolStatus::Failed => \"✕\",\n    }\n}\n\n/// Drop ANSI escape sequences.\n///\n/// The domain preserves them deliberately - stripping is lossy and\n/// irreversible - but markdown has no way to render them, so the flattening\n/// adapter is where they go. A structured representation would keep them and\n/// let the client decide.\n#[must_use]\npub fn strip_ansi(text: &str) -> String {\n    let mut out = String::with_capacity(text.len());\n    let mut chars = text.chars();\n\n    while let Some(character) = chars.next() {\n        if character != '\\u{1b}' {\n            out.push(character);\n            continue;\n        }\n        // CSI sequences (`ESC [ … final`) are all that terminal output uses\n        // here; a final byte in `@`..=`~` ends one.\n        match chars.next() {\n            Some('[') => {\n                for parameter in chars.by_ref() {\n                    if ('@'..='~').contains(&parameter) {\n                        break;\n                    }\n                }\n            }\n            // A bare or unrecognized escape: drop the escape itself and keep\n            // whatever followed.\n            Some(other) => out.push(other),\n            None => break,\n        }\n    }\n\n    out\n}\n"),
                        },
