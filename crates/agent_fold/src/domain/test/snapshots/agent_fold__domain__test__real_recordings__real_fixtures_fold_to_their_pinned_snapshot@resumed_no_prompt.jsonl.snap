eService::new(repo.clone());\n//! for message in messages.list_by_session(session).await? {\n//!     println!(\"{:?} said {} part(s)\", message.author, message.parts.len());\n//! }\n//!\n//! // ...or render them as channel messages.\n//! let context = context_for_session(&repo, session).await?;\n//! let channel_messages = list_as_channel_messages(&messages, &context).await?;\n//! # let _ = channel_messages;\n//! # Ok(())\n//! # }\n//! ```\n\n/// Domain models, the fold, and the query port.\npub mod domain;\n/// Adapters that drive the domain and render its messages outward.\npub mod inbound;\n"),
