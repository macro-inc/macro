                                old_text: None,
                                new_text: "#![deny(missing_docs)]\n//! Folds an agent session's protocol log into renderable messages, and\n//! serves them as if they were stored.\n//!\n//! An agent session is recorded as a flat log of Agent Runtime Protocol\n//! frames - `agent_session_log`, modelled by\n//! [`agent_session::domain::model::AgentSessionLog`]. That log is faithful\n//! but unreadable: a single session is hundreds of streamed chunks,\n//! tool-call patches and token-usage reports. This crate collapses it into\n//! the handful of messages a person would recognize as the story of the\n//! session.\n//!\n//! Nothing here is persisted. The fiction of the crate is that folded\n//! messages live in a database: [`domain::ports::FoldedMessageRepo`] is a\n//! repository-shaped query API, and\n//! [`domain::service::FoldedMessageService`] answers it by loading the log\n//! through [`agent_session::domain::ports::AgentSessionLogRepo`] and folding\n//! on every read. Because the messages are re-derived each time, the\n//! vocabulary in [`domain::message`] can change without a migration.\n//!\n//! The domain speaks only its own vocabulary - turns, tool calls,\n//! permissions - and names no display type. Rendering it as something a\n//! surface can show is an adapter's job: [`inbound::comms_message`] is the\n//! fold from protocol traffic to comms channel messages.\n//!\n//! ```no_run\n//! use agent_fold::domain::ports::FoldedMessageRepo;\n//! use agent_fold::domain::service::FoldedMessageService;\n//! use agent_fold::inbound::comms_message::{context_for_session, list_as_channel_messages};\n//! use agent_session::domain::model::AgentSessionId;\n//! use agent_session::domain::ports::{AgentSessionLogRepo, AgentSessionRepo};\n//!\n//! # async fn run<R>(repo: R, session: AgentSessionId) -> Result<(), rootcause::Report>\n//! # where R: AgentSessionRepo + AgentSessionLogRepo + Clone + Sync {\n//! // Query the domain's own messages...\n//! let messages = FoldedMessageService::new(repo.clone());\n//! for message in messages.list_by_session(session).await? {\n//!     println!(\"{:?} said {} part(s)\", message.author, message.parts.len());\n//! }\n//!\n//! // ...or render them as channel messages.\n//! let context = context_for_session(&repo, session).await?;\n//! let channel_messages = list_as_channel_messages(&messages, &context).await?;\n//! # let _ = channel_messages;\n//! # Ok(())\n//! # }\n//! ```\n\n/// Domain models, the fold, and the query port.\npub mod domain;\n/// Adapters that drive the domain and render its messages outward.\npub mod inbound;\n",
                            },
                        ],
                    },
