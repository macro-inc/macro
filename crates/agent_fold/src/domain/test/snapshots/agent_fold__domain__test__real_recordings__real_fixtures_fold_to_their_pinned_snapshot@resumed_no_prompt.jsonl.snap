                                path: "/Users/eric/Code/macro/crates/agent_fold/src/domain/ports.rs",
                                old_text: None,
                                new_text: "//! The crate's driving port.\n//!\n//! [`FoldedMessageRepo`] is the query API the rest of the system calls. It is\n//! deliberately shaped like a repository over stored rows - list a session's\n//! messages, get one by id - even though nothing is stored: the service\n//! behind it derives every answer from the protocol log on each call.\n//! Callers should not be able to tell, and the day the messages *are*\n//! materialized somewhere, only the implementation moves.\n//!\n//! There is no driven port here. The one capability this domain needs from\n//! the outside - reading a session's log - is already a port on the crate\n//! that owns that log: [`agent_session::domain::ports::AgentSessionLogRepo`].\n//! Re-declaring it would be a second name for one contract.\n\nuse crate::domain::message::{FoldedMessage, MessageId};\nuse agent_session::domain::model::AgentSessionId;\n\n/// Query a session's messages as if they were stored.\npub trait FoldedMessageRepo {\n    /// A session's messages, oldest first. A session with no log folds to no\n    /// messages.\n    fn list_by_session(\n        &self,\n        session: AgentSessionId,\n    ) -> impl Future<Output = Result<Vec<FoldedMessage>, rootcause::Report>> + Send;\n\n    /// One message by its natural key, or `None` when the session's log\n    /// derives no such message.\n    fn get(\n        &self,\n        session: AgentSessionId,\n        id: MessageId,\n    ) -> impl Future<Output = Result<Option<FoldedMessage>, rootcause::Report>> + Send;\n}\n",
                            },
                        ],
                    },
                    raw_input: Some(
                        Object {
                            "file_path": String("/Users/eric/Code/macro/crates/agent_fold/src/domain/ports.rs"),
                            "content": String("//! The crate's driving port.\n//!\n//! [`FoldedMessageRepo`] is the query API the rest of the system calls. It is\n//! deliberately shaped like a repository over stored rows - list a session's\n//! messages, get one by id - even though nothing is stored: the service\n//! behind it derives every answer from the protocol log on each call.\n//! Callers should not be able to tell, and the day the messages *are*\n//! materialized somewhere, only the implementation moves.\n//!\n//! There is no driven port here. The one capability this domain needs from\n//! the outside - reading a session's log - is already a port on the crate\n//! that owns that log: [`agent_session::domain::ports::AgentSessionLogRepo`].\n//! Re-declaring it would be a second name for one contract.\n\nuse crate::domain::message::{FoldedMessage, MessageId};\nuse agent_session::domain::model::AgentSessionId;\n\n/// Query a session's messages as if they were stored.\npub trait FoldedMessageRepo {\n    /// A session's messages, oldest first. A session with no log folds to no\n    /// messages.\n    fn list_by_session(\n        &self,\n        session: AgentSessionId,\n    ) -> impl Future<Output = Result<Vec<FoldedMessage>, rootcause::Report>> + Send;\n\n    /// One message by its natural key, or `None` when the session's log\n    /// derives no such message.\n    fn get(\n        &self,\n        session: AgentSessionId,\n        id: MessageId,\n    ) -> impl Future<Output = Result<Option<FoldedMessage>, rootcause::Report>> + Send;\n}\n"),
                        },
                    ),
                    raw_output: Some(
                        String("The file /Users/eric/Code/macro/crates/agent_fold/src/domain/ports.rs has been updated successfully. (file state is current in your context — no need to Read it back)"),
