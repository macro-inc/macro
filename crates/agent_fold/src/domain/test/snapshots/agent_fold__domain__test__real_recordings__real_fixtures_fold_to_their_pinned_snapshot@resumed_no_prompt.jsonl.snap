                                old_text: None,
                                new_text: "use super::*;\nuse crate::domain::service::FoldedMessageService;\nuse crate::domain::test_support::{\n    TURN, parse_log_as, test_bot, test_session, test_session_record, test_thread,\n};\nuse agent_session::testing::InMemoryAgentSessionRepo;\n\n/// A repo holding the fixture session plus its session record.\nfn seeded() -> InMemoryAgentSessionRepo {\n    let repo: InMemoryAgentSessionRepo = parse_log_as(test_session(), TURN).into_iter().collect();\n    repo.insert_session(test_session_record(test_session()));\n    repo\n}\n\n/// The context comes off the session record, so callers need not know the\n/// thread or the bot.\n#[tokio::test]\nasync fn reads_context_from_the_session() {\n    let context = context_for_session(&seeded(), test_session())\n        .await\n        .expect(\"session was seeded\");\n\n    assert_eq!(context.session, test_session());\n    assert_eq!(context.channel_id, test_thread());\n    assert_eq!(context.bot, test_bot());\n}\n\n/// A missing session is an error, not an empty context - unlike a missing\n/// *log*, which legitimately folds to nothing.\n#[tokio::test]\nasync fn missing_session_is_an_error() {\n    let unknown = AgentSessionId::new_from_uuid(Uuid::from_u128(99));\n    assert!(\n        context_for_session(&seeded(), unknown).await.is_err(),\n        \"no session record to read a thread and bot from\"\n    );\n}\n\n/// The composed fold: protocol log in, channel messages out.\n#[tokio::test]\nasync fn renders_a_session_as_channel_messages() {\n    let repo = seeded();\n    let context = context_for_session(&repo, test_session())\n        .await\n        .expect(\"session was seeded\");\n    let messages = FoldedMessageService::new(repo);\n\n    let rendered = list_as_channel_messages(&messages, &context)\n        .await\n        .expect(\"in-memory repo cannot fail\");\n\n    assert_eq!(rendered.len(), 2, \"one user message, one agent message\");\n\n    let user = &rendered[0];\n    assert_eq!(user.channel_id, test_thread());\n    assert!(\n        user.sender_id.contains(\"eric\"),\n        \"user message keeps its author: {}\",\n        user.sender_id\n    );\n    assert_eq!(user.bot_profile, None);\n    assert_eq!(user.content, \"list the examples and write a file\");\n\n    let agent = &rendered[1];\n    assert_eq!(\n        agent.sender_id,\n        format!(\"bot|{}\", test_bot().as_uuid()),\n        \"agent messages are sent by the session's bot\"\n    );\n\n    // Prose, the terminal call with its command and stripped output, the\n    // permission note, the diff, and the closing prose.\n    let content = &agent.content;\n    assert!(content.starts_with(\"Sure, one moment.\"), \"{content}\");\n    assert!(content.contains(\"**Bash**\"), \"{content}\");\n    assert!(content.contains(\"```sh\\nls examples\\n```\"), \"{content}\");\n    assert!(content.contains(\"events.rs\"), \"{content}\");\n    assert!(\n        !content.contains('\\u{1b}'),\n        \"ANSI escapes are stripped for markdown: {content:?}\"\n    );\n    assert!(content.contains(\"Permission requested\"), \"{content}\");\n    assert!(content.contains(\"**Write**\"), \"{content}\");\n    assert!(content.contains(\"+fn main() {}\"), \"{content}\");\n    assert!(content.trim_end().ends_with(\"Done.\"), \"{content}\");\n    assert!(\n        !content.contains(\"Stopped\"),\n        \"a clean end_turn needs no note: {content}\"\n    );\n}\n\n/// Ids are a pure function of the log, so re-reading a session yields the\n/// same message ids - otherwise every poll would look like new messages.\n#[tokio::test]\nasync fn message_ids_are_stable_and_distinct() {\n    let repo = seeded();\n    let context = context_for_session(&repo, test_session())\n        .await\n        .expect(\"session was seeded\");\n    let messages = FoldedMessageService::new(repo);\n\n    let first = list_as_channel_messages(&messages, &context)\n        .await\n        .expect(\"in-memory repo cannot fail\");\n    let second = list_as_channel_messages(&messages, &context)\n        .await\n        .expect(\"in-memory repo cannot fail\");\n\n    let ids: Vec<_> = first.iter().map(|message| message.id).collect();\n    let again: Vec<_> = second.iter().map(|message| message.id).collect();\n    assert_eq!(ids, again, \"ids are derived, not generated\");\n    assert_ne!(ids[0], ids[1], \"user and agent messages differ\");\n\n    // A different session derives different ids for the same turn shape.\n    let other = AgentSessionId::new_from_uuid(Uuid::from_u128(2));\n    let other_repo: InMemoryAgentSessionRepo = parse_log_as(other, TURN).into_iter().collect();\n    other_repo.insert_session(test_session_record(other));\n    let other_context = context_for_session(&other_repo, other)\n        .await\n        .expect(\"session was seeded\");\n    let other_rendered = list_as_channel_messages(&FoldedMessageService::new(other_repo), &other_context)\n        .await\n        .expect(\"in-memory repo cannot fail\");\n    assert_ne!(\n        ids[0], other_rendered[0].id,\n        \"ids are scoped to their session\"\n    );\n}\n\n/// In-flight state renders as text rather than vanishing.\n#[tokio::test]\nasync fn renders_an_interrupted_turn() {\n    let mut log = parse_log_as(test_session(), TURN);\n    log.truncate(9);\n    let repo: InMemoryAgentSessionRepo = log.into_iter().collect();\n    repo.insert_session(test_session_record(test_session()));\n\n    let context = context_for_session(&repo, test_session())\n        .await\n        .expect(\"session was seeded\");\n    let rendered = list_as_channel_messages(&FoldedMessageService::new(repo), &context)\n        .await\n        .expect(\"in-memory repo cannot fail\");\n\n    let content = &rendered[1].content;\n    assert!(content.contains(\"◦ **Bash**\"), \"pending marker: {content}\");\n    assert!(\n        content.contains(\"Waiting for permission\"),\n        \"unanswered request: {content}\"\n    );\n}\n\n#[test]\nfn strips_ansi_sequences() {\n    assert_eq!(\n        strip_ansi(\"\\u{1b}[01;34macp.rs\\u{1b}[0m\\nevents.rs\"),\n        \"acp.rs\\nevents.rs\"\n    );\n    assert_eq!(strip_ansi(\"plain\"), \"plain\");\n    // A truncated escape at the end of a captured buffer must not panic.\n    assert_eq!(strip_ansi(\"tail\\u{1b}\"), \"tail\");\n    assert_eq!(strip_ansi(\"tail\\u{1b}[\"), \"tail\");\n}\n",
                            },
                        ],
                    },
