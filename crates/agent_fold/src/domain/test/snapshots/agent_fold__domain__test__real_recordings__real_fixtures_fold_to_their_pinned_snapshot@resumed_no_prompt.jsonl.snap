                                "===== src/lib.rs =====\n     1\t#![deny(missing_docs)]\n     2\t//! Agent Runtime Protocol wire types.\n     3\t//!\n     4\t//! The Agent Runtime Protocol is the outer protocol used to communicate with\n     5\t//! an agent runtime. It carries Agent Client Protocol (ACP) messages alongside\n     6\t//! runtime control messages without interpreting the wrapped ACP payloads.\n     7\t\n     8\t/// Protocol schema, role-oriented connections, and the runtime wire port.\n     9\tpub mod domain;\n    10\t/// Adapters implementing the domain wire port over physical transports.\n    11\tpub mod outbound;\n    12\t\n    13\t/// Utilities for asserting direction-labelled JSON messages at the wire boundary.\n    14\t#[cfg(any(test, feature = \"test-utils\"))]\n    15\tpub mod testing;\n===== src/domain/mod.rs =====\n     1\t//! Domain layer: protocol schema, role-oriented connections, and the physical transport port.\n     2\t\n     3\t/// A typed duplex channel over the logical protocol stream.\n     4\tpub mod channel;\n     5\t/// Role-oriented connections over a logical Agent Runtime Protocol stream.\n     6\tpub mod connection;\n     7\t/// The physical transport port.\n     8\tpub mod ports;\n     9\t/// Versioned protocol message types.\n    10\tpub mod schema;\n===== src/domain/schema/mod.rs =====\n     1\t//! Agent Runtime Protocol schema types.\n     2\t\n     3\t/// Draft `agent-runtime.v0` schema types.\n     4\tpub mod v0;\n===== src/domain/schema/v0/mod.rs =====\n     1\t//! Draft `agent-runtime.v0` message types.\n     2\t//!\n     3\t//! The logical protocol multiplexes two kinds of traffic over one stream:\n     4\t//! runtime/agent lifecycle events and ACP conversation traffic. Each\n     5\t//! direction has its own envelope - [`ToRuntimeMessage`] for Agent Service to\n     6\t//! Agent Runtime traffic and [`ToServerMessage`] for the reverse -\n     7\t//! discriminated by a `\"type\"` field. Only the wrapped ACP payload is itself\n     8\t//! a JSON-RPC message; the outer envelope is not.\n     9\t//!\n    10\t//! A connection hosts exactly one agent execution, so nothing on this schema\n    11\t//! needs an agent or agent-instance identifier: [`AcpMessage`] simply carries\n    12\t//! the agent's raw ACP traffic.\n    13\t\n    14\tuse agent_client_protocol::RawJsonRpcMessage;\n    15\tuse serde::{Deserialize, Deserializer, Serialize, Serializer};\n    16\tuse specta::Type;\n    17\tuse specta_typescript::Unknown;\n    18\t\n    19\t#[cfg(test)]\n    20\tmod test;\n    21\t\n    22\t/// The kind of runtime or agent state transition reported to the Agent Service.\n    23\t///\n    24\t/// The protocol does not define a full event-name catalog yet, so this enum\n    25\t/// is non-exhaustive: unrecognized wire strings still round-trip losslessly\n    26\t/// through [`SystemEvent::Unknown`]. [`SystemEvent::AcpReady`] is the one\n    27\t/// name the Agent Service actually acts on (see\n    28\t/// `agent_proxy::inbound::runtime::RuntimeConnectionDriver`, which waits for\n    29\t/// it before starting the ACP `initialize`/`session/new` handshake) rather\n    30\t/// than merely forwarding it for observability.\n    31\t///\n    32\t/// This has a hand-written [`Serialize`]/[`Deserialize`] impl rather than a\n    33\t/// derive, so it cannot derive [`specta::Type`] either: nothing here\n    34\t/// introspects its shape for TypeScript. Every field that carries a\n    35\t/// `SystemEvent` is instead given a `#[specta(type = String)]` override at\n    36\t/// the field, matching the plain string it actually serializes as.\n    37\t#[derive(Debug, Clone, PartialEq, Eq, Hash)]\n    38\t#[non_exhaustive]\n    39\tpub enum SystemEvent {\n    40\t    /// The Agent Runtime's hosted agent process is up and its ACP channel is\n    41\t    /// wired end-to-end: the Agent Service may now start the ACP\n    42\t    /// `initialize`/`session/new` handshake. Sent at most once per\n    43\t    /// connection, before any ACP traffic.\n    44\t    AcpReady,\n    45\t    /// An application-defined event name with no protocol-level meaning yet.\n    46\t    Unknown(String),\n    47\t}\n    48\t\n    49\timpl SystemEvent {\n    50\t    /// Borrow the wire string for this event name.\n    51\t    #[must_use]\n    52\t    pub fn as_str(&self) -> &str {\n    53\t        match self {\n    54\t            Self::AcpReady => \"acp_ready\",\n    55\t            Self::Unknown(name) => name,\n    56\t        }\n    57\t    }\n    58\t}\n    59\t\n    60\timpl Serialize for SystemEvent {\n    61\t    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>\n    62\t    where\n    63\t        S: Serializer,\n    64\t    {\n    65\t        serializer.serialize_str(self.as_str())\n    66\t    }\n    67\t}\n    68\t\n    69\timpl<'de> Deserialize<'de> for SystemEvent {\n    70\t    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>\n    71\t    where\n    72\t        D: Deserializer<'de>,\n    73\t    {\n    74\t        Ok(match String::deserialize(deserializer)?.as_str() {\n    75\t            \"acp_ready\" => Self::AcpReady,\n    76\t            name => Self::Unknown(name.to_owned()),\n    77\t        })\n    78\t    }\n    79\t}\n    80\t\n    81\t/// One complete ACP JSON-RPC message routed between the Agent Service and the\n    82\t/// single agent execution hosted by this connection.\n    83\t///\n    84\t/// Its own JSON-RPC fields are opaque to TypeScript consumers here (typed as\n    85\t/// an arbitrary object of unknown values): they already have a proper ACP SDK\n    86\t/// on the TypeScript side, so this crate only needs to guarantee the message\n    87\t/// round-trips unchanged. This is typed as a map rather than plain `unknown`\n    88\t/// because [`ToRuntimeMessage`]/[`ToServerMessage`] carry it in an internally\n    89\t/// tagged `Acp` variant, which requires its payload provably serialize as an\n    90\t/// object so the `\"type\"` tag can be merged into it. `#[serde(transparent)]`\n    91\t/// changes nothing about the actual wire format here - a single-field tuple\n    92\t/// struct already serializes transparently by default - but it does tell\n    93\t/// specta's serde-compatibility checker that this newtype is transparent, so\n    94\t/// it looks through to the map type below instead of treating `AcpMessage`\n    95\t/// itself as an opaque, non-mergeable struct.\n    96\t#[derive(Debug, Clone, Serialize, Deserialize, Type)]\n    97\t#[serde(transparent)]\n    98\tpub struct AcpMessage(\n    99\t    #[specta(type = std::collections::HashMap<String, Unknown>)] pub RawJsonRpcMessage,\n   100\t);\n   101\t\n   102\t/// Agent Service to Agent Runtime traffic on the logical protocol stream.\n   103\t#[derive(Debug, Clone, Serialize, Deserialize, Type)]\n   104\t#[serde(tag = \"type\", rename_all = \"camelCase\")]\n   105\t#[non_exhaustive]\n   106\tpub enum ToRuntimeMessage {\n   107\t    /// An ACP message routed to the hosted agent.\n   108\t    Acp(AcpMessage),\n   109\t}\n   110\t\n   111\t/// Agent Runtime to Agent Service traffic on the logical protocol stream.\n   112\t#[derive(Debug, Clone, Serialize, Deserialize, Type)]\n   113\t#[serde(tag = \"type\", rename_all = \"camelCase\")]\n   114\t#[non_exhaustive]\n   115\tpub enum ToServerMessage {\n   116\t    /// An ACP message routed from the hosted agent.\n   117\t    Acp(AcpMessage),\n   118\t    /// A runtime or agent lifecycle event.\n   119\t    Event {\n   120\t        /// The event name.\n   121\t        #[specta(type = String)]\n   122\t        event: SystemEvent,\n   123\t    },\n   124\t}",
                            ),
