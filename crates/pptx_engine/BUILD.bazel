load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "pptx_engine",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "cli",
        "default",
        "embedded-fonts",
        "schema",
        "wasm-bindings",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/pptx_engine"},
    deps = [
        "@crates//:base64-0.22.1",
        "@crates//:clap-4.6.1",
        "@crates//:gif-0.14.2",
        "@crates//:miniz_oxide-0.8.9",
        "@crates//:png-0.18.1",
        "@crates//:schemars-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:skrifa-0.48.0",
        "@crates//:thiserror-2.0.18",
        "@crates//:tiny-skia-0.11.4",
        "@crates//:zune-core-0.5.1",
        "@crates//:zune-jpeg-0.5.15",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "pptx_engine_unit",
    crate = ":pptx_engine",
    crate_features = [
        "cli",
        "default",
        "embedded-fonts",
        "schema",
        "wasm-bindings",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/pptx_engine"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/pptx_engine"},
)

