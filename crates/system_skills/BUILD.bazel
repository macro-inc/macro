load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "system_skills",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/system_skills"},
    deps = [
        "//crates/prompt:prompt",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "system_skills_unit",
    crate = ":system_skills",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/system_skills"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/system_skills"},
)

