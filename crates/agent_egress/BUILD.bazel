load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "agent_egress",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_egress", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/agent_runtime_protocol:agent_runtime_protocol",
        "//crates/agent_session:agent_session",
        "//crates/ai_toolset:ai_toolset",
        "//crates/bot_id:bot_id",
        "//crates/folds/agent_fold:agent_fold",
        "//crates/github:github",
        "//crates/macro_auth:macro_auth",
        "//crates/macro_db_client:macro_db_client",
        "//crates/macro_tower_layers:macro_tower_layers",
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "//crates/mcp_client:mcp_client",
        "//crates/model_owner:model_owner",
        "//crates/pipedream_mcp:pipedream_mcp",
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:base64-0.22.1",
        "@crates//:bytes-1.11.1",
        "@crates//:chrono-0.4.45",
        "@crates//:futures-0.3.32",
        "@crates//:http-1.4.0",
        "@crates//:http-body-1.0.1",
        "@crates//:http-body-util-0.1.3",
        "@crates//:lru-0.16.4",
        "@crates//:rand-0.9.4",
        "@crates//:reqwest-0.13.4",
        "@crates//:rmcp-1.7.0",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:sqlx-0.8.6",
        "@crates//:sse-stream-0.2.3",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
)

rust_test(
    name = "agent_egress_unit",
    crate = ":agent_egress",
    crate_features = [],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_egress", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "@crates//:anyhow-1.0.103",
        "@crates//:tower-0.5.3",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/agent_egress"},
)

