load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "soup_filter_projection",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "models",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_filter_projection"},
    deps = [
        "//crates/document_sub_type:document_sub_type",
        "//crates/item_filter_index:item_filter_index",
        "//crates/models_soup:models_soup",
        "//crates/predicate_index:predicate_index",
        "//crates/soup:soup",
        "@crates//:base64-0.22.1",
        "@crates//:chrono-0.4.45",
        "@crates//:postcard-1.1.3",
        "@crates//:serde-1.0.228",
        "@crates//:thiserror-2.0.18",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "soup_filter_projection_unit",
    crate = ":soup_filter_projection",
    crate_features = [
        "default",
        "models",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_filter_projection"},
    deps = [
        "//crates/model_owner:model_owner",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/soup_filter_projection"},
)

