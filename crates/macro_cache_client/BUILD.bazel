load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "macro_cache_client",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "all",
        "auth",
        "auth_rate_limit",
        "default",
        "login_code_rate_limit",
        "mobile_welcome_email_rate_limit",
        "notification_rate_limit",
        "verify_email_rate_limit",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_cache_client"},
    deps = [
        "//crates/email_validator:email_validator",
        "//crates/macro_redis:macro_redis",
        "@crates//:anyhow-1.0.103",
        "@crates//:redis-1.2.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "macro_cache_client_unit",
    crate = ":macro_cache_client",
    crate_features = [
        "all",
        "auth",
        "auth_rate_limit",
        "default",
        "login_code_rate_limit",
        "mobile_welcome_email_rate_limit",
        "notification_rate_limit",
        "verify_email_rate_limit",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_cache_client"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/macro_cache_client"},
)

