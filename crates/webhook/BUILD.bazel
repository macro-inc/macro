load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "webhook",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "consumer",
        "default",
        "inbound",
        "ingestion",
        "outbound",
        "ports",
        "stream",
        "worker",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/webhook", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/agent_session:agent_session",
        "//crates/agent_trigger:agent_trigger",
        "//crates/channels:channels",
        "//crates/documents:documents",
        "//crates/entity_access:entity_access",
        "//crates/kafka_util:kafka_util",
        "//crates/macro_authorization:macro_authorization",
        "//crates/macro_event_broker:macro_event_broker",
        "//crates/macro_event_topics:macro_event_topics",
        "//crates/macro_user_id:macro_user_id",
        "//crates/macro_uuid:macro_uuid",
        "//crates/messages:messages",
        "//crates/model-error-response:model_error_response",
        "//crates/model_owner:model_owner",
        "//crates/model_user:model_user",
        "//crates/rate_limit:rate_limit",
        "//crates/sqs_client:sqs_client",
        "//crates/webhook_signature:webhook_signature",
        "@crates//:anyhow-1.0.103",
        "@crates//:axum-0.8.9",
        "@crates//:axum-extra-0.10.3",
        "@crates//:chrono-0.4.45",
        "@crates//:futures-0.3.32",
        "@crates//:rdkafka-0.37.0",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:strum-0.27.2",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-retry-0.3.2",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
        "@crates//:utoipa-5.5.0",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "webhook_unit",
    crate = ":webhook",
    crate_features = [
        "consumer",
        "default",
        "inbound",
        "ingestion",
        "outbound",
        "ports",
        "stream",
        "worker",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/webhook", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/agent_runtime_protocol:agent_runtime_protocol",
        "//crates/bot_id:bot_id",
        "//crates/channel_sender:channel_sender",
        "//crates/folds/agent_fold:agent_fold",
        "//crates/macro_db_migrator:macro_db_migrator",
        "@crates//:tower-0.5.3",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/webhook"},
)

