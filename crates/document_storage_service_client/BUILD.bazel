load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "document_storage_service_client",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/document_storage_service_client"},
    deps = [
        "//crates/entity_registry/shared_entity_registry:shared_entity_registry",
        "//crates/model:model",
        "//crates/model_owner:model_owner",
        "//crates/models_bulk_upload:models_bulk_upload",
        "//crates/models_permissions:models_permissions",
        "@crates//:anyhow-1.0.103",
        "@crates//:reqwest-0.13.4",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:thiserror-2.0.18",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "document_storage_service_client_unit",
    crate = ":document_storage_service_client",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/document_storage_service_client"},
    deps = [
        "//crates/bot_id:bot_id",
        "@crates//:tokio-1.54.1",
        "@crates//:wiremock-0.6.5",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/document_storage_service_client"},
)

