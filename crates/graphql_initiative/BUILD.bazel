load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "graphql_initiative",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_initiative"},
    deps = [
        "//crates/entity_access:entity_access",
        "//crates/graphql_common:graphql_common",
        "//crates/graphql_permission:graphql_permission",
        "//crates/graphql_properties:graphql_properties",
        "//crates/graphql_soup:graphql_soup",
        "//crates/initiative:initiative",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-entity:model_entity",
        "//crates/models_permissions:models_permissions",
        "@crates//:async-graphql-7.2.1",
        "@crates//:futures-0.3.32",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "graphql_initiative_unit",
    crate = ":graphql_initiative",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_initiative"},
    deps = [
        "//crates/activity:activity",
        "//crates/model_owner:model_owner",
        "//crates/models_pagination:models_pagination",
        "//crates/models_properties:models_properties",
        "//crates/models_soup:models_soup",
        "//crates/soup:soup",
        "@crates//:chrono-0.4.45",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
    ],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/crates/graphql_initiative"},
)

