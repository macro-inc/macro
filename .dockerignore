# Version-control and local-agent state
.git
.jj
.agents
.cursor
.claude/.local
.pi/outputs
/infra/local/generated

# Legacy layout directories may still contain ignored local build artifacts.
/agents
/js
/rust

# User-facing applications and shared JavaScript packages are not part of most
# backend service build contexts. Hosted lexical is a Cloudflare Worker; the
# local Docker image uses docker/lexical-service.Dockerfile.dockerignore, which
# still includes the JS workspace. Do not drop these lines to unstick a local
# lexical build — that invalidates every service image cache. If a builder
# ignores Dockerfile-specific dockerignores, comment them out locally only.
/apps
/packages

# Secrets and local configuration
.env
.env.*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.dev.vars*

# Dependency and generated output
**/node_modules
**/target
**/dist
**/build
**/.wrangler
**/test-results
**/playwright-report
**/coverage
**/.cache
**/.vite
**/*.tsbuildinfo
**/*.log

# Editor and operating-system noise
**/.DS_Store
**/.idea
**/.vscode
**/*.swp
**/*.swo
