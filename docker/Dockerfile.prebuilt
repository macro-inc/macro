# syntax=docker/dockerfile:1
FROM denoland/deno:2.9.6 AS deno
FROM debian:trixie-slim AS runner
ARG SERVICE_NAME=__MISSING_SERVICE_NAME__
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    dumb-init \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Copy the runtime closure and pre-built Linux binary from the GitHub Actions artifact.
COPY ./prebuilt/nix-store/ /nix/store/
COPY --chmod=755 ./prebuilt/${SERVICE_NAME} /app/svc

# Only the agent harness hosts code-mode subprocesses.
RUN --mount=from=deno,source=/usr/bin/deno,target=/tmp/deno,ro \
  if [ "$SERVICE_NAME" = "agent_harness_service" ]; then \
    install -m 755 /tmp/deno /usr/local/bin/deno; \
  fi

ENV PORT=8080
EXPOSE ${PORT}
ENTRYPOINT ["dumb-init", "./svc"]
