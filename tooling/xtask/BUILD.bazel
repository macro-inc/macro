load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_binary(
    name = "xtask_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "xtask",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_Cargo_toml", "//:esc_docker_docker_compose_yml", "//:esc_static_assets_schema_graphql", "//tooling/xtask/crates/xtask_nextest_filter:all_files", "//tooling/xtask/crates/xtask_paths:all_files", "//tooling/xtask/crates/xtask_workflows:all_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
)

