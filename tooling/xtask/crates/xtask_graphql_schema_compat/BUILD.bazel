load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "xtask_graphql_schema_compat",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_static_assets_schema_graphql"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask/crates/xtask_graphql_schema_compat"},
    deps = [
        "//tooling/xtask/crates/xtask_paths:xtask_paths",
        "@crates//:anyhow-1.0.103",
        "@crates//:apollo-compiler-1.32.0",
        "@crates//:chrono-0.4.45",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "xtask_graphql_schema_compat_unit",
    crate = ":xtask_graphql_schema_compat",
    crate_features = [],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask/crates/xtask_graphql_schema_compat"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_static_assets_schema_graphql"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask/crates/xtask_graphql_schema_compat"},
)

rust_binary(
    name = "xtask_graphql_schema_compat_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "xtask_graphql_schema_compat",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_static_assets_schema_graphql"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask/crates/xtask_graphql_schema_compat"},
    deps = [
        "//tooling/xtask/crates/xtask_paths:xtask_paths",
        ":xtask_graphql_schema_compat",
        "@crates//:anyhow-1.0.103",
        "@crates//:apollo-compiler-1.32.0",
        "@crates//:chrono-0.4.45",
    ],
    proc_macro_deps = [],
    aliases = {},
)

