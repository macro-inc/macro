load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_binary(
    name = "xtask_workflows_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "xtask_workflows",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_apps_web_scripts_ios_app_store_test_mjs", "//crates/agent_harness:all_files"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask/crates/xtask_workflows"},
    deps = [
        "//tooling/xtask/crates/xtask_paths:xtask_paths",
        "@crates//:anyhow-1.0.103",
        "@crates//:gh-workflow-0.8.1",
        "@crates//:serde_json-1.0.150",
        "@crates//:serde_yaml-0.9.34+deprecated",
    ],
    proc_macro_deps = [
        "@crates//:indoc-2.0.7",
    ],
    aliases = {},
)

