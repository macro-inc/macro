load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_binary(
    name = "xtask_local_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "xtask_local",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "local-stack",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//:esc_docker_docker_compose_yml"],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask/crates/xtask_local"},
    deps = [
        "//crates/macro_aws_config:macro_aws_config",
        "//crates/macro_env_var:macro_env_var",
        "//crates/macro_event_topics:macro_event_topics",
        "//crates/macro_queues:macro_queues",
        "//tooling/xtask/crates/xtask_paths:xtask_paths",
        "@crates//:anyhow-1.0.103",
        "@crates//:aws-sdk-dynamodb-1.112.0",
        "@crates//:aws-sdk-kms-1.109.0",
        "@crates//:aws-sdk-s3-1.133.0",
        "@crates//:aws-sdk-sqs-1.99.0",
        "@crates//:bollard-0.21.0",
        "@crates//:clap-4.6.1",
        "@crates//:console-0.15.11",
        "@crates//:docker-compose-types-0.24.0",
        "@crates//:dotenvy-0.15.7",
        "@crates//:indexmap-2.14.0",
        "@crates//:indicatif-0.18.6",
        "@crates//:libc-0.2.186",
        "@crates//:rdkafka-0.37.0",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:serde_yaml-0.9.34+deprecated",
        "@crates//:sha2-0.10.9",
        "@crates//:strum-0.27.2",
        "@crates//:tokio-1.54.1",
    ],
    proc_macro_deps = [
        "@crates//:indoc-2.0.7",
    ],
    aliases = {},
)

