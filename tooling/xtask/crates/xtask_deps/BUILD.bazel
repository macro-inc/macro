load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_binary(
    name = "xtask_deps_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "xtask_deps",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/xtask/crates/xtask_deps"},
    deps = [
        "//tooling/xtask/crates/xtask_graph:xtask_graph",
        "@crates//:anyhow-1.0.103",
        "@crates//:guppy-0.17.26",
        "@crates//:hakari-0.17.9",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:toml-0.8.23",
    ],
    proc_macro_deps = [],
    aliases = {},
)

