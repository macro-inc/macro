load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_binary(
    name = "native_app_server_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "native_app_server",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/native_app_server"},
    deps = [
        "//crates/macro_env_var:macro_env_var",
        "//crates/native_app_service:native_app_service",
        "@crates//:axum-0.8.9",
        "@crates//:rootcause-0.12.1",
        "@crates//:semver-1.0.28",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:tokio-1.54.1",
        "@crates//:tower-http-0.6.11",
        "@crates//:tracing-0.1.44",
        "@crates//:tracing-subscriber-0.3.23",
        "@crates//:url-2.5.8",
        "@crates//:zip-9.0.5",
    ],
    proc_macro_deps = [],
    aliases = {},
)

