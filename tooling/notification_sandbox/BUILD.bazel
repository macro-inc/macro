load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_binary(
    name = "notification_sandbox_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "notification_sandbox",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/tooling/notification_sandbox", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/email_formatting:email_formatting",
        "//crates/macro_aws_config:macro_aws_config",
        "//crates/macro_env:macro_env",
        "//crates/macro_user_id:macro_user_id",
        "//crates/model-entity:model_entity",
        "//crates/model_notifications:model_notifications",
        "//crates/models_pagination:models_pagination",
        "//crates/notification:notification",
        "//crates/rate_limit:rate_limit",
        "@crates//:aws-sdk-sesv2-1.119.0",
        "@crates//:aws-sdk-sns-1.100.0",
        "@crates//:chrono-0.4.45",
        "@crates//:either-1.16.0",
        "@crates//:hmac-0.12.1",
        "@crates//:inquire-0.7.5",
        "@crates//:redis-1.2.1",
        "@crates//:rootcause-0.12.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:sqlx-0.8.6",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:tracing-subscriber-0.3.23",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

