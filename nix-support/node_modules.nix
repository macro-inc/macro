{
  lib,
  stdenvNoCC,
  bun,
  coreutils,
  findutils,
  git,
  src ? ../js,
  hash ? (
    (builtins.fromJSON (builtins.readFile ./node_modules-hashes.json))
    .nodeModules.${stdenvNoCC.hostPlatform.system} or lib.fakeHash
  ),
}:
let
  packageJson = builtins.fromJSON (builtins.readFile ../js/app/packages/app/package.json);
  platform = stdenvNoCC.hostPlatform;
  bunCpu =
    if platform.isAarch64 then
      "arm64"
    else if platform.isx86_64 then
      "x64"
    else
      throw "unsupported Bun CPU for ${platform.system}";
  bunOs =
    if platform.isLinux then
      "linux"
    else if platform.isDarwin then
      "darwin"
    else
      throw "unsupported Bun OS for ${platform.system}";

  nodeModulesSrc = lib.cleanSourceWith {
    inherit src;
    filter =
      path: type:
      let
        rel = lib.removePrefix ((toString src) + "/") (toString path);
      in
      if type == "directory" then
        !(lib.hasInfix "/node_modules" rel)
        && !(lib.hasInfix "/dist" rel)
        && !(lib.hasInfix "/target" rel)
        && !(lib.hasInfix "/.direnv" rel)
        && rel != "node_modules"
        && rel != "dist"
        && rel != "target"
        && rel != ".direnv"
      else
        rel == "bun.lock"
        || rel == "package.json"
        || lib.hasSuffix "/package.json" rel
        || lib.hasPrefix "app/patches/" rel;
  };
in
stdenvNoCC.mkDerivation {
  pname = "macro-js-node-modules";
  version = packageJson.version;

  src = nodeModulesSrc;

  impureEnvVars = lib.fetchers.proxyImpureEnvVars ++ [
    "GIT_PROXY_COMMAND"
    "SOCKS_SERVER"
  ];

  nativeBuildInputs = [
    bun
    coreutils
    findutils
    git
  ];

  dontConfigure = true;

  buildPhase = ''
    runHook preBuild

    export HOME="$TMPDIR/home"
    export BUN_INSTALL_CACHE_DIR="$TMPDIR/bun-cache"
    mkdir -p "$HOME" "$BUN_INSTALL_CACHE_DIR"

    bun install \
      --cpu="${bunCpu}" \
      --os="${bunOs}" \
      --linker=hoisted \
      --frozen-lockfile \
      --ignore-scripts \
      --no-progress

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    mkdir -p "$out"
    find . -type d -name node_modules -exec cp -R --parents {} "$out" \;
    runHook postInstall
  '';

  dontFixup = true;

  outputHashAlgo = "sha256";
  outputHashMode = "recursive";
  outputHash = hash;

  meta.platforms = [
    "aarch64-darwin"
    "aarch64-linux"
    "x86_64-darwin"
    "x86_64-linux"
  ];
}
