{
  "include": ["src", "scripts", "vite.config.ts", "vite.local-auth.config.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "bun"],
    "paths": {
      "@macro-inc/sdk/generated/auth": [
        "../../packages/sdk/generated/auth/index.ts"
      ],
      "@macro-inc/sdk/generated/storage": [
        "../../packages/sdk/generated/storage/index.ts"
      ]
    }
  }
}
