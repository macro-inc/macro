{
  "name": "@macro-inc/bots",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:auth": "vite --config vite.local-auth.config.ts --mode local-auth",
    "dev:billing": "vite --config vite.local-auth.config.ts --mode local-billing",
    "preview": "vite preview --mode local-fixture",
    "build:preview": "bun run check:boundary && vite build --mode local-fixture",
    "check:boundary": "bun scripts/verify-bots-boundary.ts",
    "type-check": "tsc --noEmit",
    "lint": "biome ci && oxlint --type-aware",
    "test": "bun test",
    "build": "bun run check:boundary && vite build"
  },
  "dependencies": {
    "@kobalte/core": "0.13.11",
    "@macro-inc/sdk": "workspace:*",
    "@solidjs/router": "^0.15.3",
    "solid-js": "^1.9.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "^1.2.19",
    "@types/node": "^24.8.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^5.9.3",
    "vite": "8.3.7",
    "vite-plugin-solid": "2.11.16"
  }
}
