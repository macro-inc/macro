{
  "version": "2.5.0",
  "bundle": {
    "android": {
      "versionCode": 18
    }
  },
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macro",
  "identifier": "com.macro.workspace.mobile",
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "macro"
          ],
          "host": "app",
          "appLink": false
        },
        {
          "host": "macro.com",
          "path": [
            "/app"
          ],
          "pathPrefix": [
            "/app/"
          ]
        },
        {
          "host": "dev.macro.com",
          "path": [
            "/app"
          ],
          "pathPrefix": [
            "/app/"
          ]
        },
        {
          "host": "staging.macro.com",
          "path": [
            "/app"
          ],
          "pathPrefix": [
            "/app/"
          ]
        }
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Macro",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled",
        "useHttpsScheme": true
      }
    ]
  }
}
