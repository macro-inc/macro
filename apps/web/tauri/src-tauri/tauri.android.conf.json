{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macro",
  "identifier": "com.macro.workspace.mobile",
  "version": "2.5.0",
  "bundle": {
    "android": {
      "versionCode": 1
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        { "scheme": ["macro"], "host": "app", "appLink": false },
        { "host": "macro.com", "path": ["/app"], "pathPrefix": ["/app/"] },
        { "host": "dev.macro.com", "path": ["/app"], "pathPrefix": ["/app/"] },
        { "host": "staging.macro.com", "path": ["/app"], "pathPrefix": ["/app/"] }
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Macro",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled",
        "useHttpsScheme": true
      }
    ]
  }
}
