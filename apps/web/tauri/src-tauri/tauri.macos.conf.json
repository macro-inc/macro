{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Macro",
        "width": 800,
        "height": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "hiddenTitle": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/macos/Macro.icns"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/macos/Assets.car"
      },
      "infoPlist": "icons/macos/Info.plist"
    }
  }
}
