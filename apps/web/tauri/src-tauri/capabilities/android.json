{
  "identifier": "android-capability",
  "platforms": [
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "android-mobile:allow-register-listener",
    "android-mobile:allow-remove-listener",
    "android-auth:allow-authenticate",
    "android-mobile:allow-getInsets",
    "android-mobile:allow-getPendingShares",
    "android-mobile:allow-clearShares",
    "android-mobile:allow-stageClipboardImage",
    "android-mobile:allow-beginExport",
    "android-mobile:allow-appendExport",
    "android-mobile:allow-finishExport",
    "android-mobile:allow-discardExport",
    "android-push:default"
  ]
}
