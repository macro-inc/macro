{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Macro",
        "width": 800,
        "height": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true,
        "decorations": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "publisher": "Macro",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
