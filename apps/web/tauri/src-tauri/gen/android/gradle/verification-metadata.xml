<?xml version="1.0" encoding="UTF-8"?>
<!-- Pins the rustls-platform-verifier AAR, which Gradle downloads from a GitHub
     branch rather than a package registry. Every other group is trusted as
     before; only org.rustls needs a checksum, so a new verifier version fails
     the build until its SHA-256 is added here. See app/rustls-verifier.gradle.kts. -->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!org\.rustls$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="org.rustls" name="rustls-platform-verifier" version="0.2.0">
         <artifact name="rustls-platform-verifier-0.2.0.aar">
            <sha256 value="aa021794230fbc2f0be355999e2cf67398dd563de066a2e17001ffbd0b69101b" origin="Downloaded from the rustls-platform-verifier maven-archive branch; matches the published .sha1"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
