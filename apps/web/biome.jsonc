{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": true,
  "extends": ["../../biome.base.jsonc"],
  "vcs": {
    "root": "../.."
  },
  "files": {
    // orval's storage zod.ts passed 1 MiB with calendar schemas and 2 MiB with databases and Slack imports
    "maxSize": 4194304,
    "includes": [
      "**/*.{ts,tsx,js,jsx}",
      "**/openapi.json",
      "!**/*.d.ts",
      "!chrome-extension-vite",
      "!infra/web-app/output",
      "!scripts",
      "!.direnv",
      "src/lib/service-clients/**/generated/**",
      // graphql-codegen output; regenerated wholesale by `bun gen-graphql`
      "!src/lib/service-clients/service-storage/graphql/generated",
      "!src/lib/filesystem",
      "!packages/_app-mobile",
      "**/generated/tools",
      "!wireframe",
      "!dist",
      "!build",
      "!**/node_modules"
    ]
  },
  "overrides": [
    {
      "includes": ["scripts/**", "src/features/block-code/scripts/**"],
      "javascript": {
        "globals": ["Bun"]
      }
    },
    {
      "includes": ["src/lib/animate/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/split-router/next/routes/**",
        "src/lib/split-router/next/router/run.ts",
        "src/lib/split-router/next/router/url-gate.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/**"],
                    "message": "The split router's route table and navigation machines are pure; keep Solid out of them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/service-clients/**/generated/**"],
      "linter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "on"
          }
        }
      }
    }
  ]
}
