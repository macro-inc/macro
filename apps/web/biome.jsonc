{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": true,
  "extends": ["../../biome.base.jsonc"],
  "vcs": {
    "root": "../.."
  },
  "files": {
    // orval's zod.ts crossed biome's 1 MiB default once calendar schemas landed
    "maxSize": 2097152,
    "includes": [
      "**/*.{ts,tsx,js,jsx}",
      "**/openapi.json",
      "!**/*.d.ts",
      "!chrome-extension-vite",
      "!infra/web-app/output",
      "!scripts",
      "src/lib/service-clients/**/generated/**",
      // graphql-codegen output; regenerated wholesale by `bun gen-graphql`
      "!src/lib/service-clients/service-storage/graphql/generated",
      "!src/lib/filesystem",
      "!packages/_app-mobile",
      "**/generated/tools",
      "!wireframe",
      "!dist",
      "!build",
      "!**/node_modules"
    ]
  },
  "overrides": [
    {
      "includes": ["scripts/**", "src/features/block-code/scripts/**"],
      "javascript": {
        "globals": ["Bun"]
      }
    },
    {
      "includes": ["src/lib/animate/**", "src/features/theme/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/service-clients/**/generated/**"],
      "linter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "on"
          }
        }
      }
    }
  ]
}
