{
  // oxlint runs ALONGSIDE Biome, scoped to rules Biome cannot express.
  // Enforces FE-12 and FE-13 from docs/development/style-guide.md.
  //
  // Run: bun run lint:oxlint (from the repository root), or `bunx oxlint` from apps/web.
  //
  // typescript/no-floating-promises needs type information, so plain runs skip
  // it. `bun scripts/check-floating-promises.ts` (from apps/web) runs it with
  // `--type-aware` against floating-promises-baseline.json, a per-file ratchet:
  // a file may not gain violations, and the baseline must be lowered when
  // violations are fixed.
  "plugins": ["promise", "typescript"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "promise/prefer-await-to-then": "warn",
    // eslint/complexity — McCabe cyclomatic complexity, default max 20.
    // https://oxc.rs/docs/guide/usage/linter/rules/eslint/complexity
    "complexity": "warn",
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/generated/**",
    "**/*.gen.ts",
    "**/patches/**"
  ]
}
