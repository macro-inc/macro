{
  // oxlint runs ALONGSIDE Biome, scoped to rules Biome cannot express.
  // Enforces FE-12 and FE-13 from docs/development/style-guide.md.
  //
  // Run: bun run lint:oxlint (from the repository root).
  //
  // typescript/no-floating-promises needs type information, so run oxlint with
  // `--type-aware` and oxlint-tsgolint (lint:oxlint does). Without it the rule
  // is skipped silently. `typeAware` is a CLI flag rather than
  // `options.typeAware` because `just check` also lints apps/marketing with
  // this config, and tsgolint rejects its tsconfig.
  "plugins": ["promise", "typescript"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "promise/prefer-await-to-then": "warn",
    // eslint/complexity — McCabe cyclomatic complexity, default max 20.
    // https://oxc.rs/docs/guide/usage/linter/rules/eslint/complexity
    "complexity": "warn",
    // ignoreVoid is off: `void` doesn't mark a promise as handled (FE-13).
    // Calls listed under allowForKnownSafeCalls never reject (TanStack
    // QueryClient swallows errors unless throwOnError is set). Write them
    // without `void`; tsgolint flags a voided call even when it is listed.
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false,
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "@tanstack/query-core",
            "name": [
              "cancelQueries",
              "invalidateQueries",
              "prefetchInfiniteQuery",
              "prefetchQuery",
              "refetchQueries",
              "resetQueries"
            ]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/generated/**",
    "**/*.gen.ts",
    "**/patches/**"
  ]
}
