    "/contacts/lists/{list}/members": {
      "get": {
        "tags": ["contacts"],
        "summary": "GET /contacts/lists/{list}/members handler: one page of the members of one\nof the viewer's contact lists. Read from the list-aware directory for every\nviewer, whatever store the `contacts-list-reads` flag picks for their\nother reads; stored lists may be incomplete until the list backfill has\nrun. `teammates` is the viewer's current team.",
        "operationId": "list_contact_list_members",
        "parameters": [
          {
            "name": "list",
            "in": "path",
            "description": "The list's key.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ContactList"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque `nextCursor` from the previous page of the same list.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size: default 100; zero or over 500 is rejected.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 500,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListMembersResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/contacts/search": {
      "get": {
        "tags": ["contacts"],
        "summary": "GET /contacts/search handler: ranked search of the viewer's contacts and team.",
        "operationId": "search_people",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Text matched against email and name. Under two characters after\ntrimming returns no people; over 512 bytes is rejected.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum results: default 20, values over 50 are capped at 50, zero is rejected.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPeopleResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddContactRequest": {
        "type": "object",
        "description": "Request body for POST /contacts.",
        "required": ["user_id"],
        "properties": {
          "user_id": {
            "type": "string",
            "description": "The user ID to add as a contact."
          }
        }
      },
      "ContactList": {
        "type": "string",
        "description": "One list in a user's directory. A person is in the directory when they are\nin at least one of the owner's lists. The key (`as_ref`, parsed back with\n`FromStr`, and the same in serde) is what storage and clients see.",
        "enum": ["teammates", "interacted", "invited", "gmail", "outlook"]
      },
      "GetContactsResponse": {
        "type": "object",
        "description": "Response body for GET /contacts.",
        "required": ["contacts"],
        "properties": {
          "contacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The list of contact user IDs."
          }
        }
      },
      "ListMembersResponse": {
        "type": "object",
        "description": "Response body for GET /contacts/lists/{list}/members.",
        "required": ["members"],
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The members' user IDs (`macro|<email>`), in ID order. Never the viewer."
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Pass back as `cursor` for the next page. Only its absence means the\nlist is exhausted: a page may be short, or even empty, and still have one."
          }
        }
      },
      "SearchPeopleResponse": {
        "type": "object",
        "description": "Response body for GET /contacts/search.",
        "required": ["people"],
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchedPerson"
            },
            "description": "Matches ranked by group, then prefix matches, then by name or email.\nTeammates come first. For a viewer on the list-aware directory,\n`interacted` and `invited` people come next, then `gmail` and\n`outlook` and `imap` contacts."
          }
        }
      },
      "SearchedPerson": {
        "type": "object",
        "description": "One ranked person in a GET /contacts/search response.",
        "required": ["userId", "isTeammate", "isAgent", "lists"],
        "properties": {
          "isAgent": {
            "type": "boolean",
            "description": "Whether the person is an agent rather than a human; false for non-Macro contacts."
          },
          "isTeammate": {
            "type": "boolean",
            "description": "Whether the person is on the viewer's current team."
          },
          "lists": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The keys of the viewer's contact lists the person is in (`teammates`,\n`interacted`, `invited`, `gmail`, `outlook`, `imap`; more may be added). Empty\nfor the viewer and for a contact only the legacy directory knows."
          },
          "name": {
            "type": ["string", "null"],
            "description": "Resolved name, as the contact directory shows it; null when unknown."
          },
          "userId": {
            "type": "string",
            "description": "The person's user ID (`macro|<email>`)."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "macro contacts service",
      "description": "Contacts Service"
    }
  ]
}
