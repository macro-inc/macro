  "paths": {
    "/contacts": {
      "get": {
        "tags": ["contacts"],
        "summary": "GET /contacts handler.",
        "operationId": "get_contacts",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
