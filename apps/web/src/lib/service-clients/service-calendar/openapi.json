{
  "openapi": "3.1.0",
  "info": {
    "title": "calendar_service",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/calendars": {
      "get": {
        "tags": ["calendar_events"],
        "summary": "List the requester's visible calendars for pickers and filters.",
        "operationId": "list_calendars",
        "responses": {
          "200": {
            "description": "Calendars visible to the requester",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCalendarsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "503": {
            "description": "Transient failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "tags": ["calendar_events"],
        "summary": "Create a calendar event and return its synced entity.",
        "operationId": "create_calendar_event",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCalendarEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The created calendar event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEvent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid event fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Calendar is read-only or needs reauthorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "409": {
            "description": "No writable calendar or the provider rejected the event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "503": {
            "description": "Transient provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}": {
      "delete": {
        "tags": ["calendar_events"],
        "summary": "Delete a calendar event at its provider.",
        "operationId": "delete_calendar_event",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "description": "Calendar event entity id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "calendarId",
            "in": "query",
            "description": "Calendar whose copy of the event is deleted, for an event synced from\nmore than one calendar. Omit to delete the canonical copy.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "description": "Deletion scope; defaults to the entire event or series.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CalendarDeletionScopeParam"
            }
          },
          {
            "name": "recurrenceId",
            "in": "query",
            "description": "Original-start key of the occurrence a scoped deletion targets.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The event was deleted"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Calendar is read-only or needs reauthorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "409": {
            "description": "The provider rejected the deletion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "503": {
            "description": "Transient provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["calendar_events"],
        "summary": "Update fields of a calendar event and return its synced entity.",
        "operationId": "update_calendar_event",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "description": "Calendar event entity id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCalendarEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated calendar event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEvent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid event fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Calendar is read-only or needs reauthorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "404": {
            "description": "Event or targeted occurrence not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "409": {
            "description": "The provider rejected the update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "503": {
            "description": "Transient provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}/rsvp": {
      "put": {
        "tags": ["calendar_events"],
        "summary": "Set the requester's RSVP on a calendar event and return its synced entity.",
        "operationId": "rsvp_calendar_event",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "description": "Calendar event entity id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RsvpCalendarEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated calendar event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEvent"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Calendar is read-only or needs reauthorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "409": {
            "description": "The connected account is not an attendee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          },
          "503": {
            "description": "Transient provider failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarMutationApiError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["crate::health"],
        "summary": "Health check",
        "operationId": "health_handler",
        "responses": {
          "200": {
            "description": "health",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttendeeResponseStatus": {
        "type": "string",
        "description": "RSVP state for an attendee.",
        "enum": ["needs_action", "accepted", "declined", "tentative"]
      },
      "CalendarAttendee": {
        "type": "object",
        "description": "An attendee on a calendar event.",
        "required": [
          "email",
          "responseStatus",
          "isOrganizer",
          "isOptional",
          "isSelf"
        ],
        "properties": {
          "comment": {
            "type": ["string", "null"],
            "description": "Optional attendee comment."
          },
          "displayName": {
            "type": ["string", "null"],
            "description": "Provider display name."
          },
          "email": {
            "type": "string",
            "description": "Normalized email address."
          },
          "isOptional": {
            "type": "boolean",
            "description": "Whether attendance is optional."
          },
          "isOrganizer": {
            "type": "boolean",
            "description": "Whether this attendee is the organizer."
          },
          "isSelf": {
            "type": "boolean",
            "description": "Whether this attendee is one of the viewing requester's inboxes."
          },
          "responseStatus": {
            "$ref": "#/components/schemas/AttendeeResponseStatus",
            "description": "RSVP state."
          }
        }
      },
      "CalendarAttendeeInputBody": {
        "type": "object",
        "description": "An attendee supplied to a calendar mutation.",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "description": "Attendee email address."
          },
          "isOptional": {
            "type": "boolean",
            "description": "Whether attendance is optional."
          }
        }
      },
      "CalendarDeletionScopeParam": {
        "type": "string",
        "description": "How much of a recurring series a deletion removes.",
        "enum": ["all", "this_event", "this_and_following"]
      },
      "CalendarEvent": {
        "type": "object",
        "description": "A stable, first-class Macro calendar event entity.\n\nContent fields hold the canonical source's values: the account's primary\ncalendar copy when one is synced, else the freshest remaining copy.",
        "required": [
          "id",
          "ownerId",
          "icalUid",
          "title",
          "status",
          "visibility",
          "transparency",
          "time",
          "recurrenceLines",
          "sequence",
          "isReadOnly",
          "attendees",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarAttendee"
            },
            "description": "Attendees, keyed by email during persistence."
          },
          "calendarId": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Calendar the canonical source belongs to, when known. Absent only in\nprojections stored before calendars were attributed."
          },
          "conferenceProvider": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConferenceProvider",
                "description": "Which conferencing system backs `conference_url`. `None` whenever no\nconference is attached."
              }
            ]
          },
          "conferenceUrl": {
            "type": ["string", "null"],
            "description": "Direct join URL when known."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Entity creation time."
          },
          "creatorEmail": {
            "type": ["string", "null"],
            "description": "Provider-reported creator email. Distinct from the organizer when\nsomeone writes onto a calendar they do not own. Omitted from stored\nprojections when unknown so events ingested before this field still\ncompare equal."
          },
          "creatorName": {
            "type": ["string", "null"],
            "description": "Provider-reported creator display name."
          },
          "description": {
            "type": ["string", "null"],
            "description": "Optional event body."
          },
          "eventType": {
            "$ref": "#/components/schemas/EventType",
            "description": "Provider event type. Skipped when it is the regular type so\nprojections stored before event types were modeled still compare\nequal."
          },
          "icalUid": {
            "type": "string",
            "description": "RFC 5545 UID used to reconcile provider and email sources."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Macro entity identifier."
          },
          "isReadOnly": {
            "type": "boolean",
            "description": "Whether the canonical source's calendar prohibits editing it."
          },
          "location": {
            "type": ["string", "null"],
            "description": "Optional physical or virtual location label."
          },
          "organizerEmail": {
            "type": ["string", "null"],
            "description": "Organizer email."
          },
          "organizerName": {
            "type": ["string", "null"],
            "description": "Organizer display name."
          },
          "ownerId": {
            "type": "string",
            "description": "Macro user who owns this event entity."
          },
          "recurrenceLines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Raw RFC 5545 recurrence properties (`RRULE`, `RDATE`, `EXDATE`)."
          },
          "reminders": {
            "$ref": "#/components/schemas/EventReminders",
            "description": "Per-user reminder configuration. Skipped when it is the provider\ndefault so projections stored before reminders were modeled still\ncompare equal."
          },
          "sequence": {
            "type": "integer",
            "format": "int32",
            "description": "Provider/iCalendar sequence number.",
            "minimum": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarEventSourceContent"
            },
            "description": "Content of every active copy of this event, canonical first: the\nprimary calendar's copy, then the freshest. A client picks the copy\nwhose calendar it is showing and falls back to the first. Populated\nonly on the read path, so stored projections omit it."
          },
          "status": {
            "$ref": "#/components/schemas/EventStatus",
            "description": "Event status."
          },
          "time": {
            "$ref": "#/components/schemas/EventTime",
            "description": "Timed or all-day shape."
          },
          "title": {
            "type": "string",
            "description": "Display title."
          },
          "transparency": {
            "$ref": "#/components/schemas/EventTransparency",
            "description": "Availability behavior."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Entity update time."
          },
          "visibility": {
            "$ref": "#/components/schemas/EventVisibility",
            "description": "Event visibility."
          }
        }
      },
      "CalendarEventSourceContent": {
        "type": "object",
        "description": "The content one provider copy of an event carries.\n\nGoogle keeps these fields per calendar copy: a shared calendar's copy of a\nmember's event can have its own title, type, reminders, and access role.\nThe entity holds its canonical source's values. Every other copy's values\nare read from here so a client can show the copy that belongs to the\ncalendar being viewed.",
        "required": [
          "calendarId",
          "title",
          "eventType",
          "visibility",
          "transparency",
          "isReadOnly",
          "reminders"
        ],
        "properties": {
          "calendarId": {
            "type": "string",
            "format": "uuid",
            "description": "Calendar this copy lives on."
          },
          "creatorEmail": {
            "type": ["string", "null"],
            "description": "Provider-reported creator email."
          },
          "creatorName": {
            "type": ["string", "null"],
            "description": "Provider-reported creator display name."
          },
          "description": {
            "type": ["string", "null"],
            "description": "Optional event body."
          },
          "eventType": {
            "$ref": "#/components/schemas/EventType",
            "description": "Provider event type."
          },
          "isReadOnly": {
            "type": "boolean",
            "description": "Whether the calendar's access role prohibits editing this copy."
          },
          "location": {
            "type": ["string", "null"],
            "description": "Optional physical or virtual location label."
          },
          "reminders": {
            "$ref": "#/components/schemas/EventReminders",
            "description": "Reminder configuration of this copy."
          },
          "title": {
            "type": "string",
            "description": "Display title."
          },
          "transparency": {
            "$ref": "#/components/schemas/EventTransparency",
            "description": "Availability behavior."
          },
          "visibility": {
            "$ref": "#/components/schemas/EventVisibility",
            "description": "Event visibility."
          }
        }
      },
      "CalendarMutationApiError": {
        "type": "object",
        "description": "HTTP error body returned by calendar mutation endpoints.",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CalendarMutationErrorCode",
            "description": "Machine-readable failure category."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure description."
          }
        }
      },
      "CalendarMutationErrorCode": {
        "type": "string",
        "description": "Machine-readable failure category for calendar mutations.",
        "enum": [
          "not_found",
          "occurrence_not_found",
          "read_only",
          "no_writable_calendar",
          "not_attendee",
          "invalid_input",
          "reauth_required",
          "provider_rejected",
          "retryable",
          "persist_failed"
        ]
      },
      "CalendarRsvpScopeParam": {
        "type": "string",
        "description": "How much of a recurring series an RSVP applies to.\n\nUnlike deletion there is no this-and-following variant: the provider\ncannot express a forward-scoped response, so offering one would be a\npromise sync could not keep.",
        "enum": ["all", "this_event"]
      },
      "CalendarUpdateScopeParam": {
        "type": "string",
        "description": "How much of a recurring series an update applies to.\n\nLike RSVPs there is no this-and-following variant: the provider cannot\nexpress a forward-scoped edit as one write, and emulating it (truncate\nthe series, insert an edited clone) is non-atomic and re-invites the\nattendees of the clone. Compose it from a this-and-following deletion\nand a create when that shape is wanted.",
        "enum": ["all", "this_event"]
      },
      "ConferenceChange": {
        "type": "string",
        "description": "A requested change to an event's conferencing. Omitting the field leaves\nthe existing conference untouched; only these values change it.",
        "enum": ["google_meet", "none"]
      },
      "ConferenceProvider": {
        "type": "string",
        "description": "The conferencing system backing an event's join URL.\n\nMacro generates only Google Meet conferences, so this distinguishes one it\ncreated from a third party's — Zoom and friends arriving as `addOn`\nconference data, or a legacy classic Hangout. Clients use it to label the\nconference and to tell whether the Meet toggle reflects a Macro-managed\nconference.\n\nIt does not gate mutation. An explicit request replaces or detaches any\nconference, third-party included, exactly as deleting the event would;\nwhat protects a conference is that omitting the field leaves it untouched,\nso an unrelated edit never disturbs it.",
        "enum": ["google_meet", "other"]
      },
      "CreateCalendarEventRequest": {
        "type": "object",
        "description": "Request body creating a calendar event on the requester's calendar.",
        "required": ["title", "time"],
        "properties": {
          "attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarAttendeeInputBody"
            },
            "description": "Invited attendees."
          },
          "calendarId": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Exact calendar to create the event on; takes precedence over the\ninbox default."
          },
          "conference": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConferenceChange",
                "description": "Conference to attach to the new event; omit to create it without one."
              }
            ]
          },
          "description": {
            "type": ["string", "null"],
            "description": "Optional event body."
          },
          "emailLinkId": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Connected inbox whose primary calendar receives the event; defaults\nto the requester's primary inbox."
          },
          "location": {
            "type": ["string", "null"],
            "description": "Optional location label."
          },
          "outOfOffice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OutOfOfficeProperties",
                "description": "Out-of-office properties; present to create the event as a Google\nout-of-office status event (primary calendar only, timed, no\nattendees), omitted for a regular event."
              }
            ]
          },
          "recurrenceLines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Raw RFC 5545 recurrence properties (`RRULE`, `RDATE`, `EXDATE`)."
          },
          "reminders": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventReminders",
                "description": "Reminder configuration; omit to keep the calendar defaults."
              }
            ]
          },
          "time": {
            "$ref": "#/components/schemas/EventTime",
            "description": "Timed or all-day shape."
          },
          "title": {
            "type": "string",
            "description": "Display title."
          },
          "transparency": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventTransparency",
                "description": "Availability behavior."
              }
            ]
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventVisibility",
                "description": "Event visibility."
              }
            ]
          }
        }
      },
      "EventReminderOverride": {
        "type": "object",
        "description": "One reminder: how it alerts and how many minutes before the event start\n(before midnight in the calendar's zone for all-day events) it fires.",
        "required": ["method", "minutes"],
        "properties": {
          "method": {
            "type": "string",
            "description": "Provider method, stored verbatim; only `popup` fires Macro\nnotifications."
          },
          "minutes": {
            "type": "integer",
            "format": "int32",
            "description": "Minutes before the event start.",
            "minimum": 0
          }
        }
      },
      "EventReminders": {
        "type": "object",
        "description": "Per-user reminder configuration for an event, mirroring Google's model:\neither the calendar's default reminders apply, or the explicit overrides\nreplace them entirely.",
        "required": ["useDefault"],
        "properties": {
          "overrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventReminderOverride"
            },
            "description": "Explicit reminders replacing the defaults when `use_default` is off."
          },
          "useDefault": {
            "type": "boolean",
            "description": "Whether the calendar's default reminders apply."
          }
        }
      },
      "EventStatus": {
        "type": "string",
        "description": "Canonical event status.",
        "enum": ["confirmed", "tentative", "cancelled"]
      },
      "EventTime": {
        "oneOf": [
          {
            "type": "object",
            "description": "An event with absolute instants.",
            "required": ["startsAt", "endsAt", "kind"],
            "properties": {
              "endsAt": {
                "type": "string",
                "format": "date-time",
                "description": "Exclusive end instant."
              },
              "kind": {
                "type": "string",
                "enum": ["timed"]
              },
              "startsAt": {
                "type": "string",
                "format": "date-time",
                "description": "Inclusive start instant."
              },
              "timeZone": {
                "type": ["string", "null"],
                "description": "Original IANA time-zone identifier, when supplied."
              }
            }
          },
          {
            "type": "object",
            "description": "An all-day event using RFC 5545's exclusive end date.",
            "required": ["startDate", "endDate", "kind"],
            "properties": {
              "endDate": {
                "type": "string",
                "format": "date",
                "description": "Exclusive local end date."
              },
              "kind": {
                "type": "string",
                "enum": ["allDay"]
              },
              "startDate": {
                "type": "string",
                "format": "date",
                "description": "Inclusive local start date."
              }
            }
          }
        ],
        "description": "The mutually exclusive time shape of a calendar event.\n\nFields are renamed per variant rather than with `rename_all_fields`\nbecause utoipa only honors variant-level serde renames when it\nderives the OpenAPI schema."
      },
      "EventTransparency": {
        "type": "string",
        "description": "Whether an event blocks availability.",
        "enum": ["opaque", "transparent"]
      },
      "EventType": {
        "type": "string",
        "description": "Google's event type: ordinary meetings versus the status-style entries\n(working location, out of office, focus time, birthdays) Google renders\nand notifies differently. Immutable at the provider after creation.",
        "enum": [
          "default",
          "out_of_office",
          "focus_time",
          "working_location",
          "birthday",
          "from_gmail"
        ]
      },
      "EventVisibility": {
        "type": "string",
        "description": "Visibility of event details.",
        "enum": ["default", "public", "private", "confidential"]
      },
      "ListCalendarsResponse": {
        "type": "object",
        "description": "Calendars visible to the requester across connected and delegated inboxes.",
        "required": ["calendars"],
        "properties": {
          "calendars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibleCalendar"
            },
            "description": "Primaries and writable calendars first."
          }
        }
      },
      "OutOfOfficeAutoDeclineMode": {
        "type": "string",
        "description": "How an out-of-office event responds to conflicting invitations, mirroring\nGoogle's `autoDeclineMode`.",
        "enum": [
          "decline_none",
          "decline_all_conflicting_invitations",
          "decline_only_new_conflicting_invitations"
        ]
      },
      "OutOfOfficeProperties": {
        "type": "object",
        "description": "The extra properties Google requires on an out-of-office event, mirroring\nits `outOfOfficeProperties` block. Their presence on a draft or patch is\nwhat marks the mutation as out-of-office.",
        "properties": {
          "autoDeclineMode": {
            "$ref": "#/components/schemas/OutOfOfficeAutoDeclineMode",
            "description": "How conflicting invitations are handled while the user is out."
          },
          "declineMessage": {
            "type": ["string", "null"],
            "description": "Message returned to organizers whose invitations are auto-declined."
          }
        }
      },
      "RefreshCalendarEvent": {
        "oneOf": [
          {
            "type": "object",
            "description": "A sync run committed changes for `link_id`; viewers should refetch.",
            "required": ["link_id", "event"],
            "properties": {
              "event": {
                "type": "string",
                "enum": ["synced"]
              },
              "link_id": {
                "type": "string",
                "format": "uuid",
                "description": "Connected inbox whose calendars changed."
              }
            }
          }
        ],
        "description": "Realtime signal that a connected inbox's calendar projection changed."
      },
      "RsvpCalendarEventRequest": {
        "type": "object",
        "description": "Request body setting the requester's RSVP on an event.",
        "required": ["response"],
        "properties": {
          "calendarId": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Calendar whose copy of the event is answered, for an event synced\nfrom more than one calendar. Omit to answer on the canonical copy."
          },
          "recurrenceId": {
            "type": ["string", "null"],
            "description": "Original-start key of the occurrence the response targets."
          },
          "response": {
            "$ref": "#/components/schemas/AttendeeResponseStatus",
            "description": "The response to record for the connected account."
          },
          "scope": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CalendarRsvpScopeParam",
                "description": "How much of a recurring series the response covers. Omit to let\n`recurrenceId` decide: the identified occurrence alone when one is\nsupplied, otherwise the whole series. An explicit `this_event` scope\nrequires `recurrenceId`, so a scoped request is never silently\nwidened to the series."
              }
            ]
          }
        }
      },
      "UpdateCalendarEventRequest": {
        "type": "object",
        "description": "Request body patching an event; omitted fields are left untouched.",
        "properties": {
          "attendees": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/CalendarAttendeeInputBody"
            },
            "description": "Replacement attendee list."
          },
          "calendarId": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Calendar whose copy of the event is patched, for an event synced from\nmore than one calendar. Omit to patch the canonical copy."
          },
          "conference": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConferenceChange",
                "description": "Conference change: `google_meet` attaches a freshly generated Meet,\n`none` detaches the current conference, and omitting it leaves the\nconference untouched.\n\nA third-party conference is replaced or detached like any other, since\nthe request is explicit. Omit the field to leave it alone."
              }
            ]
          },
          "description": {
            "type": ["string", "null"],
            "description": "Replacement description; an empty string clears it."
          },
          "location": {
            "type": ["string", "null"],
            "description": "Replacement location; an empty string clears it."
          },
          "outOfOffice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OutOfOfficeProperties",
                "description": "Replacement out-of-office properties, applied only to an event that is\nalready out-of-office — the provider event type is immutable. Omit to\nleave them untouched."
              }
            ]
          },
          "recurrenceId": {
            "type": ["string", "null"],
            "description": "Original-start key of the occurrence the update targets."
          },
          "recurrenceLines": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            },
            "description": "Replacement recurrence properties; an empty list clears them."
          },
          "reminders": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventReminders",
                "description": "Replacement reminder configuration."
              }
            ]
          },
          "scope": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CalendarUpdateScopeParam",
                "description": "How much of a recurring series the update covers. Omit to let\n`recurrenceId` decide: the identified occurrence alone when one is\nsupplied, otherwise the whole event or series. An explicit\n`this_event` scope requires `recurrenceId`, so a scoped request is\nnever silently widened to the series."
              }
            ]
          },
          "time": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventTime",
                "description": "Replacement time."
              }
            ]
          },
          "title": {
            "type": ["string", "null"],
            "description": "Replacement title; an empty string clears it."
          },
          "transparency": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventTransparency",
                "description": "Replacement transparency."
              }
            ]
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EventVisibility",
                "description": "Replacement visibility."
              }
            ]
          }
        }
      },
      "VisibleCalendar": {
        "type": "object",
        "description": "A calendar visible to a requester, listed for pickers and filters.",
        "required": [
          "id",
          "emailLinkId",
          "emailAddress",
          "name",
          "isPrimary",
          "isWritable",
          "isSubscription",
          "defaultReminders"
        ],
        "properties": {
          "color": {
            "type": ["string", "null"],
            "description": "Provider color."
          },
          "defaultReminders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventReminderOverride"
            },
            "description": "Default reminders applied to events that keep `useDefault`."
          },
          "emailAddress": {
            "type": "string",
            "description": "Connected inbox address, for grouping in multi-inbox pickers."
          },
          "emailLinkId": {
            "type": "string",
            "format": "uuid",
            "description": "Connected inbox that syncs this calendar."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Persisted Macro calendar identifier."
          },
          "isPrimary": {
            "type": "boolean",
            "description": "Whether this is its account's primary calendar."
          },
          "isSubscription": {
            "type": "boolean",
            "description": "Whether this is one of Google's shared system calendars (holidays,\nbirthdays) the account subscribes to rather than one a person maintains."
          },
          "isWritable": {
            "type": "boolean",
            "description": "Whether the grant can create and modify events on this calendar."
          },
          "name": {
            "type": "string",
            "description": "Provider display name."
          },
          "syncError": {
            "type": ["string", "null"],
            "description": "A persistent sync failure isolated to this calendar, surfaced so the\nsettings row can badge it. `None` while the calendar is syncing\nnormally or a failure has not yet crossed the persistence threshold."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "calendar_events",
      "description": "Macro Calendar Service"
    }
  ]
}
