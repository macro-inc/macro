              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{agent_id}/permanent": {
      "delete": {
        "tags": ["agent proxy"],
        "summary": "Permanently delete an agent.",
        "operationId": "permanently_delete_agent",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "description": "ID of the agent",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["agent proxy"],
        "summary": "Health check handler.",
        "operationId": "agent_proxy_health",
        "responses": {
          "200": {
            "description": "health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/runtime": {
      "get": {
        "tags": ["agent proxy"],
        "summary": "Accept one agent runtime's WebSocket connection.",
        "description": "One endpoint serves every session, disambiguated by `?id=` rather than a\nlistener per session. `agent_runtime_protocol` deliberately carries no\nsession identifier on the wire - a connection hosts exactly one agent\nexecution, so the wire protocol has no routing table - which makes this\nhandler the place that identifier actually lives: matched against the\nquery parameter the runtime dialed with, then handed on the same way for\nevery session.",
        "operationId": "connect_agent_runtime",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "ID of the agent session (chat) this runtime hosts",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade; carries the agent-runtime protocol"
          },
          "400": {
            "description": "missing or malformed session id"
          }
        }
      }
    },
    "/sessions/{session_id}/acp": {
      "post": {
        "tags": ["agent proxy"],
        "summary": "Post one ACP JSON-RPC message to an agent session. The body is a complete\nACP JSON-RPC message (request, notification, or response); replies from\nthe agent stream back through the connection gateway.",
        "operationId": "post_acp_message",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "ID of the agent session (chat) to post to",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "message accepted and forwarded"
          },
          "400": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "session has no live runtime connection",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessLevel": {
        "type": "string",
        "description": "Ordered from least to most access top -> bottom",
        "enum": ["view", "comment", "edit", "owner"]
      },
      "AssistantMessagePart": {
        "oneOf": [
          {
            "type": "object",
            "description": "Plain text produced by the model.",
            "required": ["text", "type"],
            "properties": {
              "text": {
                "type": "string",
                "description": "The text content."
              },
              "type": {
                "type": "string",
                "enum": ["text"]
              }
            }
          },
          {
            "type": "object",
            "description": "A native tool call issued by the model.",
            "required": ["name", "json", "id", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Provider-assigned call id."
              },
              "json": {
                "description": "Tool arguments as JSON."
              },
              "name": {
                "type": "string",
                "description": "Tool name."
              },
              "type": {
                "type": "string",
                "enum": ["toolCall"]
              }
            }
          },
          {
            "type": "object",
            "description": "A tool call routed through an MCP service.",
            "required": ["name", "service", "json", "id", "type"],
            "properties": {
              "display_name": {
                "type": ["string", "null"],
                "description": "Optional human-readable name."
              },
              "id": {
                "type": "string",
                "description": "Provider-assigned call id."
              },
              "json": {
                "description": "Tool arguments as JSON."
              },
              "name": {
                "type": "string",
                "description": "Tool name."
              },
              "service": {
                "type": "string",
                "description": "MCP service identifier."
              },
              "type": {
                "type": "string",
                "enum": ["mcpToolCall"]
              }
            }
          },
          {
            "type": "object",
            "description": "A JSON response from a tool call.",
            "required": ["name", "json", "id", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Corresponding call id."
              },
              "json": {
                "description": "Response payload."
              },
              "name": {
                "type": "string",
                "description": "Tool name."
              },
              "type": {
                "type": "string",
                "enum": ["toolCallResponseJson"]
              }
            }
          },
          {
            "type": "object",
            "description": "An error response from a tool call.",
            "required": ["name", "description", "id", "type"],
            "properties": {
              "description": {
                "type": "string",
                "description": "Human-readable error description."
              },
              "id": {
                "type": "string",
                "description": "Corresponding call id."
              },
              "name": {
                "type": "string",
                "description": "Tool name."
              },
              "type": {
                "type": "string",
                "enum": ["toolCallErr"]
              }
            }
          },
          {
            "type": "object",
            "description": "A thinking/reasoning block from the model.",
            "required": ["thinking", "type"],
            "properties": {
              "thinking": {
                "type": "string",
                "description": "The thinking text content."
              },
              "type": {
                "type": "string",
                "enum": ["thinking"]
              }
            }
          }
        ],
        "description": "A structured part within an assistant message.\n\nWhen the model responds with tool calls the full turn is persisted as a\nflat sequence of these parts.  [`crate::convert::to_rig_messages`]\nreconstructs the turn boundaries that providers expect."
      },
      "ChatAgentKind": {
        "type": "string",
        "description": "What kind of agent backs a chat.",
        "enum": ["MacroChat", "External"]
      },
      "ChatMessageContent": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plain text content."
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssistantMessagePart"
            },
            "description": "Structured assistant message parts."
          }
        ],
        "description": "The content of a [`ChatMessage`].\n\nFor user and system messages the content is plain [`Text`](Self::Text).\nFor assistant messages it may additionally be a sequence of\n[`AssistantMessagePart`]s that encode tool-call round trips."
      },
      "ChatMessageWithAttachments": {
        "type": "object",
        "required": ["id", "content", "role", "attachments"],
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entity"
            },
            "description": "The ids of the attachments used to generate the message"
          },
          "content": {
            "$ref": "#/components/schemas/ChatMessageContent",
            "description": "Message content"
          },
          "id": {
            "type": "string",
            "description": "The chat message id"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Whether the chat is from the user or system"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "description": "The full chat response, matching the DCS API response shape.",
        "required": ["id", "userId", "name", "messages"],
        "properties": {
          "createdAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "The time the chat was created."
          },
          "id": {
            "type": "string",
            "description": "The chat uuid."
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageWithAttachments"
            },
            "description": "The messages in the chat."
          },
          "model": {
            "type": ["string", "null"],
            "description": "The model used to generate the chat (`provider/model` id)."
          },
          "name": {
            "type": "string",
            "description": "The name of the chat."
          },
          "projectId": {
            "type": ["string", "null"],
            "description": "The project id the chat belongs to."
          },
          "updatedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "The time the chat was last updated."
          },
          "userId": {
            "type": "string",
            "description": "Who the chat belongs to."
          }
        }
      },
      "CreateAgentRequest": {
        "type": "object",
        "description": "Request body for creating an agent.",
        "properties": {
          "kind": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChatAgentKind",
                "description": "What kind of agent to create. Defaults to `Macro`."
              }
            ]
          },
          "name": {
            "type": ["string", "null"],
            "description": "Optional name for the agent."
          },
          "projectId": {
            "type": ["string", "null"],
            "description": "Optional project to associate the agent with."
          }
        }
      },
      "EmptyResponse": {
        "type": "object",
        "description": "Empty response is required due to custom fetch forcing `response.json()`"
      },
      "Entity": {
        "type": "object",
        "description": "The Entity describes the minimum amount of information required to describe a unique thing in Macro\nThis contains the type of the entity [EntityType] and the string id of that entity",
        "required": ["entity_type", "entity_id"],
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "The id of that entity"
          },
          "entity_type": {
            "$ref": "#/components/schemas/EntityType",
            "description": "The type of entity we are describing"
          }
        }
      },
      "EntityType": {
        "type": "string",
        "description": "The type of an entity in Macro",
        "enum": [
          "user",
          "chat",
          "channel",
          "channel_message",
          "document",
          "project",
          "email_thread",
          "calendar_event",
          "team",
          "call",
          "foreign_entity",
          "static_file",
          "crm_company",
          "crm_contact"
        ]
      },
      "GetAgentResponse": {
        "type": "object",
        "description": "An agent with its full chat data, mirroring the DCS get-chat response\nshape plus the agent kind.",
        "required": ["chat", "kind", "userAccessLevel"],
        "properties": {
          "chat": {
            "$ref": "#/components/schemas/ChatResponse",
            "description": "The full chat data backing the agent."
          },
          "kind": {
            "$ref": "#/components/schemas/ChatAgentKind",
            "description": "What kind of agent backs the chat."
          },
          "userAccessLevel": {
            "$ref": "#/components/schemas/AccessLevel",
            "description": "The requesting user's access level on this agent."
          }
        }
      },
      "PatchAgentRequest": {
        "type": "object",
        "description": "Request body for patching an agent.",
        "properties": {
          "name": {
            "type": ["string", "null"],
            "description": "New name for the agent, if changing."
          },
          "projectId": {
            "type": ["string", "null"],
            "description": "New project ID for the agent, if moving."
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "The role of a message participant.",
        "enum": ["user", "assistant", "system"]
      },
      "StringIDResponse": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
