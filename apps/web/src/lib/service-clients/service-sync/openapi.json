    "/document/{document_id}/wakeup": {
      "get": {
        "tags": ["sync_service"],
        "operationId": "document_wakeup",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Keepalive scheduled"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BinaryBody": {
        "type": "string",
        "format": "binary"
      },
      "BlameRow": {
        "type": "object",
        "required": ["peer_id", "timestamp_ms"],
        "properties": {
          "peer_id": {
            "type": "string"
          },
          "timestamp_ms": {
            "type": "integer",
            "format": "int64"
          },
          "user_id": {
            "type": ["string", "null"]
          }
        }
      },
      "CopyDocumentRequest": {
        "type": "object",
        "required": ["target_document_id"],
        "properties": {
          "target_document_id": {
            "type": "string"
          },
          "version_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VersionIndicator"
              }
            ]
          }
        }
      },
      "DocumentMetadata": {
        "type": "object",
        "required": ["id", "peers", "version_id"],
        "properties": {
          "id": {
            "type": "string"
          },
          "peers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeerWithUserId"
            }
          },
          "version_id": {
            "type": "string"
          }
        }
      },
      "GetSnapshotRequest": {
        "type": "object",
        "properties": {
          "version_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VersionIndicator"
              }
            ]
          }
        }
      },
      "PeerResponse": {
        "type": "object",
        "required": ["peer_id", "user_id"],
        "properties": {
          "peer_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "PeerWithUserId": {
        "type": "object",
        "required": ["peer_id", "user_id"],
        "properties": {
          "peer_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "SnapshotResponse": {
        "type": "object",
        "required": ["snapshot", "revision"],
        "properties": {
          "revision": {
            "type": "string"
          },
          "snapshot": {
            "type": "string"
          }
        }
      },
      "UpdateRequest": {
        "type": "object",
        "required": ["expectedRevision", "update"],
        "properties": {
          "expectedRevision": {
            "type": "string"
          },
          "update": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateResponse": {
        "type": "object",
        "required": ["revision", "applied"],
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "VersionIndicator": {
        "type": "object",
        "required": ["peer", "counter"],
        "properties": {
          "counter": {
            "type": "integer",
            "format": "int32"
          },
          "peer": {
            "type": "string",
            "description": "Json has trouble with peer id bigints, so we need to serialize from a string"
          }
        }
      }
    },
    "securitySchemes": {
      "document_permission": {
        "type": "http",
        "scheme": "bearer"
      },
      "internal_key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-auth-key"
      }
    }
  },
  "tags": [
    {
      "name": "sync_service",
      "description": "Sync service"
    }
  ]
}
