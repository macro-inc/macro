{
  "openapi": "3.1.0",
  "info": {
    "title": "Sync Service",
    "description": "Document sync service JSON control plane",
    "contact": {
      "name": "Macro"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/document/{document_id}/active_peers": {
      "get": {
        "tags": ["sync_service"],
        "operationId": "document_active_peers",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_ai",
            "in": "query",
            "description": "Set to `false` or `0` to filter out AI editors",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active peer ids",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        },
        "security": [
          {
            "document_permission": []
          },
          {
            "internal_key": []
          }
        ]
      }
    },
    "/document/{document_id}/blame/{node_id}": {
