            "description": ""
          }
        },
        "security": [
          {
            "document_permission": []
          },
          {
            "internal_key": []
          }
        ]
      }
    },
    "/document/{document_id}/copy": {
      "post": {
        "tags": ["sync_service"],
        "operationId": "copy_document",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "description": "Source document to copy from",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopyDocumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Copy succeeded; the new document was initialized"
          },
          "404": {
            "description": "Source snapshot not found"
          }
        }
      }
    },
    "/document/{document_id}/delete": {
