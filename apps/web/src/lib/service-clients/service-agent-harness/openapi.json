{
  "openapi": "3.1.0",
  "info": {
    "title": "agent_harness_service",
    "description": "",
    "termsOfService": "https://macro.com/terms",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/agent-sessions/{session_id}": {
      "delete": {
        "tags": ["agent-sessions"],
        "summary": "Delete an agent session and its live resources.",
        "operationId": "delete_agent_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "ID of the agent session",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "401": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/agent-sessions/{session_id}/control": {
      "post": {
        "tags": ["agent-sessions"],
        "summary": "Perform a control operation on a live agent session.",
        "operationId": "control_agent_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "ID of the agent session",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          },
          "401": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentAction": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgentPromptAction",
                "description": "Send the agent a prompt."
              },
              {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["prompt"]
                  }
                }
              }
            ],
            "description": "Send the agent a prompt."
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgentSetModelAction",
                "description": "Switch the model the agent runs on."
              },
              {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["setModel"]
                  }
                }
              }
            ],
            "description": "Switch the model the agent runs on."
          },
          {
            "type": "object",
            "description": "Interrupt whatever the agent is doing.",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["stop"]
              }
            }
          }
        ],
        "description": "One thing a caller wants an agent to do."
      },
      "AgentPromptAction": {
        "type": "object",
        "description": "Ask the agent to work on something.",
        "required": ["prompt"],
        "properties": {
          "prompt": {
            "type": "string",
            "description": "What to tell the agent."
          }
        }
      },
      "AgentSetModelAction": {
        "type": "object",
        "description": "Ask the agent to run on a different model from here on.",
        "required": ["model"],
        "properties": {
          "model": {
            "type": "string",
            "description": "The model slug the agent should switch to."
          }
        }
      },
      "ControlRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AgentAction",
            "description": "The operation to perform."
          }
        ],
        "description": "Request body for a control operation on a live session.\n\nA wrapper around the operation rather than the bare enum so that fields\nwhich are about the request rather than the operation have somewhere to go.\nThe acting user is deliberately not one of them: it comes from the caller's\ncredentials, so that a caller cannot attribute an operation to someone else."
      }
    }
  },
  "tags": [
    {
      "name": "agent-sessions",
      "description": "Live agent session control"
    }
  ]
}
