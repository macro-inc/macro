  },
  "components": {
    "schemas": {
      "ActionConfiguration": {
        "type": "object",
        "description": "Canonical client configuration. Ownership and execution state are server-owned.",
        "required": ["name", "trigger", "kind", "task", "enabled"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "name": {
            "type": "string"
          },
          "task": {
            "type": "object"
          },
          "trigger": {
            "$ref": "#/components/schemas/ActionTrigger"
          }
        },
        "additionalProperties": false
      },
      "ActionExecutionRecord": {
        "type": "object",
        "required": [
          "action_id",
          "start_time",
          "end_time",
          "is_success",
          "result",
          "created_at"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "is_success": {
            "type": "boolean"
          },
          "resource_id": {
            "type": ["string", "null"],
            "description": "ID of the primary resource produced by this run (e.g. a chat thread).\nOpaque to the scheduler; the UI interprets it based on the action kind."
          },
          "result": {
            "type": "object"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActionKind": {
        "type": "string",
        "enum": ["Agent"]
      },
      "ActionTrigger": {
        "oneOf": [
          {
            "type": "object",
            "required": ["schedule", "timezone", "type"],
            "properties": {
              "schedule": {
                "$ref": "#/components/schemas/Schedule"
              },
              "timezone": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["cron"]
              }
            }
          },
          {
            "type": "object",
            "required": ["filters", "type"],
            "properties": {
              "filters": {
                "$ref": "#/components/schemas/EventFilters"
              },
              "type": {
                "type": "string",
                "enum": ["events"]
              }
            }
          }
        ],
        "description": "Exactly one trigger per action. Existing cron validation is reused."
      },
      "AgentTask": {
        "type": "object",
        "required": ["model", "prompt", "user_prompt"],
        "properties": {
          "model": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "user_prompt": {
            "type": "string"
          }
        }
      },
      "CreateScheduledAction": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ActionConfiguration"
          },
          {
            "$ref": "#/components/schemas/LegacyActionConfiguration"
          }
        ],
        "description": "Exactly one representation is accepted, even if mixed fields agree or are null."
      },
      "EmptyResponse": {
        "type": "object",
        "description": "Empty response is required due to custom fetch forcing `response.json()`"
      },
      "EventFilter": {
        "type": "object",
        "description": "An event name AND an entity ID must match within the same filter.",
        "required": ["events"],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventName"
            }
          },
          "ids": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EventFilters": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/EventFilter"
        },
        "description": "Bounded nonempty OR of filters, canonicalized to remove duplicates."
      },
      "EventName": {
        "type": "string",
        "description": "Closed allowlist: unknown names, deletions and ambiguous attribution are not\nselectors. Adding a broker variant does not automatically enable routines.",
        "enum": [
          "document.created",
          "document.updated",
          "channel.created",
          "channel.message_posted",
          "channel.mentioned",
          "channel.message_patched",
          "channel.message_attachment_created"
        ]
      },
      "InProgressExecution": {
        "type": "object",
        "required": ["action_id"],
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid"
          },
          "chat_id": {
            "type": ["string", "null"]
          }
        }
      },
      "LegacyActionConfiguration": {
        "type": "object",
        "description": "Deprecated cron-only input, accepted during the compatibility rollout.",
        "required": ["name", "schedule", "kind", "timezone", "task", "enabled"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "name": {
            "type": "string"
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "task": {
            "type": "object"
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Schedule": {
        "type": "string"
      },
      "ScheduledAction": {
        "type": "object",
        "required": [
          "owner",
          "name",
          "trigger",
          "kind",
          "created_at",
          "updated_at",
          "configuration_revision",
          "task",
          "enabled"
        ],
        "properties": {
          "claimed": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "configuration_revision": {
            "type": "integer",
            "format": "int64",
            "description": "Independent of execution bookkeeping in `updated_at`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean",
            "description": "When false, automatic dispatch skips this action. `run_now` remains\navailable regardless."
          },
          "event_activated_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Event publication boundary; absent for cron actions."
          },
          "id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "name": {
            "type": "string"
          },
          "next_run_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Next cron firing, absent for event-triggered actions."
          },
          "owner": {
            "type": "string",
            "description": "Who the action belongs to. Every action is user-owned today, but the\ntype no longer says so: the principal string on the wire and in the\n`owner` column is the same, and a bot- or team-owned row decodes\nrather than failing to parse."
          },
          "task": {
            "type": "object"
          },
          "trigger": {
            "$ref": "#/components/schemas/ActionTrigger"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScheduledActionResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScheduledAction"
          },
          {
            "type": "object",
            "properties": {
              "schedule": {
                "type": ["string", "null"],
                "description": "Deprecated: use `trigger.schedule`. Present only for cron actions.",
                "deprecated": true
              },
              "timezone": {
                "type": ["string", "null"],
                "description": "Deprecated: use `trigger.timezone`. Present only for cron actions.",
                "deprecated": true
              }
            }
          }
        ],
        "description": "Canonical trigger plus deprecated cron fields for existing clients. Event\nresponses omit legacy fields rather than inventing a schedule or timezone."
      },
      "ScheduledActionUpdate": {
        "oneOf": [
          {
            "type": "object",
            "required": ["owner", "action_id", "chat_id", "type"],
            "properties": {
              "action_id": {
                "type": "string",
                "format": "uuid"
              },
              "chat_id": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["started"]
              }
            }
          },
          {
            "type": "object",
            "required": ["owner", "action_id", "chat_id", "is_success", "type"],
            "properties": {
              "action_id": {
                "type": "string",
                "format": "uuid"
              },
              "chat_id": {
                "type": "string"
              },
              "is_success": {
                "type": "boolean"
              },
              "owner": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["stopped"]
              }
            }
          }
        ],
        "description": "Live status update for a scheduled-action run, broadcast via the connection\ngateway to the owner. Clients use the `chat_id` to navigate to the run\ntranscript and the variant tag to toggle the running indicator.\n\nSerialized with a `type` tag (`started`/`stopped`) and delivered over the\nsingle `scheduled_action_update` message type on the gateway."
      },
      "UpdateScheduledAction": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ActionConfiguration"
          },
          {
            "$ref": "#/components/schemas/LegacyActionConfiguration"
          }
        ],
        "description": "Full replacement of client configuration, not of server-owned action state."
      }
    }
  },
  "tags": [
    {
      "name": "scheduled actions",
      "description": "Scheduled action service"
    }
  ]
}
