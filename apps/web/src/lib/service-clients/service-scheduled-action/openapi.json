  "components": {
    "schemas": {
      "ActionConfiguration": {
        "type": "object",
        "description": "Canonical client configuration. Ownership and execution state are server-owned.",
        "required": ["name", "trigger", "kind", "task", "enabled"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "name": {
            "type": "string"
          },
          "task": {
            "type": "object"
          },
          "trigger": {
            "$ref": "#/components/schemas/ActionTrigger"
          }
        },
        "additionalProperties": false
      },
      "ActionConfigurationUpdate": {
        "type": "object",
        "description": "Canonical configuration replacement. Activation has its own endpoint, so\nomitting `enabled` keeps the stored value.",
        "required": ["name", "trigger", "kind", "task"],
        "properties": {
          "enabled": {
            "type": ["boolean", "null"],
            "description": "Still sent by clients deployed before the activation endpoint.",
            "deprecated": true
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "name": {
            "type": "string"
          },
          "task": {
            "type": "object"
          },
          "trigger": {
            "$ref": "#/components/schemas/ActionTrigger"
          }
        },
        "additionalProperties": false
      },
      "ActionExecutionRecord": {
        "type": "object",
        "required": [
          "action_id",
          "start_time",
          "end_time",
          "is_success",
          "result",
          "created_at"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "is_success": {
            "type": "boolean"
          },
          "resource_id": {
            "type": ["string", "null"],
            "description": "ID of the primary resource produced by this run. Its type is recorded in\n`result`, independently of the routine's current configuration."
          },
          "result": {
            "type": "object"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActionKind": {
        "type": "string",
        "enum": ["Agent"]
      },
      "ActionTrigger": {
        "oneOf": [
          {
            "type": "object",
            "required": ["schedule", "timezone", "type"],
            "properties": {
              "schedule": {
                "$ref": "#/components/schemas/Schedule"
              },
              "timezone": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["cron"]
              }
            }
          },
          {
            "type": "object",
            "required": ["filters", "type"],
            "properties": {
              "filters": {
                "$ref": "#/components/schemas/EventFilters"
              },
              "type": {
                "type": "string",
                "enum": ["events"]
              }
            }
          },
          {
            "type": "object",
            "required": ["triggers", "type"],
            "properties": {
              "triggers": {
                "$ref": "#/components/schemas/RoutineTriggers"
              },
              "type": {
                "type": "string",
                "enum": ["multiple"]
              }
            }
          }
        ],
        "description": "A routine may run on one trigger or any of several schedules and Macro events."
      },
      "AgentTask": {
        "type": "object",
        "required": ["prompt", "user_prompt"],
        "properties": {
          "agent": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentTaskAgent",
                "description": "Absent when using Macro's agent-session runtime with a selected model."
              }
            ]
          },
          "model": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RoutineModelId",
                "description": "Required for model targets; overrides the persona default for agent targets."
              }
            ]
          },
          "prompt": {
            "type": "string"
          },
          "user_prompt": {
            "type": "string"
          }
        }
      },
      "AgentTaskAgent": {
        "type": "object",
        "description": "A persona selection, independent of its runtime and current default model.",
        "required": ["bot_id"],
        "properties": {
          "bot_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AiAdmissionErrorBody": {
        "type": "object",
        "description": "Public admission error payload. Handlers with additional fields can reuse the\ndomain error's code and message and [`admission_status`].",
        "required": ["error", "code"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable denial or unavailability code."
          },
          "error": {
            "type": "string",
            "description": "Human-readable explanation, without internal billing diagnostics."
          }
        }
      },
      "ConditionResult": {
        "oneOf": [
          {
            "type": "object",
            "description": "The triggering content answered the condition with no.",
            "required": ["probability", "status"],
            "properties": {
              "probability": {
                "type": "number",
                "format": "float",
                "description": "The classifier's probability, from 0 to 1, that the answer was yes."
              },
              "status": {
                "type": "string",
                "enum": ["not_met"]
              }
            }
          },
          {
            "type": "object",
            "description": "The condition could not be checked before the retry window closed.",
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["unavailable"]
              }
            }
          }
        ],
        "description": "Why an event-triggered run was skipped before it started."
      },
      "CreateScheduledAction": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ActionConfiguration"
          },
          {
            "$ref": "#/components/schemas/LegacyActionConfiguration"
          }
        ],
        "description": "Exactly one representation is accepted, even if mixed fields agree or are null."
      },
      "EmptyResponse": {
        "type": "object",
        "description": "Empty response is required due to custom fetch forcing `response.json()`"
      },
      "EventFilter": {
        "type": "object",
        "description": "An event name AND an entity ID must match within the same filter. A\ncondition further requires the event's content to answer it with yes.",
        "required": ["events"],
        "properties": {
          "condition": {
            "type": ["string", "null"],
            "description": "Yes/no question about the triggering content, e.g. \"Is this email an\ninvoice?\". The routine runs only when the answer is yes.",
            "maxLength": 500
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventName"
            }
          },
          "ids": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EventFilters": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/EventFilter"
        },
        "description": "Bounded nonempty OR of filters, canonicalized to remove duplicates."
      },
      "EventName": {
        "type": "string",
        "description": "Closed allowlist: unknown names, deletions and ambiguous attribution are not\nselectors. Adding a broker variant does not automatically enable routines.",
        "enum": [
          "document.created",
          "document.updated",
          "document.deleted",
          "task.created",
          "task.status_changed",
          "task.priority_changed",
          "task.property_changed",
          "email.message_received",
          "channel.created",
          "channel.message_posted",
          "channel.mentioned",
          "channel.message_patched",
          "channel.message_attachment_created"
        ]
      },
      "ExecutionResource": {
        "type": "object",
        "description": "Transcript resource created by a run. Never infer this from current task configuration.",
        "required": ["type", "id"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ExecutionResourceType"
          }
        }
      },
      "ExecutionResourceType": {
        "type": "string",
        "description": "Closed set of transcript destinations understood by routine clients.",
        "enum": ["chat", "agent"]
      },
      "ExecutionResult": {
        "type": "object",
        "description": "Version 1 execution metadata stored in the existing JSON result column.\nNull/string column values predate this envelope and refer to legacy chats.",
        "required": ["version"],
        "properties": {
          "condition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConditionResult",
                "description": "Present when an event trigger's condition stopped the run from starting."
              }
            ]
          },
          "error": {
            "type": ["string", "null"]
          },
          "resource": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ExecutionResource"
              }
            ]
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "InProgressExecution": {
        "type": "object",
        "required": ["action_id"],
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid"
          },
          "chat_id": {
            "type": ["string", "null"]
          },
          "resource": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ExecutionResource",
                "description": "Absent only in responses from legacy workers."
              }
            ]
          }
        }
      },
      "LegacyActionConfiguration": {
        "type": "object",
        "description": "Deprecated cron-only input, accepted during the compatibility rollout.",
        "required": ["name", "schedule", "kind", "timezone", "task", "enabled"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "name": {
            "type": "string"
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "task": {
            "type": "object"
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RoutineModelId": {
        "type": "string",
        "description": "A nonblank model identifier. Runtime catalogs, not the scheduler, own availability."
      },
      "RoutineTrigger": {
        "oneOf": [
          {
            "type": "object",
            "required": ["schedule", "timezone", "type"],
            "properties": {
              "schedule": {
                "$ref": "#/components/schemas/Schedule"
              },
              "timezone": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["cron"]
              }
            }
          },
          {
            "type": "object",
            "required": ["filters", "type"],
            "properties": {
              "filters": {
                "$ref": "#/components/schemas/EventFilters"
              },
              "type": {
                "type": "string",
                "enum": ["events"]
              }
            }
          }
        ],
        "description": "An individual trigger in a routine's trigger list."
      },
      "RoutineTriggers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RoutineTrigger"
        },
        "description": "Bounded schedules and one combined set of event filters."
      },
      "Schedule": {
        "type": "string"
      },
      "ScheduledAction": {
        "type": "object",
        "required": [
          "owner",
          "name",
          "trigger",
          "kind",
          "created_at",
          "updated_at",
          "configuration_revision",
          "task",
          "enabled"
        ],
        "properties": {
          "claimed": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "configuration_revision": {
            "type": "integer",
            "format": "int64",
            "description": "Independent of execution bookkeeping in `updated_at`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean",
            "description": "When false, automatic dispatch skips this action. `run_now` remains\navailable regardless."
          },
          "event_activated_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Event publication boundary; absent for cron actions."
          },
          "id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "name": {
            "type": "string"
          },
          "next_run_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Next cron firing, absent for event-triggered actions."
          },
          "owner": {
            "type": "string",
            "description": "Who the action belongs to. Every action is user-owned today, but the\ntype no longer says so: the principal string on the wire and in the\n`owner` column is the same, and a bot- or team-owned row decodes\nrather than failing to parse."
          },
          "task": {
            "type": "object"
          },
          "trigger": {
            "$ref": "#/components/schemas/ActionTrigger"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScheduledActionResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScheduledAction"
          },
          {
            "type": "object",
            "properties": {
              "schedule": {
                "type": ["string", "null"],
                "description": "Deprecated: use `trigger.schedule`. Present only for cron actions.",
                "deprecated": true
              },
              "timezone": {
                "type": ["string", "null"],
                "description": "Deprecated: use `trigger.timezone`. Present only for cron actions.",
                "deprecated": true
              }
            }
          }
        ],
        "description": "Canonical trigger plus deprecated cron fields for existing clients. Event\nresponses omit legacy fields rather than inventing a schedule or timezone."
      },
      "ScheduledActionUpdate": {
        "oneOf": [
          {
            "type": "object",
            "required": ["owner", "action_id", "type"],
            "properties": {
              "action_id": {
                "type": "string",
                "format": "uuid"
              },
              "chat_id": {
                "type": ["string", "null"]
              },
              "owner": {
                "type": "string"
              },
              "resource": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/ExecutionResource"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": ["started"]
              }
            }
          },
          {
            "type": "object",
            "required": ["owner", "action_id", "is_success", "type"],
            "properties": {
              "action_id": {
                "type": "string",
                "format": "uuid"
              },
              "chat_id": {
                "type": ["string", "null"]
              },
              "is_success": {
                "type": "boolean"
              },
              "owner": {
                "type": "string"
              },
              "resource": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/ExecutionResource"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": ["stopped"]
              }
            }
          }
        ],
        "description": "Live status update for a scheduled-action run, broadcast via the connection\ngateway to the owner. Clients use the typed resource to navigate to the run\ntranscript and the variant tag to toggle the running indicator. `chat_id`\nremains populated only for chat runs, for older clients.\n\nSerialized with a `type` tag (`started`/`stopped`) and delivered over the\nsingle `scheduled_action_update` message type on the gateway."
      },
      "SetScheduledActionEnabled": {
        "type": "object",
        "required": ["enabled"],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdateScheduledAction": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ActionConfigurationUpdate"
          },
          {
            "$ref": "#/components/schemas/LegacyActionConfiguration"
          }
        ],
        "description": "Full replacement of client configuration, not of server-owned action state."
      }
    }
  },
  "tags": [
    {
      "name": "scheduled actions",
      "description": "Scheduled action service"
    }
  ]
