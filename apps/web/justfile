# Increment the versionCode and commit before preparing the next native APK or
# Play AAB release. Also raises the Android floor in min-native-build.json to
# the new versionCode, so the next prod web deploy stops serving shared JS to
# older Android installs and prompts them to update. --no-min keeps the floor
# for a release older installs don't need.
android-bump *ARGS:
    bun scripts/android-release.ts bump {{ARGS}}

# iOS: dev-facing, for testing in Simulator. Honors PORT like the web dev
# server (`PORT=3001 just ios-dev`): the vite server picks PORT up through
# beforeDevCommand's environment, and the --config merge points the webview's
# devUrl at the same port.
ios-dev: ios-prepare
    bash scripts/ios-dev.sh

# Compatibility alias for `just ios-build --no-update`.
ios-build-no-update: (ios-build "--no-update")

# iOS: build for release; --no-update disables automatic bundle updates.
ios-build *ARGS: ios-prepare
    bash scripts/ios-build.sh "$@"

# iOS: arm64 Simulator .app for the Appetize PR preview (the `ios_preview`
# workflow). Simulator builds need no signing, and --no-default-features keeps
# the bundle auto-updater off so a preview cannot quietly replace itself with
# the production bundle.
#
# The frontend is built as a separate step rather than through Tauri's
# beforeBuildCommand hook: the web and wasm builds want the nix toolchain,
# while everything Xcode drives wants Apple's, and running both under one set
# of compiler flags breaks whichever one loses. CI builds the frontend in a
# clean nix shell and then calls this with prebuilt=true.
#
# Output: tauri/src-tauri/gen/apple/build/arm64-sim/macro.app
ios-build-sim prebuilt="false": ios-prepare
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{prebuilt}}" != "true" ]; then just build-tauri-dev; fi
    export TMPDIR="$(/usr/bin/getconf DARWIN_USER_TEMP_DIR)"
    # frontendDist is restated because this override replaces the build table:
    # dropping it silently produces an app with an empty assets/ and no
    # index.html, which installs and launches to a black screen.
    # Release, like every other iOS recipe here. A debug build links a ~240MB
    # unoptimised binary, which a real Mac starts fine but Appetize's
    # virtualised device does not — the preview launched to a black screen
    # while the identical debug build rendered in CI's simulator.
    cd tauri/src-tauri && cargo tauri ios build \
      --target aarch64-sim --ci --no-sign -v \
      --config '{"build":{"beforeBuildCommand":"","frontendDist":"../../dist"}}' \
      -- --no-default-features

# iOS: full release — build, upload to App Store Connect/TestFlight, and set
# export compliance, no Xcode UI. Requires APPLE_API_KEY + APPLE_API_ISSUER
# (one-time setup in the script header). Flags: --no-bump --skip-validate --no-wait
ios-release *ARGS:
    bash scripts/ios-release.sh {{ARGS}}

# iOS: bump the release numbers for an App Store release (build number, the
# iOS floor in min-native-build.json, and the marketing version if the
# committed one has already shipped) and sync gen/apple metadata. Run it
# through Doppler so it can ask App Store Connect (`doppler run --project
# ios-release --config prd -- just ios-bump`), then commit the result before
# adding the `ios-update` label to a PR with breaking native changes. Flags:
# --no-min (non-breaking App Store release) --build-only (TestFlight iteration)
ios-bump *ARGS:
    bun scripts/ios-bump-version.mjs {{ARGS}}

