# All app builds need the gitignored wasm packages: without the cache one the
# cache worker's dynamic import 404s at runtime and the normalized cache
# silently degrades to network-only, and a missing engine fails that file type.
#
# scripts/wasm.ts builds every module in wasm-modules.json in parallel, each
# with its own CARGO_TARGET_DIR (target/wasm/<name>) so they do not serialize
# on the workspace cargo lock. scripts/cached-wasm-build.sh reuses a package
# only when nothing it is built from changed (keyed on its sources, not a
# version bump), from WASM_PKG_CACHE_DIR (~/.cache/macro/wasm-pkgs unless set);
# in PR checks the Namespace `web-ci` sccache makes the rustc invocations
# cheaper when it does rebuild, and deploy builds use a local one.
#
# Vite's chunk-rendering can exceed 6GB as the app grows. Leave headroom
# above that peak; CI builds use the same mid-size runner as preview deploys.
node_heap := "--max-old-space-size=8192"
cache_wasm_target := justfile_directory() / "../../target/wasm/cache-wasm"

# Build wasm modules (all without names, e.g. `just build-wasm pptx-engine`).
# Flags pass through to scripts/wasm.ts: `--jobs N`, `--variant NAME`.
build-wasm *ARGS:
    bun scripts/wasm.ts build "$@"

# Build wasm modules only when their inputs changed since the last build: the
# input key (scripts/wasm-cache-key.ts) is compared with the one the build left
# next to its output. A stale fold or engine package renders with the wrong
# wire shape, so dev servers run this first (`dev:prepare`).
ensure-wasm *ARGS:
    bun scripts/wasm.ts ensure "$@"

build-dev: build-wasm (bundle "development")

build-staging: build-wasm (bundle "staging")

# Production bundles carry the native build floors checked in at
# min-native-build.json (schema 3 manifest, see scripts/write-bundle-manifest.mjs);
# `just ios-bump` raises the iOS one and `just android-bump` the Android one.
# Explicit MIN_NATIVE_BUILD_* env still wins.
build-prod: build-wasm
    #!/usr/bin/env bash
    set -euo pipefail
    export MIN_NATIVE_BUILD_ANDROID="${MIN_NATIVE_BUILD_ANDROID:-$(bun -e "console.log(require('./min-native-build.json').android)")}"
    export MIN_NATIVE_BUILD_IOS="${MIN_NATIVE_BUILD_IOS:-$(bun -e "console.log(require('./min-native-build.json').ios)")}"
    just --justfile "{{justfile()}}" bundle production

# The Vite build into dist, plus the cache WASM's Brotli sidecar (package-dist).
# Quality 11 takes about 20 s, so the sidecar is compressed from the wasm-pack
# output while Vite runs: Vite copies that file into dist unchanged, and
# package-dist uses the copy only if it decompresses to the bytes there.
[private]
bundle mode:
    #!/usr/bin/env bash
    set -euo pipefail
    sidecar="{{cache_wasm_target}}/precompressed/cache_wasm_bg.wasm.br"
    bun scripts/cache-wasm/cli.ts precompress --wasm src/lib/graphql-cache/wasm/cache_wasm_bg.wasm --out "$sidecar" &
    precompress=$!
    trap 'kill "$precompress" 2>/dev/null || true' EXIT
    MODE="$1" NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    wait "$precompress" || echo "precompressing the cache WASM failed; package-dist compresses it instead" >&2
    trap - EXIT
    bun scripts/cache-wasm/cli.ts package-dist --dist dist --precompressed "$sidecar"

# Tauri build hook (run automatically via beforeBuildCommand) — not meant to be run directly.
# Tauri embeds every file in dist, so source maps are deleted: native crash
# frames point at the public web copies, whose maps stay published.
# Videos (dist/web-hosted, see `assetFileNames` in vite.base.ts) are deleted
# too: the apps stream them from the web deploy.
[private]
build-tauri: build-wasm
    printf production > tauri/src-tauri/.macro-tauri-env
    MODE=production NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist
    bun scripts/cache-wasm/cli.ts remove-sidecar --dist dist
    find dist -type f -name '*.map' -delete
    rm -rf dist/web-hosted

# As build-tauri, but MODE=development so the bundle talks to dev.macro.com.
# Used by `ios-build-sim`: a PR preview must never be wired to production.
[private]
build-tauri-dev: build-wasm
    printf development > tauri/src-tauri/.macro-tauri-env
    MODE=development NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist
    bun scripts/cache-wasm/cli.ts remove-sidecar --dist dist
    find dist -type f -name '*.map' -delete
    rm -rf dist/web-hosted

# Build the bundle, zip it, and install it at
# tooling/native_app_server/app-archive.zip for the bundle
# updater test server. The server hashes the archive at request time, so no
# checksum wiring is needed.
dist-archive: build-prod
    #!/usr/bin/env bash
    set -euo pipefail
    TARGET="$(cd {{ justfile_directory() }}/../../tooling/native_app_server && pwd)/app-archive.zip"
    rm -f "$TARGET"
    (cd dist && zip -qr "$TARGET" . -x '*cache_wasm_bg*.wasm.br' '*.map' 'web-hosted/*')
    echo "Archive: $TARGET"

