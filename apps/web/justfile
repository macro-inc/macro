# iOS: dev-facing, for testing in Simulator
ios-dev: ios-prepare
    cd tauri/src-tauri && cargo tauri ios dev --open -- --no-default-features

# iOS: prod-facing build, with bundle auto-update turned off, for testing locally on actual iPhone
ios-build-no-update: ios-prepare
    cd tauri/src-tauri && cargo tauri ios build --open -- --no-default-features

# iOS: build for release
ios-build: ios-prepare
    cd tauri/src-tauri && cargo tauri ios build --open

# iOS generated project prep. Keep native bundle metadata in sync with
# tauri.ios.conf.json, then prepare ignored local Swift dependencies.
ios-prepare:
    bun scripts/sync-ios-bundle-metadata.mjs
    bun scripts/prepare-tauri-ios-api.mjs

# Xcode resolves SwiftPM packages before Tauri's Rust build script can generate
# local plugin Swift dependencies, so prepare the ignored Tauri iOS API first.
ios-prepare-tauri-api:
    bun scripts/prepare-tauri-ios-api.mjs

# Tauri build hook (run automatically via beforeDevCommand) — not meant to be run directly
[private]
dev-tauri: ensure-cache-wasm
    printf development > tauri/src-tauri/.macro-tauri-env
    bun run --bun dev

# List available local service names
local-services:
    @sed -n "s/.*'\([a-z][-a-z]*\)':.*/\1/p" src/lib/core/constant/servers.ts | sort -u

# Run the app with local services (defaults to ALL)
# This assumes you have followed the docs/RUNNING_LOCALLY.md instructions
servers := 'ALL'
port := '3000'

local:
    PORT='{{port}}' VITE_LOCAL_SERVERS='{{servers}}' bun run --bun dev

local-sync-playground:
    VITE_LOCAL_SERVERS='ALL' VITE_SYNC_SERVICE_HOST='sync-service-playground.macroverse.workers.dev' bun run --bun dev

local-dcs:
    VITE_LOCAL_SERVERS='cognition-service,cognition-websocket-service' bun run --bun dev

local-dss:
    VITE_LOCAL_SERVERS='document-storage-service' bun run --bun dev

local-search: ensure-cache-wasm
    VITE_LOCAL_SERVERS='search-service' bun run --bun dev

local-email: ensure-cache-wasm
    VITE_LOCAL_SERVERS='email-service' bun run --bun dev

# All app builds need the gitignored wasm pkg (src/lib/graphql-cache/wasm):
# without it the cache worker's dynamic import 404s at runtime and the
# normalized cache silently degrades to network-only.
#
# The vite build's chunk-rendering peaks right at node's default ~4GB heap
# cap, so CI builds flap with "Ineffective mark-compacts near heap limit".
# Lift the ceiling; peak usage stays the same, it just stops aborting.
node_heap := "--max-old-space-size=6144"

build-dev: build-cache-wasm build-agent-fold-wasm
    MODE=development NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build

build-staging: build-cache-wasm build-agent-fold-wasm
    MODE=staging NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build

build-prod: build-cache-wasm build-agent-fold-wasm
    MODE=production NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build

# Tauri build hook (run automatically via beforeBuildCommand) — not meant to be run directly
[private]
build-tauri: build-cache-wasm build-agent-fold-wasm
    printf production > tauri/src-tauri/.macro-tauri-env
    MODE=production NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build

# Build the bundle, zip it, and install it at
# tooling/native_app_server/app-archive.zip for the bundle
# updater test server. The server hashes the archive at request time, so no
# checksum wiring is needed.
dist-archive: build-prod
    #!/usr/bin/env bash
    set -euo pipefail
    TARGET="$(cd {{ justfile_directory() }}/../../tooling/native_app_server && pwd)/app-archive.zip"
    rm -f "$TARGET"
    (cd dist && zip -qr "$TARGET" .)
    echo "Archive: $TARGET"

bundle-smoke-server *ARGS:
    # Local manual OTA smoke server. Example:
    # just bundle-smoke-server older --host 0.0.0.0 --port 3001
    bun scripts/smoke-bundle-updater-server.ts {{ARGS}}

