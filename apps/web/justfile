# Local profiling build: retain Rust symbols and DWARF source locations so an
# exported Firefox profile can be symbolicated back to Rust files and lines.
# This overwrites the gitignored release wasm package and is intentionally not
# used by application or CI builds; the next `ensure-wasm` rebuilds the release.
build-cache-wasm-profile: (build-wasm "cache-wasm" "--variant" "profiling")

# Regenerate src/lib/service-clients/service-agent-fold/generated/types.ts (and
# the SDK's packages/sdk/generated/agent-fold/index.ts)
# from agent_fold's Rust wire types with specta. Run after changing anything
# under crates/folds/agent_fold/src/inbound/wire.rs. Specta's own output is tabs and
# commas, not this project's style, so biome reformats it in place - without
# that, every regeneration would be a diff-format mismatch even with no real
# change.
gen-agent-fold-types:
    if [ -n "${SPECTA_BIN_DIR:-}" ]; then "$SPECTA_BIN_DIR/agent_fold_types"; else cargo run -p agent_fold --bin agent_fold_types; fi
    bunx biome format --write {{justfile_directory()}}/src/lib/service-clients/service-agent-fold/generated/types.ts

# Regenerate src/lib/service-clients/service-agent-reviews/generated/types.ts
# (and the SDK's packages/sdk/generated/agent-reviews/index.ts) from
# agent_code_mode's review types with specta. Run after changing a review type
# or a type a review draft or result reuses (SendEmail, CreateCalendarEvent,
# their responses, the import report); biome reformats specta's output for the
# same reason as gen-agent-fold-types.
gen-agent-review-types:
    if [ -n "${SPECTA_BIN_DIR:-}" ]; then "$SPECTA_BIN_DIR/export_review_types"; else SQLX_OFFLINE=true cargo run -p agent_code_mode --bin export_review_types; fi
    bunx biome format --write {{justfile_directory()}}/src/lib/service-clients/service-agent-reviews/generated/types.ts

# Regenerate the dynamic-UI view types (src/features/dynamic-ui/generated/types.ts
# and lexical-core's copy) from `crates/dynamic_ui` with specta. Run after
# changing a widget; biome reformats specta's output as in gen-agent-fold-types.
gen-dynamic-ui-types:
    cargo run -p dynamic_ui --features cli --bin export_view_types
    bunx biome format --write {{justfile_directory()}}/src/features/dynamic-ui/generated/types.ts {{justfile_directory()}}/../../packages/lexical-core/generated/dynamic-ui.ts

# Regenerate src/lib/core/database-sql/generated/types.ts from the
# database_sql engine's wire types with specta. Run after changing any type
# that crosses the wasm boundary (see crates/database_sql/src/wasm.rs); biome
# reformats specta's output for the same reason as gen-agent-fold-types.
gen-database-sql-types:
    cargo run -p database_sql --features cli --bin database_sql_types
    bunx biome format --write {{justfile_directory()}}/src/lib/core/database-sql/generated/types.ts
