# The fixture tests that cover a class of email or calendar bug (real
# components over scripted data, no backend). Each line is a Playwright
# config and, where the suite holds more than those tests, the files or the
# titles (`-g`, a dot for each space) to run:
# the rest of such a suite is not run in CI. A dev server's first page load
# can outlast a test's first wait, hence the retries. Tests tagged
# `@known-bug` assert behaviour that is not fixed yet and stay out.
test-email-fixtures-browser *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    while read -r config files; do
        env -u LD_LIBRARY_PATH bunx playwright test --config "$config" $files --grep-invert @known-bug --retries 2 {{ARGS}} < /dev/null
    done <<'SUITES'
    src/features/email-compose/browser-test/playwright.config.ts -g alias.does.not.make|already-sent.background.save|sends.its.newest.text.once|sends.the.newest.text.once
    src/features/email-compose/browser-test/playwright.app.config.ts recipient-commit.app
    src/features/block-email/browser-test/playwright.config.ts
    src/features/calendar/browser-test/playwright.config.ts
    src/features/calendar-view/browser-test/playwright.config.ts
    src/features/settings/browser-test/signatures/playwright.config.ts
    src/lib/core/component/LexicalMarkdown/component/decorator/browser-test/playwright.config.ts unavailable-mention.browser -g tapping.the.deleted.event.chip
    ../../packages/email-renderer/playwright.config.ts rendering.pw
    SUITES

