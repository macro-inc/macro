    bunx --bun biome lint --only=nursery/noImportCycles

cycles-ci:
    bunx --bun biome lint --changed --only=nursery/noImportCycles

# Build the GraphQL cache wasm module into src/lib/graphql-cache/wasm
# (gitignored). Unconditional — CI app builds must never skip it (schema or
# engine changes alter the wasm without a cache-wasm version bump).
build-cache-wasm:
    wasm-pack build {{justfile_directory()}}/../../crates/client/cache-wasm --target web --release --out-dir {{justfile_directory()}}/src/lib/graphql-cache/wasm

# Local profiling build: retain Rust symbols and DWARF source locations so an
# exported Firefox profile can be symbolicated back to Rust files and lines.
# This overwrites the gitignored release wasm package and is intentionally not
# used by application or CI builds.
build-cache-wasm-profile:
    wasm-pack build {{justfile_directory()}}/../../crates/client/cache-wasm --target web --profile cache-wasm-profiling --out-dir {{justfile_directory()}}/src/lib/graphql-cache/wasm

# Build the agent-fold wasm module into src/lib/core/agent-fold/wasm
# (gitignored). `--no-default-features` drops the crate's `cli` feature, whose
# tokio/clap do not build for wasm32; the fold itself needs neither.
build-agent-fold-wasm:
    wasm-pack build {{justfile_directory()}}/../../crates/agent_fold --target web --release --out-dir {{justfile_directory()}}/src/lib/core/agent-fold/wasm -- --no-default-features

# Dev fast path: build the agent-fold wasm pkg only when it is missing. Unlike
# ensure-cache-wasm there is no version-drift check yet, so run
# `just build-agent-fold-wasm` by hand after changing the fold.
ensure-agent-fold-wasm:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{justfile_directory()}}/src/lib/core/agent-fold/wasm/agent_fold_bg.wasm" ]; then
        just --justfile "{{justfile()}}" build-agent-fold-wasm
    fi

# Dev fast path: build the wasm pkg only when missing or its version drifts
# from client/cache-wasm/Cargo.toml (bump that version to push a rebuild to
# dev machines). See tooling/xtask/crates/xtask_cache_wasm/src/main.rs.
ensure-cache-wasm:
    cd {{justfile_directory()}}/../.. && SQLX_OFFLINE=true cargo run -q -p xtask -- cache-wasm
