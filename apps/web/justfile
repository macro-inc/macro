# The same suite on a running local stack instance (tests/email-e2e/README.md,
# "The full-stack tier"); the root `just email-e2e-full-stack` starts the
# instance and builds the bundle. The addresses are read from the instance.
test-email-e2e-full-stack instance *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    status=$(cd ../.. && just run_local status --json --instance "{{instance}}")
    # A stack started with Doppler's config holds real Google, model and
    # payment keys: its sign-ups and its assistant would reach those
    # services. The tier runs only on a stack that was started without.
    state="../../infra/local/generated/{{instance}}/stack.json"
    if [ "$(jq -r '.no_doppler' "$state" 2>/dev/null)" != "true" ]; then
        echo "The instance {{instance}} was not started with --no-doppler ($state): the full-stack tier does not run on it. Stop it and start it with: just email-e2e-full-stack" >&2
        exit 1
    fi
    # Assigned before they are exported: `export X=$(...)` hides a failure.
    project=$(jq -er .project <<<"$status")
    port() { docker compose -p "$project" port "$1" "$2" | sed 's/.*://'; }
    proxy=$(jq -er .proxy_url <<<"$status")
    database=$(jq -er .postgres_url <<<"$status")
    redis=$(port redis 6379)
    gmail=$(port gmail_emulator 8080)
    outlook=$(port outlook_emulator 8080)
    queues=$(jq -er .localstack_url <<<"$status")
    # A stack runs the three stand-ins only when its config holds no real
    # key for what they stand for: without one of them, it would call the
    # real service.
    model=$(port model_emulator 8080 2>/dev/null || true)
    if [ -z "$model" ]; then
        echo "The instance {{instance}} has no model stand-in running, so the assistant would reach a real model. Stop it and start it with: just email-e2e-full-stack" >&2
        exit 1
    fi
    export EMAIL_E2E_STACK_PROXY_URL="$proxy"
    export EMAIL_E2E_STACK_DATABASE_URL="$database"
    export EMAIL_E2E_STACK_REDIS_URL="redis://localhost:$redis"
    export EMAIL_E2E_STACK_GMAIL_URL="http://localhost:$gmail"
    export EMAIL_E2E_STACK_OUTLOOK_URL="http://localhost:$outlook"
    export EMAIL_E2E_STACK_SQS_URL="$queues"
    export EMAIL_E2E_STACK_MODEL_URL="http://localhost:$model"
    export EMAIL_E2E_STACK_NO_DOPPLER=true
    env -u LD_LIBRARY_PATH bunx playwright test --config tests/email-e2e/playwright.config.ts {{ARGS}}

# The coverage ledger of the email UI, from the last run of the browser suite
# (tests/email-e2e/ledger/README.md). Reports only; `--enforce` fails on a
# function or row with neither a passing test nor a waiver, `--record`
# rewrites the list of what only the full-stack tier covers.
email-e2e-ledger *ARGS:
