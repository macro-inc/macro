# Build the GraphQL cache wasm module into src/lib/graphql-cache/wasm
# (gitignored). Unconditional — CI app builds must never skip it (schema or
# engine changes alter the wasm without a cache-wasm version bump).
build-cache-wasm:
    CARGO_TARGET_DIR="{{cache_wasm_target}}" wasm-pack build {{justfile_directory()}}/../../crates/client/cache-wasm --target web --release --out-dir {{justfile_directory()}}/src/lib/graphql-cache/wasm

# Build the production browser harness served by Vite preview.
build-cache-wasm-browser-production: build-cache-wasm build-cache-wasm-browser-test-hooks
    bunx --bun vite build --config src/lib/graphql-cache/worker/browser-test/vite.config.ts
    bun scripts/cache-wasm/cli.ts package-dist --dist src/lib/graphql-cache/worker/browser-test/.dist-production

# Build the separate destructive-hook WASM used only by cache recovery tests.
# Its distinct name keeps it outside the one-production-cache-WASM deploy gate.
[private]
build-cache-wasm-browser-test-hooks:
    CARGO_TARGET_DIR="{{cache_wasm_target}}" wasm-pack build {{justfile_directory()}}/../../crates/client/cache-wasm \
      --target web --release \
      --out-name cache_wasm_browser_test_hooks \
      --out-dir {{justfile_directory()}}/src/lib/graphql-cache/wasm-browser-test \
      --features browser-test-hooks

# Exercise development and production asset URLs, lazy election, MIME,
# fresh-scope startup, DB-ready, first-ready, and linear-memory budgets.
test-cache-wasm-browser:
    bunx --bun playwright test --config src/lib/graphql-cache/worker/browser-test/playwright.config.ts --project chromium --project firefox
    bunx --bun playwright test --config src/lib/graphql-cache/worker/browser-test/playwright.production.config.ts --project chromium-production --project firefox-production

# Local profiling build: retain Rust symbols and DWARF source locations so an
# exported Firefox profile can be symbolicated back to Rust files and lines.
# This overwrites the gitignored release wasm package and is intentionally not
# used by application or CI builds.
build-cache-wasm-profile:
    CARGO_TARGET_DIR="{{cache_wasm_target}}" wasm-pack build {{justfile_directory()}}/../../crates/client/cache-wasm --target web --profile cache-wasm-profiling --out-dir {{justfile_directory()}}/src/lib/graphql-cache/wasm

# Build the agent-fold wasm module into src/lib/core/agent-fold/wasm
# (gitignored). `--no-default-features` drops the crate's `cli` feature, whose
# tokio/clap do not build for wasm32; the fold itself needs neither.
build-agent-fold-wasm:
    CARGO_TARGET_DIR="{{agent_fold_wasm_target}}" wasm-pack build {{justfile_directory()}}/../../crates/agent_fold --target web --release --out-dir {{justfile_directory()}}/src/lib/core/agent-fold/wasm -- --no-default-features

# Dev fast path: build the agent-fold wasm pkg only when it is missing or any
# fold source is newer than the built artifact. A stale artifact folds with the
# wrong wire shape, which renders as chips silently stuck on their last event.
ensure-agent-fold-wasm:
    #!/usr/bin/env bash
    set -euo pipefail
    WASM="{{justfile_directory()}}/src/lib/core/agent-fold/wasm/agent_fold_bg.wasm"
    CRATE="{{justfile_directory()}}/../../crates/agent_fold"
    if [ ! -f "$WASM" ] || [ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" -newer "$WASM" -print -quit)" ]; then
        just --justfile "{{justfile()}}" build-agent-fold-wasm
    fi

# Build the database-sql wasm module (the SQL engine's staged `Query`) into
# src/lib/core/database-sql/wasm (gitignored).
build-database-sql-wasm:
    CARGO_TARGET_DIR="{{database_sql_wasm_target}}" wasm-pack build {{justfile_directory()}}/../../crates/database_sql --target web --release --out-dir {{justfile_directory()}}/src/lib/core/database-sql/wasm

# Dev fast path: build the database-sql wasm pkg only when it is missing or
# any source it is compiled from is newer than the built artifact: the
# engine's own and every workspace crate it depends on (the ops come from
# models_databases), so a changed export is never served stale.
ensure-database-sql-wasm:
    #!/usr/bin/env bash
    set -euo pipefail
    WASM="{{justfile_directory()}}/src/lib/core/database-sql/wasm/database_sql_bg.wasm"
    ROOT="{{justfile_directory()}}/../.."
    if [ ! -f "$WASM" ]; then
        just --justfile "{{justfile()}}" build-database-sql-wasm
        exit 0
    fi
    CRATES=$(cd "$ROOT" && cargo tree -p database_sql --target wasm32-unknown-unknown -e normal --prefix none --format '{p}' | sed -n 's/.*(\(\/[^)]*\)).*/\1/p' | sort -u)
    SOURCES=()
    for crate in $CRATES; do
        SOURCES+=("$crate/Cargo.toml")
        [ -d "$crate/src" ] && SOURCES+=("$crate/src")
    done
    if [ -n "$(find "${SOURCES[@]}" -newer "$WASM" -print -quit)" ]; then
        just --justfile "{{justfile()}}" build-database-sql-wasm
    fi

# Build the pptx-engine wasm module (PPTX rendering and editing, hosted in a
# worker by the pptx block) into src/lib/core/pptx-engine/wasm (gitignored).
# SIMD speeds up rasterization; every browser the app supports has it.
build-pptx-engine-wasm:
    CARGO_TARGET_DIR="{{pptx_engine_wasm_target}}" CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS="-C target-feature=+simd128" wasm-pack build {{justfile_directory()}}/../../crates/pptx_engine --target web --release --out-dir {{justfile_directory()}}/src/lib/core/pptx-engine/wasm

# Dev fast path: build the pptx-engine wasm pkg only when it is missing or any
# engine source is newer than the built artifact.
ensure-pptx-engine-wasm:
    #!/usr/bin/env bash
    set -euo pipefail
    WASM="{{justfile_directory()}}/src/lib/core/pptx-engine/wasm/pptx_engine_bg.wasm"
    CRATE="{{justfile_directory()}}/../../crates/pptx_engine"
    if [ ! -f "$WASM" ] || [ -n "$(find "$CRATE/src" "$CRATE/fonts" "$CRATE/assets" "$CRATE/Cargo.toml" -newer "$WASM" -print -quit)" ]; then
        just --justfile "{{justfile()}}" build-pptx-engine-wasm
    fi

# Build the docx-engine wasm module (DOCX layout, rendering and editing, hosted
# in a worker by the write block) into src/lib/core/docx-engine/wasm (gitignored).
build-docx-engine-wasm:
    CARGO_TARGET_DIR="{{docx_engine_wasm_target}}" CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS="-C target-feature=+simd128" wasm-pack build {{justfile_directory()}}/../../crates/docx_engine --target web --release --out-dir {{justfile_directory()}}/src/lib/core/docx-engine/wasm

# Dev fast path: build the docx-engine wasm pkg only when it is missing or any
# engine source (including the pptx engine it builds on) is newer than it.
ensure-docx-engine-wasm:
    #!/usr/bin/env bash
    set -euo pipefail
    WASM="{{justfile_directory()}}/src/lib/core/docx-engine/wasm/docx_engine_bg.wasm"
    CRATE="{{justfile_directory()}}/../../crates/docx_engine"
    PPTX="{{justfile_directory()}}/../../crates/pptx_engine"
    if [ ! -f "$WASM" ] || [ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" "$PPTX/src" "$PPTX/fonts" "$PPTX/Cargo.toml" -newer "$WASM" -print -quit)" ]; then
        just --justfile "{{justfile()}}" build-docx-engine-wasm
    fi

# Regenerate src/lib/service-clients/service-agent-fold/generated/types.ts
# from agent_fold's Rust wire types with specta. Run after changing anything
# under crates/agent_fold/src/inbound/wire.rs. Specta's own output is tabs and
# commas, not this project's style, so biome reformats it in place - without
# that, every regeneration would be a diff-format mismatch even with no real
# change.
gen-agent-fold-types:
    cargo run -p agent_fold --bin export_types
    bunx biome format --write {{justfile_directory()}}/src/lib/service-clients/service-agent-fold/generated/types.ts

# Regenerate src/lib/core/database-sql/generated/types.ts from the
# database_sql engine's wire types with specta. Run after changing any type
# that crosses the wasm boundary (see crates/database_sql/src/wasm.rs); biome
# reformats specta's output for the same reason as gen-agent-fold-types.
gen-database-sql-types:
    cargo run -p database_sql --features cli --bin database_sql_types
    bunx biome format --write {{justfile_directory()}}/src/lib/core/database-sql/generated/types.ts

# Dev fast path: build the wasm pkg only when missing or its version drifts
# from client/cache-wasm/Cargo.toml (bump that version to push a rebuild to
# dev machines). See tooling/xtask/crates/xtask_cache_wasm/src/main.rs.
ensure-cache-wasm:
    cd {{justfile_directory()}}/../.. && SQLX_OFFLINE=true cargo run -q -p xtask -- cache-wasm
