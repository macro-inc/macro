    VITE_LOCAL_SERVERS='email-service' bun run --bun dev

# All app builds need the gitignored wasm pkg (src/lib/graphql-cache/wasm):
# without it the cache worker's dynamic import 404s at runtime and the
# normalized cache silently degrades to network-only.
#
# The two wasm-pack crates do not share artifacts. Build them in parallel
# with distinct CARGO_TARGET_DIR values so they do not serialize on the
# workspace cargo lock. CI still always rebuilds (schema/engine changes can
# alter wasm without a version bump); Namespace `web-ci` sccache makes the
# rustc invocations cheap across deploys.
#
# Vite's chunk-rendering can exceed 6GB as the app grows. Leave headroom
# above that peak; CI builds use the same mid-size runner as preview deploys.
node_heap := "--max-old-space-size=8192"
cache_wasm_target := justfile_directory() / "../../target/cache-wasm"
agent_fold_wasm_target := justfile_directory() / "../../target/agent-fold-wasm"
database_sql_wasm_target := justfile_directory() / "../../target/database-sql-wasm"
pptx_engine_wasm_target := justfile_directory() / "../../target/pptx-engine-wasm"
docx_engine_wasm_target := justfile_directory() / "../../target/docx-engine-wasm"

[parallel]
build-wasm: build-cache-wasm build-agent-fold-wasm build-database-sql-wasm build-pptx-engine-wasm build-docx-engine-wasm

build-dev: build-wasm
    MODE=development NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist

build-staging: build-wasm
    MODE=staging NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist

build-prod: build-wasm
    MODE=production NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist

# Tauri build hook (run automatically via beforeBuildCommand) — not meant to be run directly
[private]
build-tauri: build-wasm
    printf production > tauri/src-tauri/.macro-tauri-env
    MODE=production NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist
    bun scripts/cache-wasm/cli.ts remove-sidecar --dist dist

# As build-tauri, but MODE=development so the bundle talks to dev.macro.com.
# Used by `ios-build-sim`: a PR preview must never be wired to production.
[private]
build-tauri-dev: build-cache-wasm build-agent-fold-wasm
    printf development > tauri/src-tauri/.macro-tauri-env
    MODE=development NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist
    bun scripts/cache-wasm/cli.ts remove-sidecar --dist dist

# Build the bundle, zip it, and install it at
# tooling/native_app_server/app-archive.zip for the bundle
# updater test server. The server hashes the archive at request time, so no
# checksum wiring is needed.
dist-archive: build-prod
    #!/usr/bin/env bash
    set -euo pipefail
    TARGET="$(cd {{ justfile_directory() }}/../../tooling/native_app_server && pwd)/app-archive.zip"
    rm -f "$TARGET"
    (cd dist && zip -qr "$TARGET" . -x '*cache_wasm_bg*.wasm.br')
    echo "Archive: $TARGET"

