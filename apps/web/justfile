    PORT='{{port}}' VITE_LOCAL_SERVERS='{{servers}}' bun run --bun dev

local-sync-playground:
    VITE_LOCAL_SERVERS='ALL' VITE_SYNC_SERVICE_HOST='sync-service-playground.macroverse.workers.dev' bun run --bun dev

