load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "mcp_auth_proxy",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "default",
        "inbound",
        "outbound",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/services/mcp_auth_proxy", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/ai_toolset:ai_toolset",
        "//crates/bot_id:bot_id",
        "//crates/cursor_api_key:cursor_api_key",
        "//crates/fusionauth:fusionauth",
        "//crates/macro_auth:macro_auth",
        "//crates/macro_user_id:macro_user_id",
        "@crates//:anyhow-1.0.103",
        "@crates//:axum-0.8.9",
        "@crates//:base64-0.22.1",
        "@crates//:chrono-0.4.45",
        "@crates//:redis-1.2.1",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:sqlx-0.8.6",
        "@crates//:thiserror-2.0.18",
        "@crates//:tower-0.5.3",
        "@crates//:tower-http-0.6.11",
        "@crates//:tracing-0.1.44",
        "@crates//:url-2.5.8",
        "@crates//:urlencoding-2.1.3",
        "@crates//:uuid-1.23.1",
        "@crates//:zeroize-1.9.0",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "mcp_auth_proxy_unit",
    crate = ":mcp_auth_proxy",
    crate_features = [
        "default",
        "inbound",
        "outbound",
    ],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/services/mcp_auth_proxy", "DATABASE_URL": "postgres://user@127.0.0.1:60097/macrodb", "SQLX_OFFLINE": "false"},
    deps = [
        "//crates/macro_db_migrator:macro_db_migrator",
        "@crates//:tokio-1.54.1",
    ],
    proc_macro_deps = [
        "@crates//:async-trait-0.1.89",
    ],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/services/mcp_auth_proxy"},
)

