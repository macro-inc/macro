{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macro-prox",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-22",
  "observability": {
    "enabled": true
  },
  // Cap each client to 30 req/s. The binding only allows a 10s or 60s window,
  // so 300 per 10s expresses 30/s. Bindings are not inherited by named
  // environments, so this is repeated under each env below.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 10 }
    }
  ],
  "vars": {
    "POSTHOG_HOST": "https://us.i.posthog.com",
    // Full origins (scheme included) the `/i/otlp` route forwards to, split
    // per signal because Datadog has no single OTLP origin: traces and logs
    // use different intake hosts. In deployed envs the server-side dd-api-key
    // is injected (a secret set via `wrangler secret put DD_API_KEY`, never
    // committed here). In the local pool the docker command overrides both to
    // the otel-collector alias via --var (one collector serves both paths).
    "OTLP_TRACES_INTAKE_URL": "https://trace.agent.us5.datadoghq.com",
    "OTLP_LOGS_INTAKE_URL": "https://otlp-http-intake.logs.us5.datadoghq.com"
  },
  "env": {
    "local": {
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 300, "period": 10 }
        }
      ],
      "vars": {
        "POSTHOG_HOST": "https://us.i.posthog.com",
        // Host defaults for a bare `bun run dev`; the docker pool overrides
        // both to http://otel-collector:4318 via --var (see docker-compose.yml).
        "OTLP_TRACES_INTAKE_URL": "http://localhost:4318",
        "OTLP_LOGS_INTAKE_URL": "http://localhost:4318"
      }
    },
    "dev": {
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 300, "period": 10 }
        }
      ],
      "vars": {
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "OTLP_TRACES_INTAKE_URL": "https://trace.agent.us5.datadoghq.com",
        "OTLP_LOGS_INTAKE_URL": "https://otlp-http-intake.logs.us5.datadoghq.com"
      }
    },
    "prod": {
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 300, "period": 10 }
        }
      ],
      "vars": {
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "OTLP_TRACES_INTAKE_URL": "https://trace.agent.us5.datadoghq.com",
        "OTLP_LOGS_INTAKE_URL": "https://otlp-http-intake.logs.us5.datadoghq.com"
      }
    }
  },
  "dev": {
    "port": 8098
  }
}
