{
	"name": "ai-editing-worker",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "bun scripts/generate-sandbox.ts",
		"type-check": "tsc --noEmit --project tsconfig.json",
		"traces": "bun scripts/traces.ts",
		"deploy-dev": "bun run prebuild && wrangler deploy --env dev",
		"deploy-prod": "bun run prebuild && wrangler deploy --env prod"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.85",
		"@ai-sdk/cerebras": "^2.0.57",
		"@ai-sdk/openai": "^3.0.73",
		"@hono/zod-validator": "^0.8.0",
		"@loro-mirror/core": "workspace:*",
		"@macro-inc/collaboration": "workspace:*",
		"@macro-inc/lexical-core": "workspace:*",
		"ai": "^6.0.207",
		"ai-fallback": "2",
		"envsafe": "^2.0.3",
		"hono": "^4.6.20",
		"loro-crdt": "1.13.7",
		"quickjs-emscripten": "^0.31.0",
		"yargs": "^18.0.0",
		"zod": "^4.4.3",
		"bitf": "^1.0.2",
		"flat": "^6.0.1",
		"p-queue": "^9.3.0",
		"random-js": "^2.1.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"@types/yargs": "^17.0.35",
		"bun-types": "^1.3.14",
		"wrangler": "^4.103.0"
	}
}
