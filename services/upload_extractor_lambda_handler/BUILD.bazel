load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_binary(
    name = "upload_extractor_lambda_handler_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "upload_extractor_lambda_handler",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "local",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/services/upload_extractor_lambda_handler"},
    deps = [
        "//crates/connection_gateway_client:connection_gateway_client",
        "//crates/document_storage_service_client:document_storage_service_client",
        "//crates/dynamodb_client:dynamodb_client",
        "//crates/macro_aws_config:macro_aws_config",
        "//crates/macro_entrypoint:macro_entrypoint",
        "//crates/macro_env_var:macro_env_var",
        "//crates/macro_service_urls:macro_service_urls",
        "//crates/model-entity:model_entity",
        "//crates/model:model",
        "//crates/models_bulk_upload:models_bulk_upload",
        "//crates/sqs_client:sqs_client",
        "@crates//:anyhow-1.0.103",
        "@crates//:aws-sdk-s3-1.133.0",
        "@crates//:aws-sdk-sqs-1.99.0",
        "@crates//:aws_lambda_events-0.16.1",
        "@crates//:chrono-0.4.45",
        "@crates//:futures-0.3.32",
        "@crates//:lambda_runtime-0.13.0",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:tempfile-3.27.0",
        "@crates//:tokio-1.54.1",
        "@crates//:tokio-stream-0.1.18",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:walkdir-2.5.0",
        "@crates//:zip-9.0.5",
    ],
    proc_macro_deps = [],
    aliases = {},
)

