load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "local",
        "local-extract",
        "macos",
    ],
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations"],
)

rust_binary(
    name = "document_text_extractor_bin",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_name = "document_text_extractor",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    crate_features = [
        "local",
        "local-extract",
        "macos",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]) + ["//crates/macro_db_client:migrations", "//:sqlx_offline_data", "//tooling/bazel-proto:fake_cargo.sh"],
    rustc_env = {"BAZEL_WS_ROOT": "/proc/self/cwd", "CARGO": "/proc/self/cwd/../../tooling/bazel-proto/fake_cargo.sh", "CARGO_MANIFEST_DIR": "/proc/self/cwd/services/document_text_extractor", "SQLX_OFFLINE": "true"},
    deps = [
        "//crates/agent:agent",
        "//crates/macro_aws_config:macro_aws_config",
        "//crates/macro_entrypoint:macro_entrypoint",
        "//crates/macro_env_var:macro_env_var",
        "//crates/model:model",
        "//crates/s3_key:s3_key",
        ":build_script",
        "@crates//:anyhow-1.0.103",
        "@crates//:aws-sdk-s3-1.133.0",
        "@crates//:aws_lambda_events-0.16.1",
        "@crates//:chrono-0.4.45",
        "@crates//:lambda_runtime-0.13.0",
        "@crates//:mockall-0.13.1",
        "@crates//:pdfium-render-0.8.37",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sqlx-0.8.6",
        "@crates//:tiktoken-rs-0.5.9",
        "@crates//:tokio-1.54.1",
        "@crates//:tracing-0.1.44",
        "@crates//:urlencoding-2.1.3",
        "@crates//:uuid-1.23.1",
    ],
    proc_macro_deps = [],
    aliases = {},
)

