image := "agent-container"

typecheck:
    nix develop --command bunx tsc --noEmit

# Regenerate src/protocol/generated.ts from the Rust types with Specta.
gen-protocol:
    nix develop --command cargo run -p agent_runtime_protocol --bin export_types

build-image:
    cd container && docker build -t {{image}} .

serve:
    GITHUB_TOKEN=$(gh auth token) nix develop --command bun run index.ts

client *args:
    bun scripts/client.tsx {{args}}

# Kick off a session (webhook flow: returns the id immediately; watch `just upstream`).
session repo prompt:
    curl -s -X POST localhost:3000/session -H 'content-type: application/json' \
      -d '{"repoUrl":"{{repo}}","prompt":"{{prompt}}"}'

destroy id:
    curl -s -X DELETE localhost:3000/session/{{id}}
