{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencode"
  ],
  "model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio",
        "--toolsets",
        "issues,pull_requests"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  }
}
