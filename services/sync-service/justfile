export ENV := "local"

worker-build: setup worker_build_setup
  worker-build --features create-default-state,bebop-owned-all

# rust both unit and e2e tests
test: worker-build
  npx vitest run
  cargo test

# Run tests without the alarm-keep-alive feature
test-no-alarm: setup worker_build_setup
    worker-build --profile sync-service-release --no-default-features --features create-default-state,bebop-owned-all
    npx vitest

setup:
    npm install && cd bebop/ && npx bebopc build

worker_build_setup:
    cargo install worker-build@0.8.4

# initialize the local D1 database used by wrangler dev
migrate-d1-local:
  CI=true npx wrangler d1 migrations apply USER_PEER_MAPPING --local --config wrangler.toml

# run worker using wrangler / miniflare
dev: migrate-d1-local
  npx wrangler dev

# clean testing artifacts
clean:
  rm -rf node_modules .wrangler data

deploy-dev:
  npx wrangler deploy --env dev

migrate-d1-playground:
  CI=true npx wrangler d1 migrations apply USER_PEER_MAPPING --config wrangler.automerge.toml --env playground --remote

# First deployment provisions fresh storage before applying migrations. This
# worker has no application traffic; run the native smoke test after migration.
deploy-playground:
  npx wrangler deploy --config wrangler.automerge.toml --env playground
  just migrate-d1-playground

deploy-playground-dry:
  npx wrangler deploy --config wrangler.automerge.toml --env playground --dry-run

deploy-dev-dry:
  npx wrangler deploy --env dev --dry-run

deploy-prod-dry:
  npx wrangler deploy --env prod --dry-run

migrate-d1-prod:
  CI=true npx wrangler d1 migrations apply USER_PEER_MAPPING --env prod --remote

# CI runs the same two steps (.github/workflows/deploy_sync_service.yml)
deploy-prod: migrate-d1-prod
  npx wrangler deploy --env prod

# Isolated local native protocol worker; never reads an pre-Automerge local volume.
local-automerge:
  CI=true npx wrangler d1 migrations apply USER_PEER_MAPPING --local --config wrangler.automerge.toml --persist-to .wrangler-automerge
  npx wrangler dev --config wrangler.automerge.toml --persist-to .wrangler-automerge --var LOCAL_API_KEY:local --port 8791
