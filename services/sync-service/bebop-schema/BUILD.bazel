load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(name = "all_files", srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]))

rust_library(
    name = "sync_service_bebop_schema",
    srcs = glob(["**/*.rs"], exclude = ["target/**"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.1.0",
    crate_features = [
        "bebop-owned-all",
    ],
    compile_data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/services/sync-service/bebop-schema"},
    deps = [
        "@crates//:bebop-3.2.3",
    ],
    proc_macro_deps = [],
    aliases = {},
)

rust_test(
    name = "sync_service_bebop_schema_unit",
    crate = ":sync_service_bebop_schema",
    crate_features = [
        "bebop-owned-all",
    ],
    rustc_env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/services/sync-service/bebop-schema"},
    deps = [],
    proc_macro_deps = [],
    aliases = {},
    data = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    env = {"CARGO_MANIFEST_DIR": "/proc/self/cwd/services/sync-service/bebop-schema"},
)

