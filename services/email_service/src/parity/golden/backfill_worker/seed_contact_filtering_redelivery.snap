        INFO get_message {"gate_cap":5,"gate_in_flight":1,"link_id":"<link:A>","provider_message_id":"seed","retry_count":0}
          INFO get_access_token {"freshness":"Cached","link_id":"<link:A>"}
            INFO get_access_token {"freshness":"Cached","link_id":"<link:A>"}
              INFO fetch_link_by_id {"link_id":"<link:A>"}
          INFO get_message {"message_provider_id":"seed"}
            INFO get_message {"message_provider_id":"seed"}
        INFO publish_nodes {}
    INFO cleanup_message {"message_id":"delivery","message_receipt_handle":"delivery-receipt-1"}
      INFO delete_message {"receipt_handle":"<volatile>"}
