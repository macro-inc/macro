{
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"strict": true,
		"noEmit": true,
		"lib": ["es2022", "dom"],
		"types": ["@types/node", "bun-types"]
	},
	"exclude": ["node_modules"],
	"include": ["src", "test"]
}
