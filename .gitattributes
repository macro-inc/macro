# Mark .sqlx files as generated so they're excluded from PR diff stats
**/.sqlx/** linguist-generated=true

# Workflows generated by `cargo x workflows` (xtask). Collapse them in PR diffs
# and exclude from language stats; edit the Rust source, not the YAML.
.github/workflows/code-check-cloud-storage.yml linguist-generated=true
.github/workflows/check-generated-workflows.yml linguist-generated=true
