# Mark .sqlx files as generated so they're excluded from PR diff stats
**/.sqlx/** linguist-generated=true

# API clients and schemas are generated from service contracts. Collapse them in
# PR diffs and exclude them from language stats.
apps/web/src/lib/service-clients/**/generated/** linguist-generated=true
apps/web/src/lib/service-clients/**/openapi.json linguist-generated=true

# Workflows generated by `cargo x workflows` (xtask). Collapse them in PR diffs
# and exclude from language stats; edit the Rust source, not the YAML.
.github/workflows/code_check_cloud_storage.yml linguist-generated=true
.github/workflows/check_generated.yml linguist-generated=true

# Time zone tables generated from vendor/chrono-tz/tz by its update-tzdata.sh.
vendor/chrono-tz/src/prebuilt/** linguist-generated=true

# sqlx keys its offline cache (.sqlx) on the exact query text, so a CRLF
# checkout (Git for Windows) of a `query_file!` source misses the cache.
*.sql text eol=lf
