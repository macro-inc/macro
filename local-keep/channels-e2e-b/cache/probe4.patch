+import { appendFileSync } from 'node:fs';
+import { join as joinPath } from 'node:path';
+import { runDirectory as probeRunDirectory } from './stack';
+function listen(context: import('@playwright/test').BrowserContext, who: string): void {
+  const title = base.info().title;
+  context.on('console', (message) => {
+    if (!/mutation_queue|graphql-cache/.test(message.text())) return;
+    void Promise.all(message.args().map((arg) => arg.jsonValue().catch(() => '?'))).then((args) =>
+      appendFileSync(
+        joinPath(probeRunDirectory(), 'console.log'),
+        `${title}\t${who}\t${new Date().toISOString()}\t${JSON.stringify(args)}\n`
+      )
+    );
+  });
+}
+export const COPIES = Array.from({ length: Number(process.env.CHANNELS_E2E_COPIES ?? 1) }, (_, n) => n + 1);
+/** Probe: runs a check with the usual wait; if it fails, times how long the thing takes, up to 330 s, then fails as before. */
+export async function timed(label: string, run: (timeout: number) => Promise<void>, usual = 15_000): Promise<void> {
+  const from = Date.now();
+  try {
+    await run(usual);
+  } catch (error) {
+    let note = `${label}: not within 330 s`;
+    try {
+      await run(330_000);
+      note = `${label}: after ${Math.round((Date.now() - from) / 1000)} s`;
+    } catch {}
+    base.info().annotations.push({ type: 'late', description: note });
+    appendFileSync(joinPath(probeRunDirectory(), 'late.log'), `${base.info().title}\t${note}\n`);
+    throw error;
+  }
+}
